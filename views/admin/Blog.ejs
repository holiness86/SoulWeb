<%# views/admin/Blog.ejs — مدیریت وبلاگ
    ورودی‌ها از server.js: posts (با populate('author','name'))
    روت‌ها: GET /sw-admin/blog-form · GET /sw-admin/blog-form/:id (ویرایش) · POST /sw-admin/blog/:id/status (JSON) · POST /sw-admin/blog/:id/delete %>
<%
  const list = Array.isArray(posts) ? posts : [];
  const fa = (n) => Number(n || 0).toLocaleString('fa-IR');

  const fmtDate = (d) => {
    if (!d) return '—';
    const x = new Date(d);
    return Number.isNaN(x.getTime()) ? '—' : x.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' });
  };
  const authorName = (p) => (p.author && p.author.name) ? p.author.name : '—';
  const isPub = (p) => p.status === 'published';

  const publishedCount = list.filter(isPub).length;
  const draftCount = list.length - publishedCount;
  const totalViews = list.reduce((s, p) => s + (Number(p.views) || 0), 0);
  const categories = Array.from(new Set(list.map((p) => p.category).filter(Boolean)));
%>
<%- include('partials/_head', { title: 'مدیریت وبلاگ' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'blog' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'وبلاگ' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content" id="blogPage">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">مدیریت وبلاگ</h1>
          <p class="page-subtitle"><span id="cntPub"><%= fa(publishedCount) %></span> مقاله منتشرشده · <span id="cntDraft"><%= fa(draftCount) %></span> پیش‌نویس</p>
        </div>
        <a href="/sw-admin/blog-form" class="btn-sol-sm"><i class="bi bi-plus-lg"></i> مقاله جدید</a>
      </div>

      <!-- Stats -->
      <div class="sw-g c4 fade-up fade-up-2">
        <div class="pstat"><div class="pstat-icon"><i class="bi bi-journal-text"></i></div><div><div class="pstat-val text-grad" id="statPub"><%= fa(publishedCount) %></div><div class="pstat-lbl">مقاله منتشرشده</div></div></div>
        <div class="pstat"><div class="pstat-icon warn"><i class="bi bi-file-earmark-text"></i></div><div><div class="pstat-val text-grad" id="statDraft"><%= fa(draftCount) %></div><div class="pstat-lbl">پیش‌نویس</div></div></div>
        <div class="pstat"><div class="pstat-icon accent"><i class="bi bi-eye-fill"></i></div><div><div class="pstat-val text-grad"><%= fa(totalViews) %></div><div class="pstat-lbl">کل بازدید</div></div></div>
        <div class="pstat"><div class="pstat-icon ok"><i class="bi bi-folder2"></i></div><div><div class="pstat-val text-grad"><%= fa(categories.length) %></div><div class="pstat-lbl">دسته‌بندی</div></div></div>
      </div>

      <!-- Filter / Search -->
      <div class="filter-bar fade-up fade-up-2" role="toolbar" aria-label="فیلتر مقالات">
        <button type="button" class="filter-chip active" data-status="all">همه <span class="filter-count" id="chipAll"><%= fa(list.length) %></span></button>
        <button type="button" class="filter-chip" data-status="published">منتشرشده <span class="filter-count" id="chipPub"><%= fa(publishedCount) %></span></button>
        <button type="button" class="filter-chip" data-status="draft">پیش‌نویس <span class="filter-count" id="chipDraft"><%= fa(draftCount) %></span></button>

        <div class="tools">
          <label class="sw-search" aria-label="جستجو در مقالات">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="blogSearch" placeholder="عنوان، نویسنده یا برچسب…" autocomplete="off">
          </label>
          <select class="sol-select" id="blogCategory" aria-label="فیلتر دسته‌بندی">
            <option value="all">همه دسته‌ها</option>
            <% categories.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
          </select>
        </div>
      </div>

      <!-- Posts Table -->
      <div class="dash-panel fade-up fade-up-3">
        <div class="sw-tw">
          <table class="sol-table">
            <thead>
              <tr><th>مقاله</th><th>دسته‌بندی</th><th>نویسنده</th><th>بازدید</th><th>وضعیت</th><th>تاریخ</th><th>عملیات</th></tr>
            </thead>
            <tbody id="blogBody">
              <% list.forEach(function (p) { const pub = isPub(p); const tags = Array.isArray(p.tags) ? p.tags : []; %>
                <tr data-id="<%= p._id %>" data-status="<%= pub ? 'published' : 'draft' %>" data-cat="<%= p.category || '' %>" data-title="<%= p.title || '' %>"
                    data-q="<%= [p.title, authorName(p), p.category, tags.join(' ')].join(' ') %>">
                  <td>
                    <div class="blog-cell">
                      <a class="blog-thumb" href="/sw-admin/blog-form/<%= p._id %>" tabindex="-1" aria-hidden="true">
                        <% if (p.coverImage) { %><img src="<%= p.coverImage %>" alt="" loading="lazy" decoding="async"><% } else { %><i class="bi bi-journal-richtext"></i><% } %>
                      </a>
                      <div class="blog-cell-text">
                        <a class="cell-title blog-title-link" href="/sw-admin/blog-form/<%= p._id %>"><%= p.title || 'بدون عنوان' %></a>
                        <div class="cell-sub" dir="ltr">/blog/<%= p.slug || '' %></div>
                      </div>
                    </div>
                  </td>
                  <td><% if (p.category) { %><span class="cat-chip"><%= p.category %></span><% } else { %><span class="cell-sub">—</span><% } %></td>
                  <td><%= authorName(p) %></td>
                  <td class="cell-sub"><%= fa(p.views) %></td>
                  <td><span class="badge-status <%= pub ? 'badge-done' : 'badge-review' %>" data-badge><%= pub ? 'منتشرشده' : 'پیش‌نویس' %></span></td>
                  <td class="cell-sub"><%= fmtDate(p.publishedAt || p.createdAt) %></td>
                  <td>
                    <div class="row-actions">
                      <a href="/sw-admin/blog-form/<%= p._id %>" class="btn-icon" title="ویرایش" aria-label="ویرایش"><i class="bi bi-pencil"></i></a>
                      <button type="button" class="btn-icon <%= pub ? '' : 'ok' %>" data-pub-toggle title="<%= pub ? 'برگرداندن به پیش‌نویس' : 'انتشار' %>" aria-label="<%= pub ? 'برگرداندن به پیش‌نویس' : 'انتشار' %>"><i class="bi <%= pub ? 'bi-file-earmark' : 'bi-send' %>"></i></button>
                      <a href="/blog/<%= p.slug || '' %>" class="btn-icon" title="مشاهده در سایت" aria-label="مشاهده در سایت" target="_blank" rel="noopener" data-site-link <%= pub ? '' : 'hidden' %>><i class="bi bi-box-arrow-up-left"></i></a>
                      <form action="/sw-admin/blog/<%= p._id %>/delete" method="POST" data-sw-confirm="مقاله «<%= p.title || 'بدون عنوان' %>» حذف شود؟ این کار قابل بازگشت نیست.">
                        <button type="submit" class="btn-icon danger" title="حذف" aria-label="حذف"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
              <tr id="blogNoMatch" hidden><td colspan="7"><div class="sw-empty"><i class="bi bi-search"></i>مقاله‌ای با این فیلترها پیدا نشد.</div></td></tr>
              <% if (!list.length) { %>
                <tr><td colspan="7"><div class="sw-empty"><i class="bi bi-journal-text"></i>هنوز مقاله‌ای ثبت نشده است.<br><a href="/sw-admin/blog-form" class="btn-sol-sm" style="margin-top:1rem;">اولین مقاله را بنویسید</a></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="tbl-foot">
          <span id="blogRange">—</span>
          <div class="sw-pager" id="blogPager"></div>
        </div>
      </div>

    </main>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return Number(v).toLocaleString('fa-IR'); }
  function norm(s) { return String(s || '').replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/[۰-۹]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); }).toLowerCase(); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var body = $('#blogBody'), rows = $$('tr[data-id]', body), PAGE = 10;
  var state = { status: 'all', cat: 'all', q: '', page: 1 };

  /* ───────── فیلتر + جستجو + صفحه‌بندی (سمت کلاینت) ───────── */
  function matches(r) {
    var q = norm(state.q);
    return (state.status === 'all' || r.dataset.status === state.status) && (state.cat === 'all' || r.dataset.cat === state.cat) && (!q || norm(r.dataset.q).indexOf(q) > -1);
  }
  function pagerBtn(label, page, o) {
    var b = document.createElement('button'); b.type = 'button'; b.className = 'pg-btn' + (o.active ? ' active' : ''); b.textContent = label; b.disabled = !!o.disabled;
    if (o.aria) b.setAttribute('aria-label', o.aria); if (o.active) b.setAttribute('aria-current', 'page');
    b.addEventListener('click', function () { state.page = page; render(); }); return b;
  }
  function render() {
    var list = rows.filter(matches), pages = Math.max(1, Math.ceil(list.length / PAGE));
    state.page = Math.min(state.page, pages);
    var from = (state.page - 1) * PAGE, show = list.slice(from, from + PAGE);
    rows.forEach(function (r) { r.hidden = show.indexOf(r) < 0; });
    $('#blogNoMatch').hidden = !(rows.length && !list.length);
    $('#blogRange').textContent = list.length ? 'نمایش ' + fa(from + 1) + '–' + fa(from + show.length) + ' از ' + fa(list.length) + ' مقاله' : (rows.length ? 'مقاله‌ای یافت نشد' : '—');
    var pg = $('#blogPager'); pg.textContent = '';
    if (pages < 2) return;
    pg.appendChild(pagerBtn('›', state.page - 1, { disabled: state.page === 1, aria: 'قبلی' }));
    for (var i = 1; i <= pages; i++) {
      if (i === 1 || i === pages || Math.abs(i - state.page) <= 1) pg.appendChild(pagerBtn(fa(i), i, { active: i === state.page }));
      else if (Math.abs(i - state.page) === 2) { var d = document.createElement('span'); d.className = 'pg-dots'; d.textContent = '…'; pg.appendChild(d); }
    }
    pg.appendChild(pagerBtn('‹', state.page + 1, { disabled: state.page === pages, aria: 'بعدی' }));
  }
  $$('.filter-chip[data-status]').forEach(function (chip) {
    chip.addEventListener('click', function () {
      $$('.filter-chip[data-status]').forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active'); state.status = chip.dataset.status; state.page = 1; render();
    });
  });
  $('#blogCategory').addEventListener('change', function (e) { state.cat = e.target.value; state.page = 1; render(); });
  var t = 0;
  $('#blogSearch').addEventListener('input', function (e) { clearTimeout(t); t = setTimeout(function () { state.q = e.target.value.trim(); state.page = 1; render(); }, 90); });

  /* ───────── انتشار / پیش‌نویس (JSON) با بازگردانی ───────── */
  function recount() {
    var pub = rows.filter(function (r) { return r.dataset.status === 'published'; }).length, dr = rows.length - pub;
    ['cntPub', 'statPub', 'chipPub'].forEach(function (id) { $('#' + id).textContent = fa(pub); });
    ['cntDraft', 'statDraft', 'chipDraft'].forEach(function (id) { $('#' + id).textContent = fa(dr); });
  }
  function paint(r, pub) {
    r.dataset.status = pub ? 'published' : 'draft';
    var b = $('[data-badge]', r); b.className = 'badge-status ' + (pub ? 'badge-done' : 'badge-review'); b.textContent = pub ? 'منتشرشده' : 'پیش‌نویس';
    var btn = $('[data-pub-toggle]', r); btn.className = 'btn-icon' + (pub ? '' : ' ok');
    btn.title = pub ? 'برگرداندن به پیش‌نویس' : 'انتشار'; btn.setAttribute('aria-label', btn.title);
    $('i', btn).className = 'bi ' + (pub ? 'bi-file-earmark' : 'bi-send');
    $('[data-site-link]', r).hidden = !pub;
  }
  function setPublished(r, pub, undoable) {
    var prev = r.dataset.status === 'published';
    paint(r, pub); recount(); render();
    return fetch('/sw-admin/blog/' + r.dataset.id + '/status', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ status: pub ? 'published' : 'draft' })
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (j) { if (!res.ok || !j.success) throw new Error(j.message || 'خطا در ارتباط با سرور'); return j; });
    }).then(function () {
      if (!undoable) return;
      toast(pub ? 'مقاله منتشر شد' : 'به پیش‌نویس برگشت', { type: 'success', detail: r.dataset.title, ms: 5000, actions: [{ label: 'بازگردانی', fn: function () { setPublished(r, prev, false); } }] });
    }).catch(function (err) {
      paint(r, prev); recount(); render(); toast(err.message || 'تغییر وضعیت انجام نشد', { type: 'error' });
    });
  }
  body.addEventListener('click', function (e) {
    var b = e.target.closest('[data-pub-toggle]'); if (!b) return;
    var r = b.closest('tr'); setPublished(r, r.dataset.status !== 'published', true);
  });

  render();
});
</script>

<%- include('partials/_scripts') %>
