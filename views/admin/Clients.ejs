</style>

<script>
/* =========================
   Persian Helpers
========================= */

function toPersianDigits(value) {
  if (value === null || value === undefined || value === '') return '-';

  return String(value).replace(/[0-9]/g, function(digit) {
    return '۰۱۲۳۴۵۶۷۸۹'[Number(digit)];
  });
}

function normalizeText(value) {
  return String(value || '')
    .trim()
    .toLowerCase()
    .replace(/ي/g, 'ی')
    .replace(/ك/g, 'ک')
    .replace(/‌/g, ' ');
}

function getClientInitials(name) {
  if (!name || name === '-') return '-';

  const parts = name.trim().split(/\\s+/);

  if (parts.length === 1) {
    return parts[0].charAt(0);
  }

  return parts[0].charAt(0) + parts[1].charAt(0);
}

function calculateCooperationTime(createdAt) {
  if (!createdAt) return '-';

  const createdDate = new Date(createdAt);

  if (Number.isNaN(createdDate.getTime())) return '-';

  const now = new Date();
  const diffMs = now - createdDate;
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffDays < 1) return 'امروز';
  if (diffDays < 30) return toPersianDigits(diffDays) + ' روز';

  const diffMonths = Math.floor(diffDays / 30);
  if (diffMonths < 12) return toPersianDigits(diffMonths) + ' ماه';

  const diffYears = Math.floor(diffDays / 365);
  return toPersianDigits(diffYears) + ' سال';
}

function getRatingNumber(rating) {
  if (!rating) return '۵';

  const starsCount = String(rating).split('★').length - 1;

  if (starsCount > 0) {
    return toPersianDigits(starsCount);
  }

  return toPersianDigits(rating);
}

/* =========================
   Clients Table Filter
========================= */

const clientSearch = document.getElementById('clientSearch');
const statusFilter = document.getElementById('statusFilter');
const categoryFilter = document.getElementById('categoryFilter');
const clientRows = document.querySelectorAll('#clientsTable tbody tr');

function filterClientsTable() {
  const searchValue = normalizeText(clientSearch ? clientSearch.value : '');
  const statusValue = statusFilter ? statusFilter.value : 'all';
  const categoryValue = categoryFilter ? categoryFilter.value : 'all';

  clientRows.forEach(function(row) {
    const rowText = normalizeText(row.textContent);
    const rowStatus = row.dataset.status || '';
    const rowCategory = row.dataset.category || '';

    const matchesSearch = rowText.includes(searchValue);
    const matchesStatus = statusValue === 'all' || rowStatus === statusValue;
    const matchesCategory = categoryValue === 'all' || rowCategory === categoryValue;

    row.style.display = matchesSearch && matchesStatus && matchesCategory ? '' : 'none';
  });
}

if (clientSearch) {
  clientSearch.addEventListener('input', filterClientsTable);
}

if (statusFilter) {
  statusFilter.addEventListener('change', filterClientsTable);
}

if (categoryFilter) {
  categoryFilter.addEventListener('change', filterClientsTable);
}

/* =========================
   Client Detail Modal
========================= */

const viewClientButtons = document.querySelectorAll('.btn-view-client');

viewClientButtons.forEach(function(button) {
  button.addEventListener('click', function() {
    const name = this.dataset.name || '-';
    const company = this.dataset.company || '-';
    const email = this.dataset.email || '-';
    const phone = this.dataset.phone || '-';
    const address = this.dataset.address || '-';
