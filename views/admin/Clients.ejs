<!-- Modal: مشتری جدید -->
<div class="modal-overlay" id="clientModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">مشتری جدید</div>
      <button data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">نام</label>
        <input class="sol-input" type="text" placeholder="نام مشتری">
      </div>
      <div class="form-row">
        <label class="sol-label">نام شرکت</label>
        <input class="sol-input" type="text" placeholder="نام شرکت یا برند">
      </div>
    </div>
    <div class="form-row">
      <label class="sol-label">ایمیل</label>
      <input class="sol-input" type="email" placeholder="example@domain.com">
    </div>
    <div class="form-row">
      <label class="sol-label">شماره تماس</label>
      <input class="sol-input" type="tel" placeholder="۰۹۱۲۱۲۳۴۵۶۷">
    </div>
    <div class="form-row">
      <label class="sol-label">نوع همکاری</label>
      <select class="sol-select" style="width:100%">
        <option>طراحی وب</option><option>فروشگاه</option><option>UI/UX</option><option>نگه‌داری</option>
      </select>
    </div>
    <div class="form-row">
      <label class="sol-label">یادداشت</label>
      <textarea class="sol-input" rows="2" placeholder="یادداشت اختیاری…" style="resize:vertical;"></textarea>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" data-modal-close>انصراف</button>
      <button class="btn-sol-sm"><i class="bi bi-check-lg"></i> ثبت مشتری</button>
    </div>
  </div>
</div>

<!-- Modal: جزئیات مشتری -->
<div class="modal-overlay" id="clientDetail">
  <div class="modal-box" style="width:min(620px,92vw);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">پروفایل مشتری</div>
      <button data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div style="display:flex;align-items:center;gap:1rem;padding:1.25rem;background:var(--color-bg);border-radius:var(--radius-lg);margin-bottom:1.5rem;">
      <div style="width:56px;height:56px;border-radius:var(--radius-md);background:var(--grad-main);display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:800;color:#fff;flex-shrink:0;">علی</div>
      <div style="flex:1;">
        <div style="font-size:1rem;font-weight:800;margin-bottom:.2rem;">علی امینی</div>
        <div style="font-size:.8rem;color:var(--color-text-muted);">فروشگاه اسیل · ali@asil.ir · ۰۹۱۲۱۲۳۴۵۶۷</div>
      </div>
      <span class="badge-status badge-done">فعال</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem;">
      <div style="text-align:center;padding:.85rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <div style="font-size:1.4rem;font-weight:900;" class="text-grad">۳</div>
        <div style="font-size:.75rem;color:var(--color-text-muted);">پروژه</div>
      </div>
      <div style="text-align:center;padding:.85rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <div style="font-size:1.4rem;font-weight:900;" class="text-grad">۵★</div>
        <div style="font-size:.75rem;color:var(--color-text-muted);">رضایت</div>
      </div>
      <div style="text-align:center;padding:.85rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <div style="font-size:1.4rem;font-weight:900;" class="text-grad">۲ سال</div>
        <div style="font-size:.75rem;color:var(--color-text-muted);">همکاری</div>
      </div>
    </div>
    <div style="font-size:.82rem;font-weight:700;margin-bottom:.75rem;color:var(--color-text-muted);">پروژه‌های این مشتری</div>
    <div style="display:flex;flex-direction:column;gap:.5rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:.7rem .9rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <span style="font-size:.83rem;font-weight:600;">فروشگاه آنلاین اسیل</span>
        <span class="badge-status badge-done">تحویل‌شد</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:.7rem .9rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <span style="font-size:.83rem;font-weight:600;">وب‌سایت معرفی اسیل</span>
        <span class="badge-status badge-done">تحویل‌شد</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:.7rem .9rem;background:var(--color-bg);border-radius:var(--radius-md);">
        <span style="font-size:.83rem;font-weight:600;">نگه‌داری ماهانه</span>
        <span class="badge-status badge-inprog">فعال</span>
      </div>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" data-modal-close>بستن</button>
      <button class="btn-sol-sm"><i class="bi bi-pencil"></i> ویرایش اطلاعات</button>
    </div>
  </div>
</div>

<%- include('partials/_scripts', { extraScripts: `
<style>
.pstat{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:.85rem;transition:all var(--dur-normal) var(--ease-spring)}
.pstat:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm);border-color:var(--main-200)}
.pstat-icon{width:40px;height:40px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.pstat-val{font-size:1.5rem;font-weight:900;line-height:1}
.pstat-lbl{font-size:.73rem;color:var(--color-text-muted);margin-top:.15rem}
.cl-av{width:36px;height:36px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;color:#fff;flex-shrink:0}
.pg-btn{width:32px;height:32px;border-radius:var(--radius-sm);border:1.5px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.8rem;transition:all var(--dur-fast);font-family:var(--font-primary)}
.pg-btn:disabled{opacity:.4;cursor:not-allowed}
.pg-btn.active,.pg-btn:not(:disabled):hover{background:var(--main-500);border-color:var(--main-500);color:#fff}
</style>
<script>
// جستجو در جدول مشتریان
document.getElementById('clientSearch').addEventListener('input', function(){
  const q = this.value.toLowerCase();
  document.querySelectorAll('#clientsTable tbody tr').forEach(function(row){
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
<\/script>
` }) %>
