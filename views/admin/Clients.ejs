<%# views/sw-admin/clients.ejs %>
<%- include('partials/_head', { title: 'مدیریت مشتریان' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', { activePage: 'clients', adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' } }) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'مشتریان' }],
  searchPlaceholder: 'جستجو در مشتریان…'
}) %>

<main class="page-content">

  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title">مدیریت مشتریان</h1>
      <p class="page-subtitle">۸۶ مشتری ثبت‌شده · ۳ مشتری جدید این هفته</p>
    </div>
    <div style="display:flex;gap:.6rem;">
      <a href="/sw-admin/clients/export" class="btn-ghost-sm"><i class="bi bi-download"></i> خروجی CSV</a>
      <button class="btn-sol-sm" data-modal-open="clientModal"><i class="bi bi-person-plus-fill"></i> مشتری جدید</button>
    </div>
  </div>

  <!-- Stats -->
  <div class="stat-grid fade-up fade-up-2" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;">
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(100,71,244,.1);color:var(--main-500);"><i class="bi bi-people-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="<%= clientsCount %>" data-suffix=""><%= clientsCount %></div><div class="pstat-lbl">کل مشتریان</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(34,197,94,.1);color:#16a34a;"><i class="bi bi-person-check-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="<%= activeClientsCount %>" data-suffix=""><%= activeClientsCount %></div><div class="pstat-lbl">مشتری فعال</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(0,144,232,.1);color:var(--accent-500);"><i class="bi bi-person-plus-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="<%= newClientsThisWeekCount %>" data-suffix=""><%= newClientsThisWeekCount %></div><div class="pstat-lbl">جدید این هفته</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="bi bi-star-fill"></i></div>
      <div><div class="pstat-val text-grad">۴.۹</div><div class="pstat-lbl">میانگین رضایت</div></div>
    </div>
  </div>

  <!-- Search + Filter -->
  <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-bottom:1.25rem;" class="fade-up fade-up-2">
    <div style="flex:1;min-width:200px;display:flex;align-items:center;gap:.5rem;background:var(--color-surface);border:1.5px solid var(--color-border);border-radius:var(--radius-md);padding:.45rem 1rem;">
      <i class="bi bi-search" style="color:var(--color-text-light);font-size:.85rem;"></i>
      <input type="text" placeholder="نام، ایمیل یا شرکت…" style="border:none;background:transparent;outline:none;font-family:var(--font-primary);font-size:.85rem;color:var(--color-text-primary);width:100%;" id="clientSearch">
    </div>
<select class="sol-select" style="width:auto;" id="statusFilter">
  <option value="all">همه وضعیت‌ها</option>
  <option value="active">فعال</option>
  <option value="inactive">غیرفعال</option>
</select>

<select class="sol-select" style="width:auto;" id="categoryFilter">
  <option value="all">همه دسته‌ها</option>
  <option value="فروشگاه">فروشگاه</option>
  <option value="طراحی وب">طراحی وب</option>
  <option value="UI/UX">UI/UX</option>
  <option value="نگه‌داری">نگه‌داری</option>
</select>

  </div>

  <!-- Clients Table -->
<div class="dash-panel fade-up fade-up-3">
  <div style="overflow-x:auto;">
    <table class="sol-table" id="clientsTable">
      <thead>
        <tr>
          <th>مشتری</th>
          <th>ایمیل / تلفن</th>
          <th>پروژه‌ها</th>
          <th>آخرین پروژه</th>
          <th>وضعیت</th>
          <th>رضایت</th>
          <th>عملیات</th>
        </tr>
      </thead>

      <tbody>
        <% if (clients && clients.length > 0) { %>

          <% clients.forEach((client, index) => { %>

            <%
              const gradients = [
                'var(--grad-main)',
                'linear-gradient(135deg,#0090e8,#4dc3ff)',
                'linear-gradient(135deg,#a394fb,#6447f4)',
                'linear-gradient(135deg,#22c55e,#0090e8)',
                'linear-gradient(135deg,#f59e0b,#ef4444)',
                'linear-gradient(135deg,#6447f4,#1e1274)'
              ];

              const avatarText = client.avatar
                ? client.avatar
                : (client.name || '؟')
                    .split(' ')
                    .map(part => part[0])
                    .join('')
                    .substring(0, 3);

              const bg = gradients[index % gradients.length];
            %>

            <tr 
              data-status="<%= client.isActive ? 'active' : 'inactive' %>"
              data-category="<%= client.avatar || '' %>"
            >
              <td>
                <div style="display:flex;align-items:center;gap:.75rem;">
                  <div class="cl-av" style="background:<%= bg %>;">
                    <%= avatarText %>
                  </div>

                  <div>
                    <div style="font-weight:700;font-size:.85rem;">
                      <%= client.name || '-' %>
                    </div>

                    <div style="font-size:.72rem;color:var(--color-text-muted);">
                      <%= client.company || '-' %>
                    </div>
                  </div>
                </div>
              </td>

              <td>
                <div style="font-size:.8rem;">
                  <%= client.email || '-' %>
                </div>

                <div style="font-size:.73rem;color:var(--color-text-muted);">
                  <%= client.phone || '-' %>
                </div>
              </td>

              <td>
                <span style="font-size:.85rem;font-weight:700;">
                  <%= client.projectsCount || 0 %>
                </span>
              </td>

              <td>
                <span style="font-size:.8rem;">
                  <%= client.lastProject || '—' %>
                </span>
              </td>

              <td>
                <% if (client.isActive) { %>
                  <span class="badge-status badge-done">فعال</span>
                <% } else { %>
                  <span class="badge-status badge-inprog">غیرفعال</span>
                <% } %>
              </td>

              <td>
                <span style="color:#f59e0b;letter-spacing:.1em;">
                  <%= client.rating || '★★★★★' %>
                </span>
              </td>

              <td>
                <div style="display:flex;gap:.4rem;">
                  <button
                    class="btn-ghost-sm btn-view-client"
                    type="button"
                    style="padding:.28rem .6rem;"
                    data-modal-open="clientDetail"

                    data-id="<%= client._id %>"
                    data-name="<%= client.name || '' %>"
                    data-company="<%= client.company || '' %>"
                    data-email="<%= client.email || '' %>"
                    data-phone="<%= client.phone || '' %>"
                    data-address="<%= client.address || '' %>"
                    data-notes="<%= client.notes || '' %>"
                    data-active="<%= client.isActive ? 'true' : 'false' %>"
                    data-category="<%= client.avatar || '' %>"
                    data-created-at="<%= client.createdAt ? client.createdAt.toISOString() : '' %>"
                    data-projects-count="<%= client.projectsCount || 0 %>"
                    data-rating="<%= client.rating || '★★★★★' %>"
                  >
                    <i class="bi bi-eye"></i>
                  </button>



                  <button
                    class="btn-ghost-sm"
                    style="padding:.28rem .6rem;"
                    data-id="<%= client._id %>"
                    data-name="<%= client.name || '' %>"
                    data-company="<%= client.company || '' %>"
                    data-email="<%= client.email || '' %>"
                    data-phone="<%= client.phone || '' %>"
                    data-address="<%= client.address || '' %>"
                    data-notes="<%= client.notes || '' %>"
                    data-active="<%= client.isActive %>"
                    data-category="<%= client.avatar || '' %>"
                  >
                    <i class="bi bi-pencil"></i>
                  </button>

                  <form
                    action="/sw-admin/clients/<%= client._id %>/delete"
                    method="POST"
                    onsubmit="return confirm('مطمئنی می‌خوای این مشتری حذف بشه؟')"
                    style="margin:0;"
                  >
                    <button class="btn-danger-sm" style="padding:.28rem .6rem;" type="submit">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>

          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="7" style="text-align:center;padding:2rem;color:var(--color-text-muted);">
              هنوز هیچ مشتری‌ای ثبت نشده است.
            </td>
          </tr>

        <% } %>
      </tbody>
    </table>
  </div>
</div>


    <!-- Pagination -->
<div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-top:1px solid var(--color-border);flex-wrap:wrap;gap:.75rem;">

  <span style="font-size:.78rem;color:var(--color-text-muted);">
    نمایش 
    <%= startItem.toLocaleString('fa-IR') %>–<%= endItem.toLocaleString('fa-IR') %>
    از
    <%= clientsCount.toLocaleString('fa-IR') %>
    مشتری
  </span>

  <% if (totalPages > 1) { %>
    <div style="display:flex;gap:.35rem;align-items:center;">

      <% if (currentPage > 1) { %>
        <a class="pg-btn" href="/sw-admin/clients?page=<%= currentPage - 1 %>">
          <i class="bi bi-chevron-right"></i>
        </a>
      <% } else { %>
        <button class="pg-btn" disabled>
          <i class="bi bi-chevron-right"></i>
        </button>
      <% } %>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a
          class="pg-btn <%= currentPage === i ? 'active' : '' %>"
          href="/sw-admin/clients?page=<%= i %>"
        >
          <%= i.toLocaleString('fa-IR') %>
        </a>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a class="pg-btn" href="/sw-admin/clients?page=<%= currentPage + 1 %>">
          <i class="bi bi-chevron-left"></i>
        </a>
      <% } else { %>
        <button class="pg-btn" disabled>
          <i class="bi bi-chevron-left"></i>
        </button>
      <% } %>

    </div>
  <% } %>

</div>

  </div>

</main>
</div>
</div>

<!-- Modal: مشتری جدید -->
<form method="post" action="/sw-admin/clients">
  <div class="modal-overlay" id="clientModal">
    <div class="modal-box">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
        <div class="modal-title" style="margin:0;">مشتری جدید</div>
        <button data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-row">
          <label class="sol-label">نام</label>
          <input class="sol-input" type="text" placeholder="نام مشتری" name="name">
        </div>
        <div class="form-row">
          <label class="sol-label">نام شرکت</label>
          <input class="sol-input" type="text" placeholder="نام شرکت یا برند" name="company">
        </div>
      </div>
      <div class="form-row">
        <label class="sol-label">ایمیل</label>
        <input class="sol-input" type="email" placeholder="example@domain.com" name="email">
      </div>
      <div class="form-row">
        <label class="sol-label">شماره تماس</label>
        <input class="sol-input" type="tel" placeholder="۰۹۱۲۱۲۳۴۵۶۷" name="phone">
      </div>
      <div class="form-row">
        <label class="sol-label">نوع همکاری</label>
        <select class="sol-select" style="width:100%" name="avatar">
          <option value="طراحی وب">طراحی وب</option><option value="فروشگاه">فروشگاه</option><option value="UI/UX">UI/UX</option><option value="نگه‌داری">نگه‌داری</option>
        </select>
      </div>
      <div class="form-row">
        <label class="sol-label">یادداشت</label>
        <textarea class="sol-input" rows="2" placeholder="یادداشت اختیاری…" style="resize:vertical;" name="notes"></textarea>
      </div>
      <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
        <button class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button class="btn-sol-sm"><i class="bi bi-check-lg"></i> ثبت مشتری</button>
      </div>
    </div>
  </div>
</form>
<!-- Modal: جزئیات مشتری -->
