<%- include('partials/_head', { title: 'پنل مدیریت' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', {
    activePage: 'dashboard',
    adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' }
  }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content">

      <!-- Page Header -->
      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">خوش آمدید، علی 👋</h1>
          <p class="page-subtitle">امروز ۲۱ خرداد ۱۴۰۴ — وضعیت کلی پروژه‌ها و فعالیت‌های تیم</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn-ghost-sm"><i class="bi bi-download"></i> گزارش</button>
          <button class="btn-sol-sm"><i class="bi bi-plus-lg"></i> پروژه جدید</button>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="stat-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;">

        <div class="stat-card-dash fade-up fade-up-1">
          <div class="stat-header" style="display:flex;align-items:center;justify-content:space-between;">
            <div class="stat-icon-box main" style="width:40px;height:40px;border-radius:var(--radius-sm);background:rgba(100,71,244,.12);color:var(--main-500);display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-kanban-fill"></i></div>
            <span class="stat-trend up" style="display:flex;align-items:center;gap:.25rem;font-size:.73rem;font-weight:700;background:rgba(34,197,94,.12);color:#16a34a;border-radius:var(--radius-full);padding:.2rem .55rem;"><i class="bi bi-arrow-up-short"></i>۱۲٪</span>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="24" data-suffix="">۲۴</div>
            <div style="font-size:.78rem;color:var(--color-text-muted);margin-top:.2rem;">پروژه فعال</div>
            <div style="font-size:.73rem;color:var(--color-text-light);">۸ پروژه در مرحله ریویو</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-2">
          <div class="stat-header" style="display:flex;align-items:center;justify-content:space-between;">
            <div class="stat-icon-box accent" style="width:40px;height:40px;border-radius:var(--radius-sm);background:rgba(0,144,232,.12);color:var(--accent-500);display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-people-fill"></i></div>
            <span class="stat-trend up" style="display:flex;align-items:center;gap:.25rem;font-size:.73rem;font-weight:700;background:rgba(34,197,94,.12);color:#16a34a;border-radius:var(--radius-full);padding:.2rem .55rem;"><i class="bi bi-arrow-up-short"></i>۸٪</span>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="86" data-suffix="">۸۶</div>
            <div style="font-size:.78rem;color:var(--color-text-muted);margin-top:.2rem;">مشتری فعال</div>
            <div style="font-size:.73rem;color:var(--color-text-light);">۳ مشتری جدید این هفته</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-3">
          <div class="stat-header" style="display:flex;align-items:center;justify-content:space-between;">
            <div style="width:40px;height:40px;border-radius:var(--radius-sm);background:rgba(34,197,94,.12);color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-check-circle-fill"></i></div>
            <span style="display:flex;align-items:center;gap:.25rem;font-size:.73rem;font-weight:700;background:rgba(34,197,94,.12);color:#16a34a;border-radius:var(--radius-full);padding:.2rem .55rem;"><i class="bi bi-arrow-up-short"></i>۲۲٪</span>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="153" data-suffix="">۱۵۳</div>
            <div style="font-size:.78rem;color:var(--color-text-muted);margin-top:.2rem;">پروژه تحویل‌داده‌شده</div>
            <div style="font-size:.73rem;color:var(--color-text-light);">۹۸٪ رضایت مشتری</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-4">
          <div class="stat-header" style="display:flex;align-items:center;justify-content:space-between;">
            <div style="width:40px;height:40px;border-radius:var(--radius-sm);background:rgba(245,158,11,.12);color:#d97706;display:flex;align-items:center;justify-content:center;font-size:1.1rem;"><i class="bi bi-chat-dots-fill"></i></div>
            <span style="display:flex;align-items:center;gap:.25rem;font-size:.73rem;font-weight:700;background:rgba(239,68,68,.12);color:#dc2626;border-radius:var(--radius-full);padding:.2rem .55rem;"><i class="bi bi-arrow-down-short"></i>۳٪</span>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="5" data-suffix="">۵</div>
            <div style="font-size:.78rem;color:var(--color-text-muted);margin-top:.2rem;">پیام خوانده‌نشده</div>
            <div style="font-size:.73rem;color:var(--color-text-light);">آخرین پیام: ۲ ساعت پیش</div>
          </div>
        </div>

      </div><!-- /stat-grid -->

      <!-- Quick Mini Cards -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-bottom:1.5rem;" class="fade-up fade-up-5">
        <div class="mini-card" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:44px;height:44px;border-radius:var(--radius-md);background:rgba(100,71,244,.1);color:var(--main-500);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;"><i class="bi bi-clock-history"></i></div>
          <div><div style="font-size:1.35rem;font-weight:900;line-height:1;">۱۴۲ ساعت</div><div style="font-size:.75rem;color:var(--color-text-muted);margin-top:.15rem;">کل ساعات کاری این ماه</div></div>
        </div>
        <div class="mini-card" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:44px;height:44px;border-radius:var(--radius-md);background:rgba(0,144,232,.1);color:var(--accent-500);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;"><i class="bi bi-stars"></i></div>
          <div><div style="font-size:1.35rem;font-weight:900;line-height:1;">۴.۹ / ۵</div><div style="font-size:.75rem;color:var(--color-text-muted);margin-top:.15rem;">میانگین امتیاز مشتریان</div></div>
        </div>
        <div class="mini-card" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:44px;height:44px;border-radius:var(--radius-md);background:rgba(34,197,94,.1);color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;"><i class="bi bi-lightning-charge-fill"></i></div>
          <div><div style="font-size:1.35rem;font-weight:900;line-height:1;">۷ روز</div><div style="font-size:.75rem;color:var(--color-text-muted);margin-top:.15rem;">میانگین زمان تحویل پروژه</div></div>
        </div>
      </div>

      <!-- Main Grid: Chart + Activity -->
      <div style="display:grid;grid-template-columns:1fr 340px;gap:1.25rem;margin-bottom:1.25rem;" class="fade-up fade-up-5">

        <!-- Chart Panel -->
        <div class="dash-panel">
          <div class="panel-header">
            <h6 class="panel-title"><i class="bi bi-bar-chart-fill me-1" style="color:var(--main-500);"></i> پروژه‌های ماهانه</h6>
            <a href="#" class="panel-action">جزئیات <i class="bi bi-arrow-left"></i></a>
          </div>
          <div style="padding:1.25rem;">
            <div style="display:flex;align-items:flex-end;gap:.6rem;height:140px;">
              <% const bars = [
                { h:'55%', label:'دی',       val:'۱۱' },
                { h:'70%', label:'بهمن',     val:'۱۴' },
                { h:'45%', label:'اسفند',    val:'۹'  },
                { h:'85%', label:'فروردین',  val:'۱۷' },
                { h:'65%', label:'اردیبهشت', val:'۱۳' },
                { h:'90%', label:'خرداد',    val:'۱۸', active: true }
              ]; %>
              <% bars.forEach(function(bar){ %>
                <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:.4rem;height:100%;justify-content:flex-end;">
                  <div class="chart-bar <%= bar.active ? 'active' : '' %>"
                       style="width:100%;max-width:40px;height:<%= bar.h %>;border-radius:var(--radius-sm) var(--radius-sm) .25rem .25rem;cursor:pointer;"
                       data-val="<%= bar.val %>"></div>
                  <span style="font-size:.68rem;color:var(--color-text-light);text-align:center;"><%= bar.label %></span>
                </div>
              <% }); %>
            </div>
            <div style="display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:1rem;">
              <div style="display:flex;align-items:center;gap:.4rem;font-size:.75rem;color:var(--color-text-muted);">
                <div style="width:8px;height:8px;border-radius:50%;background:var(--main-500);"></div>تحویل‌شده
              </div>
              <div style="display:flex;align-items:center;gap:.4rem;font-size:.75rem;color:var(--color-text-muted);">
                <div style="width:8px;height:8px;border-radius:50%;background:var(--main-200);"></div>در جریان
              </div>
            </div>
          </div>
        </div>

        <!-- Activity Feed -->
        <div class="dash-panel">
          <div class="panel-header">
            <h6 class="panel-title"><i class="bi bi-activity me-1" style="color:var(--main-500);"></i> فعالیت‌های اخیر</h6>
            <a href="#" class="panel-action">همه <i class="bi bi-arrow-left"></i></a>
          </div>
          <div>
            <% const activities = [
              { icon:'bi-check-circle-fill', type:'main',    text:'<strong>پروژه آتین‌دیزاین</strong> به مرحله تحویل رسید', time:'۱۵ دقیقه پیش' },
              { icon:'bi-person-plus-fill',  type:'accent',  text:'<strong>مشتری جدید</strong> ثبت‌نام کرد — محسن رضایی',  time:'۴۵ دقیقه پیش' },
              { icon:'bi-chat-left-dots-fill',type:'warning', text:'<strong>۳ پیام جدید</strong> از طریق فرم تماس',         time:'۱ ساعت پیش' },
              { icon:'bi-file-earmark-plus-fill', type:'main', text:'<strong>پروژه جدید</strong> ثبت شد — فروشگاه پرتو',  time:'۳ ساعت پیش' },
              { icon:'bi-receipt-cutoff',    type:'success', text:'<strong>فاکتور #۱۰۴۸</strong> پرداخت شد',              time:'دیروز' },
              { icon:'bi-star-fill',         type:'accent',  text:'<strong>نظر جدید</strong> ۵ ستاره از سارا طاهری',      time:'دیروز' },
              { icon:'bi-exclamation-triangle-fill', type:'warning', text:'<strong>ددلاین</strong> پروژه پارسیان فرداست', time:'۲ روز پیش' }
            ]; %>
            <% activities.forEach(function(act){ %>
              <div style="display:flex;align-items:flex-start;gap:.85rem;padding:.7rem 1.25rem;transition:background var(--dur-fast);">
                <div style="width:32px;height:32px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0;margin-top:.1rem;
                  background:<%= act.type==='main' ? 'rgba(100,71,244,.12)' : act.type==='accent' ? 'rgba(0,144,232,.12)' : act.type==='success' ? 'rgba(34,197,94,.12)' : 'rgba(245,158,11,.12)' %>;
                  color:<%= act.type==='main' ? 'var(--main-500)' : act.type==='accent' ? 'var(--accent-500)' : act.type==='success' ? '#16a34a' : '#d97706' %>;">
                  <i class="bi <%= act.icon %>"></i>
                </div>
                <div style="flex:1;">
                  <p style="font-size:.82rem;margin:0;line-height:1.5;"><%- act.text %></p>
                  <div style="font-size:.7rem;color:var(--color-text-light);margin-top:.15rem;"><i class="bi bi-clock me-1"></i><%= act.time %></div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

      </div><!-- /main-grid -->

      <!-- Projects Table -->
      <div class="dash-panel fade-up fade-up-6 mb-4">
        <div class="panel-header">
          <h6 class="panel-title"><i class="bi bi-kanban-fill me-1" style="color:var(--main-500);"></i> پروژه‌های جاری</h6>
          <a href="/sw-admin/projects" class="panel-action">همه پروژه‌ها <i class="bi bi-arrow-left"></i></a>
        </div>
        <div style="overflow-x:auto;">
          <table class="sol-table">
            <thead>
              <tr>
                <th>پروژه</th><th>مشتری</th><th>نوع</th>
                <th>وضعیت</th><th>پیشرفت</th><th>ددلاین</th>
              </tr>
            </thead>
            <tbody>
              <% const projects = [
                { name:'وب‌سایت شرکتی آتین‌دیزاین', type:'طراحی وب — PHP',       client:'امیر حسینی', cat:'وب',     status:'done',   prog:100, deadline:'۱ خرداد',    urgent:false },
                { name:'فروشگاه آنلاین کیانی لباس',  type:'فروشگاه — WooCommerce', client:'کیانی لباس',  cat:'فروشگاه', status:'inprog', prog:68,  deadline:'۱۵ خرداد',   urgent:false },
                { name:'اپلیکیشن مدیریت مالی',       type:'UI/UX — React',         client:'آفیلیو',      cat:'UI/UX',   status:'review', prog:85,  deadline:'۲۲ خرداد',   urgent:false },
                { name:'پورتال سازمانی پارسیان',      type:'وب اپ — Laravel',       client:'گروه پارسیان',cat:'وب اپ',   status:'inprog', prog:42,  deadline:'فردا! ⚠️',   urgent:true  },
                { name:'فروشگاه دیجیتال پرتو',       type:'فروشگاه — Node.js',     client:'شرکت پرتو',  cat:'فروشگاه', status:'hold',   prog:30,  deadline:'نامشخص',      urgent:false }
              ]; %>
              <% projects.forEach(function(p){ %>
                <tr>
                  <td>
                    <div style="font-weight:600;font-size:.85rem;"><%= p.name %></div>
                    <div style="font-size:.73rem;color:var(--color-text-muted);"><%= p.type %></div>
                  </td>
                  <td style="font-size:.83rem;"><%= p.client %></td>
                  <td style="font-size:.78rem;color:var(--color-text-muted);"><%= p.cat %></td>
                  <td>
                    <span class="badge-status badge-<%= p.status %>">
                      <%= p.status==='done' ? 'تحویل داده شد' : p.status==='inprog' ? 'در حال انجام' : p.status==='review' ? 'در ریویو' : 'متوقف' %>
                    </span>
                  </td>
                  <td>
                    <div style="display:flex;align-items:center;gap:.5rem;">
                      <div class="prog-bar-mini"><div class="prog-fill" style="width:<%= p.prog %>%;"></div></div>
                      <span style="font-size:.73rem;color:<%= p.urgent ? '#dc2626' : 'var(--color-text-muted)' %>;font-weight:<%= p.urgent ? '700' : 'normal' %>;"><%= p.prog %>٪</span>
                    </div>
                  </td>
                  <td style="font-size:.78rem;color:<%= p.urgent ? '#dc2626' : 'var(--color-text-muted)' %>;font-weight:<%= p.urgent ? '600' : 'normal' %>;"><%= p.deadline %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bottom: Messages + Tasks -->
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;margin-bottom:1.5rem;" class="fade-up fade-up-6">

        <!-- Messages -->
        <div class="dash-panel">
          <div class="panel-header">
            <h6 class="panel-title"><i class="bi bi-chat-dots-fill me-1" style="color:var(--main-500);"></i> پیام‌های اخیر</h6>
            <a href="#" class="panel-action">همه <i class="bi bi-arrow-left"></i></a>
          </div>
          <% const messages = [
            { name:'محسن رضایی',  initials:'محر', color:'var(--grad-main)',                            preview:'سلام، میخواستم درباره پروژه فروشگاه صحبت کنیم…', time:'الان',   unread:true  },
            { name:'سارا طاهری',  initials:'سار', color:'linear-gradient(135deg,#0090e8,#4dc3ff)',    preview:'ممنونم از طراحی عالی، فقط یه تغییر کوچیک داشتم', time:'۲۰ د',  unread:true  },
            { name:'رضا محمدی',   initials:'رضا', color:'linear-gradient(135deg,#a394fb,#6447f4)',    preview:'پیش‌فاکتور رو دیدم، تأیید می‌کنم. بریم جلو!',    time:'۱ س',   unread:true  },
            { name:'علی امینی',   initials:'علی', color:'linear-gradient(135deg,#22c55e,#0090e8)',    preview:'سایت فروشگاه رو لانچ کردیم، عالیه! ممنون',       time:'دیروز',  unread:false },
            { name:'نگار صادقی',  initials:'نگر', color:'linear-gradient(135deg,#f59e0b,#ef4444)',    preview:'آیا امکان اضافه کردن بلاگ به سایت هست؟',          time:'دیروز',  unread:false }
          ]; %>
          <% messages.forEach(function(msg){ %>
            <div style="display:flex;align-items:flex-start;gap:.85rem;padding:.9rem 1.25rem;border-bottom:1px solid var(--color-border);cursor:pointer;background:<%= msg.unread ? 'rgba(100,71,244,.04)' : 'transparent' %>;">
              <div style="width:36px;height:36px;border-radius:var(--radius-sm);background:<%= msg.color %>;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;color:#fff;flex-shrink:0;"><%= msg.initials %></div>
              <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:.25rem;">
                  <span style="font-size:.83rem;font-weight:700;"><%= msg.name %></span>
                  <span style="font-size:.7rem;color:var(--color-text-light);white-space:nowrap;"><%= msg.time %></span>
                </div>
                <div style="font-size:.77rem;color:var(--color-text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:<%= msg.unread ? '500' : 'normal' %>;"><%= msg.preview %></div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Tasks -->
        <div class="dash-panel">
          <div class="panel-header">
            <h6 class="panel-title"><i class="bi bi-list-check me-1" style="color:var(--main-500);"></i> وظایف امروز</h6>
            <button class="btn-sol-sm" style="padding:.3rem .8rem;font-size:.74rem;"><i class="bi bi-plus"></i> جدید</button>
          </div>
          <% const tasks = [
            { text:'ریویو طراحی اپ مالی',             pri:'low',    done:true  },
            { text:'جلسه مشاوره با کیانی لباس',       pri:'medium', done:true  },
            { text:'ارسال پیش‌فاکتور به پرتو',        pri:'high',   done:false },
            { text:'بروزرسانی صفحه خدمات سُل وب',    pri:'medium', done:false },
            { text:'تکمیل مرحله سوم پورتال پارسیان', pri:'high',   done:false },
            { text:'پاسخ به پیام‌های ریسپانسیو',      pri:'low',    done:false },
            { text:'آپلود نمونه کار جدید در پورتفولیو',pri:'medium', done:false }
          ]; %>
          <% tasks.forEach(function(task){ %>
            <div class="task-item" style="display:flex;align-items:center;gap:.75rem;padding:.75rem 1.25rem;border-bottom:1px solid var(--color-border);cursor:pointer;">
              <div class="task-check <%= task.done ? 'done' : '' %>" style="width:18px;height:18px;border-radius:5px;border:2px solid var(--color-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all var(--dur-fast);cursor:pointer;background:<%= task.done ? 'var(--main-500)' : 'transparent' %>;border-color:<%= task.done ? 'var(--main-500)' : 'var(--color-border)' %>;color:#fff;font-size:.65rem;">
                <%= task.done ? '<i class="bi bi-check-lg"></i>' : '' %>
              </div>
              <span class="task-text <%= task.done ? 'done' : '' %>" style="flex:1;font-size:.83rem;<%= task.done ? 'text-decoration:line-through;color:var(--color-text-muted);' : '' %>"><%= task.text %></span>
              <span style="font-size:.67rem;font-weight:700;padding:.15rem .5rem;border-radius:var(--radius-full);
                background:<%= task.pri==='high' ? 'rgba(239,68,68,.1)' : task.pri==='medium' ? 'rgba(245,158,11,.1)' : 'rgba(34,197,94,.1)' %>;
                color:<%= task.pri==='high' ? '#dc2626' : task.pri==='medium' ? '#d97706' : '#16a34a' %>;">
                <%= task.pri==='high' ? 'بالا' : task.pri==='medium' ? 'متوسط' : 'کم' %>
              </span>
            </div>
          <% }); %>
        </div>

      </div>

    </main><!-- /page-content -->
  </div><!-- /main-content -->
</div><!-- /admin-shell -->

<%- include('partials/_scripts', {
  extraScripts: `
  <style>
    .stat-card-dash {
