<%
  // ── Helpers (فقط نمایش؛ همه‌ی داده از server.js می‌آید) ──
  const fa = (n) => Number(n || 0).toLocaleString('fa-IR');
  const ago = (v) => {
    const s = Math.round((Date.now() - new Date(v).getTime()) / 1000);
    if (!isFinite(s)) return '';
    if (s < 60) return 'همین الان';
    const m = Math.round(s / 60); if (m < 60) return fa(m) + ' دقیقه پیش';
    const h = Math.round(m / 60); if (h < 24) return fa(h) + ' ساعت پیش';
    const dd = Math.round(h / 24); return dd === 1 ? 'دیروز' : fa(dd) + ' روز پیش';
  };
  const firstName = ((locals.adminUser && locals.adminUser.name) || '').split(' ')[0];
  const VARIANTS = ['accent', 'success', 'warning'];
  const PRI = { high: 'بالا', medium: 'متوسط', low: 'کم' };
%>
<%- include('partials/_head', { title: 'پنل مدیریت' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'dashboard' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content">

      <!-- Page Header -->
      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">خوش آمدید<%= firstName ? '، ' + firstName : '' %> 👋</h1>
          <p class="page-subtitle">امروز <%= todayFa %> — وضعیت کلی پروژه‌ها و فعالیت‌های تیم</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/sw-admin/reports" class="btn-ghost-sm"><i class="bi bi-bar-chart-line-fill"></i> گزارش‌ها</a>
          <a href="/sw-admin/projects" class="btn-sol-sm"><i class="bi bi-plus-lg"></i> پروژه جدید</a>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="sw-g c4">

        <div class="stat-card-dash fade-up fade-up-1">
          <div class="stat-header">
            <div class="stat-ico"><i class="bi bi-kanban-fill"></i></div>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="<%= stats.activeProjects %>"><%= fa(stats.activeProjects) %></div>
            <div class="stat-label">پروژه فعال</div>
            <div class="stat-note"><%= fa(stats.reviewProjects) %> پروژه در مرحله ریویو</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-2">
          <div class="stat-header">
            <div class="stat-ico accent"><i class="bi bi-people-fill"></i></div>
            <% if (stats.newClients > 0) { %><span class="stat-trend up"><i class="bi bi-arrow-up-short"></i><%= fa(stats.newClients) %></span><% } %>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="<%= stats.totalClients %>"><%= fa(stats.totalClients) %></div>
            <div class="stat-label">مشتری فعال</div>
            <div class="stat-note"><%= fa(stats.newClients) %> مشتری جدید این هفته</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-3">
          <div class="stat-header">
            <div class="stat-ico ok"><i class="bi bi-check-circle-fill"></i></div>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="<%= stats.doneProjects %>"><%= fa(stats.doneProjects) %></div>
            <div class="stat-label">پروژه تحویل‌داده‌شده</div>
            <div class="stat-note"><%= fa(stats.donePct) %>٪ از کل پروژه‌ها</div>
          </div>
        </div>

        <a href="/sw-admin/tickets" class="stat-card-dash fade-up fade-up-4">
          <div class="stat-header">
            <div class="stat-ico warn"><i class="bi bi-ticket-detailed-fill"></i></div>
          </div>
          <div>
            <div class="stat-value text-grad" data-count="<%= stats.openTickets %>"><%= fa(stats.openTickets) %></div>
            <div class="stat-label">تیکت باز</div>
            <div class="stat-note"><%= stats.lastTicketAt ? 'آخرین تیکت: ' + ago(stats.lastTicketAt) : 'تیکتی ثبت نشده' %></div>
          </div>
        </a>

      </div>

      <!-- Quick Mini Cards -->
      <div class="sw-g c3 fade-up fade-up-5">
        <div class="mini-card">
          <div class="mini-ico ok"><i class="bi bi-cash-stack"></i></div>
          <div>
            <div class="mini-val"><%= fa(minis.paidAmount) %> تومان</div>
            <div class="stat-note">مجموع فاکتورهای پرداخت‌شده</div>
          </div>
        </div>
        <div class="mini-card">
          <div class="mini-ico"><i class="bi bi-receipt-cutoff"></i></div>
          <div>
            <div class="mini-val"><%= fa(minis.pendingCount) %> فاکتور</div>
            <div class="stat-note"><%= minis.pendingCount ? 'در انتظار پرداخت: ' + fa(minis.pendingAmount) + ' تومان' : 'فاکتور پرداخت‌نشده‌ای نیست' %></div>
          </div>
        </div>
        <div class="mini-card">
          <div class="mini-ico accent"><i class="bi bi-stars"></i></div>
          <div>
            <div class="mini-val"><%= minis.ratingAvg ? fa(minis.ratingAvg) + ' / ۵' : '—' %></div>
            <div class="stat-note"><%= minis.ratingCount ? 'میانگین از ' + fa(minis.ratingCount) + ' نظر تاییدشده' : 'هنوز نظری ثبت نشده' %></div>
          </div>
        </div>
      </div>

      <!-- Main Grid: Chart + Activity -->
      <div class="sw-layout fade-up fade-up-5" style="margin-bottom:var(--sw-s3);">

        <!-- Chart Panel -->
        <div class="dash-panel">
          <div class="panel-header">
            <h2 class="panel-title"><i class="bi bi-bar-chart-fill" style="color:var(--main-500);"></i> پروژه‌های ثبت‌شده در ۶ ماه اخیر</h2>
            <a href="/sw-admin/reports" class="panel-action">جزئیات <i class="bi bi-arrow-left"></i></a>
          </div>
          <div class="chart-bars" role="img" aria-label="نمودار تعداد پروژه‌های ثبت‌شده در هر ماه">
            <% chart.forEach(function (bar) { %>
              <div class="chart-col">
                <button type="button" class="chart-bar <%= bar.active ? 'active' : '' %>" style="--h:<%= bar.h %>%;"
                        data-val="<%= fa(bar.val) %>" aria-label="<%= bar.label %>: <%= fa(bar.val) %> پروژه"></button>
                <span><%= bar.label %></span>
              </div>
            <% }); %>
          </div>
          <div class="legend"><span><i></i>پروژه ثبت‌شده در ماه</span></div>
        </div>

        <!-- Activity Feed -->
        <div class="dash-panel">
          <div class="panel-header">
            <h2 class="panel-title"><i class="bi bi-activity" style="color:var(--main-500);"></i> فعالیت‌های اخیر</h2>
          </div>
          <% if (!recentActivities.length) { %>
            <div class="sw-empty"><i class="bi bi-inbox"></i>فعالیتی ثبت نشده است</div>
          <% } %>
          <% recentActivities.forEach(function (act) { %>
            <div class="feed-item">
              <div class="feed-ico <%= VARIANTS.includes(act.colorVariant) ? act.colorVariant : '' %>"><i class="bi <%= act.icon || 'bi-lightning-charge-fill' %>"></i></div>
              <div style="flex:1;min-width:0;">
                <p class="feed-text"><%= act.title %></p>
                <div class="feed-time"><i class="bi bi-clock"></i> <%= ago(act.createdAt) %></div>
              </div>
            </div>
          <% }); %>
        </div>

      </div>

      <!-- Projects Table -->
      <div class="dash-panel fade-up fade-up-6" style="margin-bottom:var(--sw-s3);">
        <div class="panel-header">
          <h2 class="panel-title"><i class="bi bi-kanban-fill" style="color:var(--main-500);"></i> آخرین پروژه‌ها</h2>
          <a href="/sw-admin/projects" class="panel-action">همه پروژه‌ها <i class="bi bi-arrow-left"></i></a>
        </div>
        <div class="sw-tw">
          <table class="sol-table">
            <thead>
              <tr><th>پروژه</th><th>مشتری</th><th>نوع</th><th>وضعیت</th><th>پیشرفت</th><th>ددلاین</th></tr>
            </thead>
            <tbody>
              <% if (!projects.length) { %>
                <tr><td colspan="6"><div class="sw-empty"><i class="bi bi-kanban"></i>هنوز پروژه‌ای ثبت نشده است</div></td></tr>
              <% } %>
              <% projects.forEach(function (p) { %>
                <tr>
                  <td>
                    <div class="cell-title"><%= p.name %></div>
                    <% if (p.type) { %><div class="cell-sub"><%= p.type %></div><% } %>
                  </td>
                  <td><%= p.client %></td>
                  <td class="cell-sub"><%= p.cat %></td>
                  <td><span class="badge-status badge-<%= p.cls %>"><%= p.label %></span></td>
                  <td>
                    <div class="prog-wrap">
                      <div class="prog-bar-mini"><div class="prog-fill" style="width:<%= p.prog %>%;"></div></div>
                      <span class="<%= p.urgent ? 'urgent' : '' %>"><%= fa(p.prog) %>٪</span>
                    </div>
                  </td>
                  <td class="<%= p.urgent ? 'urgent' : 'cell-sub' %>"><%= p.deadline %><%= p.urgent ? ' ⚠️' : '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bottom: Tickets + Tasks -->
      <div class="sw-g c2 fade-up fade-up-6">

        <!-- Tickets -->
        <div class="dash-panel">
          <div class="panel-header">
            <h2 class="panel-title"><i class="bi bi-chat-dots-fill" style="color:var(--main-500);"></i> آخرین تیکت‌ها</h2>
            <a href="/sw-admin/tickets" class="panel-action">همه <i class="bi bi-arrow-left"></i></a>
          </div>
          <% if (!tickets.length) { %>
            <div class="sw-empty"><i class="bi bi-chat-square-text"></i>تیکتی ثبت نشده است</div>
          <% } %>
          <% tickets.forEach(function (t) { %>
            <a href="/sw-admin/tickets" class="msg-item <%= t.unread ? 'unread' : '' %>">
              <div class="msg-av v<%= t.v %>"><%= t.initials %></div>
              <div class="msg-main">
                <div class="msg-top"><b><%= t.name %></b><span class="msg-time"><%= ago(t.time) %></span></div>
                <div class="msg-prev"><%= t.preview %></div>
              </div>
            </a>
          <% }); %>
        </div>

        <!-- Tasks -->
        <div class="dash-panel">
          <div class="panel-header">
            <h2 class="panel-title"><i class="bi bi-list-check" style="color:var(--main-500);"></i> وظایف</h2>
            <button type="button" class="btn-sol-sm" data-modal-open="taskModal"><i class="bi bi-plus-lg"></i> جدید</button>
          </div>
          <% if (!todayTasks.length) { %>
            <div class="sw-empty"><i class="bi bi-check2-all"></i>وظیفه‌ای ثبت نشده است</div>
          <% } %>
          <% todayTasks.forEach(function (task) { %>
            <div class="task-item" data-id="<%= task._id %>">
              <div class="task-check <%= task.isDone ? 'done' : '' %>" role="checkbox" tabindex="0" aria-checked="<%= !!task.isDone %>"><%- task.isDone ? '<i class="bi bi-check-lg"></i>' : '' %></div>
              <span class="task-text <%= task.isDone ? 'done' : '' %>"><%= task.title %></span>
              <span class="pri <%= task.priority %>"><%= PRI[task.priority] || PRI.medium %></span>
            </div>
          <% }); %>
        </div>

      </div>

    </main><!-- /page-content -->
  </div><!-- /main-content -->
</div><!-- /admin-shell -->

<!-- Modal: وظیفه جدید -->
<div class="modal-overlay" id="taskModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">وظیفه جدید</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>
    <form action="/sw-admin/tasks" method="POST" data-validate>
      <div class="sw-field">
        <label class="sol-label" for="taskTitle">عنوان</label>
        <input class="sol-input" id="taskTitle" name="title" data-rule="required" placeholder="مثلاً: ارسال پیش‌فاکتور" autocomplete="off">
      </div>
      <div class="sw-field">
        <label class="sol-label" for="taskPri">اولویت</label>
        <select class="sol-select" id="taskPri" name="priority">
          <option value="low">کم</option>
          <option value="medium" selected>متوسط</option>
          <option value="high">بالا</option>
        </select>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button type="submit" class="btn-sol-sm">ثبت وظیفه</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/_scripts', {
  extraScripts: `
  <script>
  // تغییر وضعیت وظیفه با کلیک یا Enter/Space (خوش‌بینانه؛ در خطا برمی‌گردد)
  (function () {
    function toggle(row) {
      var chk = row.querySelector('.task-check'), txt = row.querySelector('.task-text'), was = chk.classList.contains('done');
      function set(v) {
        chk.classList.toggle('done', v); txt.classList.toggle('done', v);
        chk.setAttribute('aria-checked', String(v)); chk.innerHTML = v ? '<i class="bi bi-check-lg"></i>' : '';
      }
      set(!was);
      fetch('/sw-admin/tasks/' + row.dataset.id + '/toggle', { method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j.success) throw new Error('fail');
          set(j.isDone);
          if (j.isDone) SW.island('وظیفه انجام شد', { type: 'success', icon: 'check2-circle', ms: 2200 });
        })
        .catch(function () { set(was); SW.island('تغییر وضعیت وظیفه انجام نشد', { type: 'error' }); });
    }
    document.addEventListener('click', function (e) {
      var row = e.target.closest('.task-item'); if (row) toggle(row);
    });
    document.addEventListener('keydown', function (e) {
      if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('task-check')) { e.preventDefault(); toggle(e.target.closest('.task-item')); }
    });
  })();
  </script>
  `
}) %>
