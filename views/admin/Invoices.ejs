<%- include('partials/_head', { title: 'فاکتورها' }) %>
<link rel="stylesheet" href="assets/css/jalalidatepicker.min.css">

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', {
  activePage: 'invoices',
  adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' }
}) %>
<%
const safeInvoices = Array.isArray(invoices) ? invoices : []
const stats = invoiceStats || {}

const totalInvoices = Number(stats.total) || safeInvoices.length || 0
const waitingInvoices = Number(stats.sent) || 0

const paidAmount = Number(stats.paidAmount) || 0
const waitingAmount = Number(stats.sentAmount) || 0
const overdueAmount = Number(stats.overdueAmount) || 0

function formatMoney(v){
  return (Number(v) || 0).toLocaleString('fa-IR')
}

function formatDate(d){
  if(!d) return '—'
  try{
    return new Date(d).toLocaleDateString('fa-IR',{
      year:'numeric',
      month:'2-digit',
      day:'2-digit'
    })
  }catch{
    return '—'
  }
}

function getClientName(c){
  if(!c) return 'بدون مشتری'
  return c.company || c.name || 'بدون نام'
}

function getProjectTitle(p){
  if(!p) return 'بدون پروژه'
  return p.title || 'بدون عنوان'
}

function getInvoiceStatusLabel(status){
  const map={
    draft:'پیش‌نویس',
    sent:'ارسال‌شده',
    paid:'پرداخت‌شده',
    overdue:'معوق',
    cancelled:'لغوشده'
  }
  return map[status] || 'نامشخص'
}

function getInvoiceStatusClass(status){
  const map={
    draft:'new',
    sent:'review',
    paid:'done',
    overdue:'hold',
    cancelled:'danger'
  }
  return map[status] || 'new'
}

function isOverdue(inv){
  if(!inv || !inv.dueDate) return false
  if(inv.status==='paid' || inv.status==='cancelled') return false

  const today=new Date()
  const due=new Date(inv.dueDate)

  today.setHours(0,0,0,0)
  due.setHours(0,0,0,0)

  return due<today
}
%>

<div class="main-content" id="mainContent">

<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'فاکتورها' }],
  searchPlaceholder: 'جستجو در فاکتورها…'
}) %>

<main class="page-content">

<div class="page-header fade-up fade-up-1">
  <div>
    <h1 class="page-title">مدیریت فاکتورها</h1>

    <p class="page-subtitle">
      <%= totalInvoices.toLocaleString('fa-IR') %>
      فاکتور کل
      ·
      <%= waitingInvoices.toLocaleString('fa-IR') %>
      فاکتور در انتظار پرداخت
    </p>
  </div>

  <div style="display:flex;gap:.6rem;">
    <a href="/sw-admin/invoices/export/pdf" class="btn-ghost-sm" target="_blank">
      <i class="bi bi-download"></i>
      خروجی PDF
    </a>

    <button class="btn-sol-sm" data-modal-open="invoiceModal">
      <i class="bi bi-plus-lg"></i>
      فاکتور جدید
    </button>
  </div>
</div>


<!-- Stats -->
<div class="stat-grid fade-up fade-up-2" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;">

  <div class="inv-stat">
    <div class="inv-stat-icon" style="background:rgba(100,71,244,.1);color:var(--main-500);">
      <i class="bi bi-receipt"></i>
    </div>
    <div>
      <div class="inv-stat-val text-grad">
        <%= totalInvoices.toLocaleString('fa-IR') %>
      </div>
      <div class="inv-stat-lbl">کل فاکتورها</div>
    </div>
  </div>

  <div class="inv-stat">
    <div class="inv-stat-icon" style="background:rgba(34,197,94,.1);color:#16a34a;">
      <i class="bi bi-check-circle-fill"></i>
    </div>
    <div>
      <div class="inv-stat-val" style="color:#16a34a;">
        <%= formatMoney(paidAmount) %>
      </div>
      <div class="inv-stat-lbl">پرداخت‌شده (تومان)</div>
    </div>
  </div>

  <div class="inv-stat">
    <div class="inv-stat-icon" style="background:rgba(245,158,11,.1);color:#d97706;">
      <i class="bi bi-clock-history"></i>
    </div>
    <div>
      <div class="inv-stat-val" style="color:#d97706;">
        <%= formatMoney(waitingAmount) %>
      </div>
      <div class="inv-stat-lbl">در انتظار (تومان)</div>
    </div>
  </div>

  <div class="inv-stat">
    <div class="inv-stat-icon" style="background:rgba(239,68,68,.1);color:#dc2626;">
      <i class="bi bi-exclamation-circle-fill"></i>
    </div>
    <div>
      <div class="inv-stat-val" style="color:#dc2626;">
        <%= formatMoney(overdueAmount) %>
      </div>
      <div class="inv-stat-lbl">معوق (تومان)</div>
    </div>
  </div>

</div>




  <!-- Filter & Search -->
  <div class="invoice-toolbar fade-up fade-up-2" style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-bottom:1.25rem;">
    <div style="flex:1;min-width:220px;display:flex;align-items:center;gap:.5rem;background:var(--color-surface);border:1.5px solid var(--color-border);border-radius:var(--radius-md);padding:.45rem 1rem;">
      <i class="bi bi-search" style="color:var(--color-text-light);font-size:.85rem;"></i>
      <input type="text" placeholder="شماره فاکتور، نام مشتری…" style="border:none;background:transparent;outline:none;font-family:var(--font-primary);font-size:.85rem;color:var(--color-text-primary);width:100%;" id="invSearch">
    </div>

    <select id="invoiceStatusFilter" class="sol-select" style="width:auto;">
      <option value="all">همه وضعیت‌ها</option>
      <option value="paid">پرداخت‌شده</option>
      <option value="sent">در انتظار</option>
      <option value="overdue">معوق</option>
      <option value="draft">پیش‌نویس</option>
      <option value="cancelled">لغوشده</option>
    </select>

    <select id="invoiceRangeFilter" class="sol-select" style="width:auto;">
      <option value="all">همه زمان‌ها</option>
      <option value="month">این ماه</option>
      <option value="3m">۳ ماه اخیر</option>
      <option value="6m">۶ ماه اخیر</option>
      <option value="year">امسال</option>
    </select>
  </div>


  <!-- Invoices Table -->
  <div class="dash-panel fade-up fade-up-3">
    <div style="overflow-x:auto;">
      <table class="sol-table" id="invTable">
        <thead>
          <tr>
            <th>شماره فاکتور</th>
            <th>مشتری</th>
            <th>پروژه</th>
            <th>مبلغ (تومان)</th>
            <th>تاریخ صدور</th>
            <th>سررسید</th>
            <th>وضعیت</th>
            <th>عملیات</th>
          </tr>
        </thead>
<tbody>
  <% if (safeInvoices && safeInvoices.length > 0) { %>

    <% safeInvoices.forEach(function(inv) { %>
      <% 
        const overdue = isOverdue(inv)
        const statusForView = overdue && inv.status !== 'paid' && inv.status !== 'cancelled'
          ? 'overdue'
          : inv.status

        const invoiceCreatedAt = inv.createdAt 
          ? new Date(inv.createdAt).toISOString() 
          : ''
      %>

      <tr
        class="invoice-row"
        data-status="<%= statusForView || '' %>"
        data-original-status="<%= inv.status || '' %>"
        data-created-at="<%= invoiceCreatedAt %>"
        data-total="<%= Number(inv.total) || 0 %>"
      >
        <td>
          <span style="font-family:monospace;font-size:.82rem;font-weight:700;color:var(--main-500);">
            <%= inv.invoiceNumber || '—' %>
          </span>
        </td>

        <td style="font-size:.84rem;font-weight:600;">
          <%= getClientName(inv.client) %>
        </td>

        <td style="font-size:.82rem;color:var(--color-text-muted);">
          <%= getProjectTitle(inv.project) %>
        </td>

        <td style="font-size:.84rem;font-weight:700;direction:ltr;text-align:right;">
          <%= formatMoney(inv.total) %>
        </td>

        <td style="font-size:.78rem;">
          <%= formatDate(inv.issueDate || inv.createdAt) %>
        </td>

        <td 
          style="
            font-size:.78rem;
            color:<%= overdue ? '#dc2626' : 'var(--color-text-muted)' %>;
            font-weight:<%= overdue ? '700' : 'normal' %>;
          "
        >
          <%= formatDate(inv.dueDate) %>
        </td>

        <td>
          <span class="badge-status badge-<%= getInvoiceStatusClass(statusForView) %>">
            <%= getInvoiceStatusLabel(statusForView) %>
          </span>
        </td>

        <td>
          <div style="display:flex;gap:.4rem;align-items:center;">

            <button 
              type="button"
              class="btn-ghost-sm" 
              style="padding:.28rem .6rem;" 
              title="مشاهده" 
              data-modal-open="invViewModal"
              data-id="<%= inv._id %>"
            >
              <i class="bi bi-eye"></i>
            </button>

            <a 
              href="/sw-admin/invoices/<%= inv._id %>/pdf"
              class="btn-ghost-sm invoice-pdf-btn"
              style="padding:.28rem .6rem;"
              title="دانلود PDF"
              target="_blank"
              rel="noopener"
            >
              <i class="bi bi-download"></i>
            </a>

            <a 
              href="/sw-admin/invoices/<%= inv._id %>/send-email" 
              class="btn-ghost-sm" 
              style="padding:.28rem .6rem;" 
              title="ارسال ایمیل"
            >
              <i class="bi bi-envelope"></i>
            </a>

            <form 
              action="/sw-admin/invoices/<%= inv._id %>/delete" 
              method="POST" 
              onsubmit="return confirm('آیا از حذف این فاکتور مطمئن هستید؟')"
              style="display:inline;"
            >
              <button 
                type="submit"
                class="btn-danger-sm" 
                style="padding:.28rem .6rem;" 
                title="حذف"
              >
                <i class="bi bi-trash"></i>
              </button>
            </form>

          </div>
        </td>      </tr>
    <% }); %>

    <tr id="noInvoiceRowsMessage" style="display:none;">
      <td colspan="8" style="text-align:center;padding:2rem;color:var(--color-text-muted);font-size:.9rem;">
        هیچ فاکتوری با این فیلترها پیدا نشد.
      </td>
    </tr>

  <% } else { %>

    <tr>
      <td colspan="8" style="text-align:center;padding:2rem;color:var(--color-text-muted);font-size:.9rem;">
        هنوز هیچ فاکتوری ثبت نشده است.
      </td>
    </tr>

  <% } %>
</tbody>


      </table>
    </div>
<div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-top:1px solid var(--color-border);flex-wrap:wrap;gap:.75rem;">
  <span style="font-size:.78rem;color:var(--color-text-muted);">
    نمایش 
    <%= invoices && invoices.length ? '۱' : '۰' %>
    –
    <%= invoices ? invoices.length.toLocaleString('fa-IR') : '۰' %>
    از
    <%= invoices ? invoices.length.toLocaleString('fa-IR') : '۰' %>
    فاکتور
  </span>

  <div style="display:flex;gap:.35rem;">
    <button class="pg-btn" disabled><i class="bi bi-chevron-right"></i></button>
    <button class="pg-btn active">۱</button>
    <button class="pg-btn" disabled><i class="bi bi-chevron-left"></i></button>
  </div>
</div>

  </div>

</main>
</div>
</div>

