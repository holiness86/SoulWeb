      </div>
    </div>

    <button 
      type="button" 
      class="btn-ghost-sm" 
      style="margin-top:.5rem;width:100%;justify-content:center;" 
      id="addInvItem"
    >
      <i class="bi bi-plus"></i> افزودن آیتم
    </button>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem;">
      <div class="form-row">
        <label class="sol-label">تاریخ صدور</label>
        <input 
          class="sol-input" 
          type="text" 
          name="issue_date" 
          id="invoiceIssueDate"
          placeholder="۱۴۰۴/۰۳/۲۱"
          autocomplete="off"
          data-jdp
          data-jdp-only-date
        >
      </div>

      <div class="form-row">
        <label class="sol-label">سررسید پرداخت</label>
        <input 
          class="sol-input" 
          type="text" 
          name="due_date" 
          id="invoiceDueDate"
          placeholder="۱۴۰۴/۰۴/۱۵"
          autocomplete="off"
          data-jdp
          data-jdp-only-date
        >
      </div>
    </div>

    <div class="form-row">
      <label class="sol-label">یادداشت</label>

      <textarea 
        class="sol-input" 
        rows="2" 
        placeholder="یادداشت اختیاری…" 
        style="resize:vertical;" 
        name="note"
      ></textarea>
    </div>

    <input type="hidden" name="status" id="invoiceStatusInput" value="sent">

    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button type="button" class="btn-ghost-sm" data-modal-close>
        انصراف
      </button>

      <button 
        type="submit" 
        class="btn-ghost-sm" 
        data-invoice-status="draft"
      >
        <i class="bi bi-file-earmark"></i> پیش‌نویس
      </button>

      <button 
        type="submit" 
        class="btn-sol-sm" 
        data-invoice-status="sent"
      >
        <i class="bi bi-send-fill"></i> صدور فاکتور
      </button>
    </div>
  </form>
</div>

