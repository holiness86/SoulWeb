  }

  .inv-stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: .85rem;
    transition: all var(--dur-normal) var(--ease-spring);
  }

  .inv-stat:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--main-200);
  }

  .inv-stat-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .inv-stat-val {
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1;
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .inv-stat-lbl {
    font-size: .73rem;
    color: var(--color-text-muted);
    margin-top: .15rem;
  }

  .pg-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: .8rem;
    transition: all var(--dur-fast);
    font-family: var(--font-primary);
  }

  .pg-btn.active,
  .pg-btn:not(:disabled):hover {
    background: var(--main-500);
    border-color: var(--main-500);
    color: #fff;
  }

  .pg-btn:disabled {
    opacity: .4;
    cursor: not-allowed;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const invSearch = document.getElementById('invSearch')
  const invTable = document.getElementById('invTable')
  const invItems = document.getElementById('invItems')
  const addInvItemBtn = document.getElementById('addInvItem')
  const clientSelect = document.getElementById('invoiceClientSelect')
  const projectSelect = document.getElementById('invoiceProjectSelect')
  const invoiceStatusInput = document.getElementById('invoiceStatusInput')
  const invoiceForm = document.getElementById('invoiceForm')

  if (invSearch && invTable) {
    invSearch.addEventListener('input', function () {
      const q = this.value.toLowerCase()

      invTable.querySelectorAll('tbody tr').forEach(function (row) {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none'
      })
    })
  }

  if (addInvItemBtn && invItems) {
    addInvItemBtn.addEventListener('click', function () {
      const row = document.createElement('div')
      row.className = 'inv-item-row'

      row.innerHTML =
        '<input class="sol-input" type="text" placeholder="شرح خدمات" style="flex:2;" name="item_desc[]" required>' +
        '<input class="sol-input" type="number" placeholder="تعداد" style="flex:0.5;" name="item_qty[]" min="1" value="1" required>' +
        '<input class="sol-input" type="number" placeholder="مبلغ واحد" style="flex:1;" name="item_price[]" min="0" required>' +
        '<button type="button" class="btn-danger-sm remove-inv-item" style="padding:.45rem .6rem;flex-shrink:0;"><i class="bi bi-trash"></i></button>'

      invItems.appendChild(row)
    })
  }

  if (invItems) {
    invItems.addEventListener('click', function (e) {
      const removeBtn = e.target.closest('.remove-inv-item')
      if (!removeBtn) return

      const rows = invItems.querySelectorAll('.inv-item-row')

      if (rows.length <= 1) {
        alert('حداقل یک آیتم برای فاکتور لازم است.')
        return
      }

      const row = removeBtn.closest('.inv-item-row')
      if (row) row.remove()
    })
  }

  if (clientSelect && projectSelect) {
    clientSelect.addEventListener('change', async function () {
      const clientId = clientSelect.value

      projectSelect.innerHTML = '<option value="">در حال دریافت پروژه‌ها…</option>'

      if (!clientId) {
        projectSelect.innerHTML = '<option value="">ابتدا مشتری را انتخاب کنید…</option>'
        return
      }

      try {
        const res = await fetch('/sw-admin/clients/' + clientId + '/projects')

        if (!res.ok) {
          throw new Error('Failed to fetch projects')
        }

        const projects = await res.json()

        if (!projects.length) {
          projectSelect.innerHTML = '<option value="">این مشتری پروژه‌ای ندارد</option>'
          return
        }

        projectSelect.innerHTML = '<option value="">انتخاب پروژه…</option>'

        projects.forEach(function (project) {
          const option = document.createElement('option')
          option.value = project._id
          option.textContent = project.title
          projectSelect.appendChild(option)
        })

      } catch (err) {
        console.error(err)
        projectSelect.innerHTML = '<option value="">خطا در دریافت پروژه‌ها</option>'
      }
    })
  }

  if (invoiceForm && invoiceStatusInput) {
    invoiceForm.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-invoice-status]')
      if (!btn) return

      invoiceStatusInput.value = btn.dataset.invoiceStatus || 'sent'
    })
  }
})
document.addEventListener('DOMContentLoaded', function () {
  const statusFilter = document.getElementById('invoiceStatusFilter')
  const rangeFilter = document.getElementById('invoiceRangeFilter')
  const rows = Array.from(document.querySelectorAll('.invoice-row'))
  const emptyMessage = document.getElementById('noInvoiceRowsMessage')

  if (!statusFilter || !rangeFilter || !rows.length) return

  function getStartDateByRange(range) {
    const now = new Date()
    let startDate = null

    if (range === 'month') {
      startDate = new Date(now.getFullYear(), now.getMonth(), 1)
    }

    if (range === '3m') {
      startDate = new Date(now)
      startDate.setMonth(startDate.getMonth() - 3)
    }

    if (range === '6m') {
      startDate = new Date(now)
      startDate.setMonth(startDate.getMonth() - 6)
    }

    if (range === 'year') {
      startDate = new Date(now.getFullYear(), 0, 1)
    }

    return startDate
  }

  function applyInvoiceFilters() {
    const selectedStatus = statusFilter.value
    const selectedRange = rangeFilter.value

    const startDate = getStartDateByRange(selectedRange)

    let visibleCount = 0

    rows.forEach(row => {
      const rowStatus = row.dataset.status || ''
      const rowCreatedAtRaw = row.dataset.createdAt || ''
      const rowCreatedAt = rowCreatedAtRaw ? new Date(rowCreatedAtRaw) : null

      let statusMatched = true
      let rangeMatched = true

      if (selectedStatus !== 'all') {
        statusMatched = rowStatus === selectedStatus
      }

      if (selectedRange !== 'all' && startDate) {
        if (!rowCreatedAt || Number.isNaN(rowCreatedAt.getTime())) {
          rangeMatched = false
        } else {
          rangeMatched = rowCreatedAt >= startDate
        }
      }

      const shouldShow = statusMatched && rangeMatched

      row.style.display = shouldShow ? '' : 'none'

      if (shouldShow) visibleCount++
    })

    if (emptyMessage) {
      emptyMessage.style.display = visibleCount === 0 ? '' : 'none'
    }
  }

  statusFilter.addEventListener('change', applyInvoiceFilters)
  rangeFilter.addEventListener('change', applyInvoiceFilters)

  applyInvoiceFilters()
})

document.querySelectorAll('[data-modal-open="invViewModal"]').forEach(btn => {
  btn.addEventListener('click', () => {

    const id = btn.dataset.id
    const pdfBtn = document.getElementById('modalPdfBtn')

    if (pdfBtn && id) {
      pdfBtn.href = `/sw-admin/invoices/${id}/pdf`
    }

  })
})


</script>