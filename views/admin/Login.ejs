<%# views/admin/Login.ejs — ورود به پنل مدیریت سُل وب
    ورودی‌ها از سرور: error (string، اختیاری) · email (string، اختیاری؛ برای پر ماندن فیلد بعد از خطا)
    فرم: POST /sw-admin/login  { email, password, remember } %>
<%
  const year = new Intl.DateTimeFormat('fa-IR-u-ca-persian', { year: 'numeric' }).format(new Date());
%>
<%- include('partials/_head', { title: 'ورود به پنل مدیریت' }) %>

<main class="login-page">

  <!-- ══ پنل برندینگ ══ -->
  <section class="login-visual" aria-hidden="true">
    <div class="lv-blob lv-blob-1"></div>
    <div class="lv-blob lv-blob-2"></div>
    <div class="lv-blob lv-blob-3"></div>
    <div class="lv-dots"></div>

    <div class="lv-card lv-card-2"><i class="bi bi-shield-lock-fill" style="color:#4ade80;"></i> ورود مخصوص مدیران</div>
    <div class="lv-card lv-card-1"><span class="lv-green-dot"></span> همه‌چیز در یک پنل</div>

    <div class="lv-content">
      <div class="lv-logo fade-up fade-up-1">
        <div class="lv-logo-icon">سل</div>
        <div>
          <div class="lv-logo-text">سُل وب</div>
          <div class="lv-logo-sub">پنل مدیریت حرفه‌ای</div>
        </div>
      </div>

      <h2 class="lv-title fade-up fade-up-2">مدیریت هوشمند <span>کسب‌وکار آنلاین</span></h2>
      <p class="lv-desc fade-up fade-up-3">از مدیریت پروژه‌ها تا فاکتورها، همه‌چیز در یک پنل مدرن و سریع — طراحی‌شده برای تیم سُل وب.</p>

      <div class="lv-features fade-up fade-up-4">
        <div class="lv-feature"><div class="lv-feature-icon"><i class="bi bi-kanban-fill"></i></div>مدیریت کامل پروژه‌ها با کانبان</div>
        <div class="lv-feature"><div class="lv-feature-icon"><i class="bi bi-people-fill"></i></div>مدیریت مشتریان و تیکت‌ها در یک جا</div>
        <div class="lv-feature"><div class="lv-feature-icon"><i class="bi bi-bar-chart-line-fill"></i></div>گزارش‌ها و آمار عملکرد</div>
        <div class="lv-feature"><div class="lv-feature-icon"><i class="bi bi-receipt"></i></div>صدور و مدیریت فاکتورها</div>
      </div>
    </div>
  </section>

  <!-- ══ فرم ورود ══ -->
  <section class="login-form-side">

    <button type="button" class="hdr-btn login-theme" id="themeToggle" title="تغییر تم" aria-label="تغییر تم">
      <i class="bi bi-moon-stars-fill"></i>
    </button>

    <a href="/" class="login-mobile-logo" aria-label="بازگشت به وب‌سایت">
      <div class="lml-icon">سل</div>
      <span class="lml-text">سُل وب</span>
    </a>

    <div class="login-box <%= locals.error ? 'shake' : '' %>">

      <div class="login-header fade-up fade-up-1">
        <h1>خوش آمدید 👋</h1>
        <p>برای ورود به پنل مدیریت، اطلاعات خود را وارد کنید</p>
      </div>

      <% if (locals.error) { %>
        <div class="login-alert" role="alert">
          <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
          <span><%= locals.error %></span>
        </div>
      <% } %>

      <form action="/sw-admin/login" method="POST" id="loginForm" data-validate novalidate>

        <div class="sw-field fade-up fade-up-2">
          <label class="sol-label" for="email">ایمیل</label>
          <div class="input-wrap">
            <i class="bi bi-envelope" aria-hidden="true"></i>
            <input class="sol-input" id="email" name="email" type="email" inputmode="email" dir="ltr"
                   autocomplete="username" autocapitalize="none" spellcheck="false"
                   placeholder="name@example.com" data-rule="required|email"
                   value="<%= locals.email || '' %>">
          </div>
        </div>

        <div class="sw-field fade-up fade-up-3">
          <label class="sol-label" for="password">رمز عبور</label>
          <div class="input-wrap">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <input class="sol-input" id="password" name="password" type="password" dir="ltr"
                   autocomplete="current-password" placeholder="رمز عبور خود را وارد کنید"
                   data-rule="required">
            <button type="button" class="login-eye" id="togglePassword" aria-label="نمایش رمز عبور" aria-pressed="false">
              <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
          </div>
          <div class="login-hint" id="capsHint" role="status"><i class="bi bi-capslock-fill" aria-hidden="true"></i> Caps Lock روشن است</div>
        </div>

        <div class="login-options fade-up fade-up-4">
          <label class="login-remember">
            <span class="sw-toggle sw-toggle-sm"><input type="checkbox" name="remember" value="1"><span class="sw-slider"></span></span>
            مرا به خاطر بسپار
          </label>
        </div>

        <button type="submit" class="btn-sol-sm login-submit fade-up fade-up-5">
          <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i> ورود به داشبورد
        </button>

      </form>

      <div class="login-divider fade-up fade-up-6">یا</div>

      <a href="/" class="btn-ghost-sm login-back fade-up fade-up-6"><i class="bi bi-globe2" aria-hidden="true"></i> بازگشت به وب‌سایت</a>

    </div>

    <div class="login-footer">© <%= year %> تیم سُل وب</div>

  </section>

</main>

<script src="/assets/js/admin.js"></script>
<script>
(function () {
  var pw = document.getElementById('password'), em = document.getElementById('email'),
      eye = document.getElementById('togglePassword'), caps = document.getElementById('capsHint');

  eye.addEventListener('click', function () {
    var show = pw.type === 'password';
    pw.type = show ? 'text' : 'password';
    eye.setAttribute('aria-pressed', String(show));
    eye.setAttribute('aria-label', show ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور');
    eye.firstElementChild.className = 'bi ' + (show ? 'bi-eye-slash' : 'bi-eye');
    pw.focus();
  });

  function capsCheck(e) { if (e.getModifierState) caps.classList.toggle('show', e.getModifierState('CapsLock')); }
  pw.addEventListener('keydown', capsCheck);
  pw.addEventListener('keyup', capsCheck);
  pw.addEventListener('blur', function () { caps.classList.remove('show'); });

  // فوکوس اولیه فقط روی دسکتاپ (روی موبایل کیبورد ناخواسته باز نشود)
  if (matchMedia('(pointer:fine)').matches) (em.value ? pw : em).focus();
})();
</script>

</body>
</html>
