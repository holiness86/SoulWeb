<%- include('partials/_head', { title: 'کتابخانه رسانه' }) %>
<div class="sidebar-overlay" id="sidebarOverlay"></div><div class="admin-shell">
<%- include('partials/_sidebar', { activePage: 'media' }) %><div class="main-content">
<%- include('partials/_header', { breadcrumbs: [{label:'داشبورد',href:'/sw-admin'},{label:'کتابخانه رسانه'}] }) %>
<main class="page-content"><div class="page-header"><div><h1 class="page-title">کتابخانه رسانه</h1><p class="page-subtitle">تصاویر وب‌سایت را بارگذاری کنید و متن جایگزین و توضیحاتشان را نگه دارید.</p></div></div>
<section class="dash-panel media-upload-panel"><form id="mediaUploadForm" class="media-upload-form"><label class="sw-field"><span class="sol-label">انتخاب تصویر</span><input class="sol-input" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" required></label><label class="sw-field"><span class="sol-label">متن جایگزین (Alt)</span><input class="sol-input" name="alt" maxlength="200" placeholder="شرح کوتاه تصویر"></label><label class="sw-field"><span class="sol-label">توضیحات</span><input class="sol-input" name="description" maxlength="500"></label><button class="btn-sol-sm" type="submit"><i class="bi bi-cloud-upload"></i> بارگذاری</button><p class="media-message" role="status" aria-live="polite"></p></form></section>
<div class="media-grid" id="mediaGrid"><% items.forEach(function(item){ %><article class="media-card" data-id="<%= item._id %>"><img src="<%= item.url %>" alt="<%= item.alt || '' %>" loading="lazy" decoding="async"><div class="media-card-body"><div class="cell-title" title="<%= item.originalName %>"><%= item.originalName || item.filename %></div><label class="sw-field"><span class="sol-label">Alt</span><input class="sol-input" data-alt maxlength="200" value="<%= item.alt || '' %>"></label><label class="sw-field"><span class="sol-label">توضیحات</span><textarea class="sol-input" data-description rows="2" maxlength="500"><%= item.description || '' %></textarea></label><button class="btn-ghost-sm" type="button" data-media-save>ذخیره توضیحات</button></div></article><% }); %><% if(!items.length){ %><div class="sw-empty">هنوز تصویری در کتابخانه نیست.</div><% } %></div>
</main></div></div>
<script>
document.addEventListener('DOMContentLoaded',function(){var form=document.getElementById('mediaUploadForm'),grid=document.getElementById('mediaGrid'),msg=document.querySelector('.media-message');function card(m){var a=document.createElement('article');a.className='media-card';a.dataset.id=m._id;a.innerHTML='<img loading="lazy" decoding="async"><div class="media-card-body"><div class="cell-title"></div><label class="sw-field"><span class="sol-label">Alt</span><input class="sol-input" data-alt maxlength="200"></label><label class="sw-field"><span class="sol-label">توضیحات</span><textarea class="sol-input" data-description rows="2" maxlength="500"></textarea></label><button class="btn-ghost-sm" type="button" data-media-save>ذخیره توضیحات</button></div>';a.querySelector('img').src=m.url;a.querySelector('img').alt=m.alt||'';a.querySelector('.cell-title').textContent=m.originalName||m.filename;a.querySelector('[data-alt]').value=m.alt||'';a.querySelector('[data-description]').value=m.description||'';return a}form.addEventListener('submit',async function(e){e.preventDefault();msg.textContent='در حال بارگذاری…';try{var r=await fetch('/sw-admin/api/media',{method:'POST',body:new FormData(form)}),m=await r.json();if(!r.ok)throw Error(m.message);grid.prepend(card(m));form.reset();msg.textContent='تصویر بارگذاری شد.'}catch(err){msg.textContent=err.message}});grid.addEventListener('click',async function(e){var b=e.target.closest('[data-media-save]');if(!b)return;var c=b.closest('.media-card');try{var r=await fetch('/sw-admin/api/media/'+c.dataset.id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({alt:c.querySelector('[data-alt]').value,description:c.querySelector('[data-description]').value})});var m=await r.json();if(!r.ok)throw Error(m.message);c.querySelector('img').alt=m.alt;b.textContent='ذخیره شد';setTimeout(function(){b.textContent='ذخیره توضیحات'},1200)}catch(err){b.textContent=err.message}})});
</script><%- include('partials/_scripts') %>
