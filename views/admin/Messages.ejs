<%- include('partials/_head', { title: 'پیام‌ها' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', {
  activePage: 'messages',
  adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' }
}) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'پیام‌ها' }],
  searchPlaceholder: 'جستجو در پیام‌ها…'
}) %>

<main class="page-content">

  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title">پیام‌ها</h1>
      <p class="page-subtitle">۵ پیام خوانده‌نشده · ۲۳ پیام کل</p>
    </div>
    <button class="btn-sol-sm" data-modal-open="composeModal">
      <i class="bi bi-pencil-square"></i> پیام جدید
    </button>
  </div>

  <div class="msg-layout fade-up fade-up-2">

    <!-- Sidebar Inbox -->
    <div class="msg-sidebar dash-panel">
      <div class="msg-sidebar-header">
        <div class="msg-search">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="جستجو…" id="msgSearch">
        </div>
        <div class="msg-tabs">
          <button class="msg-tab active" data-tab="inbox">صندوق ورودی <span class="msg-count">۵</span></button>
          <button class="msg-tab" data-tab="sent">ارسال‌شده</button>
          <button class="msg-tab" data-tab="archived">آرشیو</button>
        </div>
      </div>
      <div class="msg-list" id="msgList">
        <% const msgs = [
          { id:1, name:'محسن رضایی',  init:'محر', color:'var(--grad-main)',                         sub:'درباره پروژه فروشگاه',     prev:'سلام، میخواستم یه چیزی بپرسم…', time:'الان',    unread:true,  active:true  },
          { id:2, name:'سارا طاهری',  init:'سار', color:'linear-gradient(135deg,#0090e8,#4dc3ff)', sub:'تغییر طراحی هدر',          prev:'فقط یه تغییر کوچیک میخوام…',     time:'۲۰ د',   unread:true,  active:false },
          { id:3, name:'رضا محمدی',   init:'رضا', color:'linear-gradient(135deg,#a394fb,#6447f4)', sub:'تأیید پیش‌فاکتور',         prev:'پیش‌فاکتور رو دیدم، تأیید…',    time:'۱ س',    unread:true,  active:false },
          { id:4, name:'علی امینی',   init:'علی', color:'linear-gradient(135deg,#22c55e,#0090e8)', sub:'لانچ سایت',                prev:'سایت فروشگاه رو لانچ کردیم!',    time:'دیروز',  unread:true,  active:false },
          { id:5, name:'نگار صادقی',  init:'نگر', color:'linear-gradient(135deg,#f59e0b,#ef4444)', sub:'اضافه کردن بلاگ',          prev:'آیا امکان اضافه کردن بلاگ…',     time:'دیروز',  unread:true,  active:false },
          { id:6, name:'کیانی لباس',  init:'کیا', color:'linear-gradient(135deg,#6447f4,#1e1274)', sub:'پیگیری پروژه',             prev:'سلام، پروژه در چه مرحله‌ای…',    time:'۲ روز',  unread:false, active:false },
          { id:7, name:'گروه پارسیان',init:'پار', color:'linear-gradient(135deg,#0090e8,#005896)', sub:'مشکل در پرتال',            prev:'یه باگ پیدا کردیم در صفحه…',     time:'۳ روز',  unread:false, active:false },
        ]; %>
        <% msgs.forEach(function(m){ %>
        <div class="msg-item <%= m.unread ? 'unread' : '' %> <%= m.active ? 'active' : '' %>" data-id="<%= m.id %>">
          <div class="msg-av" style="background:<%= m.color %>;"><%= m.init %></div>
          <div class="msg-item-body">
            <div class="msg-item-top">
              <span class="msg-item-name"><%= m.name %></span>
              <span class="msg-item-time"><%= m.time %></span>
            </div>
            <div class="msg-item-sub"><%= m.sub %></div>
            <div class="msg-item-prev"><%= m.prev %></div>
          </div>
          <% if(m.unread){ %><div class="msg-dot"></div><% } %>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- Chat Area -->
    <div class="msg-chat dash-panel">
      <div class="msg-chat-header">
        <div style="display:flex;align-items:center;gap:.85rem;">
          <div class="msg-av" style="background:var(--grad-main);width:40px;height:40px;font-size:.82rem;">محر</div>
          <div>
            <div style="font-weight:700;font-size:.9rem;">محسن رضایی</div>
            <div style="font-size:.73rem;color:var(--color-text-muted);">استارتاپ آفیلیو · آنلاین</div>
          </div>
        </div>
        <div style="display:flex;gap:.5rem;">
          <button class="hdr-btn" title="تلفن"><i class="bi bi-telephone"></i></button>
          <button class="hdr-btn" title="ویدیو"><i class="bi bi-camera-video"></i></button>
          <button class="hdr-btn" title="بیشتر"><i class="bi bi-three-dots"></i></button>
        </div>
      </div>

      <div class="msg-chat-body" id="chatBody">
        <div class="msg-date-sep"><span>دیروز</span></div>

        <div class="msg-bubble received">
          <div class="bubble-text">سلام! میخواستم درباره پروژه فروشگاه یه سوال بپرسم.</div>
          <div class="bubble-time">۱۴:۲۰</div>
        </div>
        <div class="msg-bubble sent">
          <div class="bubble-text">سلام محسن جان! بفرمایید، چه سوالی دارید؟</div>
          <div class="bubble-time">۱۴:۲۵</div>
        </div>
        <div class="msg-bubble received">
          <div class="bubble-text">ددلاین پروژه رو میتونیم یه هفته جلو بندازیم؟ مناسبت خاصی داریم.</div>
          <div class="bubble-time">۱۴:۲۸</div>
        </div>
        <div class="msg-bubble sent">
          <div class="bubble-text">باید با تیم بررسی کنم. احتمالاً امکان‌پذیره اگه scope تغییر نکنه.</div>
          <div class="bubble-time">۱۴:۳۵</div>
        </div>

        <div class="msg-date-sep"><span>امروز</span></div>

        <div class="msg-bubble received">
          <div class="bubble-text">خیلی ممنون! منتظر تأیید شما هستیم. ضمناً درباره صفحه پرداخت هم یه سوال داشتم.</div>
          <div class="bubble-time">۰۹:۱۵</div>
        </div>
        <div class="msg-bubble sent">
          <div class="bubble-text">بله بفرمایید 🙏</div>
          <div class="bubble-time">۰۹:۲۰</div>
        </div>
        <div class="msg-bubble received">
          <div class="bubble-text">آیا درگاه پرداخت زرین‌پال رو هم پشتیبانی می‌کنه؟</div>
          <div class="bubble-time">الان</div>
        </div>
      </div>

      <div class="msg-input-area">
        <button class="hdr-btn" title="فایل"><i class="bi bi-paperclip"></i></button>
        <div class="msg-input-box">
          <input type="text" id="msgInput" placeholder="پیام خود را بنویسید…">
        </div>
        <button class="msg-emoji-btn" title="ایموجی"><i class="bi bi-emoji-smile"></i></button>
        <button class="btn-sol-sm msg-send-btn" id="msgSend">
          <i class="bi bi-send-fill"></i>
        </button>
      </div>
    </div>

  </div>

</main>
</div>
</div>

<!-- Modal: پیام جدید -->
<div class="modal-overlay" id="composeModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">پیام جدید</div>
      <button data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="form-row">
      <label class="sol-label">گیرنده</label>
      <select class="sol-select" style="width:100%">
        <option>انتخاب مشتری…</option>
        <option>محسن رضایی — آفیلیو</option>
        <option>علی امینی — اسیل</option>
        <option>سارا طاهری — نگاه</option>
        <option>رضا محمدی — آوا</option>
      </select>
    </div>
    <div class="form-row">
      <label class="sol-label">موضوع</label>
      <input class="sol-input" type="text" placeholder="موضوع پیام را بنویسید…">
    </div>
    <div class="form-row">
      <label class="sol-label">متن پیام</label>
      <textarea class="sol-input" rows="5" placeholder="پیام خود را بنویسید…" style="resize:vertical;"></textarea>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" data-modal-close>انصراف</button>
      <button class="btn-sol-sm"><i class="bi bi-send-fill"></i> ارسال پیام</button>
    </div>
  </div>
</div>

<%- include('partials/_scripts', { extraScripts: `
<style>
.msg-layout { display:grid; grid-template-columns:320px 1fr; gap:1.25rem; height:calc(100vh - 180px); min-height:500px; }
@media(max-width:900px){ .msg-layout{ grid-template-columns:1fr; } .msg-sidebar{ display:none; } }
.msg-sidebar { display:flex; flex-direction:column; overflow:hidden; }
.msg-sidebar-header { padding:.85rem 1rem; border-bottom:1px solid var(--color-border); flex-shrink:0; }
.msg-search { display:flex; align-items:center; gap:.5rem; background:var(--color-bg); border:1.5px solid var(--color-border); border-radius:var(--radius-md); padding:.38rem .85rem; margin-bottom:.75rem; }
.msg-search i { color:var(--color-text-light); font-size:.82rem; }
.msg-search input { border:none; background:transparent; outline:none; font-family:var(--font-primary); font-size:.82rem; color:var(--color-text-primary); width:100%; }
.msg-tabs { display:flex; gap:.35rem; }
.msg-tab { flex:1; font-family:var(--font-primary); font-size:.73rem; font-weight:600; padding:.38rem .5rem; border:1.5px solid var(--color-border); border-radius:var(--radius-sm); background:transparent; color:var(--color-text-muted); cursor:pointer; transition:all var(--dur-fast); display:flex; align-items:center; justify-content:center; gap:.3rem; }
.msg-tab.active { background:var(--main-500); border-color:var(--main-500); color:#fff; }
.msg-count { background:rgba(255,255,255,.3); color:#fff; font-size:.62rem; padding:.05rem .35rem; border-radius:99px; }
.msg-list { flex:1; overflow-y:auto; }
.msg-item { display:flex; align-items:flex-start; gap:.75rem; padding:.85rem 1rem; cursor:pointer; transition:background var(--dur-fast); border-bottom:1px solid var(--color-border); position:relative; }
.msg-item:hover { background:var(--color-bg); }
.msg-item.active { background:rgba(100,71,244,.07); border-right:3px solid var(--main-500); }
.msg-item.unread .msg-item-name { font-weight:800; color:var(--color-text-primary); }
.msg-av { width:36px; height:36px; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:.7rem; font-weight:800; color:#fff; flex-shrink:0; }
.msg-item-body { flex:1; min-width:0; }
.msg-item-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:.15rem; }
.msg-item-name { font-size:.82rem; font-weight:600; color:var(--color-text-primary); }
.msg-item-time { font-size:.68rem; color:var(--color-text-light); white-space:nowrap; }
.msg-item-sub { font-size:.77rem; font-weight:600; color:var(--color-text-muted); margin-bottom:.1rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.msg-item-prev { font-size:.72rem; color:var(--color-text-light); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.msg-dot { position:absolute; top:.85rem; left:.85rem; width:8px; height:8px; border-radius:50%; background:var(--main-500); }

.msg-chat { display:flex; flex-direction:column; overflow:hidden; }
.msg-chat-header { display:flex; align-items:center; justify-content:space-between; padding:.85rem 1.25rem; border-bottom:1px solid var(--color-border); flex-shrink:0; }
.msg-chat-body { flex:1; overflow-y:auto; padding:1.25rem; display:flex; flex-direction:column; gap:.65rem; }
.msg-date-sep { text-align:center; position:relative; margin:.5rem 0; }
.msg-date-sep::before { content:''; position:absolute; top:50%; right:0; left:0; height:1px; background:var(--color-border); }
.msg-date-sep span { position:relative; background:var(--color-surface); padding:0 .75rem; font-size:.7rem; color:var(--color-text-light); }
.msg-bubble { display:flex; flex-direction:column; max-width:65%; }
.msg-bubble.received { align-self:flex-start; align-items:flex-start; }
.msg-bubble.sent { align-self:flex-end; align-items:flex-end; }
.bubble-text { padding:.65rem 1rem; border-radius:var(--radius-lg); font-size:.84rem; line-height:1.55; }
.msg-bubble.received .bubble-text { background:var(--color-bg); border-bottom-right-radius:.35rem; color:var(--color-text-primary); }
.msg-bubble.sent .bubble-text { background:var(--grad-main); color:#fff; border-bottom-left-radius:.35rem; }
.bubble-time { font-size:.67rem; color:var(--color-text-light); margin-top:.25rem; padding:0 .25rem; }
.msg-input-area { display:flex; align-items:center; gap:.65rem; padding:.85rem 1.25rem; border-top:1px solid var(--color-border); flex-shrink:0; }
.msg-input-box { flex:1; background:var(--color-bg); border:1.5px solid var(--color-border); border-radius:var(--radius-full); padding:.5rem 1.1rem; transition:all var(--dur-fast); }
.msg-input-box:focus-within { border-color:var(--main-400); box-shadow:0 0 0 3px rgba(100,71,244,.1); }
.msg-input-box input { border:none; background:transparent; outline:none; font-family:var(--font-primary); font-size:.85rem; color:var(--color-text-primary); width:100%; }
.msg-emoji-btn { background:transparent; border:none; font-size:1.1rem; color:var(--color-text-light); cursor:pointer; transition:color var(--dur-fast); }
.msg-emoji-btn:hover { color:var(--main-500); }
.msg-send-btn { border-radius:var(--radius-full) !important; padding:.5rem .9rem !important; }
</style>
<script>
// send on click / enter
const msgSend = document.getElementById('msgSend');
const msgInput = document.getElementById('msgInput');
const chatBody = document.getElementById('chatBody');

function sendMessage() {
  const val = msgInput.value.trim();
  if(!val) return;
  const now = new Date();
  const time = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble sent';
  bubble.innerHTML = '<div class="bubble-text">' + val + '</div><div class="bubble-time">' + time + '</div>';
  chatBody.appendChild(bubble);
  chatBody.scrollTop = chatBody.scrollHeight;
  msgInput.value = '';
}
msgSend.addEventListener('click', sendMessage);
msgInput.addEventListener('keydown', function(e){ if(e.key==='Enter') sendMessage(); });
chatBody.scrollTop = chatBody.scrollHeight;

// list filter
document.getElementById('msgSearch').addEventListener('input', function(){
  const q = this.value.toLowerCase();
  document.querySelectorAll('.msg-item').forEach(function(item){
    item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});

// tab switch
document.querySelectorAll('.msg-tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('.msg-tab').forEach(t=>t.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>
`}) %>
