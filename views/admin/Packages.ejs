<%# views/admin/Packages.ejs — مدیریت پکیج‌ها
    ورودی‌ها از server.js: packages
    روت‌ها: POST /sw-admin/packages/save (افزودن/ویرایش) · /:id/toggle (JSON) · /:id/delete
    نکته: فیلد duration در مدل برای نام آیکون Bootstrap (bi-…) استفاده می‌شود و slug برای برچسب نمایشی؛ قیمت به «میلیون تومان» است. %>
<%
  const list = Array.isArray(packages) ? packages : [];
  const fa = (n) => Number(n || 0).toLocaleString('fa-IR');
  const iconOf = (p) => (typeof p.duration === 'string' && p.duration.indexOf('bi-') === 0) ? p.duration : 'bi-box-seam';

  // آمار مستقیم از خود پکیج‌ها محاسبه می‌شود (مدل سفارش جدا نداریم)
  const activeCount  = list.filter((p) => p.isActive).length;
  const totalSales   = list.reduce((s, p) => s + (Number(p.sales) || 0), 0);
  const totalViews   = list.reduce((s, p) => s + (Number(p.views) || 0), 0);
  const revenue      = list.reduce((s, p) => s + (Number(p.price) || 0) * (Number(p.sales) || 0), 0);
  const best         = list.reduce((m, p) => ((Number(p.sales) || 0) > (m ? Number(m.sales) || 0 : 0) ? p : m), null);

  const payload = (p) => JSON.stringify({
    id: String(p._id), name: p.name || '', slug: p.slug || '', price: p.price ?? '', icon: p.duration || '',
    description: p.description || '', features: (p.features || []).join('\n'),
    featured: !!p.isFeatured, sales: Number(p.sales) || 0, views: Number(p.views) || 0
  });
%>
<%- include('partials/_head', { title: 'مدیریت پکیج‌ها' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'packages' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'پکیج‌ها' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content" id="pkgPage" data-total="<%= list.length %>">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">مدیریت پکیج‌ها</h1>
          <p class="page-subtitle"><span id="subActive"><%= fa(activeCount) %></span> پکیج فعال از <%= fa(list.length) %> · نمایش در صفحهٔ «پکیج‌ها» وب‌سایت</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/#packages" class="btn-ghost-sm" target="_blank" rel="noopener"><i class="bi bi-eye"></i> مشاهده در سایت</a>
          <button type="button" class="btn-sol-sm" id="newPackageBtn" data-modal-open="packageModal"><i class="bi bi-plus-lg"></i> پکیج جدید</button>
        </div>
      </div>

      <!-- Stats -->
      <div class="sw-g c4 fade-up fade-up-2">
        <div class="pstat"><div class="pstat-icon"><i class="bi bi-box-seam-fill"></i></div><div><div class="pstat-val text-grad" id="statActive"><%= fa(activeCount) %></div><div class="pstat-lbl">پکیج فعال</div></div></div>
        <div class="pstat"><div class="pstat-icon ok"><i class="bi bi-cart-check-fill"></i></div><div><div class="pstat-val text-grad"><%= fa(totalSales) %></div><div class="pstat-lbl">مجموع فروش</div></div></div>
        <div class="pstat"><div class="pstat-icon warn"><i class="bi bi-star-fill"></i></div><div><div class="pstat-val money"><%= best ? best.name : '—' %></div><div class="pstat-lbl">پرفروش‌ترین</div></div></div>
        <div class="pstat"><div class="pstat-icon accent"><i class="bi bi-cash-stack"></i></div><div><div class="pstat-val money"><%= revenue ? fa(Math.round(revenue * 10) / 10) + ' م' : '—' %></div><div class="pstat-lbl">درآمد تخمینی (میلیون تومان)</div></div></div>
      </div>

      <!-- Packages -->
      <div class="pkg-admin-grid fade-up fade-up-3" id="pkgGrid">
        <% list.forEach(function (p, i) { %>
          <article class="pkg-admin-card <%= p.isFeatured ? 'featured' : '' %> <%= p.isActive ? '' : 'is-off' %>" style="--i:<%= Math.min(i, 8) %>" data-package="<%= payload(p) %>">
            <div class="pkg-admin-top">
              <span class="pkg-admin-badge <%= p.isFeatured ? 'featured' : '' %>"><%= p.isFeatured ? 'پرطرفدار ⭐' : (p.slug || 'پکیج') %></span>
              <label class="sw-toggle" title="فعال / غیرفعال">
                <input type="checkbox" data-pkg-toggle aria-label="فعال بودن پکیج <%= p.name %>" <%= p.isActive ? 'checked' : '' %>>
                <span class="sw-slider"></span>
              </label>
            </div>

            <div class="pkg-admin-icon <%= p.isFeatured ? 'featured' : '' %>"><i class="bi <%= iconOf(p) %>"></i></div>
            <h2 class="pkg-admin-name"><%= p.name %></h2>
            <div class="pkg-admin-price"><%= fa(p.price) %><small>میلیون تومان</small></div>
            <p class="pkg-admin-desc"><%= p.description || '' %></p>

            <ul class="pkg-admin-feat">
              <% (p.features || []).forEach(function (feat) { %><li><i class="bi bi-check-lg"></i> <%= feat %></li><% }); %>
            </ul>

            <div class="pkg-admin-stats">
              <span><i class="bi bi-cart-check"></i> <%= fa(p.sales) %> فروش</span>
              <span><i class="bi bi-eye"></i> <%= fa(p.views) %> بازدید</span>
            </div>

            <div class="pkg-admin-actions">
              <button type="button" class="btn-ghost-sm grow" data-modal-open="packageModal" data-pkg-edit><i class="bi bi-pencil"></i> ویرایش</button>
              <form action="/sw-admin/packages/<%= p._id %>/delete" method="POST" data-sw-confirm="پکیج «<%= p.name %>» حذف شود؟ این کار قابل بازگشت نیست.">
                <button type="submit" class="btn-danger-sm" title="حذف" aria-label="حذف پکیج <%= p.name %>"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </article>
        <% }); %>

        <% if (!list.length) { %>
          <div class="sw-empty pkg-empty"><i class="bi bi-box-seam"></i>هنوز هیچ پکیجی ثبت نشده است.</div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Modal: پکیج جدید / ویرایش -->
<div class="modal-overlay" id="packageModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title" id="packageModalTitle">افزودن پکیج جدید</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>

    <form action="/sw-admin/packages/save" method="POST" id="packageForm" data-validate novalidate>
      <input type="hidden" name="id" id="packageId">

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="packageName">نام پکیج</label>
          <input class="sol-input" name="name" id="packageName" type="text" placeholder="مثال: حرفه‌ای" data-rule="required" autocomplete="off">
        </div>
        <div class="sw-field">
          <label class="sol-label" for="packageSlug">برچسب نمایشی</label>
          <input class="sol-input" name="slug" id="packageSlug" type="text" placeholder="مثال: پرطرفدار" autocomplete="off">
        </div>
      </div>

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="packagePrice">قیمت (میلیون تومان)</label>
          <input class="sol-input" name="price" id="packagePrice" type="number" min="0" step="any" dir="ltr" placeholder="45" data-rule="required|num|min:0">
        </div>
        <div class="sw-field">
          <label class="sol-label" for="packageIcon">آیکون (Bootstrap Icons)</label>
          <div class="sw-inline">
            <div class="grow"><input class="sol-input" name="duration" id="packageIcon" type="text" dir="ltr" placeholder="bi-rocket-takeoff" autocomplete="off"></div>
            <span class="icon-preview" id="iconPreview"><i class="bi bi-box-seam"></i></span>
          </div>
        </div>
      </div>

      <div class="icon-picks" id="iconPicks" role="group" aria-label="انتخاب سریع آیکون">
        <% ['bi-rocket-takeoff', 'bi-box-seam', 'bi-lightning-charge', 'bi-gem', 'bi-building', 'bi-shop', 'bi-code-slash', 'bi-palette', 'bi-globe2', 'bi-shield-check'].forEach(function (ic) { %>
          <button type="button" class="icon-pick" data-icon="<%= ic %>" title="<%= ic %>" aria-label="<%= ic %>"><i class="bi <%= ic %>"></i></button>
        <% }); %>
      </div>

      <div class="sw-field">
        <label class="sol-label" for="packageDescription">توضیح کوتاه</label>
        <input class="sol-input" name="description" id="packageDescription" type="text" placeholder="توضیح یک‌خطی پکیج" autocomplete="off">
      </div>

      <div class="sw-field">
        <label class="sol-label" for="packageFeatures">ویژگی‌ها (هر خط یک ویژگی) <span class="feat-count" id="featCount">۰ مورد</span></label>
        <textarea class="sol-input" name="features" id="packageFeatures" rows="4" placeholder="کدنویسی اختصاصی&#10;صفحات نامحدود&#10;سئو پیشرفته"></textarea>
      </div>

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="packageSales">تعداد فروش</label>
          <input class="sol-input" name="sales" id="packageSales" type="number" min="0" dir="ltr" value="0" data-rule="num|min:0">
        </div>
        <div class="sw-field">
          <label class="sol-label" for="packageViews">تعداد بازدید</label>
          <input class="sol-input" name="views" id="packageViews" type="number" min="0" dir="ltr" value="0" data-rule="num|min:0">
        </div>
      </div>

      <div class="sw-field">
        <label class="sw-switch-row">
          <span class="sw-toggle"><input type="checkbox" name="isFeatured" id="packageIsFeatured"><span class="sw-slider"></span></span>
          <span>پکیج پرطرفدار (نمایش ویژه)</span>
        </label>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button type="submit" class="btn-sol-sm"><i class="bi bi-check-lg"></i> ذخیره پکیج</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return String(v == null ? '' : v).replace(/[0-9]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var form = $('#packageForm'), title = $('#packageModalTitle');
  var F = { id: $('#packageId'), name: $('#packageName'), slug: $('#packageSlug'), price: $('#packagePrice'), icon: $('#packageIcon'),
            desc: $('#packageDescription'), feats: $('#packageFeatures'), sales: $('#packageSales'), views: $('#packageViews'), featured: $('#packageIsFeatured') };

  /* ───────── آیکون: پیش‌نمایش زنده + انتخاب سریع ───────── */
  function syncIcon() {
    var v = (F.icon.value || '').trim(), ok = /^bi-[a-z0-9-]+$/.test(v);
    $('#iconPreview i').className = 'bi ' + (ok ? v : 'bi-box-seam');
    $$('.icon-pick').forEach(function (b) { b.classList.toggle('active', b.dataset.icon === v); });
  }
  F.icon.addEventListener('input', syncIcon);
  $('#iconPicks').addEventListener('click', function (e) {
    var b = e.target.closest('.icon-pick'); if (!b) return; F.icon.value = b.dataset.icon; syncIcon();
  });

  /* ───────── شمارندهٔ ویژگی‌ها ───────── */
  function syncFeats() { var n = F.feats.value.split('\n').filter(function (l) { return l.trim(); }).length; $('#featCount').textContent = fa(n) + ' مورد'; }
  F.feats.addEventListener('input', syncFeats);

  /* ───────── حالت ثبت / ویرایش ───────── */
  function clearErrors() {
    $$('.sw-err', form).forEach(function (n) { n.remove(); });
    $$('.is-invalid', form).forEach(function (n) { n.classList.remove('is-invalid'); n.removeAttribute('aria-invalid'); });
  }
  function setMode(d) {
    clearErrors();
    if (d) {
      title.textContent = 'ویرایش پکیج';
      F.id.value = d.id; F.name.value = d.name; F.slug.value = d.slug; F.price.value = d.price; F.icon.value = d.icon;
      F.desc.value = d.description; F.feats.value = d.features; F.sales.value = d.sales; F.views.value = d.views; F.featured.checked = !!d.featured;
    } else {
      title.textContent = 'افزودن پکیج جدید'; form.reset(); F.id.value = ''; F.sales.value = 0; F.views.value = 0;
    }
    syncIcon(); syncFeats();
  }
  $('#newPackageBtn').addEventListener('click', function () { setMode(null); });
  $('#pkgGrid').addEventListener('click', function (e) {
    var b = e.target.closest('[data-pkg-edit]'); if (!b) return;
    var card = b.closest('[data-package]'), d = null;
    try { d = JSON.parse(card.dataset.package); } catch (err) {}
    if (d) setMode(d);
  });

  /* ───────── فعال / غیرفعال با AJAX (خوش‌بینانه، با برگشت در خطا) ───────── */
  function recount() {
    var n = $$('.pkg-admin-card:not(.is-off)').length;
    $('#statActive').textContent = fa(n); $('#subActive').textContent = fa(n);
  }
  $('#pkgGrid').addEventListener('change', function (e) {
    var cb = e.target.closest('[data-pkg-toggle]'); if (!cb) return;
    var card = cb.closest('.pkg-admin-card'), d = JSON.parse(card.dataset.package), want = cb.checked;
    card.classList.toggle('is-off', !want); recount();
    fetch('/sw-admin/packages/' + d.id + '/toggle', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ isActive: want })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.success) throw new Error(j.message || 'خطا در تغییر وضعیت پکیج'); return j; });
    }).then(function () {
      toast(want ? 'پکیج در سایت نمایش داده می‌شود' : 'پکیج از سایت مخفی شد', { type: 'success', detail: d.name, ms: 2200 });
    }).catch(function (err) {
      cb.checked = !want; card.classList.toggle('is-off', want); recount();
      toast(err.message || 'خطای ارتباط با سرور', { type: 'error' });
    });
  });

  recount();
});
</script>

<%- include('partials/_scripts') %>
