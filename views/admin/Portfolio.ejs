<%- include('partials/_head', { title: 'پورتفولیو' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', {
  activePage: 'portfolio',
  adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' }
}) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'محتوا' }, { label: 'پورتفولیو' }],
  searchPlaceholder: 'جستجو در پورتفولیو…'
}) %>
<%
const publishedCount = items.filter(item => item.isPublished).length
const draftCount = items.filter(item => !item.isPublished).length
%>

<main class="page-content">

  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title">مدیریت پورتفولیو</h1>
<p class="page-subtitle">
  <%= publishedCount.toLocaleString('fa-IR') %> نمونه کار منتشر‌شده ·
  <%= draftCount.toLocaleString('fa-IR') %> پیش‌نویس
</p>
    </div>
<button 
  type="button"
  class="btn-sol-sm create-btn"
  data-modal-open="portfolioModal"
>
  <i class="bi bi-plus-lg"></i> نمونه کار جدید
</button>
  </div>

  <!-- Filter -->
<div class="filter-bar fade-up fade-up-2" data-filter-group style="display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.25rem;">

  <button class="filter-chip active" data-filter="all">همه</button>

  <% if (categories && categories.length) { %>
    <% categories.forEach(cat => { %>
      <button class="filter-chip" data-filter="<%= cat.slug %>">
        <%= cat.title %>
      </button>
    <% }) %>
  <% } %>

</div>


  <!-- Portfolio Grid -->
<div class="port-grid fade-up fade-up-3">

<%
const categoryMap = {
  web: 'طراحی وب',
  shop: 'فروشگاه',
  uiux: 'UI/UX',
  app: 'وب اپ'
}

const gradients = [
  'linear-gradient(135deg,#6447f4,#0090e8)',
  'linear-gradient(135deg,#0090e8,#4dc3ff)',
  'linear-gradient(135deg,#a394fb,#6447f4)',
  'linear-gradient(135deg,#1e1274,#4028b8)',
  'linear-gradient(135deg,#005896,#0090e8)',
  'linear-gradient(135deg,#4028b8,#836af8)'
]

const icons = [
  'bi-laptop',
  'bi-bag-heart',
  'bi-palette2',
  'bi-building',
  'bi-cart3',
  'bi-bar-chart-fill'
]
%>

<% items.forEach(function(item,index){ %>

<div class="port-card" data-category="<%= item.category && item.category.slug ? item.category.slug : item.category %>">

<div class="port-thumb">

  <% if(item.coverImage){ %>
    <img 
      src="<%= item.coverImage %>" 
      alt="<%= item.title %>" 
      class="port-thumb-img"
    >
  <% } else { %>
    <div 
      class="port-thumb-fallback" 
      style="background:<%= gradients[index % gradients.length] %>;"
    >
      <i 
        class="bi <%= icons[index % icons.length] %>" 
        style="font-size:3rem;color:rgba(255,255,255,.7);"
      ></i>
    </div>
  <% } %>

  <div class="port-thumb-overlay">
    <button 
      type="button"
      class="btn-ghost-sm edit-btn"
      data-modal-open="portfolioModal"
      data-id="<%= item._id %>"
      data-title="<%= item.title || '' %>"
      data-description="<%= item.description || '' %>"
      data-category="<%= item.category && item.category.slug ? item.category.slug : item.category %>"
      data-client="<%= item.client ? item.client._id : '' %>"
      data-tech="<%= item.techStack ? item.techStack.join(',') : '' %>"
      data-url="<%= item.liveUrl || '' %>"
    >
      <i class="bi bi-pencil"></i> ویرایش
    </button>
  </div>

  <% if(!item.isPublished){ %>
    <span class="port-draft-badge">پیش‌نویس</span>
  <% } %>

</div>


  <div class="port-body">

    <div class="port-cat">
      <%= categoryMap[item.category] || item.category %>
    </div>

    <div class="port-title">
      <%= item.title %>
    </div>

    <div class="port-meta">
      <span>
        <i class="bi bi-person" style="font-size:.75rem;"></i>
          <%= item.client ? item.client.name : '—' %>
      </span>

      <span>
        <i class="bi bi-code-slash" style="font-size:.75rem;"></i>
        <%= item.techStack ? item.techStack.join(' + ') : '' %>
      </span>
    </div>

    <div class="port-footer">

      <% if(item.isPublished){ %>

      <div style="display:flex;align-items:center;gap:.3rem;font-size:.73rem;color:var(--color-text-muted);">
        <i class="bi bi-eye"></i>
        <%= item.views ? item.views.toLocaleString('fa-IR') : '۰' %> بازدید
      </div>

      <span class="badge-status badge-done">منتشرشده</span>

      <% } else { %>

<span class="badge-status badge-new">پیش‌نویس</span>

<form action="/sw-admin/portfolio/<%= item._id %>/publish" method="POST">
  <button 
    class="btn-sol-sm"
    type="submit"
    style="padding:.28rem .75rem;font-size:.73rem;"
  >
    <i class="bi bi-send"></i> انتشار
  </button>
</form>

      <% } %>

    </div>

  </div>

</div>

<% }) %>

</div>


</main>
</div>
</div>

<!-- Modal: نمونه کار جدید/ویرایش -->
<form id="portfolioForm" action="/sw-admin/portfolio" method="POST" enctype="multipart/form-data">
  <div class="modal-overlay" id="portfolioModal">
    <div class="modal-box" style="width:min(560px,92vw);">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
        <div class="modal-title" style="margin:0;">نمونه کار جدید</div>
<button 
  type="button"
  data-modal-close 
  style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"
>
  <i class="bi bi-x-lg"></i>
</button>
      </div>
      <!-- Image Upload -->
      <div class="port-upload-area" id="uploadArea">
        <i class="bi bi-cloud-upload-fill" style="font-size:2rem;color:var(--main-400);"></i>
        <div style="font-size:.85rem;font-weight:600;margin-top:.5rem;">تصویر شاخص را اینجا بکشید</div>
        <div style="font-size:.73rem;color:var(--color-text-light);">یا کلیک کنید برای انتخاب (PNG, JPG)</div>
        <input type="file" accept="image/*" style="display:none;" id="imgUpload" name="coverImage">
      </div>
      <div class="form-row">
        <label class="sol-label">عنوان پروژه</label>
        <input class="sol-input" type="text" placeholder="مثال: وب‌سایت شرکتی آلفا" name="title" id="portTitle">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-row">
          <label class="sol-label">دسته‌بندی</label>
            <select class="sol-select" style="width:100%" name="category" id="portCategory">

              <option value="">انتخاب دسته</option>

              <% categories.forEach(cat => { %>
                <option value="<%= cat.slug %>">
                  <%= cat.title %>
                </option>
              <% }) %>

            </select>
        </div>
        <div class="form-row">
          <label class="sol-label">مشتری</label>
            <select class="sol-select" name="client" id="portClient">
              <option value="">بدون مشتری</option>
              <% clients.forEach(c => { %>
                <option value="<%= c._id %>"><%= c.name %></option>
              <% }) %>
            </select>

        </div>
      </div>
      <div class="form-row">
        <label class="sol-label">تکنولوژی‌های استفاده‌شده</label>
        <input class="sol-input" type="text" placeholder="مثال: PHP · Laravel · Bootstrap" name="techStack" id="portTech">
      </div>
      <div class="form-row">
        <label class="sol-label">لینک پروژه</label>
        <input class="sol-input" type="url" placeholder="https://…" name="liveUrl" id="portUrl">
      </div>
      <div class="form-row">
        <label class="sol-label">توضیحات</label>
        <textarea class="sol-input" rows="3" placeholder="توضیح کوتاهی از پروژه…" style="resize:vertical;" name="description" id="portDesc"></textarea>
      </div>
<div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
  <button class="btn-ghost-sm" type="button" data-modal-close>انصراف</button>
  <button class="btn-ghost-sm" type="submit" name="publish" value="0">
    <i class="bi bi-file-earmark"></i> پیش‌نویس
  </button>
  <button class="btn-sol-sm" type="submit" name="publish" value="1">
    <i class="bi bi-send"></i> انتشار
  </button>
</div>

    </div>
  </div>
</form>
<%- include('partials/_scripts', { extraScripts: `
<style>

  .port-thumb{
  height:180px;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  overflow:hidden;
  background:var(--color-bg);
}

.port-thumb-img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform var(--dur-normal) var(--ease-spring);
}

.port-card:hover .port-thumb-img{
  transform:scale(1.06);
}

.port-thumb-fallback{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
}

.filter-chip{display:inline-flex;align-items:center;gap:.35rem;font-family:var(--font-primary);font-size:.78rem;font-weight:600;padding:.38rem .9rem;border-radius:var(--radius-full);border:1.5px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);cursor:pointer;transition:all var(--dur-fast);}
.filter-chip:hover,.filter-chip.active{background:var(--main-500);border-color:var(--main-500);color:#fff;}
.port-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;}
.port-card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);overflow:hidden;transition:all var(--dur-normal) var(--ease-spring);}
.port-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--main-200);}
.port-thumb{height:180px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.port-thumb-overlay{position:absolute;inset:0;background:rgba(30,18,116,.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity var(--dur-normal);}
.port-card:hover .port-thumb-overlay{opacity:1;}
.port-draft-badge{position:absolute;top:.75rem;right:.75rem;background:rgba(0,0,0,.6);color:#fff;font-size:.67rem;font-weight:700;padding:.2rem .6rem;border-radius:99px;backdrop-filter:blur(4px);}
.port-body{padding:1.1rem;}
.port-cat{font-size:.7rem;font-weight:700;color:var(--main-500);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem;}
.port-title{font-size:.88rem;font-weight:700;margin-bottom:.5rem;line-height:1.4;}
.port-meta{display:flex;gap:.85rem;flex-wrap:wrap;margin-bottom:.75rem;}
.port-meta span{font-size:.73rem;color:var(--color-text-muted);display:flex;align-items:center;gap:.25rem;}
.port-footer{display:flex;align-items:center;justify-content:space-between;gap:.5rem;}
.port-upload-area{border:2px dashed var(--main-200);border-radius:var(--radius-lg);padding:2rem;text-align:center;cursor:pointer;transition:all var(--dur-fast);margin-bottom:1rem;background:var(--main-50);}
.port-upload-area:hover{border-color:var(--main-400);background:rgba(100,71,244,.08);}
[data-bs-theme="dark"] .port-upload-area{background:rgba(100,71,244,.08);}
</style>
<script>
document.getElementById('uploadArea').addEventListener('click', function(){
  document.getElementById('imgUpload').click();
});

(function(){

  const filterGroup = document.querySelector('[data-filter-group]')
  if(!filterGroup) return

  const buttons = filterGroup.querySelectorAll('.filter-chip')
  const cards   = document.querySelectorAll('.port-card')

  filterGroup.addEventListener('click', function(e){

    const btn = e.target.closest('.filter-chip')
    if(!btn) return

    buttons.forEach(b => b.classList.remove('active'))
    btn.classList.add('active')

    const selectedCat = btn.dataset.filter

    cards.forEach(card => {
      const cardCat = card.dataset.category

      if(selectedCat === 'all' || cardCat === selectedCat){
        card.style.display = ''
      } else {
        card.style.display = 'none'
      }
    })

  })

})();

const portfolioForm = document.getElementById('portfolioForm')
const modalTitle = document.querySelector('#portfolioModal .modal-title')

const portTitle = document.getElementById('portTitle')
const portDesc = document.getElementById('portDesc')
const portCategory = document.getElementById('portCategory')
const portClient = document.getElementById('portClient')
const portTech = document.getElementById('portTech')
const portUrl = document.getElementById('portUrl')
const imgUpload = document.getElementById('imgUpload')

// حالت ساخت نمونه‌کار جدید
document.querySelectorAll('.create-btn').forEach(btn => {
  btn.addEventListener('click', function(){

    portfolioForm.action = '/sw-admin/portfolio'

    if(modalTitle) modalTitle.textContent = 'نمونه کار جدید'

    portTitle.value = ''
    portDesc.value = ''
    portCategory.value = ''
    portClient.value = ''
    portTech.value = ''
    portUrl.value = ''

    if(imgUpload) imgUpload.value = ''

  })
})

// حالت ویرایش
document.querySelectorAll('.edit-btn').forEach(btn => {

  btn.addEventListener('click', function(){

    const id = this.dataset.id

portfolioForm.action = '/sw-admin/portfolio/' + id + '/update'

    if(modalTitle) modalTitle.textContent = 'ویرایش نمونه کار'

    portTitle.value = this.dataset.title || ''
    portDesc.value = this.dataset.description || ''
    portCategory.value = this.dataset.category || ''
    portClient.value = this.dataset.client || ''
    portTech.value = this.dataset.tech || ''
    portUrl.value = this.dataset.url || ''

    if(imgUpload) imgUpload.value = ''

  })

})
</script>
`}) %>