              <button class="view-btn"><i class="bi bi-chevron-left"></i></button>
            </div>
          </div>
        </div>
      </div><!-- /tableView -->

    </main>
  </div>
</div>

<!-- New Project Modal -->
<div class="modal-overlay" id="projectModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">پروژه جدید</div>
      <button id="closeModal" style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="form-row">
      <label class="sol-label">نام پروژه</label>
      <input class="sol-input" type="text" placeholder="مثال: وب‌سایت شرکت آلفا">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">مشتری</label>
        <select class="sol-select">
          <option>انتخاب مشتری…</option><option>کیانی لباس</option><option>گروه پارسیان</option><option>آفیلیو</option>
        </select>
      </div>
      <div class="form-row">
        <label class="sol-label">نوع پروژه</label>
        <select class="sol-select">
          <option>طراحی وب</option><option>فروشگاه</option><option>UI/UX</option><option>وب اپ</option>
        </select>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">تاریخ شروع</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۳/۲۱">
      </div>
      <div class="form-row">
        <label class="sol-label">ددلاین</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۴/۱۵">
      </div>
    </div>
    <div class="form-row">
      <label class="sol-label">تکنولوژی</label>
      <input class="sol-input" type="text" placeholder="مثال: PHP · Laravel · React">
    </div>
    <div class="form-row">
      <label class="sol-label">توضیحات</label>
      <textarea class="sol-input" rows="3" placeholder="توضیح مختصر پروژه…" style="resize:vertical;"></textarea>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" id="cancelModal">انصراف</button>
      <button class="btn-sol-sm"><i class="bi bi-check-lg"></i> ثبت پروژه</button>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  const html=document.documentElement,themeBtn=document.getElementById('themeToggle'),TKEY='sol-admin-theme';
  applyTheme(localStorage.getItem(TKEY)||'light');
  themeBtn.addEventListener('click',function(){const n=html.getAttribute('data-bs-theme')==='dark'?'light':'dark';applyTheme(n);localStorage.setItem(TKEY,n);});
  function applyTheme(t){html.setAttribute('data-bs-theme',t);themeBtn.innerHTML=t==='dark'?'<i class="bi bi-sun-fill"></i>':'<i class="bi bi-moon-stars-fill"></i>';}
  const sidebar=document.getElementById('sidebar'),mainContent=document.getElementById('mainContent'),toggleBtn=document.getElementById('sidebarToggle'),overlay=document.getElementById('sidebarOverlay');
  let isMini=false,isMobile=window.innerWidth<=768;
  toggleBtn.addEventListener('click',function(){if(isMobile){sidebar.classList.toggle('mobile-open');overlay.classList.toggle('show');}else{isMini=!isMini;sidebar.classList.toggle('mini',isMini);mainContent.classList.toggle('mini',isMini);}});
  overlay.addEventListener('click',function(){sidebar.classList.remove('mobile-open');overlay.classList.remove('show');});
  window.addEventListener('resize',function(){isMobile=window.innerWidth<=768;if(!isMobile){sidebar.classList.remove('mobile-open');overlay.classList.remove('show');}});
  document.querySelectorAll('.nav-item-sol').forEach(function(item){item.addEventListener('click',function(e){if(item.getAttribute('href')==='#')e.preventDefault();document.querySelectorAll('.nav-item-sol').forEach(function(i){i.classList.remove('active');});item.classList.add('active');});});
  const fsBtn=document.getElementById('fullscreenBtn');
  if(fsBtn){fsBtn.addEventListener('click',function(){if(!document.fullscreenElement){document.documentElement.requestFullscreen().catch(function(){});fsBtn.innerHTML='<i class="bi bi-fullscreen-exit"></i>';}else{document.exitFullscreen();fsBtn.innerHTML='<i class="bi bi-fullscreen"></i>';}});}
  /* View toggle */
  const kanbanView=document.getElementById('kanbanView'),tableView=document.getElementById('tableView');
  document.getElementById('viewKanban').addEventListener('click',function(){kanbanView.style.display='';tableView.style.display='none';this.classList.add('active');document.getElementById('viewTable').classList.remove('active');});
  document.getElementById('viewTable').addEventListener('click',function(){tableView.style.display='';kanbanView.style.display='none';this.classList.add('active');document.getElementById('viewKanban').classList.remove('active');});
  /* Filter chips */
  document.querySelectorAll('.filter-chip').forEach(function(chip){chip.addEventListener('click',function(){document.querySelectorAll('.filter-chip').forEach(function(c){c.classList.remove('active');});chip.classList.add('active');});});
  /* Modal */
  const modal=document.getElementById('projectModal');
  document.getElementById('newProjectBtn').addEventListener('click',function(){modal.classList.add('open');});
  document.getElementById('closeModal').addEventListener('click',function(){modal.classList.remove('open');});
  document.getElementById('cancelModal').addEventListener('click',function(){modal.classList.remove('open');});
  modal.addEventListener('click',function(e){if(e.target===modal)modal.classList.remove('open');});
})();
</script>
</body>
</html>