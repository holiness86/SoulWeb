                  <td>کیانی لباس</td><td>فروشگاه</td>
                  <td><span class="badge-status badge-inprog">در انجام</span></td>
                  <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:68%"></div></div><span style="font-size:.73rem;color:var(--color-text-muted);">۶۸٪</span></div></td>
                  <td style="font-size:.78rem;">۱۵ خرداد</td><td><div style="display:flex;gap:.4rem;"><button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-eye"></i></button><button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-pencil"></i></button><button class="btn-danger-sm" style="padding:.28rem .6rem;"><i class="bi bi-trash"></i></button></div></td>
                </tr>
                <tr>
                  <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۲</span></td>
                  <td><div style="font-weight:600;font-size:.85rem;">پورتال سازمانی پارسیان</div><div style="font-size:.73rem;color:var(--color-text-muted);">Laravel</div></td>
                  <td>گروه پارسیان</td><td>وب اپ</td>
                  <td><span class="badge-status badge-inprog">در انجام</span></td>
                  <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:42%"></div></div><span style="font-size:.73rem;color:#dc2626;font-weight:700;">۴۲٪</span></div></td>
                  <td style="font-size:.78rem;color:#dc2626;font-weight:700;">⚠️ فردا!</td>
                  <td><div style="display:flex;gap:.4rem;"><button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-eye"></i></button><button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-pencil"></i></button><button class="btn-danger-sm" style="padding:.28rem .6rem;"><i class="bi bi-trash"></i></button></div></td>
                </tr>
                <tr>
                  <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۳</span></td>
