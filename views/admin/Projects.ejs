<%# views/admin/Projects.ejs — مدیریت پروژه‌ها (کانبان + جدول)
    ورودی‌ها از server.js: projects, clients, serviceCategories
    روت‌ها: POST /sw-admin/projects/add · /:id/update · /:id/delete · /:id/status (JSON، برای درگ‌اند‌دراپ) · GET /export %>
<%
  const safeProjects   = Array.isArray(projects) ? projects : [];
  const safeClients    = typeof clients !== 'undefined' && Array.isArray(clients) ? clients : [];
  const safeCategories = typeof serviceCategories !== 'undefined' && Array.isArray(serviceCategories) ? serviceCategories : [];

  const fa = (n) => String(n ?? 0).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]);

  // وضعیت‌ها (کلیدها باید با enum مدل Project یکی باشند)
  const statusMap = {
    active   : { title: 'در حال انجام', badge: 'badge-inprog', dot: '#6447f4' },
    review   : { title: 'در ریویو',     badge: 'badge-review', dot: '#f59e0b' },
    done     : { title: 'تحویل‌شده',    badge: 'badge-done',   dot: '#22c55e' },
    hold     : { title: 'متوقف',        badge: 'badge-hold',   dot: '#9899bc' },
    cancelled: { title: 'لغوشده',       badge: 'badge-hold',   dot: '#dc2626' }
  };
  const columns = Object.keys(statusMap);

  const defaultTechOptions = [
    'PHP', 'Laravel', 'وردپرس', 'React', 'Vue.js', 'Next.js', 'Node.js', 'Angular',
    'TypeScript', 'Tailwind CSS', 'Bootstrap', 'MySQL', 'MongoDB', 'jQuery'
  ];

  const counts = { all: safeProjects.length };
  columns.forEach((k) => { counts[k] = safeProjects.filter((p) => p.status === k).length; });

  const clientName   = (p) => !p.client ? 'بدون مشتری' : (typeof p.client === 'string' ? p.client : (p.client.company || p.client.name || 'بدون مشتری'));
  const categoryName = (p) => !p.category ? 'بدون نوع' : (typeof p.category === 'string' ? p.category : (p.category.title || 'بدون نوع'));
  const techArray    = (p) => Array.isArray(p.techStack) ? p.techStack : [];
  const clientId     = (p) => !p.client ? '' : (typeof p.client === 'object' ? (p.client._id || '') : p.client);
  const categoryId   = (p) => !p.category ? '' : (typeof p.category === 'object' ? (p.category._id || '') : p.category);
  const progressOf   = (p) => Math.max(0, Math.min(100, Number(p.progress || 0)));
  const initialsOf   = (p) => { const n = clientName(p).trim(); return n === 'بدون مشتری' ? '؟' : n.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('‌'); };

  const dueText = (p) => {
    if (!p.deadline) return 'نامشخص';
    const d = new Date(p.deadline);
    return Number.isNaN(d.getTime()) ? 'نامشخص' : d.toLocaleDateString('fa-IR', { day: 'numeric', month: 'long' });
  };
  const isNear = (p) => {
    if (!p.deadline || p.status === 'done' || p.status === 'cancelled') return false;
    const d = new Date(p.deadline);
    return !Number.isNaN(d.getTime()) && Math.ceil((d - new Date()) / 86400000) <= 1;
  };
  const jalaliInput = (date) => {
    if (!date) return '';
    const d = new Date(date);
    if (Number.isNaN(d.getTime())) return '';
    const m = {};
    new Intl.DateTimeFormat('fa-IR-u-nu-latn', { year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(d).forEach((x) => { m[x.type] = x.value; });
    return m.year + '/' + m.month + '/' + m.day;
  };

  const payload = (p) => JSON.stringify({
    id: p._id || '', title: p.title || '', client: clientId(p), clientName: clientName(p),
    category: categoryId(p), categoryTitle: categoryName(p), status: p.status || 'active',
    progress: progressOf(p), startDate: jalaliInput(p.startDate), deadline: jalaliInput(p.deadline),
    tech: techArray(p), description: p.description || ''
  });
  const searchText = (p) => [p.title, clientName(p), categoryName(p), techArray(p).join(' ')].join(' ');
  const attrs = (p) => ({
    id: p._id, status: p.status, title: p.title || '', progress: progressOf(p),
    deadline: p.deadline ? new Date(p.deadline).getTime() : 0,
    created : p.createdAt ? new Date(p.createdAt).getTime() : 0
  });
%>
<%- include('partials/_head', { title: 'مدیریت پروژه‌ها' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'projects' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'پروژه‌ها' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content" id="projectsPage" data-status-map="<%= JSON.stringify(statusMap) %>">

      <!-- Page Header -->
      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">مدیریت پروژه‌ها</h1>
          <p class="page-subtitle">
            <span data-stat="active"><%= fa(counts.active) %></span> پروژه فعال ·
            <span data-stat="review"><%= fa(counts.review) %></span> در انتظار بررسی ·
            <span data-stat="hold"><%= fa(counts.hold) %></span> متوقف
          </p>
        </div>
        <div class="d-flex gap-2">
          <a href="/sw-admin/projects/export" class="btn-ghost-sm"><i class="bi bi-download"></i> خروجی Excel</a>
          <button type="button" class="btn-sol-sm" id="newProjectBtn" data-modal-open="projectModal"><i class="bi bi-plus-lg"></i> پروژه جدید</button>
        </div>
      </div>

      <!-- Stats -->
      <div class="sw-g c4 fade-up fade-up-2">
        <div class="pstat"><div class="pstat-icon"><i class="bi bi-kanban-fill"></i></div><div><div class="pstat-val text-grad" data-stat="active"><%= fa(counts.active) %></div><div class="pstat-lbl">پروژه فعال</div></div></div>
        <div class="pstat"><div class="pstat-icon ok"><i class="bi bi-check-circle-fill"></i></div><div><div class="pstat-val text-grad" data-stat="done"><%= fa(counts.done) %></div><div class="pstat-lbl">تحویل‌داده‌شده</div></div></div>
        <div class="pstat"><div class="pstat-icon warn"><i class="bi bi-clock-history"></i></div><div><div class="pstat-val text-grad" data-stat="review"><%= fa(counts.review) %></div><div class="pstat-lbl">در انتظار ریویو</div></div></div>
        <div class="pstat"><div class="pstat-icon danger"><i class="bi bi-pause-circle-fill"></i></div><div><div class="pstat-val text-grad" data-stat="hold"><%= fa(counts.hold) %></div><div class="pstat-lbl">متوقف‌شده</div></div></div>
      </div>

      <!-- Filter / Search / Sort / View -->
      <div class="filter-bar fade-up fade-up-2" role="toolbar" aria-label="فیلتر پروژه‌ها">
        <button type="button" class="filter-chip active" data-filter="all">همه <span class="filter-count"><%= fa(counts.all) %></span></button>
        <% columns.forEach(function (key) { %>
          <button type="button" class="filter-chip" data-filter="<%= key %>">
            <span class="dot" style="background:<%= statusMap[key].dot %>;"></span><%= statusMap[key].title %>
            <span class="filter-count"><%= fa(counts[key]) %></span>
          </button>
        <% }); %>

        <div class="tools">
          <label class="sw-search" aria-label="جستجو در پروژه‌ها">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="projectSearch" placeholder="نام پروژه، مشتری، تکنولوژی…" autocomplete="off">
          </label>
          <select class="sol-select" id="projectSort" aria-label="مرتب‌سازی">
            <option value="newest">مرتب: جدیدترین</option>
            <option value="deadline">مرتب: ددلاین</option>
            <option value="progress">مرتب: پیشرفت</option>
            <option value="title">مرتب: نام پروژه</option>
          </select>
          <div class="view-switch" role="group" aria-label="نوع نمایش">
            <button type="button" class="view-btn active" id="viewKanban" title="کانبان" aria-label="نمایش کانبان" aria-pressed="true"><i class="bi bi-grid-3x3-gap"></i></button>
            <button type="button" class="view-btn" id="viewTable" title="جدول" aria-label="نمایش جدول" aria-pressed="false"><i class="bi bi-list-ul"></i></button>
          </div>
        </div>
      </div>

      <!-- Kanban -->
      <div id="kanbanView">
        <div class="kanban-board fade-up fade-up-3">
          <% columns.forEach(function (key) { %>
            <% const colProjects = safeProjects.filter((p) => p.status === key); %>
            <section class="kanban-col" data-status-col="<%= key %>" aria-label="<%= statusMap[key].title %>">
              <div class="kanban-head">
                <div class="kanban-head-title"><span class="kanban-dot" style="background:<%= statusMap[key].dot %>;"></span><%= statusMap[key].title %></div>
                <span class="kanban-count"><%= fa(colProjects.length) %></span>
              </div>
              <div class="kanban-cards">
                <div class="kanban-empty">پروژه‌ای وجود ندارد</div>
                <% colProjects.forEach(function (p) { const a = attrs(p), near = isNear(p); %>
                  <article class="kcard <%= p.status === 'done' ? 'is-done' : '' %>" tabindex="0"
                           data-id="<%= a.id %>" data-status="<%= a.status %>" data-title="<%= a.title %>"
                           data-progress="<%= a.progress %>" data-deadline="<%= a.deadline %>" data-created="<%= a.created %>"
                           data-q="<%= searchText(p) %>" data-project="<%= payload(p) %>">
                    <div class="kcard-top">
                      <span class="kcard-cat"><i class="bi bi-folder"></i> <%= categoryName(p) %></span>
                      <div class="kcard-actions">
                        <button type="button" class="kcard-action-btn" title="مشاهده" aria-label="مشاهده" data-modal-open="projectViewModal" data-project-view><i class="bi bi-eye"></i></button>
                        <button type="button" class="kcard-action-btn" title="ویرایش" aria-label="ویرایش" data-modal-open="projectModal" data-project-edit><i class="bi bi-pencil"></i></button>
                      </div>
                    </div>
                    <h3 class="kcard-title"><%= p.title || 'بدون عنوان' %></h3>
                    <div class="kcard-prog"><div class="kcard-prog-fill" style="width:<%= a.progress %>%;"></div></div>
                    <div class="kcard-meta">
                      <span class="badge-status <%= statusMap[p.status] ? statusMap[p.status].badge : 'badge-new' %>"><%= statusMap[p.status] ? statusMap[p.status].title : 'نامشخص' %></span>
                      <span class="kcard-due <%= near ? 'danger' : '' %>"><i class="bi <%= near ? 'bi-exclamation-triangle' : 'bi-calendar3' %>"></i> <%= dueText(p) %></span>
                    </div>
                    <div class="kcard-foot">
                      <span class="kcard-client"><span class="kcard-av"><%= initialsOf(p) %></span><%= clientName(p) %></span>
                      <span class="kcard-tech"><%= techArray(p).slice(0, 3).join(' · ') %> <%= techArray(p).length ? '·' : '' %> <%= fa(a.progress) %>٪</span>
                    </div>
                  </article>
                <% }); %>
              </div>
            </section>
          <% }); %>
        </div>
      </div>

      <!-- Table -->
      <div id="tableView" hidden>
        <div class="dash-panel fade-up fade-up-3">
          <div class="sw-tw">
            <table class="sol-table">
              <thead>
                <tr><th>#</th><th>نام پروژه</th><th>مشتری</th><th>نوع</th><th>وضعیت</th><th>پیشرفت</th><th>ددلاین</th><th>عملیات</th></tr>
              </thead>
              <tbody>
                <% safeProjects.forEach(function (p, i) { const a = attrs(p), near = isNear(p); %>
                  <tr data-id="<%= a.id %>" data-status="<%= a.status %>" data-title="<%= a.title %>"
                      data-progress="<%= a.progress %>" data-deadline="<%= a.deadline %>" data-created="<%= a.created %>"
                      data-q="<%= searchText(p) %>" data-project="<%= payload(p) %>">
                    <td class="cell-sub">#<%= fa(i + 1) %></td>
                    <td>
                      <div class="cell-title"><%= p.title || 'بدون عنوان' %></div>
                      <div class="cell-sub" dir="ltr" style="text-align:right;"><%= techArray(p).join(' · ') || 'بدون تکنولوژی' %></div>
                    </td>
                    <td><%= clientName(p) %></td>
                    <td><%= categoryName(p) %></td>
                    <td><span class="badge-status <%= statusMap[p.status] ? statusMap[p.status].badge : 'badge-new' %>"><%= statusMap[p.status] ? statusMap[p.status].title : 'نامشخص' %></span></td>
                    <td>
                      <div class="prog-wrap">
                        <div class="prog-bar-mini"><div class="prog-fill" style="width:<%= a.progress %>%;"></div></div>
                        <span class="<%= near ? 'urgent' : '' %>"><%= fa(a.progress) %>٪</span>
                      </div>
                    </td>
                    <td class="<%= near ? 'urgent' : 'cell-sub' %>"><%= near ? '⚠️ ' : '' %><%= dueText(p) %></td>
                    <td>
                      <div class="row-actions">
                        <button type="button" class="btn-icon" title="مشاهده" aria-label="مشاهده" data-modal-open="projectViewModal" data-project-view><i class="bi bi-eye"></i></button>
                        <button type="button" class="btn-icon" title="ویرایش" aria-label="ویرایش" data-modal-open="projectModal" data-project-edit><i class="bi bi-pencil"></i></button>
                        <form action="/sw-admin/projects/<%= p._id %>/delete" method="POST" data-sw-confirm="آیا از حذف پروژه «<%= p.title || 'بدون عنوان' %>» مطمئن هستید؟ این کار قابل بازگشت نیست.">
                          <button type="submit" class="btn-icon danger" title="حذف" aria-label="حذف"><i class="bi bi-trash"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
                <tr id="tableEmpty" <%= safeProjects.length ? 'hidden' : '' %>>
                  <td colspan="8"><div class="sw-empty"><i class="bi bi-kanban"></i>هیچ پروژه‌ای پیدا نشد.</div></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Modal: پروژه جدید / ویرایش -->
<div class="modal-overlay" id="projectModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title" id="projectModalTitle">پروژه جدید</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>

    <form action="/sw-admin/projects/add" method="POST" id="projectForm" data-validate novalidate>

      <div class="sw-field">
        <label class="sol-label" for="projectTitleInput">نام پروژه</label>
        <input class="sol-input" type="text" name="title" id="projectTitleInput" placeholder="مثال: وب‌سایت شرکت آلفا" data-rule="required" autocomplete="off">
      </div>

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="projectClientSelect">مشتری</label>
          <select class="sol-select" name="client" id="projectClientSelect" data-rule="required">
            <option value="" selected disabled>انتخاب مشتری…</option>
            <% safeClients.forEach(function (c) { %><option value="<%= c._id %>"><%= c.name || 'مشتری بدون نام' %></option><% }); %>
          </select>
        </div>

        <div class="sw-field">
          <label class="sol-label" for="projectCategorySelect">نوع پروژه</label>
          <div class="sw-inline">
            <div class="grow">
              <select class="sol-select" name="category" id="projectCategorySelect" data-rule="required">
                <option value="" selected disabled>انتخاب نوع پروژه…</option>
                <% safeCategories.forEach(function (cat) { %><option value="<%= cat._id %>"><%= cat.title || cat.name || 'دسته‌بندی بدون عنوان' %></option><% }); %>
              </select>
            </div>
            <button type="button" class="btn-ghost-sm" id="addCategoryBtn" title="افزودن نوع جدید" aria-label="افزودن نوع پروژه جدید" aria-expanded="false"><i class="bi bi-plus-lg"></i></button>
          </div>
          <div class="sw-inline" id="addCategoryBox" hidden style="margin-top:.6rem;">
            <div class="grow"><input type="text" class="sol-input" id="newCategoryInput" placeholder="عنوان نوع پروژه جدید…" aria-label="عنوان نوع پروژه جدید"></div>
            <button type="button" class="btn-sol-sm" id="confirmAddCategory">افزودن</button>
          </div>
        </div>
      </div>

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="projectStartDate">تاریخ شروع</label>
          <input class="sol-input" type="text" name="startDate" id="projectStartDate" placeholder="۱۴۰۵/۰۱/۱۵" autocomplete="off" data-jdp data-jdp-only-date>
        </div>
        <div class="sw-field">
          <label class="sol-label" for="projectDeadline">ددلاین</label>
          <input class="sol-input" type="text" name="deadline" id="projectDeadline" placeholder="۱۴۰۵/۰۲/۱۵" autocomplete="off" data-jdp data-jdp-only-date>
        </div>
      </div>

      <!-- وضعیت فقط در حالت ویرایش؛ پروژه‌ی جدید همیشه «در حال انجام» ثبت می‌شود -->
      <div class="sw-field" id="statusField" hidden>
        <label class="sol-label" for="projectStatusSelect">وضعیت پروژه</label>
        <select class="sol-select" name="status" id="projectStatusSelect">
          <% columns.forEach(function (key) { %><option value="<%= key %>"><%= statusMap[key].title %></option><% }); %>
        </select>
      </div>

      <div class="sw-field">
        <span class="sol-label">تکنولوژی‌ها</span>
        <div class="tech-checklist" id="techChecklist">
          <% defaultTechOptions.forEach(function (tech) { %>
            <label class="tech-check-item"><input type="checkbox" name="techStack[]" value="<%= tech %>"><span><%= tech %></span></label>
          <% }); %>
        </div>
        <div class="sw-inline" style="margin-top:.65rem;">
          <div class="grow"><input type="text" class="sol-input" id="newTechInput" placeholder="افزودن تکنولوژی جدید…" aria-label="تکنولوژی جدید"></div>
          <button type="button" class="btn-ghost-sm" id="addTechBtn"><i class="bi bi-plus-lg"></i> افزودن</button>
        </div>
      </div>

      <div class="sw-field">
        <label class="sol-label" for="projectProgressInput">پیشرفت پروژه</label>
        <div class="sw-range-row">
          <input class="sw-range" type="range" name="progress" id="projectProgressInput" min="0" max="100" step="1" value="0">
          <output class="sw-range-out" id="projectProgressOut" for="projectProgressInput">۰٪</output>
        </div>
      </div>

      <div class="sw-field">
        <label class="sol-label" for="projectDescriptionInput">توضیحات</label>
        <textarea class="sol-input" name="description" id="projectDescriptionInput" rows="3" placeholder="توضیح مختصر پروژه…"></textarea>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button type="submit" class="btn-sol-sm" id="projectSubmitBtn"><i class="bi bi-check-lg"></i> ثبت پروژه</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: مشاهده جزئیات -->
<div class="modal-overlay" id="projectViewModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title" id="projectViewTitle">جزئیات پروژه</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="view-info-grid">
      <div class="view-info-box"><span class="view-info-lbl"><i class="bi bi-person"></i> مشتری</span><span class="view-info-val" id="projectViewClient">—</span></div>
      <div class="view-info-box"><span class="view-info-lbl"><i class="bi bi-folder"></i> نوع پروژه</span><span class="view-info-val" id="projectViewCategory">—</span></div>
      <div class="view-info-box"><span class="view-info-lbl"><i class="bi bi-calendar-event"></i> تاریخ شروع</span><span class="view-info-val" id="projectViewStart">—</span></div>
      <div class="view-info-box"><span class="view-info-lbl"><i class="bi bi-calendar-x"></i> ددلاین</span><span class="view-info-val" id="projectViewDeadline">—</span></div>
    </div>

    <div class="view-block">
      <span class="view-info-lbl"><i class="bi bi-cpu"></i> تکنولوژی‌ها</span>
      <div class="view-tech" id="projectViewTech"></div>
    </div>
    <div class="view-block">
      <span class="view-info-lbl"><i class="bi bi-card-text"></i> توضیحات</span>
      <p class="view-desc" id="projectViewDescription">توضیحی ثبت نشده است.</p>
    </div>

    <div class="modal-foot">
      <button type="button" class="btn-ghost-sm" data-modal-close>بستن</button>
      <button type="button" class="btn-sol-sm" id="projectViewEditBtn"><i class="bi bi-pencil"></i> ویرایش پروژه</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var page = document.getElementById('projectsPage');
  var STATUS = JSON.parse(page.dataset.statusMap || '{}');

  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return String(v == null ? '' : v).replace(/[0-9]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }
  function norm(s) { return String(s || '').replace(/ي/g, 'ی').replace(/ك/g, 'ک').toLowerCase(); }
  function toast(msg, o) { if (window.SW) SW.island(msg, o); }

  var state = { filter: 'all', q: '', sort: 'newest' };
  var kanbanView = $('#kanbanView'), tableView = $('#tableView');
  var viewKanban = $('#viewKanban'), viewTable = $('#viewTable');

  /* ───────── نمایش: کانبان / جدول (ماندگار) ───────── */
  function setView(v) {
    var k = v !== 'table';
    kanbanView.hidden = !k; tableView.hidden = k;
    viewKanban.classList.toggle('active', k); viewTable.classList.toggle('active', !k);
    viewKanban.setAttribute('aria-pressed', String(k)); viewTable.setAttribute('aria-pressed', String(!k));
    try { localStorage.setItem('sw-projects-view', v); } catch (e) {}
  }
  viewKanban.addEventListener('click', function () { setView('kanban'); });
  viewTable.addEventListener('click', function () { setView('table'); });
  try { setView(localStorage.getItem('sw-projects-view') || 'kanban'); } catch (e) { setView('kanban'); }

  /* ───────── فیلتر + جستجو + مرتب‌سازی (بدون ریلود) ───────── */
  function items() { return $$('.kanban-board .kcard').concat($$('#tableView tbody tr[data-id]')); }

  function apply() {
    var qn = norm(state.q), shownRows = 0;
    items().forEach(function (el) {
      var ok = (state.filter === 'all' || el.dataset.status === state.filter) && (!qn || norm(el.dataset.q).indexOf(qn) > -1);
      el.hidden = !ok;
      if (ok && el.tagName === 'TR') shownRows++;
    });
    $$('.kanban-col').forEach(function (col) { col.hidden = state.filter !== 'all' && col.dataset.statusCol !== state.filter; });
    $('#tableEmpty').hidden = shownRows > 0;
  }

  function sortVal(el, t) {
    if (t === 'progress') return Number(el.dataset.progress || 0);
    if (t === 'deadline') return Number(el.dataset.deadline || 0) || 9e15;   // بدون ددلاین = آخر
    return Number(el.dataset.created || 0);
  }
  function sortIn(container, selector) {
    var t = state.sort;
    var list = $$(selector, container).sort(function (a, b) {
      if (t === 'title') return String(a.dataset.title).localeCompare(String(b.dataset.title), 'fa');
      return t === 'deadline' ? sortVal(a, t) - sortVal(b, t) : sortVal(b, t) - sortVal(a, t);
    });
    list.forEach(function (el) { container.appendChild(el); });
  }
  function applySort() {
    $$('.kanban-cards').forEach(function (c) { sortIn(c, '.kcard'); });
    sortIn($('#tableView tbody'), 'tr[data-id]');
    var empty = $('#tableEmpty'); empty.parentNode.appendChild(empty);
  }

  $$('.filter-chip[data-filter]').forEach(function (chip) {
    chip.addEventListener('click', function () {
      $$('.filter-chip[data-filter]').forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active'); state.filter = chip.dataset.filter; apply();
    });
  });
  var searchTimer = 0;
  $('#projectSearch').addEventListener('input', function (e) {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () { state.q = e.target.value.trim(); apply(); }, 90);
  });
  $('#projectSort').addEventListener('change', function (e) { state.sort = e.target.value; applySort(); apply(); });

  // ورود نرم کارت‌ها: --i برای تاخیر پلکانی
  $$('.kanban-cards').forEach(function (c) { $$('.kcard', c).forEach(function (k, i) { k.style.setProperty('--i', Math.min(i, 12)); }); });

  /* ───────── شمارنده‌ها (چیپ‌ها، ستون‌ها، آمار) ───────── */
  function recount() {
    var c = { all: 0 };
    Object.keys(STATUS).forEach(function (k) { c[k] = 0; });
    $$('.kanban-board .kcard').forEach(function (card) { c.all++; if (c[card.dataset.status] !== undefined) c[card.dataset.status]++; });
    $$('.filter-chip[data-filter]').forEach(function (ch) { var n = $('.filter-count', ch); if (n) n.textContent = fa(c[ch.dataset.filter]); });
    $$('.kanban-col').forEach(function (col) { $('.kanban-count', col).textContent = fa(c[col.dataset.statusCol]); });
    $$('[data-stat]').forEach(function (el) { el.textContent = fa(c[el.dataset.stat]); });
  }

  /* ───────── اعمال وضعیت جدید روی کارت و ردیف جدول ───────── */
  function paint(el, to) {
    el.dataset.status = to;
    try { var d = JSON.parse(el.dataset.project || '{}'); d.status = to; el.dataset.project = JSON.stringify(d); } catch (e) {}
    var b = $('.badge-status', el);
    if (b && STATUS[to]) { b.className = 'badge-status ' + STATUS[to].badge; b.textContent = STATUS[to].title; }
  }
  function applyStatus(card, to) {
    paint(card, to); card.classList.toggle('is-done', to === 'done');
    var row = $('#tableView tbody tr[data-id="' + card.dataset.id + '"]');
    if (row) paint(row, to);
  }
  function moveCard(card, to) {
    var cards = $('.kanban-col[data-status-col="' + to + '"] .kanban-cards');
    if (!cards) return;
    cards.appendChild(card); applyStatus(card, to); recount();
    card.classList.remove('landed'); void card.offsetWidth; card.classList.add('landed');
    apply();
  }

  /* ───────── API وضعیت ───────── */
  function saveStatus(id, to) {
    return fetch('/sw-admin/projects/' + id + '/status', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ status: to })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        if (!r.ok || !j.success) throw new Error(j.message || 'تغییر وضعیت انجام نشد');
        return j;
      });
    });
  }
  function persist(card, from, to, undoable) {
    return saveStatus(card.dataset.id, to).then(function () {
      if (!undoable) return;
      toast('به «' + STATUS[to].title + '» منتقل شد', {
        type: 'success', detail: card.dataset.title, ms: 5000,
        actions: [{ label: 'بازگردانی', fn: function () { moveCard(card, from); persist(card, to, from, false); } }]
      });
    }).catch(function (err) {
      moveCard(card, from);
      toast(err.message || 'تغییر وضعیت انجام نشد', { type: 'error' });
    });
  }

  /* ───────── درگ‌اند‌دراپ کانبان (Pointer Events: ماوس + لمس) ─────────
     ماوس: بعد از ۵ پیکسل حرکت · لمس: نگه‌داشتن ۲۶۰ms (تا اسکرول عادی خراب نشود)
     کارت شناور با transform حرکت می‌کند؛ رها کردن = فرود فنری روی جای خالی */
  var board = $('.kanban-board'), drag = null, noClickUntil = 0;

  board.addEventListener('pointerdown', function (e) {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    var card = e.target.closest('.kcard');
    if (!card || e.target.closest('button,a,input,select,textarea')) return;
    drag = { card: card, pid: e.pointerId, sx: e.clientX, sy: e.clientY, x: e.clientX, y: e.clientY, active: false, touch: e.pointerType !== 'mouse', raf: 0, timer: 0 };
    if (drag.touch) drag.timer = setTimeout(function () { if (drag && !drag.active) begin(); }, 260);
  });

  document.addEventListener('pointermove', function (e) {
    if (!drag || e.pointerId !== drag.pid) return;
    drag.x = e.clientX; drag.y = e.clientY;
    if (!drag.active) {
      var dist = Math.hypot(drag.x - drag.sx, drag.y - drag.sy);
      if (drag.touch) { if (dist > 8) { clearTimeout(drag.timer); drag = null; } return; }   // لمس: قبل از long-press = اسکرول
      if (dist < 5) return;
      begin();
    }
    if (!drag.raf) drag.raf = requestAnimationFrame(tick);
  });
  // وقتی درگ فعال است اسکرول لمسی را مسدود کن
  document.addEventListener('touchmove', function (e) { if (drag && drag.active) e.preventDefault(); }, { passive: false });

  function begin() {
    var card = drag.card, r = card.getBoundingClientRect();
    drag.active = true; drag.from = card.dataset.status;
    drag.offX = drag.sx - r.left; drag.offY = drag.sy - r.top; drag.ox = r.left; drag.oy = r.top;
    drag.parent = card.parentNode; drag.next = card.nextSibling;

    var clone = card.cloneNode(true);
    clone.classList.add('kcard-float'); clone.removeAttribute('data-project'); clone.removeAttribute('tabindex');
    clone.style.width = r.width + 'px'; clone.style.left = r.left + 'px'; clone.style.top = r.top + 'px';
    document.body.appendChild(clone); drag.clone = clone;

    var ph = document.createElement('div'); ph.className = 'kcard-ph'; ph.style.height = r.height + 'px'; drag.ph = ph;
    card.parentNode.insertBefore(ph, card); card.hidden = true;
    document.body.classList.add('is-card-dragging');
    if (navigator.vibrate) navigator.vibrate(8);
    tick();
  }

  function setOver(col) {
    if (drag.over === col) return;
    if (drag.over) drag.over.classList.remove('drop');
    drag.over = col; if (col) col.classList.add('drop');
  }
  function place(cards, y) {
    var list = $$('.kcard:not([hidden])', cards), before = null;
    for (var i = 0; i < list.length; i++) {
      var b = list[i].getBoundingClientRect();
      if (y < b.top + b.height / 2) { before = list[i]; break; }
    }
    if (before) { if (before.previousElementSibling !== drag.ph) cards.insertBefore(drag.ph, before); }
    else if (cards.lastElementChild !== drag.ph) cards.appendChild(drag.ph);
  }
  function tick() {
    if (!drag || !drag.active) return;
    drag.raf = 0;
    drag.clone.style.transform = 'translate3d(' + (drag.x - drag.offX - drag.ox) + 'px,' + (drag.y - drag.offY - drag.oy) + 'px,0) scale(1.03) rotate(1.2deg)';
    var el = document.elementFromPoint(drag.x, drag.y), col = el && el.closest('.kanban-col');
    setOver(col);
    if (col) place($('.kanban-cards', col), drag.y);
    // اسکرول خودکار نزدیک لبه‌ی صفحه
    var m = 70, vy = 0;
    if (drag.y < m) vy = -Math.ceil((m - drag.y) / 6);
    else if (window.innerHeight - drag.y < m) vy = Math.ceil((m - (window.innerHeight - drag.y)) / 6);
    if (vy) { window.scrollBy(0, vy); drag.raf = requestAnimationFrame(tick); }
  }

  function land(d, target, done) {
    var r = target.getBoundingClientRect(), clone = d.clone, fin = false;
    clone.style.transition = 'transform .42s var(--sw-spring), opacity .25s';
    clone.style.transform = 'translate3d(' + (r.left - d.ox) + 'px,' + (r.top - d.oy) + 'px,0) scale(1) rotate(0deg)';
    function end() { if (fin) return; fin = true; clone.remove(); done(); }
    clone.addEventListener('transitionend', end, { once: true });
    setTimeout(end, 520);
  }

  function finish(cancel) {
    var d = drag; drag = null;
    if (!d) return;
    clearTimeout(d.timer);
    if (!d.active) return;
    cancelAnimationFrame(d.raf);
    noClickUntil = Date.now() + 120;
    document.body.classList.remove('is-card-dragging');
    var col = d.ph.closest('.kanban-col'), to = col && col.dataset.statusCol, card = d.card;
    if (d.over) d.over.classList.remove('drop');

    if (cancel || !col || to === d.from) {            // برگشت به جای اول
      d.ph.remove(); d.parent.insertBefore(card, d.next); card.hidden = false; card.style.visibility = 'hidden';
      land(d, card, function () { card.style.visibility = ''; });
      return;
    }
    d.ph.replaceWith(card); card.hidden = false; card.style.visibility = 'hidden';   // جابه‌جایی خوش‌بینانه
    applyStatus(card, to); recount(); apply();
    land(d, card, function () { card.style.visibility = ''; card.classList.add('landed'); });
    persist(card, d.from, to, true);
  }
  document.addEventListener('pointerup', function (e) { if (drag && e.pointerId === drag.pid) finish(false); });
  document.addEventListener('pointercancel', function () { finish(true); });
  window.addEventListener('blur', function () { finish(true); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && drag && drag.active) finish(true); });

  // کلیک روی کارت = مشاهده (بعد از درگ نادیده گرفته می‌شود)
  board.addEventListener('click', function (e) {
    if (Date.now() < noClickUntil || e.target.closest('button,a')) return;
    var card = e.target.closest('.kcard'); if (card) $('[data-project-view]', card).click();
  });
  board.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && e.target.classList.contains('kcard')) $('[data-project-view]', e.target).click();
  });

  /* ───────── مودال پروژه: افزودن / ویرایش ───────── */
  var form = $('#projectForm'), modalTitle = $('#projectModalTitle'), submitBtn = $('#projectSubmitBtn');
  var fTitle = $('#projectTitleInput'), fClient = $('#projectClientSelect'), fCategory = $('#projectCategorySelect');
  var fStatus = $('#projectStatusSelect'), fStart = $('#projectStartDate'), fDeadline = $('#projectDeadline');
  var fDesc = $('#projectDescriptionInput'), fProg = $('#projectProgressInput'), fProgOut = $('#projectProgressOut');
  var techBox = $('#techChecklist'), statusField = $('#statusField');

  function syncProgress() { fProgOut.textContent = fa(fProg.value) + '٪'; }
  fProg.addEventListener('input', syncProgress);

  function clearErrors() {
    $$('.sw-err', form).forEach(function (n) { n.remove(); });
    $$('.is-invalid', form).forEach(function (n) { n.classList.remove('is-invalid'); n.removeAttribute('aria-invalid'); });
  }
  function resetTech() { $$('input[type="checkbox"]', techBox).forEach(function (cb) { cb.checked = false; }); }
  function ensureTech(value, checked) {
    if (!value) return;
    var cb = $$('input[type="checkbox"]', techBox).filter(function (x) { return x.value === value; })[0];
    if (!cb) {
      var label = document.createElement('label'); label.className = 'tech-check-item';
      cb = document.createElement('input'); cb.type = 'checkbox'; cb.name = 'techStack[]'; cb.value = value;
      var span = document.createElement('span'); span.textContent = value;
      label.appendChild(cb); label.appendChild(span); techBox.appendChild(label);
    }
    cb.checked = !!checked;
  }
  function ensureCategory(id, title) {
    if (!id) return;
    var opt = Array.prototype.slice.call(fCategory.options).filter(function (o) { return o.value === id; })[0];
    if (!opt) { opt = document.createElement('option'); opt.value = id; opt.textContent = title || id; fCategory.appendChild(opt); }
    fCategory.value = id;
  }

  function setMode(mode, data) {
    data = data || {}; clearErrors();
    if (mode === 'edit') {
      modalTitle.textContent = 'ویرایش پروژه';
      submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> ذخیره تغییرات';
      form.action = '/sw-admin/projects/' + data.id + '/update';
      statusField.hidden = false;
      fTitle.value = data.title || ''; fDesc.value = data.description || '';
      fStart.value = fa(data.startDate || ''); fDeadline.value = fa(data.deadline || '');
      fProg.value = data.progress != null ? data.progress : 0;
      fStatus.value = data.status || 'active';
      fClient.value = data.client || '';
      resetTech(); ensureCategory(data.category, data.categoryTitle);
      (data.tech || []).forEach(function (t) { ensureTech(t, true); });
    } else {
      modalTitle.textContent = 'پروژه جدید';
      submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> ثبت پروژه';
      form.action = '/sw-admin/projects/add';
      statusField.hidden = true;
      form.reset(); resetTech();
    }
    syncProgress();
  }

  $('#newProjectBtn').addEventListener('click', function () { setMode('create'); });

  function dataOf(btn) {
    var holder = btn.closest('[data-project]');
    try { return JSON.parse(holder.dataset.project || '{}'); } catch (e) { return null; }
  }
  document.addEventListener('click', function (e) {
    var edit = e.target.closest('[data-project-edit]');
    if (edit) { var d = dataOf(edit); if (d) setMode('edit', d); return; }
    var view = e.target.closest('[data-project-view]');
    if (view) { var v = dataOf(view); if (v) fillView(v); }
  });

  /* ───────── افزودن «نوع پروژه» (AJAX) و «تکنولوژی» ───────── */
  var addCatBtn = $('#addCategoryBtn'), addCatBox = $('#addCategoryBox'), newCat = $('#newCategoryInput'), confirmCat = $('#confirmAddCategory');

  addCatBtn.addEventListener('click', function () {
    var open = addCatBox.hidden; addCatBox.hidden = !open;
    addCatBtn.setAttribute('aria-expanded', String(open));
    if (open) newCat.focus();
  });
  function addCategory() {
    var title = (newCat.value || '').trim();
    if (!title) return;
    confirmCat.classList.add('sw-loading'); confirmCat.disabled = true;
    fetch('/sw-admin/service-categories/add', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ title: title })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        if (!r.ok || !j.ok) throw new Error(j.message || 'خطا در ثبت نوع پروژه');
        return j;
      });
    }).then(function (j) {
      var opt = document.createElement('option'); opt.value = j.category._id; opt.textContent = j.category.title;
      fCategory.appendChild(opt); fCategory.value = j.category._id;
      newCat.value = ''; addCatBox.hidden = true; addCatBtn.setAttribute('aria-expanded', 'false');
      toast('نوع پروژه اضافه شد', { type: 'success', detail: j.category.title });
    }).catch(function (err) {
      toast(err.message || 'خطا در ارتباط با سرور', { type: 'error' });
    }).then(function () { confirmCat.classList.remove('sw-loading'); confirmCat.disabled = false; });
  }
  confirmCat.addEventListener('click', addCategory);
  newCat.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addCategory(); } });

  var newTech = $('#newTechInput');
  function addTech() {
    var v = (newTech.value || '').trim();
    if (!v) return;
    ensureTech(v, true); newTech.value = '';
  }
  $('#addTechBtn').addEventListener('click', addTech);
  newTech.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addTech(); } });

  /* ───────── مودال مشاهده ───────── */
  var current = null;
  function fillView(data) {
    current = data;
    $('#projectViewTitle').textContent = data.title || 'جزئیات پروژه';
    $('#projectViewClient').textContent = data.clientName || 'بدون مشتری';
    $('#projectViewCategory').textContent = data.categoryTitle || 'بدون نوع';
    $('#projectViewStart').textContent = data.startDate ? fa(data.startDate) : 'ثبت‌نشده';
    $('#projectViewDeadline').textContent = data.deadline ? fa(data.deadline) : 'ثبت‌نشده';
    var techEl = $('#projectViewTech'); techEl.textContent = '';
    if (data.tech && data.tech.length) {
      data.tech.forEach(function (t) { var p = document.createElement('span'); p.className = 'tech-pill'; p.textContent = t; techEl.appendChild(p); });
    } else {
      var none = document.createElement('span'); none.className = 'view-none'; none.textContent = 'تکنولوژی ثبت نشده است.'; techEl.appendChild(none);
    }
    $('#projectViewDescription').textContent = (data.description && data.description.trim()) ? data.description : 'توضیحی ثبت نشده است.';
  }
  $('#projectViewEditBtn').addEventListener('click', function () {
    if (!current) return;
    setMode('edit', current);
    window.closeModal('projectViewModal');
    window.openModal('projectModal');
  });

  /* ───────── تقویم شمسی (فایل لوکال از پارشیال‌ها) ───────── */
  if (window.jalaliDatepicker) {
    jalaliDatepicker.startWatch({ time: false, persianDigits: true, autoHide: true, topSpace: 4, zIndex: 99999 });
  }

  syncProgress();
});
</script>

