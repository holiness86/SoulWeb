<%# views/sw-admin/projects.ejs %>
<%- include('partials/_head', { title: 'مدیریت پروژه‌ها' }) %>
<link rel="stylesheet" href="assets/css/jalalidatepicker.min.css">

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', { 
  activePage: 'projects', 
  adminUser: { 
    name: 'علی مدیری', 
    role: 'مدیر کل سیستم', 
    initials: 'ادم' 
  } 
}) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'پروژه‌ها' }],
  searchPlaceholder: 'جستجو در پروژه‌ها…'
}) %>

<main class="page-content">

  <%
    const safeProjects = Array.isArray(projects) ? projects : [];
    const safeClients = typeof clients !== 'undefined' && Array.isArray(clients) ? clients : [];
    const safeServiceCategories = typeof serviceCategories !== 'undefined' && Array.isArray(serviceCategories) ? serviceCategories : [];

    const toFaDigits = (num) => {
      return String(num ?? 0).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
    };

    const formatDateFa = (date) => {
      if (!date) return 'نامشخص';

      try {
        const d = new Date(date);

        if (Number.isNaN(d.getTime())) {
          return 'نامشخص';
        }

        return d.toLocaleDateString('fa-IR', {
          day: 'numeric',
          month: 'long'
        });
      } catch (e) {
        return 'نامشخص';
      }
    };

    const statusMap = {
      active: {
        title: 'در حال انجام',
        badge: 'badge-inprog',
        dot: '#6447f4'
      },
      review: {
        title: 'در ریویو',
        badge: 'badge-review',
        dot: '#f59e0b'
      },
      done: {
        title: 'تحویل‌شده',
        badge: 'badge-done',
        dot: '#22c55e'
      },
      hold: {
        title: 'متوقف',
        badge: 'badge-hold',
        dot: '#9899bc'
      },
      cancelled: {
        title: 'لغوشده',
        badge: 'badge-hold',
        dot: '#dc2626'
      }
    };

    const kanbanColumns = [
      {
        key: 'active',
        title: 'در حال انجام',
        dot: '#6447f4'
      },
      {
        key: 'review',
        title: 'در ریویو',
        dot: '#f59e0b'
      },
      {
        key: 'done',
        title: 'تحویل‌شده',
        dot: '#22c55e'
      },
      {
        key: 'hold',
        title: 'متوقف',
        dot: '#9899bc'
      },
      {
        key: 'cancelled',
        title: 'لغوشده',
        dot: '#dc2626'
      }
    ];

    const stats = {
      active: 0,
      done: 0,
      review: 0,
      hold: 0,
      cancelled: 0
    };

    safeProjects.forEach(project => {
      if (project.status && stats[project.status] !== undefined) {
        stats[project.status]++;
      }
    });

    const getStatusTitle = (status) => {
      return statusMap[status]?.title || 'نامشخص';
    };

    const getStatusBadge = (status) => {
      return statusMap[status]?.badge || 'badge-new';
    };

    const getClientName = (project) => {
      if (!project || !project.client) return 'بدون مشتری';

      if (typeof project.client === 'string') {
        return project.client;
      }

      return project.client.company || project.client.name || project.client.fullName || 'بدون مشتری';
    };

    const getCategoryTitle = (project) => {
      if (!project || !project.category) return 'بدون نوع';

      if (typeof project.category === 'string') {
        return project.category;
      }

      return project.category.title || project.category.name || 'بدون نوع';
    };

    const getTechText = (project) => {
      if (!project) return 'بدون تکنولوژی';

      if (Array.isArray(project.techStack) && project.techStack.length) {
        return project.techStack.join(' · ');
      }

      if (Array.isArray(project.technologies) && project.technologies.length) {
        return project.technologies.join(' · ');
      }

      if (typeof project.technologies === 'string' && project.technologies.trim()) {
        return project.technologies;
      }

      return 'بدون تکنولوژی';
    };

    const getDueText = (project) => {
      return formatDateFa(project?.deadline);
    };

    const isDeadlineNear = (project) => {
      if (!project || !project.deadline) return false;
      if (project.status === 'done' || project.status === 'cancelled') return false;

      const now = new Date();
      const deadline = new Date(project.deadline);

      if (Number.isNaN(deadline.getTime())) {
        return false;
      }

      const diffDays = Math.ceil((deadline - now) / (1000 * 60 * 60 * 24));

      return diffDays <= 1;
    };

    const getInitials = (project) => {
      const name = getClientName(project).trim();

      if (!name || name === 'بدون مشتری') {
        return '؟';
      }

      return name
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(part => part[0])
        .join('');
    };

    const toJalaliInputValue = (date) => {
      if (!date) return '';

      try {
        const d = new Date(date);
        if (Number.isNaN(d.getTime())) return '';

        const parts = new Intl.DateTimeFormat('fa-IR-u-nu-latn', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).formatToParts(d);

        const map = {};
        parts.forEach(p => { map[p.type] = p.value; });

        return `${map.year}/${map.month}/${map.day}`;
      } catch (e) {
        return '';
      }
    };

    const defaultTechOptions = [
      'PHP', 'Laravel', 'وردپرس', 'React', 'Vue.js', 'Next.js',
      'Node.js', 'Angular', 'TypeScript', 'Tailwind CSS', 'Bootstrap',
      'MySQL', 'MongoDB', 'jQuery'
    ];

    const getTechArray = (project) => {
      if (!project) return [];

      if (Array.isArray(project.techStack) && project.techStack.length) {
        return project.techStack;
      }

      if (Array.isArray(project.technologies) && project.technologies.length) {
        return project.technologies;
      }

      if (typeof project.technologies === 'string' && project.technologies.trim()) {
        return project.technologies.split(/[·,/]/).map(t => t.trim()).filter(Boolean);
      }

      return [];
    };

    const getClientId = (project) => {
      if (!project || !project.client) return '';
      return typeof project.client === 'object' ? (project.client._id || '') : project.client;
    };

    const getCategoryId = (project) => {
      if (!project || !project.category) return '';
      return typeof project.category === 'object' ? (project.category._id || '') : project.category;
    };

    const buildProjectPayload = (project) => JSON.stringify({
      id: project._id || '',
      title: project.title || '',
      client: getClientId(project),
      category: getCategoryId(project),
      categoryTitle: getCategoryTitle(project),
      status: project.status || 'active',
      progress: Number(project.progress || 0),
      startDate: toJalaliInputValue(project.startDate),
      deadline: toJalaliInputValue(project.deadline),
      tech: getTechArray(project),
      description: project.description || '',
      clientName: getClientName(project)
    });

    const totalProjects = safeProjects.length;
  %>

  <!-- Page Header -->
  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title">مدیریت پروژه‌ها</h1>
      <p class="page-subtitle">
        <%= toFaDigits(stats.active) %> پروژه فعال ·
        <%= toFaDigits(stats.review) %> در انتظار بررسی ·
        <%= toFaDigits(stats.hold) %> متوقف
      </p>
    </div>

    <div style="display:flex;gap:.6rem;">
<a href="/sw-admin/projects/export" class="btn-ghost-sm">
  <i class="bi bi-download"></i>
  خروجی Excel
</a>


      <button class="btn-sol-sm" id="newProjectBtn" data-modal-open="projectModal">
        <i class="bi bi-plus-lg"></i>
        پروژه جدید
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;" class="fade-up fade-up-2">

    <!-- پروژه فعال -->
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(100,71,244,.1);color:var(--main-500);">
        <i class="bi bi-kanban-fill"></i>
      </div>

      <div>
        <div class="pstat-val text-grad stat-value"
             data-count="<%= stats.active %>"
             data-suffix="">
          <%= toFaDigits(stats.active) %>
        </div>

        <div class="pstat-lbl">
          پروژه فعال
        </div>
      </div>
    </div>

    <!-- تحویل شده -->
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(34,197,94,.1);color:#16a34a;">
        <i class="bi bi-check-circle-fill"></i>
      </div>

      <div>
        <div class="pstat-val text-grad stat-value"
             data-count="<%= stats.done %>"
             data-suffix="">
          <%= toFaDigits(stats.done) %>
        </div>

        <div class="pstat-lbl">
          تحویل‌داده‌شده
        </div>
      </div>
    </div>

    <!-- ریویو -->
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(245,158,11,.1);color:#d97706;">
        <i class="bi bi-clock-history"></i>
      </div>

      <div>
        <div class="pstat-val text-grad stat-value"
             data-count="<%= stats.review %>"
             data-suffix="">
          <%= toFaDigits(stats.review) %>
        </div>

        <div class="pstat-lbl">
          در انتظار ریویو
        </div>
      </div>
    </div>

    <!-- متوقف -->
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(239,68,68,.1);color:#dc2626;">
        <i class="bi bi-pause-circle-fill"></i>
      </div>

      <div>
        <div class="pstat-val text-grad stat-value"
             data-count="<%= stats.hold %>"
             data-suffix="">
          <%= toFaDigits(stats.hold) %>
        </div>

        <div class="pstat-lbl">
          متوقف‌شده
        </div>
      </div>
    </div>

  </div>

<!-- Filter Bar -->
<div class="filter-bar fade-up fade-up-2" data-filter-group>

  <button class="filter-chip active" data-filter="all">
    همه
    <span class="filter-count">
      <%= toFaDigits(safeProjects.length) %>
    </span>
  </button>

  <% kanbanColumns.forEach(column => { %>
    <%
      const statusCount = safeProjects.filter(project => project.status === column.key).length;
    %>

    <button class="filter-chip" data-filter="<%= column.key %>">
      <span 
        style="width:7px;height:7px;border-radius:50%;background:<%= column.dot %>;display:inline-block;"
      ></span>

      <%= column.title %>

      <span class="filter-count">
        <%= toFaDigits(statusCount) %>
      </span>
    </button>
  <% }) %>

  <div style="margin-right:auto;display:flex;gap:.5rem;align-items:center;">
    <select 
      class="sol-select" 
      id="projectSort"
      style="width:auto;font-size:.78rem;padding:.38rem .8rem;"
    >
      <option value="newest">مرتب: جدیدترین</option>
      <option value="deadline">مرتب: ددلاین</option>
      <option value="progress">مرتب: پیشرفت</option>
      <option value="title">مرتب: نام پروژه</option>
    </select>

    <div style="display:flex;gap:.3rem;">
      <button type="button" class="view-btn active" id="viewKanban" title="کانبان">
        <i class="bi bi-grid-3x3-gap"></i>
      </button>

      <button type="button" class="view-btn" id="viewTable" title="جدول">
        <i class="bi bi-list-ul"></i>
      </button>
    </div>
  </div>
</div>


  <!-- Kanban View -->
  <div id="kanbanView">
    <div class="kanban-board fade-up fade-up-3">

      <% kanbanColumns.forEach(column => { %>
        <%
          const columnProjects = safeProjects.filter(project => project.status === column.key);
        %>

<div class="kanban-col" data-status-col="<%= column.key %>">
          <div class="kanban-head">
            <div class="kanban-head-title">
              <div class="kanban-dot" style="background:<%= column.dot %>;"></div>
              <%= column.title %>
            </div>

            <span class="kanban-count">
              <%= toFaDigits(columnProjects.length) %>
            </span>
          </div>

          <div class="kanban-cards">

            <% if (columnProjects.length === 0) { %>
              <div class="kcard" style="opacity:.65;text-align:center;">
                <div class="kcard-title" style="font-size:.8rem;color:var(--color-text-muted);">
                  پروژه‌ای وجود ندارد
                </div>
              </div>
            <% } %>

            <% columnProjects.forEach(project => { %>
              <%
                const progress = Number(project.progress || 0);
                const progressWidth = Math.max(0, Math.min(100, progress));

                const doneStyle = project.status === 'done'
                  ? 'opacity:.7;'
                  : '';

                const progressFillStyle = project.status === 'done'
                  ? `width:${progressWidth}%;background:linear-gradient(135deg,#22c55e,#16a34a)`
                  : `width:${progressWidth}%`;

                const deadlineDanger = isDeadlineNear(project);
              %>

              <div 
                class="kcard" 
                style="<%= doneStyle %>" 
                data-status="<%= project.status %>"
                data-title="<%= project.title || '' %>"
                data-progress="<%= progressWidth %>"
                data-deadline="<%= project.deadline ? new Date(project.deadline).getTime() : 0 %>"
                data-created="<%= project.createdAt ? new Date(project.createdAt).getTime() : 0 %>"
              >
                <div style="display:flex;justify-content:flex-end;gap:.3rem;margin-bottom:.4rem;">
                  <button
                    type="button"
                    class="kcard-action-btn"
                    title="مشاهده توضیحات"
                    data-modal-open="projectViewModal"
                    data-project-view
                    data-project="<%= buildProjectPayload(project) %>"
                  >
                    <i class="bi bi-eye"></i>
                  </button>

                  <button
                    type="button"
                    class="kcard-action-btn"
                    title="ویرایش پروژه"
                    data-modal-open="projectModal"
                    data-project-edit
                    data-project="<%= buildProjectPayload(project) %>"
                  >
                    <i class="bi bi-pencil"></i>
                  </button>
                </div>

                <div class="kcard-title">
                  <%= project.title || 'بدون عنوان' %>
                </div>

                <div class="kcard-prog">
                  <div class="kcard-prog-fill" style="<%= progressFillStyle %>"></div>
                </div>

                <div class="kcard-meta">
                  <span class="badge-status <%= getStatusBadge(project.status) %>">
                    <%= getStatusTitle(project.status) %>
                  </span>

                  <span
                    class="kcard-due"
                    style="<%= deadlineDanger ? 'color:#dc2626;font-weight:700;' : '' %>"
                  >
                    <% if (deadlineDanger) { %>
                      <i class="bi bi-exclamation-triangle"></i>
                    <% } else { %>
                      <i class="bi bi-calendar3"></i>
                    <% } %>

                    <%= getDueText(project) %>
                  </span>
                </div>

                <div style="margin-top:.6rem;display:flex;justify-content:space-between;align-items:center;gap:.75rem;">
                  <div class="kcard-avatars">
                    <div class="kcard-av" style="background:var(--grad-main);">
                      <%= getInitials(project) %>
                    </div>
                  </div>

                  <span style="font-size:.68rem;color:var(--color-text-light);text-align:left;direction:ltr;">
                    <%= getTechText(project) %> · <%= toFaDigits(progressWidth) %>٪
                  </span>
                </div>

                <div style="margin-top:.55rem;font-size:.7rem;color:var(--color-text-muted);display:flex;justify-content:space-between;gap:.5rem;">
                  <span>
                    <i class="bi bi-person"></i>
                    <%= getClientName(project) %>
                  </span>

                  <span>
                    <i class="bi bi-folder"></i>
                    <%= getCategoryTitle(project) %>
                  </span>
                </div>
              </div>
            <% }) %>

          </div>
        </div>
      <% }) %>

    </div>
  </div>
  <!-- /kanbanView -->

  <!-- Table View -->
  <div id="tableView" style="display:none;">
    <div class="dash-panel fade-up fade-up-3">
      <div style="overflow-x:auto;">
        <table class="sol-table">
          <thead>
            <tr>
              <th>#</th>
              <th>نام پروژه</th>
              <th>مشتری</th>
              <th>نوع</th>
              <th>وضعیت</th>
              <th>پیشرفت</th>
              <th>ددلاین</th>
              <th>عملیات</th>
            </tr>
          </thead>

          <tbody>
            <% if (safeProjects.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align:center;padding:2rem;color:var(--color-text-muted);">
                  هیچ پروژه‌ای پیدا نشد.
                </td>
              </tr>
            <% } %>

            <% safeProjects.forEach((project, index) => { %>
              <%
                const progress = Number(project.progress || 0);
                const progressWidth = Math.max(0, Math.min(100, progress));
                const deadlineDanger = isDeadlineNear(project);
              %>

              <tr 
                data-status="<%= project.status %>"
                data-title="<%= project.title || '' %>"
                data-progress="<%= progressWidth %>"
                data-deadline="<%= project.deadline ? new Date(project.deadline).getTime() : 0 %>"
                data-created="<%= project.createdAt ? new Date(project.createdAt).getTime() : 0 %>"
              >
                <td>
                  <span style="font-size:.75rem;color:var(--color-text-light);">
                    #<%= toFaDigits(index + 1) %>
                  </span>
                </td>

                <td>
                  <div style="font-weight:600;">
                    <%= project.title || 'بدون عنوان' %>
                  </div>

                  <div style="font-size:.73rem;color:var(--color-text-muted);direction:ltr;text-align:right;">
                    <%= getTechText(project) %>
                  </div>
                </td>

                <td>
                  <%= getClientName(project) %>
                </td>

                <td>
                  <%= getCategoryTitle(project) %>
                </td>

                <td>
                  <span class="badge-status <%= getStatusBadge(project.status) %>">
                    <%= getStatusTitle(project.status) %>
                  </span>
                </td>

                <td>
                  <div style="display:flex;align-items:center;gap:.5rem;">
                    <div class="prog-bar-mini">
                      <div class="prog-fill" style="width:<%= progressWidth %>%"></div>
                    </div>

                    <span style="font-size:.73rem;color:<%= deadlineDanger ? '#dc2626' : 'var(--color-text-muted)' %>;font-weight:<%= deadlineDanger ? '700' : '400' %>;">
                      <%= toFaDigits(progressWidth) %>٪
                    </span>
                  </div>
                </td>

                <td
                  style="font-size:.78rem;<%= deadlineDanger ? 'color:#dc2626;font-weight:700;' : '' %>"
                >
                  <% if (deadlineDanger) { %>
                    ⚠️
                  <% } %>

                  <%= getDueText(project) %>
                </td>

                <td>
                  <div style="display:flex;gap:.4rem;">
                    <button
                      type="button"
                      class="btn-ghost-sm"
                      style="padding:.28rem .6rem;"
                      title="مشاهده"
                      data-modal-open="projectViewModal"
                      data-project-view
                      data-project="<%= buildProjectPayload(project) %>"
                    >
                      <i class="bi bi-eye"></i>
                    </button>

                    <button
                      type="button"
                      class="btn-ghost-sm"
                      style="padding:.28rem .6rem;"
                      title="ویرایش"
                      data-modal-open="projectModal"
                      data-project-edit
                      data-project="<%= buildProjectPayload(project) %>"
                    >
                      <i class="bi bi-pencil"></i>
                    </button>

                    <form
                      action="/sw-admin/projects/<%= project._id %>/delete"
                      method="POST"
                      style="display:inline;"
                      onsubmit="return confirm('آیا از حذف این پروژه مطمئن هستید؟')"
                    >
                      <button
                        type="submit"
                        class="btn-danger-sm"
                        style="padding:.28rem .6rem;"
                        title="حذف"
                      >
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-top:1px solid var(--color-border);flex-wrap:wrap;gap:.75rem;">
        <span style="font-size:.78rem;color:var(--color-text-muted);">
          نمایش <%= toFaDigits(totalProjects) %> پروژه
        </span>

        <div style="display:flex;gap:.35rem;">
          <button class="view-btn active">
            <%= toFaDigits(1) %>
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- /tableView -->

</main>
</div><!-- /main-content -->
</div><!-- /admin-shell -->

<!-- دکمه نامرئی برای سوییچ از مدال مشاهده به مدال ویرایش -->
<button type="button" id="projectModalProxyTrigger" data-modal-open="projectModal" style="display:none;"></button>

<!-- Modal: پروژه جدید / ویرایش پروژه -->
<div class="modal-overlay" id="projectModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;" id="projectModalTitle">پروژه جدید</div>

      <button type="button" data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <form action="/sw-admin/projects/add" method="POST" id="projectForm">
      <input type="hidden" name="projectId" id="projectIdInput" value="">

      <div class="form-row">
        <label class="sol-label">نام پروژه</label>
        <input 
          class="sol-input" 
          type="text" 
          name="title" 
          id="projectTitleInput"
          placeholder="مثال: وب‌سایت شرکت آلفا" 
          required
        >
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-row">
          <label class="sol-label">مشتری</label>

          <select class="sol-select" name="client" id="projectClientSelect" style="width:100%" required>
            <option value="" selected disabled>انتخاب مشتری…</option>

            <% safeClients.forEach(c => { %>
              <option value="<%= c._id %>">
                <%= c.name || 'مشتری بدون نام' %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-row">
          <label class="sol-label">نوع پروژه</label>

          <div style="display:flex;gap:.5rem;">
            <select class="sol-select" name="category" id="projectCategorySelect" style="width:100%" required>
              <option value="" selected disabled>انتخاب نوع پروژه…</option>

              <% safeServiceCategories.forEach(cat => { %>
                <option value="<%= cat._id %>">
                  <%= cat.title || cat.name || 'دسته‌بندی بدون عنوان' %>
                </option>
              <% }) %>
            </select>

            <button type="button" class="btn-ghost-sm" id="addCategoryBtn" title="افزودن نوع جدید" style="flex-shrink:0;padding:.5rem .7rem;">
              <i class="bi bi-plus-lg"></i>
            </button>
          </div>

          <div id="addCategoryBox" style="display:none;gap:.5rem;margin-top:.6rem;">
            <input type="text" class="sol-input" id="newCategoryInput" placeholder="عنوان نوع پروژه جدید…" style="flex:1;">
            <button type="button" class="btn-sol-sm" id="confirmAddCategory">افزودن</button>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-row">
          <label class="sol-label">تاریخ شروع</label>
          <input 
            class="sol-input" 
            type="text" 
            name="startDate" 
            id="projectStartDate"
            placeholder="۱۴۰۴/۰۳/۲۱"
            autocomplete="off"
            data-jdp
            data-jdp-only-date
          >
        </div>

        <div class="form-row">
          <label class="sol-label">ددلاین</label>
          <input 
            class="sol-input" 
            type="text" 
            name="deadline" 
            id="projectDeadline"
            placeholder="۱۴۰۴/۰۴/۱۵"
            autocomplete="off"
            data-jdp
            data-jdp-only-date
          >
        </div>
      </div>

      <div class="form-row">
        <label class="sol-label">وضعیت پروژه</label>

        <select class="sol-select" name="status" id="projectStatusSelect" style="width:100%">
          <% kanbanColumns.forEach(column => { %>
            <option value="<%= column.key %>"><%= column.title %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-row">
        <label class="sol-label">تکنولوژی‌ها</label>

        <div class="tech-checklist" id="techChecklist">
          <% defaultTechOptions.forEach(tech => { %>
            <label class="tech-check-item">
              <input type="checkbox" name="techStack[]" value="<%= tech %>">
              <span><%= tech %></span>
            </label>
          <% }) %>
        </div>

        <div style="display:flex;gap:.5rem;margin-top:.65rem;">
          <input type="text" class="sol-input" id="newTechInput" placeholder="افزودن تکنولوژی جدید…" style="flex:1;">
          <button type="button" class="btn-ghost-sm" id="addTechBtn">
            <i class="bi bi-plus-lg"></i> افزودن
          </button>
        </div>
      </div>

      <div class="form-row">
        <label class="sol-label">توضیحات</label>
        <textarea 
          class="sol-input" 
          name="description" 
          id="projectDescriptionInput"
          rows="3" 
          placeholder="توضیح مختصر پروژه…" 
          style="resize:vertical;"
        ></textarea>
      </div>

      <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
        <button type="button" class="btn-ghost-sm" data-modal-close>
          انصراف
        </button>

        <button type="submit" class="btn-sol-sm" id="projectSubmitBtn">
          <i class="bi bi-check-lg"></i>
          ثبت پروژه
        </button>
      </div>

    </form>
  </div>
</div>

<!-- Modal: مشاهده توضیحات پروژه -->
<div class="modal-overlay" id="projectViewModal">
  <div class="modal-box" style="width:min(560px,92vw);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;" id="projectViewTitle">جزئیات پروژه</div>

      <button type="button" data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-bottom:1.1rem;">
      <div class="view-info-box">
        <span class="view-info-lbl"><i class="bi bi-person"></i> مشتری</span>
        <span class="view-info-val" id="projectViewClient">—</span>
      </div>

      <div class="view-info-box">
        <span class="view-info-lbl"><i class="bi bi-folder"></i> نوع پروژه</span>
        <span class="view-info-val" id="projectViewCategory">—</span>
      </div>

      <div class="view-info-box">
        <span class="view-info-lbl"><i class="bi bi-calendar-event"></i> تاریخ شروع</span>
        <span class="view-info-val" id="projectViewStart">—</span>
      </div>

      <div class="view-info-box">
        <span class="view-info-lbl"><i class="bi bi-calendar-x"></i> ددلاین</span>
        <span class="view-info-val" id="projectViewDeadline">—</span>
      </div>
    </div>

    <div style="margin-bottom:1.1rem;">
      <span class="view-info-lbl"><i class="bi bi-cpu"></i> تکنولوژی‌ها</span>
      <div id="projectViewTech" style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.55rem;"></div>
    </div>

    <div>
      <span class="view-info-lbl"><i class="bi bi-card-text"></i> توضیحات</span>
      <p id="projectViewDescription" style="font-size:.86rem;line-height:1.9;color:var(--color-text-muted);margin-top:.55rem;background:var(--color-bg);border-radius:var(--radius-md);padding:1rem;">
        توضیحی ثبت نشده است.
      </p>
    </div>

    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button type="button" class="btn-ghost-sm" data-modal-close>
        بستن
      </button>

      <button type="button" class="btn-sol-sm" id="projectViewEditBtn">
        <i class="bi bi-pencil"></i>
        ویرایش پروژه
      </button>
    </div>
  </div>
</div>

<%- include('partials/_scripts', { extraScripts: `
<script src="assets/js/jalalidatepicker.min.js"></script>
<style>
.pstat{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:.85rem;transition:all var(--dur-normal) var(--ease-spring)}
