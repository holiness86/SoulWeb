.filter-bar{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:1.25rem}
.filter-chip{display:inline-flex;align-items:center;gap:.35rem;font-family:var(--font-primary);font-size:.78rem;font-weight:600;padding:.38rem .9rem;border-radius:var(--radius-full);border:1.5px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);cursor:pointer;transition:all var(--dur-fast)}
.filter-chip:hover,.filter-chip.active{background:var(--main-500);border-color:var(--main-500);color:#fff}

.view-btn{width:32px;height:32px;border-radius:var(--radius-sm);border:1.5px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.9rem;transition:all var(--dur-fast)}
.view-btn:disabled{opacity:.4;cursor:not-allowed}
.view-btn.active,.view-btn:not(:disabled):hover{background:var(--main-500);border-color:var(--main-500);color:#fff}

.kanban-board{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:1.5rem}
@media(max-width:1400px){.kanban-board{grid-template-columns:repeat(4,1fr)}}
@media(max-width:1100px){.kanban-board{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.kanban-board{grid-template-columns:1fr}}

.kanban-col{background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-lg);overflow:hidden}
[data-bs-theme="dark"] .kanban-col{background:var(--color-surface-alt)}

.kanban-head{padding:.75rem 1rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-border)}
.kanban-head-title{font-size:.8rem;font-weight:700;display:flex;align-items:center;gap:.45rem}
.kanban-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.kanban-count{font-size:.68rem;font-weight:700;background:var(--color-border);color:var(--color-text-muted);padding:.1rem .4rem;border-radius:99px}

.kanban-cards{padding:.65rem;display:flex;flex-direction:column;gap:.6rem;min-height:120px}

.kcard{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:.85rem 1rem;cursor:pointer;transition:all var(--dur-normal) var(--ease-spring);position:relative;overflow:hidden}
.kcard:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);border-color:var(--main-200)}
[data-bs-theme="dark"] .kcard:hover{border-color:rgba(100,71,244,.25)}

.kcard::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:var(--grad-main);opacity:0;transition:opacity var(--dur-fast)}
.kcard:hover::before{opacity:1}

.kcard-title{font-size:.83rem;font-weight:700;margin-bottom:.5rem;line-height:1.4}
.kcard-meta{display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap}
.kcard-due{font-size:.68rem;color:var(--color-text-muted);display:flex;align-items:center;gap:.2rem}

.kcard-prog{height:3px;border-radius:99px;background:var(--color-border);margin:.6rem 0;overflow:hidden}
.kcard-prog-fill{height:100%;border-radius:99px;background:var(--grad-main)}

.kcard-avatars{display:flex;gap:.25rem;align-items:center}
.kcard-av{width:20px;height:20px;border-radius:5px;font-size:.55rem;font-weight:800;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}

.filter-count{
  font-size:.65rem;
  font-weight:800;
  min-width:18px;
  height:18px;
  padding:0 .35rem;
  border-radius:99px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.22);
}

.filter-chip:not(.active) .filter-count{
  background:var(--color-border);
  color:var(--color-text-muted);
}

.tech-checklist{display:flex;flex-wrap:wrap;gap:.5rem .65rem;background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:.85rem 1rem}
.tech-check-item{display:flex;align-items:center;gap:.4rem;font-size:.8rem;font-weight:600;color:var(--color-text-primary);cursor:pointer;-webkit-user-select:none;user-select:none}
.tech-check-item input[type="checkbox"]{width:15px;height:15px;accent-color:var(--main-500);cursor:pointer}

.tech-pill{display:inline-flex;align-items:center;font-size:.74rem;font-weight:700;color:var(--main-600);background:var(--main-50);border:1px solid var(--main-200);border-radius:var(--radius-full);padding:.25rem .75rem}
[data-bs-theme="dark"] .tech-pill{background:rgba(100,71,244,.15);border-color:rgba(100,71,244,.3);color:var(--main-300)}

.view-info-box{background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:.7rem .9rem;display:flex;flex-direction:column;gap:.35rem}
.view-info-lbl{font-size:.7rem;color:var(--color-text-muted);display:flex;align-items:center;gap:.35rem;font-weight:600}
.view-info-val{font-size:.86rem;font-weight:700;color:var(--color-text-primary)}

.kcard-action-btn{width:24px;height:24px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);display:flex;align-items:center;justify-content:center;font-size:.72rem;cursor:pointer;transition:all var(--dur-fast)}
.kcard-action-btn:hover{background:var(--main-500);border-color:var(--main-500);color:#fff}

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const viewKanbanBtn = document.getElementById('viewKanban');
  const viewTableBtn = document.getElementById('viewTable');
  const kanbanView = document.getElementById('kanbanView');
  const tableView = document.getElementById('tableView');

  const filterChips = document.querySelectorAll('.filter-chip[data-filter]');
  const kanbanColumns = document.querySelectorAll('.kanban-col[data-status-col]');
  const tableRows = document.querySelectorAll('#tableView tbody tr[data-status]');
  const projectSort = document.getElementById('projectSort');

  let activeFilter = 'all';

  // -----------------------------
  // View Switch: Kanban / Table
  // -----------------------------
  if (viewKanbanBtn && viewTableBtn && kanbanView && tableView) {
    viewKanbanBtn.addEventListener('click', function () {
      kanbanView.style.display = '';
      tableView.style.display = 'none';

      viewKanbanBtn.classList.add('active');
      viewTableBtn.classList.remove('active');
    });

    viewTableBtn.addEventListener('click', function () {
      kanbanView.style.display = 'none';
      tableView.style.display = '';

      viewTableBtn.classList.add('active');
      viewKanbanBtn.classList.remove('active');
    });
  }

  // -----------------------------
  // Filter Function
  // -----------------------------
  function applyFilter(filter) {
    activeFilter = filter;

    // Kanban columns
    kanbanColumns.forEach(function (column) {
      const colStatus = column.dataset.statusCol;

      if (filter === 'all' || colStatus === filter) {
        column.style.display = '';
      } else {
        column.style.display = 'none';
      }
    });

    // Table rows
    tableRows.forEach(function (row) {
      const rowStatus = row.dataset.status;

      if (filter === 'all' || rowStatus === filter) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  // -----------------------------
  // Filter Buttons Events
  // -----------------------------
  filterChips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      const filter = chip.dataset.filter;

      filterChips.forEach(function (item) {
        item.classList.remove('active');
      });

      chip.classList.add('active');

      applyFilter(filter);
    });
  });

  // -----------------------------
  // Sort Helpers
  // -----------------------------
  function getSortableValue(element, sortType) {
    if (sortType === 'progress') {
      return Number(element.dataset.progress || 0);
    }

    if (sortType === 'deadline') {
      return Number(element.dataset.deadline || 0);
    }

    if (sortType === 'newest') {
      return Number(element.dataset.created || 0);
    }

    if (sortType === 'title') {
      return String(element.dataset.title || '').trim();
    }

    return 0;
  }

  function sortElements(container, selector, sortType) {
    if (!container) return;

    const items = Array.from(container.querySelectorAll(selector));

    items.sort(function (a, b) {
      const aValue = getSortableValue(a, sortType);
      const bValue = getSortableValue(b, sortType);

      if (sortType === 'title') {
        return String(aValue).localeCompare(String(bValue), 'fa');
      }

      // newest/progress/deadline descending/ascending logic
      if (sortType === 'deadline') {
        // ددلاین نزدیک‌تر اول
        return aValue - bValue;
      }

      // جدیدترین و پیشرفت بیشتر اول
      return bValue - aValue;
    });

    items.forEach(function (item) {
      container.appendChild(item);
    });
  }

  function applySort(sortType) {
    // Sort Kanban cards inside each column
    document.querySelectorAll('.kanban-cards').forEach(function (cardsContainer) {
      sortElements(cardsContainer, '.kcard[data-status]', sortType);
    });

    // Sort Table rows
    const tableBody = document.querySelector('#tableView tbody');

    if (tableBody) {
      sortElements(tableBody, 'tr[data-status]', sortType);
    }

    // بعد از sort، فیلتر فعلی دوباره اعمال شود
    applyFilter(activeFilter);
  }

  // -----------------------------
  // Sort Event
  // -----------------------------
  if (projectSort) {
    projectSort.addEventListener('change', function () {
      applySort(projectSort.value);
    });
  }

  // -----------------------------
  // Jalali Datepicker
  // -----------------------------
  if (window.jalaliDatepicker) {
    jalaliDatepicker.startWatch();
  }

  // -----------------------------
  // Modal پروژه: المان‌های مشترک فرم
  // -----------------------------
  const projectModal          = document.getElementById('projectModal');
  const projectForm           = document.getElementById('projectForm');
  const projectModalTitle     = document.getElementById('projectModalTitle');
  const projectSubmitBtn      = document.getElementById('projectSubmitBtn');
  const projectIdInput        = document.getElementById('projectIdInput');
  const projectTitleInput     = document.getElementById('projectTitleInput');
  const projectClientSelect   = document.getElementById('projectClientSelect');
  const projectCategorySelect = document.getElementById('projectCategorySelect');
  const projectStatusSelect   = document.getElementById('projectStatusSelect');
  const projectStartDate      = document.getElementById('projectStartDate');
  const projectDeadline       = document.getElementById('projectDeadline');
  const projectDescription    = document.getElementById('projectDescriptionInput');
  const techChecklist         = document.getElementById('techChecklist');
  const newProjectBtn         = document.getElementById('newProjectBtn');
  const projectModalProxy     = document.getElementById('projectModalProxyTrigger');

  function resetTechChecklist() {
    if (!techChecklist) return;

    techChecklist.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
      cb.checked = false;
    });
  }

  function ensureTechCheckbox(value, checked) {
    if (!techChecklist || !value) return;

    let existing = Array.from(techChecklist.querySelectorAll('input[type="checkbox"]'))
      .find(function (cb) { return cb.value === value; });

    if (!existing) {
      const label = document.createElement('label');
      label.className = 'tech-check-item';

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.name = 'techStack[]';
      checkbox.value = value;

      const span = document.createElement('span');
      span.textContent = value;

      label.appendChild(checkbox);
      label.appendChild(span);
      techChecklist.appendChild(label);

      existing = checkbox;
    }

    existing.checked = !!checked;
  }

  function ensureCategoryOption(id, title) {
    if (!projectCategorySelect || !id) return;

    let option = Array.from(projectCategorySelect.options).find(function (o) {
      return o.value === id;
    });

    if (!option) {
      option = document.createElement('option');
      option.value = id;
      option.textContent = title || id;
      projectCategorySelect.appendChild(option);
    }

    projectCategorySelect.value = id;
  }

  function setProjectFormMode(mode, data) {
    data = data || {};

    if (mode === 'edit') {
      projectModalTitle.textContent = 'ویرایش پروژه';
      projectSubmitBtn.innerHTML = '<i class="bi bi-check-lg"></i> ذخیره تغییرات';
      projectForm.action = '/sw-admin/projects/' + data.id + '/edit';
      projectIdInput.value = data.id || '';

      projectTitleInput.value = data.title || '';
      projectDescription.value = data.description || '';
      projectStartDate.value = data.startDate || '';
      projectDeadline.value = data.deadline || '';

      if (projectStatusSelect) {
        projectStatusSelect.value = data.status || 'active';
      }

      if (projectClientSelect && data.client) {
        projectClientSelect.value = data.client;
      }

      resetTechChecklist();

      if (data.category) {
        ensureCategoryOption(data.category, data.categoryTitle);
      }

      (data.tech || []).forEach(function (tech) {
        ensureTechCheckbox(tech, true);
      });

    } else {
      projectModalTitle.textContent = 'پروژه جدید';
      projectSubmitBtn.innerHTML = '<i class="bi bi-check-lg"></i> ثبت پروژه';
      projectForm.action = '/sw-admin/projects/add';
      projectIdInput.value = '';
      projectForm.reset();
      resetTechChecklist();
    }
  }

  if (newProjectBtn) {
    newProjectBtn.addEventListener('click', function () {
      setProjectFormMode('create');
    });
  }

  document.addEventListener('click', function (e) {
    const editBtn = e.target.closest('[data-project-edit]');
    if (!editBtn) return;

    try {
      const data = JSON.parse(editBtn.dataset.project || '{}');
      setProjectFormMode('edit', data);
    } catch (err) {
      console.error('خطا در خواندن اطلاعات پروژه برای ویرایش', err);
    }
  });

  // -----------------------------
  // افزودن «نوع پروژه» جدید به آپشن‌ها
  // -----------------------------
  const addCategoryBtn     = document.getElementById('addCategoryBtn');
  const addCategoryBox     = document.getElementById('addCategoryBox');
  const newCategoryInput   = document.getElementById('newCategoryInput');
  const confirmAddCategory = document.getElementById('confirmAddCategory');

  if (addCategoryBtn && addCategoryBox) {
    addCategoryBtn.addEventListener('click', function () {
      const isHidden = !addCategoryBox.style.display || addCategoryBox.style.display === 'none';
      addCategoryBox.style.display = isHidden ? 'flex' : 'none';

      if (isHidden && newCategoryInput) {
        newCategoryInput.focus();
      }
    });
  }

  function addNewCategory() {
    if (!newCategoryInput || !projectCategorySelect) return;

    const value = (newCategoryInput.value || '').trim();
    if (!value) return;

    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    projectCategorySelect.appendChild(option);
    projectCategorySelect.value = value;

    newCategoryInput.value = '';
    addCategoryBox.style.display = 'none';
  }

  if (confirmAddCategory) {
    confirmAddCategory.addEventListener('click', addNewCategory);
  }

  if (newCategoryInput) {
    newCategoryInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        addNewCategory();
      }
    });
  }

  // -----------------------------
  // افزودن «تکنولوژی» جدید به چک‌باکس‌ها
  // -----------------------------
  const newTechInput = document.getElementById('newTechInput');
  const addTechBtn   = document.getElementById('addTechBtn');

  function addNewTech() {
    if (!newTechInput) return;

    const value = (newTechInput.value || '').trim();
    if (!value) return;

    ensureTechCheckbox(value, true);
    newTechInput.value = '';
  }

  if (addTechBtn) {
    addTechBtn.addEventListener('click', addNewTech);
  }

  if (newTechInput) {
    newTechInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        addNewTech();
      }
    });
  }

  // -----------------------------
  // Modal مشاهده توضیحات پروژه
  // -----------------------------
  const projectViewTitle       = document.getElementById('projectViewTitle');
  const projectViewClient      = document.getElementById('projectViewClient');
  const projectViewCategory    = document.getElementById('projectViewCategory');
  const projectViewStart       = document.getElementById('projectViewStart');
  const projectViewDeadline    = document.getElementById('projectViewDeadline');
  const projectViewTech        = document.getElementById('projectViewTech');
  const projectViewDescription = document.getElementById('projectViewDescription');
  const projectViewEditBtn     = document.getElementById('projectViewEditBtn');

  let currentViewedProject = null;

  document.addEventListener('click', function (e) {
    const viewBtn = e.target.closest('[data-project-view]');
    if (!viewBtn) return;

    try {
      const data = JSON.parse(viewBtn.dataset.project || '{}');
      currentViewedProject = data;

      projectViewTitle.textContent = data.title || 'جزئیات پروژه';
      projectViewClient.textContent = data.clientName || 'بدون مشتری';
      projectViewCategory.textContent = data.categoryTitle || 'بدون نوع';
      projectViewStart.textContent = data.startDate || 'ثبت‌نشده';
      projectViewDeadline.textContent = data.deadline || 'ثبت‌نشده';

      projectViewTech.innerHTML = '';

      if (data.tech && data.tech.length) {
        data.tech.forEach(function (tech) {
          const pill = document.createElement('span');
          pill.className = 'tech-pill';
          pill.textContent = tech;
          projectViewTech.appendChild(pill);
        });
      } else {
        projectViewTech.innerHTML = '<span style="font-size:.78rem;color:var(--color-text-light);">تکنولوژی ثبت نشده است.</span>';
      }

      projectViewDescription.textContent = (data.description && data.description.trim())
        ? data.description
        : 'توضیحی ثبت نشده است.';
    } catch (err) {
      console.error('خطا در خواندن اطلاعات پروژه برای مشاهده', err);
    }
  });

  if (projectViewEditBtn) {
    projectViewEditBtn.addEventListener('click', function () {
      if (!currentViewedProject) return;

      setProjectFormMode('edit', currentViewedProject);

      const viewModal = document.getElementById('projectViewModal');
      if (viewModal) viewModal.classList.remove('show', 'active');

      if (projectModalProxy) projectModalProxy.click();
    });
  }
});
</script>
