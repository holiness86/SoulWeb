<!-- New Project Modal -->
<div class="modal-overlay" id="projectModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">پروژه جدید</div>
      <button id="closeModal" style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="form-row">
      <label class="sol-label">نام پروژه</label>
      <input class="sol-input" type="text" placeholder="مثال: وب‌سایت شرکت آلفا">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">مشتری</label>
        <select class="sol-select">
          <option>انتخاب مشتری…</option><option>کیانی لباس</option><option>گروه پارسیان</option><option>آفیلیو</option>
        </select>
      </div>
      <div class="form-row">
        <label class="sol-label">نوع پروژه</label>
        <select class="sol-select">
          <option>طراحی وب</option><option>فروشگاه</option><option>UI/UX</option><option>وب اپ</option>
        </select>
      </div></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">تاریخ شروع</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۳/۲۱">
      </div>
      <div class="form-row">
        <label class="sol-label">ددلاین</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۴/۱۵">
      </div>
    </div>
    <div class="form-row">
      <label class="sol-label">تکنولوژی</label>
      <input class="sol-input" type="text" placeholder="مثال: PHP · Laravel · React">
    </div>
    <div class="form-row">
      <label class="sol-label">توضیحات</label>
      <textarea class="sol-input" rows="3" placeholder="توضیح مختصر پروژه…" style="resize:vertical;"></textarea>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" id="cancelModal">انصراف</button>
      <button class="btn-sol-sm"><i class="bi bi-check-lg"></i> ثبت پروژه</button>
    </div>
  </div>
</div>

<%- include('partials/_scripts', {
  extraScripts: `<style>
    .pstat {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.25rem;
      display: flex; align-items: center; gap: 1rem;
      transition: all var(--dur-normal) var(--ease-spring);
    }
    .pstat:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); border-color: var(--main-200); }
    .pstat-icon { width:40px; height:40px; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
    .pstat-val { font-size:1.5rem; font-weight:900; line-height:1; }
    .pstat-lbl { font-size:.75rem; color:var(--color-text-muted); margin-top:.2rem; }

    .filter-bar { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin-bottom:1.25rem; }
    .filter-chip {
      padding:.38rem .9rem; border-radius:var(--radius-full); border:1px solid var(--color-border);
      background:var(--color-surface); font-size:.78rem; cursor:pointer; color:var(--color-text-muted);
      transition:all var(--dur-fast);
    }
    .filter-chip.active, .filter-chip:hover { background:var(--main-500); color:#fff; border-color:var(--main-500); }

    .view-toggle { display:flex; border:1px solid var(--color-border); border-radius:var(--radius-sm); overflow:hidden; }
    .view-btn {
      padding:.38rem .7rem; background:var(--color-surface); border:none; cursor:pointer;
      font-size:.85rem; color:var(--color-text-muted); transition:all var(--dur-fast);
    }
    .view-btn.active, .view-btn:not([disabled]):hover { background:var(--main-500); color:#fff; }
    .view-btn[disabled] { opacity:.4; cursor:default; }

    .kanban-board { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; align-items:start; }
    .kanban-col { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); overflow:hidden; }
    .kanban-head { display:flex; align-items:center; justify-content:space-between; padding:.85rem 1rem; border-bottom:1px solid var(--color-border); }
    .kanban-head-title { display:flex; align-items:center; gap:.5rem; font-size:.82rem; font-weight:700; }
    .kanban-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .kanban-count { font-size:.72rem; font-weight:700; background:rgba(100,71,244,.1); color:var(--main-500); padding:.15rem .55rem; border-radius:var(--radius-full); }
    .kanban-cards { padding:.75rem; display:flex; flex-direction:column; gap:.65rem; }
    .kcard {
      background:var(--color-bg); border:1px solid var(--color-border); border-radius:var(--radius-md);
      padding:.85rem; cursor:pointer; transition:all var(--dur-fast);
    }
    .kcard:hover { border-color:var(--main-300); box-shadow:var(--shadow-sm); transform:translateY(-1px); }
    .kcard-title { font-size:.82rem; font-weight:600; margin-bottom:.6rem; line-height:1.4; }
    .kcard-prog { height:4px; background:var(--color-border); border-radius:var(--radius-full); margin-bottom:.6rem; overflow:hidden; }
    .kcard-prog-fill { height:100%; background:var(--grad-main); border-radius:var(--radius-full); }
    .kcard-meta { display:flex; align-items:center; justify-content:space-between; }
    .kcard-due { font-size:.7rem; color:var(--color-text-light); display:flex; align-items:center; gap:.3rem; }
    .kcard-avatars { display:flex; gap:-.25rem; }
    .kcard-av { width:24px; height:24px; border-radius:5px; font-size:.58rem; font-weight:800; color:#fff; display:flex; align-items:center; justify-content:center; border:2px solid var(--color-bg); margin-left:-.3rem; }

    @media(max-width:900px) { .kanban-board { grid-template-columns:repeat(2,1fr); } }
    @media(max-width:560px) { .kanban-board { grid-template-columns:1fr; } }
  </style>
  <script>
    // View toggle
    document.getElementById('viewKanban').addEventListener('click', function() {
      document.getElementById('kanbanView').style.display = '';
      document.getElementById('tableView').style.display = 'none';
      this.classList.add('active');
      document.getElementById('viewTable').classList.remove('active');
    });
    document.getElementById('viewTable').addEventListener('click', function() {
      document.getElementById('tableView').style.display = '';
      document.getElementById('kanbanView').style.display = 'none';
      this.classList.add('active');
      document.getElementById('viewKanban').classList.remove('active');
    });
    // Modal
    const modal = document.getElementById('projectModal');
    document.getElementById('newProjectBtn').addEventListener('click', () => modal.classList.add('active'));
    document.getElementById('closeModal').addEventListener('click', () => modal.classList.remove('active'));
    document.getElementById('cancelModal').addEventListener('click', () => modal.classList.remove('active'));
    modal.addEventListener('click', e => { if(e.target === modal) modal.classList.remove('active'); });</script>
  `
}) %>
