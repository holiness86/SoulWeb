<%# views/sw-admin/projects.ejs %>
<%- include('partials/_head', { title: 'مدیریت پروژه‌ها' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', { activePage: 'projects', adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' } }) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'پروژه‌ها' }],
  searchPlaceholder: 'جستجو در پروژه‌ها…'
}) %>

<main class="page-content">

  <!-- Page Header -->
  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title">مدیریت پروژه‌ها</h1>
      <p class="page-subtitle">۲۴ پروژه فعال · ۸ در انتظار بررسی · ۳ متوقف</p>
    </div>
    <div style="display:flex;gap:.6rem;">
      <button class="btn-ghost-sm"><i class="bi bi-download"></i> خروجی Excel</button>
      <button class="btn-sol-sm" data-modal-open="projectModal"><i class="bi bi-plus-lg"></i> پروژه جدید</button>
    </div>
  </div>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;" class="fade-up fade-up-2">
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(100,71,244,.1);color:var(--main-500);"><i class="bi bi-kanban-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="24" data-suffix="">۲۴</div><div class="pstat-lbl">پروژه فعال</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(34,197,94,.1);color:#16a34a;"><i class="bi bi-check-circle-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="153" data-suffix="">۱۵۳</div><div class="pstat-lbl">تحویل‌داده‌شده</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="bi bi-clock-history"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="8" data-suffix="">۸</div><div class="pstat-lbl">در انتظار ریویو</div></div>
    </div>
    <div class="pstat">
      <div class="pstat-icon" style="background:rgba(239,68,68,.1);color:#dc2626;"><i class="bi bi-pause-circle-fill"></i></div>
      <div><div class="pstat-val text-grad stat-value" data-count="3" data-suffix="">۳</div><div class="pstat-lbl">متوقف‌شده</div></div>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar fade-up fade-up-2" data-filter-group>
    <button class="filter-chip active" data-filter="all">همه</button>
    <button class="filter-chip" data-filter="inprog">در حال انجام</button>
    <button class="filter-chip" data-filter="review">ریویو</button>
    <button class="filter-chip" data-filter="done">تحویل‌شده</button>
    <button class="filter-chip" data-filter="hold">متوقف</button>
    <div style="margin-right:auto;display:flex;gap:.5rem;align-items:center;">
      <select class="sol-select" style="width:auto;font-size:.78rem;padding:.38rem .8rem;">
        <option>مرتب: جدیدترین</option>
        <option>مرتب: ددلاین</option>
        <option>مرتب: پیشرفت</option>
      </select>
      <div style="display:flex;gap:.3rem;">
        <button class="view-btn active" id="viewKanban" title="کانبان"><i class="bi bi-grid-3x3-gap"></i></button>
        <button class="view-btn" id="viewTable" title="جدول"><i class="bi bi-list-ul"></i></button>
      </div>
    </div>
  </div>

  <!-- Kanban View -->
  <div id="kanbanView">
    <div class="kanban-board fade-up fade-up-3">

      <!-- در انتظار -->
      <div class="kanban-col">
        <div class="kanban-head">
          <div class="kanban-head-title"><div class="kanban-dot" style="background:#9899bc;"></div>در انتظار</div>
          <span class="kanban-count">۳</span>
        </div>
        <div class="kanban-cards">
          <div class="kcard">
            <div class="kcard-title">طراحی وب‌سایت استارتاپ ویستا</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:0%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-new">جدید</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۵ تیر</span>
            </div>
            <div style="margin-top:.6rem;display:flex;justify-content:space-between;align-items:center;">
              <div class="kcard-avatars">
                <div class="kcard-av" style="background:var(--grad-main);">علی</div>
                <div class="kcard-av" style="background:linear-gradient(135deg,#0090e8,#4dc3ff);">مح</div>
              </div>
              <span style="font-size:.68rem;color:var(--color-text-light);">PHP · ۰٪</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">اپلیکیشن مدیریت انبار سورنا</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:0%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-new">جدید</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱۲ تیر</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">رابط کاربری اپ سلامت پلاس</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:0%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-new">جدید</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۲۰ تیر</span>
            </div>
          </div>
        </div>
      </div>

      <!-- در حال انجام -->
      <div class="kanban-col">
        <div class="kanban-head">
          <div class="kanban-head-title"><div class="kanban-dot" style="background:#6447f4;"></div>در حال انجام</div>
          <span class="kanban-count">۵</span>
        </div>
        <div class="kanban-cards">
          <div class="kcard">
            <div class="kcard-title">فروشگاه کیانی لباس</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:68%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-inprog">در انجام</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱۵ خرداد</span>
            </div>
            <div style="margin-top:.6rem;display:flex;justify-content:space-between;align-items:center;">
              <div class="kcard-avatars"><div class="kcard-av" style="background:linear-gradient(135deg,#a394fb,#6447f4);">سار</div></div>
              <span style="font-size:.68rem;color:var(--color-text-light);">WooCommerce · ۶۸٪</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">پورتال سازمانی پارسیان</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:42%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-inprog">در انجام</span>
              <span class="kcard-due" style="color:#dc2626;font-weight:700;"><i class="bi bi-exclamation-triangle"></i>فردا!</span>
            </div>
            <div style="margin-top:.6rem;display:flex;justify-content:space-between;align-items:center;">
              <div class="kcard-avatars">
                <div class="kcard-av" style="background:var(--grad-main);">علی</div>
                <div class="kcard-av" style="background:linear-gradient(135deg,#22c55e,#0090e8);">رضا</div>
              </div>
              <span style="font-size:.68rem;color:var(--color-text-light);">Laravel · ۴۲٪</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">فروشگاه دیجیتال آذرنت</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:55%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-inprog">در انجام</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۸ تیر</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">سایت شرکتی پردیس‌گستر</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:78%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-inprog">در انجام</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۲۵ خرداد</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ریویو -->
      <div class="kanban-col">
        <div class="kanban-head">
          <div class="kanban-head-title"><div class="kanban-dot" style="background:#f59e0b;"></div>در ریویو</div>
          <span class="kanban-count">۸</span>
        </div>
        <div class="kanban-cards">
          <div class="kcard">
            <div class="kcard-title">اپلیکیشن مدیریت مالی آفیلیو</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:85%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-review">ریویو</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۲۲ خرداد</span>
            </div>
            <div style="margin-top:.6rem;display:flex;justify-content:space-between;align-items:center;">
              <div class="kcard-avatars"><div class="kcard-av" style="background:linear-gradient(135deg,#f59e0b,#ef4444);">نگر</div></div>
              <span style="font-size:.68rem;color:var(--color-text-light);">React · ۸۵٪</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">داشبورد تحلیل داده هوشمند</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:92%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-review">ریویو</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱۸ خرداد</span>
            </div>
          </div>
          <div class="kcard">
            <div class="kcard-title">وب‌سایت پزشکی دکتر رضایی</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:95%"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-review">ریویو</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱۶ خرداد</span>
            </div>
          </div>
        </div>
      </div>

      <!-- تحویل‌شده -->
      <div class="kanban-col">
        <div class="kanban-head">
          <div class="kanban-head-title"><div class="kanban-dot" style="background:#22c55e;"></div>تحویل‌شده</div>
          <span class="kanban-count">۸</span>
        </div>
        <div class="kanban-cards">
          <div class="kcard" style="opacity:.7;">
            <div class="kcard-title">وب‌سایت شرکتی آتین‌دیزاین</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:100%;background:linear-gradient(135deg,#22c55e,#16a34a)"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-done">تحویل‌شد</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱ خرداد</span>
            </div>
          </div>
          <div class="kcard" style="opacity:.7;">
            <div class="kcard-title">اپ رستوران‌یاب کافه‌نت</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:100%;background:linear-gradient(135deg,#22c55e,#16a34a)"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-done">تحویل‌شد</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۲۰ اردیبهشت</span>
            </div>
          </div>
          <div class="kcard" style="opacity:.7;">
            <div class="kcard-title">سایت خدمات پاک‌سرویس</div>
            <div class="kcard-prog"><div class="kcard-prog-fill" style="width:100%;background:linear-gradient(135deg,#22c55e,#16a34a)"></div></div>
            <div class="kcard-meta">
              <span class="badge-status badge-done">تحویل‌شد</span>
              <span class="kcard-due"><i class="bi bi-calendar3"></i>۱۰ اردیبهشت</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div><!-- /kanbanView -->

  <!-- Table View -->
  <div id="tableView" style="display:none;">
    <div class="dash-panel fade-up fade-up-3">
      <div style="overflow-x:auto;">
        <table class="sol-table">
          <thead>
            <tr>
              <th>#</th><th>نام پروژه</th><th>مشتری</th><th>نوع</th>
              <th>وضعیت</th><th>پیشرفت</th><th>ددلاین</th><th>عملیات</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۱</span></td>
              <td><div style="font-weight:600;">فروشگاه کیانی لباس</div><div style="font-size:.73rem;color:var(--color-text-muted);">WooCommerce</div></td>
              <td>کیانی لباس</td><td>فروشگاه</td>
              <td><span class="badge-status badge-inprog">در انجام</span></td>
              <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:68%"></div></div><span style="font-size:.73rem;color:var(--color-text-muted);">۶۸٪</span></div></td>
              <td style="font-size:.78rem;">۱۵ خرداد</td>
              <td><div style="display:flex;gap:.4rem;">
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;" title="مشاهده"><i class="bi bi-eye"></i></button>
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;" title="ویرایش"><i class="bi bi-pencil"></i></button>
                <button class="btn-danger-sm" style="padding:.28rem .6rem;" title="حذف"><i class="bi bi-trash"></i></button>
              </div></td>
            </tr>
            <tr>
              <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۲</span></td>
              <td><div style="font-weight:600;">پورتال سازمانی پارسیان</div><div style="font-size:.73rem;color:var(--color-text-muted);">Laravel</div></td>
              <td>گروه پارسیان</td><td>وب اپ</td>
              <td><span class="badge-status badge-inprog">در انجام</span></td>
              <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:42%"></div></div><span style="font-size:.73rem;color:#dc2626;font-weight:700;">۴۲٪</span></div></td>
              <td style="font-size:.78rem;color:#dc2626;font-weight:700;">⚠️ فردا!</td>
              <td><div style="display:flex;gap:.4rem;">
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-eye"></i></button>
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-pencil"></i></button>
                <button class="btn-danger-sm" style="padding:.28rem .6rem;"><i class="bi bi-trash"></i></button>
              </div></td>
            </tr>
            <tr>
              <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۳</span></td>
              <td><div style="font-weight:600;">اپلیکیشن مدیریت مالی</div><div style="font-size:.73rem;color:var(--color-text-muted);">React + Node.js</div></td>
              <td>آفیلیو</td><td>UI/UX</td>
              <td><span class="badge-status badge-review">ریویو</span></td>
              <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:85%"></div></div><span style="font-size:.73rem;color:var(--color-text-muted);">۸۵٪</span></div></td>
              <td style="font-size:.78rem;">۲۲ خرداد</td>
              <td><div style="display:flex;gap:.4rem;">
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-eye"></i></button>
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-pencil"></i></button>
                <button class="btn-danger-sm" style="padding:.28rem .6rem;"><i class="bi bi-trash"></i></button>
              </div></td>
            </tr>
            <tr>
              <td><span style="font-size:.75rem;color:var(--color-text-light);">#۱۰۰</span></td>
              <td><div style="font-weight:600;">وب‌سایت شرکتی آتین‌دیزاین</div><div style="font-size:.73rem;color:var(--color-text-muted);">PHP</div></td>
              <td>آتین‌دیزاین</td><td>وب</td>
              <td><span class="badge-status badge-done">تحویل‌شد</span></td>
              <td><div style="display:flex;align-items:center;gap:.5rem;"><div class="prog-bar-mini"><div class="prog-fill" style="width:100%"></div></div><span style="font-size:.73rem;color:#16a34a;font-weight:700;">۱۰۰٪</span></div></td>
              <td style="font-size:.78rem;">۱ خرداد</td>
              <td><div style="display:flex;gap:.4rem;">
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-eye"></i></button>
                <button class="btn-ghost-sm" style="padding:.28rem .6rem;"><i class="bi bi-pencil"></i></button>
                <button class="btn-danger-sm" style="padding:.28rem .6rem;"><i class="bi bi-trash"></i></button>
              </div></td>
            </tr>
            <tr>
              <td><span style="font-size:.75rem;color:var(--color-text-light);">#۰۹۹</span></td>
              <td><div style="font-weight:600;">فروشگاه دیجیتال پرتو</div><div style="font-size:.73rem;color:var(--color-text-muted);">Node.js</div></td>
              <td>شرکت پرتو</td><td>فروشگاه</td>
              <td><span class="badge-status badge-hold">متوقف</span></td>
