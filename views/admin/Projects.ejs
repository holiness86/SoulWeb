</main>
</div><!-- /main-content -->
</div><!-- /admin-shell -->

<!-- Modal: پروژه جدید -->
<div class="modal-overlay" id="projectModal">
  <div class="modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
      <div class="modal-title" style="margin:0;">پروژه جدید</div>
      <button data-modal-close style="background:transparent;border:none;font-size:1.2rem;color:var(--color-text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="form-row">
      <label class="sol-label">نام پروژه</label>
      <input class="sol-input" type="text" placeholder="مثال: وب‌سایت شرکت آلفا">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">مشتری</label>
        <select class="sol-select" style="width:100%">
          <option>انتخاب مشتری…</option>
          <option>کیانی لباس</option><option>گروه پارسیان</option><option>آفیلیو</option>
        </select>
      </div>
      <div class="form-row">
        <label class="sol-label">نوع پروژه</label>
        <select class="sol-select" style="width:100%">
          <option>طراحی وب</option><option>فروشگاه</option><option>UI/UX</option><option>وب اپ</option>
        </select>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div class="form-row">
        <label class="sol-label">تاریخ شروع</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۳/۲۱">
      </div>
      <div class="form-row">
        <label class="sol-label">ددلاین</label>
        <input class="sol-input" type="text" placeholder="۱۴۰۴/۰۴/۱۵">
      </div>
    </div>
    <div class="form-row">
      <label class="sol-label">تکنولوژی</label>
      <input class="sol-input" type="text" placeholder="مثال: PHP · Laravel · React">
    </div>
    <div class="form-row">
      <label class="sol-label">توضیحات</label>
      <textarea class="sol-input" rows="3" placeholder="توضیح مختصر پروژه…" style="resize:vertical;"></textarea>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem;">
      <button class="btn-ghost-sm" data-modal-close>انصراف</button>
      <button class="btn-sol-sm"><i class="bi bi-check-lg"></i> ثبت پروژه</button>
    </div>
  </div>
</div>

<%- include('partials/_scripts', { extraScripts: `
<style>
.pstat{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.1rem 1.25rem;display:flex;align-items:center;gap:.85rem;transition:all var(--dur-normal) var(--ease-spring)}
