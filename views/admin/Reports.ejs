<%# views/admin/Reports.ejs — گزارش‌ها و آمار عملکرد
    ورودی‌ها از server.js (روت /sw-admin/reports): range, rangeLabel, months[], series{revenue,projects,done,clients}, kpi, types[], topClients[], invoiceStatus
    اگر هنوز روت قدیمی (فقط stats) فعال باشد، صفحه در حالت ساده نمایش داده می‌شود.
    خروجی‌ها: به روت‌های موجود لینک می‌شوند (فاکتورها PDF، پروژه‌ها Excel، مشتریان CSV) + چاپ/PDF صفحه %>
<%
  const full = typeof kpi !== 'undefined' && kpi;
  const fa = (n) => Number(n || 0).toLocaleString('fa-IR');
  const compact = (n) => {
    n = Number(n) || 0;
    if (n >= 1e9) return fa(+(n / 1e9).toFixed(1)) + ' میلیارد';
    if (n >= 1e6) return fa(+(n / 1e6).toFixed(1)) + ' میلیون';
    if (n >= 1e3) return fa(+(n / 1e3).toFixed(1)) + ' هزار';
    return fa(n);
  };
  const niceMax = (v) => { if (v <= 0) return 1; const p = Math.pow(10, Math.floor(Math.log10(v))), f = v / p; return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p; };

  const mon   = full ? months : [];
  const ser   = full ? series : { revenue: [], projects: [], done: [], clients: [] };
  const n     = mon.length;

  // نمودار درآمد (محور زمان از راست به چپ، مثل جهت متن)
  const W = 600, TOP = 20, BASE = 190, PAD = 30;
  const revMax = niceMax(Math.max.apply(null, ser.revenue.concat([0])));
  const rx = (i) => W - PAD - (n > 1 ? i * (W - PAD * 2) / (n - 1) : 0);
  const ry = (v) => BASE - (v / revMax) * (BASE - TOP);
  const revPts = ser.revenue.map((v, i) => [rx(i), ry(v)]);
  const linePath = revPts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const areaPath = revPts.length ? linePath + ' L' + revPts[revPts.length - 1][0].toFixed(1) + ',' + BASE + ' L' + revPts[0][0].toFixed(1) + ',' + BASE + ' Z' : '';
  const hasRevenue = ser.revenue.some((v) => v > 0);

  const spark = (arr) => {
    const mx = Math.max.apply(null, arr.concat([1]));
    return arr.map((v, i) => (i ? 'L' : 'M') + (100 - (arr.length > 1 ? i * 100 / (arr.length - 1) : 0)).toFixed(1) + ',' + (26 - (v / mx) * 24).toFixed(1)).join(' ');
  };

  // دونات وضعیت فاکتورها
  const ST = [
    { k: 'paid', t: 'پرداخت‌شده', c: '#22c55e' }, { k: 'sent', t: 'در انتظار', c: '#f59e0b' },
    { k: 'overdue', t: 'معوق', c: '#ef4444' }, { k: 'draft', t: 'پیش‌نویس', c: '#6447f4' }, { k: 'cancelled', t: 'لغوشده', c: '#9899bc' }
  ];
  const inv = full ? invoiceStatus : {};
  const invTotal = ST.reduce((s, x) => s + (inv[x.k] || 0), 0);
  let acc = 0;
  const donut = ST.map((x) => { const pct = invTotal ? (inv[x.k] || 0) / invTotal * 100 : 0; const seg = { ...x, count: inv[x.k] || 0, pct, off: 25 - acc }; acc += pct; return seg; });

  const typeMax = full && types.length ? Math.max.apply(null, types.map((t) => t.count)) : 1;
  const TYPE_COLORS = ['var(--grad-main)', 'linear-gradient(135deg,#0090e8,#4dc3ff)', 'linear-gradient(135deg,#a394fb,#6447f4)', 'linear-gradient(135deg,#22c55e,#0090e8)', 'linear-gradient(135deg,#f59e0b,#ef4444)', 'linear-gradient(135deg,#6d6e94,#9899bc)'];
  const initials = (nm) => (nm || '؟').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('‌');
  const trendChip = (t) => t === null || t === undefined ? '' : '<span class="stat-trend ' + (t >= 0 ? 'up' : 'down') + '"><i class="bi bi-arrow-' + (t >= 0 ? 'up' : 'down') + '-short"></i>' + fa(Math.abs(t)) + '٪</span>';
%>
<%- include('partials/_head', { title: 'گزارش‌ها و آمار' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'reports' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'گزارش‌ها' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content" id="repPage">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">گزارش‌ها و آمار عملکرد</h1>
          <p class="page-subtitle">نمای کلی از وضعیت کسب‌وکار — <%= full ? rangeLabel : 'خلاصه' %></p>
        </div>
        <div class="d-flex gap-2 sw-noprint">
          <% if (full) { %>
            <select class="sol-select" id="rangeSel" aria-label="بازهٔ زمانی">
              <option value="6m" <%= range === '6m' ? 'selected' : '' %>>۶ ماه اخیر</option>
              <option value="12m" <%= range === '12m' ? 'selected' : '' %>>۱۲ ماه اخیر</option>
              <option value="year" <%= range === 'year' ? 'selected' : '' %>>امسال</option>
              <option value="lastyear" <%= range === 'lastyear' ? 'selected' : '' %>>سال گذشته</option>
            </select>
          <% } %>
          <button type="button" class="btn-sol-sm" id="printBtn"><i class="bi bi-file-earmark-pdf"></i> دانلود / چاپ گزارش</button>
        </div>
      </div>

      <% if (!full) { %>
        <!-- حالت ساده: روت قدیمی فقط stats می‌فرستد -->
        <div class="sw-note">برای نمایش نمودارها و مقایسهٔ بازه‌ها، روت <code>/sw-admin/reports</code> را با نسخهٔ جدید جایگزین کنید. فعلاً فقط خلاصهٔ آمار نمایش داده می‌شود.</div>
        <% const st = (typeof stats !== 'undefined' && stats) ? stats : {}; %>
        <div class="sw-g c4 fade-up fade-up-2">
          <div class="pstat"><div class="pstat-icon ok"><i class="bi bi-cash-coin"></i></div><div><div class="pstat-val money"><%= compact(st.totalRevenue) %></div><div class="pstat-lbl">درآمد پرداخت‌شده (تومان)</div></div></div>
          <div class="pstat"><div class="pstat-icon"><i class="bi bi-kanban-fill"></i></div><div><div class="pstat-val text-grad"><%= fa(st.totalProjects) %></div><div class="pstat-lbl">کل پروژه‌ها</div></div></div>
          <div class="pstat"><div class="pstat-icon accent"><i class="bi bi-people-fill"></i></div><div><div class="pstat-val text-grad"><%= fa(st.totalClients) %></div><div class="pstat-lbl">کل مشتریان</div></div></div>
          <div class="pstat"><div class="pstat-icon warn"><i class="bi bi-star-fill"></i></div><div><div class="pstat-val text-grad"><%= fa(st.totalReviews) %></div><div class="pstat-lbl">نظرات تأییدشده</div></div></div>
        </div>
      <% } else { %>

      <!-- KPI -->
      <div class="sw-g c4 fade-up fade-up-2">
        <div class="kpi-card">
          <div class="kpi-top"><div class="pstat-icon"><i class="bi bi-cash-coin"></i></div><%- trendChip(kpi.revenue.trend) %></div>
          <div class="kpi-val text-grad"><%= compact(kpi.revenue.value) %></div>
          <div class="kpi-lbl">درآمد دریافتی (تومان)</div>
          <svg class="kpi-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="<%= spark(ser.revenue) %>" pathLength="1" class="spark-line" style="stroke:var(--main-500);"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-top"><div class="pstat-icon ok"><i class="bi bi-kanban-fill"></i></div><%- trendChip(kpi.done.trend) %></div>
          <div class="kpi-val text-grad"><%= fa(kpi.done.value) %></div>
          <div class="kpi-lbl">پروژه تحویل‌شده</div>
          <svg class="kpi-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="<%= spark(ser.done) %>" pathLength="1" class="spark-line" style="stroke:#16a34a;"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-top"><div class="pstat-icon accent"><i class="bi bi-people-fill"></i></div><%- trendChip(kpi.newClients.trend) %></div>
          <div class="kpi-val text-grad"><%= fa(kpi.newClients.value) %></div>
          <div class="kpi-lbl">مشتری جدید (از <%= fa(kpi.newClients.active) %> مشتری فعال)</div>
          <svg class="kpi-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="<%= spark(ser.clients) %>" pathLength="1" class="spark-line" style="stroke:#0090e8;"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-top"><div class="pstat-icon warn"><i class="bi bi-star-fill"></i></div></div>
          <div class="kpi-val text-grad"><%= kpi.rating.avg ? fa(kpi.rating.avg) : '—' %></div>
          <div class="kpi-lbl"><%= kpi.rating.count ? 'میانگین امتیاز از ' + fa(kpi.rating.count) + ' نظر تأییدشده' : 'هنوز نظر امتیازداری ثبت نشده' %></div>
          <div class="kpi-stars" aria-hidden="true"><% for (let i = 1; i <= 5; i++) { %><i class="bi <%= kpi.rating.avg && i <= Math.round(kpi.rating.avg) ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></div>
        </div>
      </div>

      <!-- نمودار درآمد + وضعیت فاکتورها -->
      <div class="rep-grid fade-up fade-up-3">
        <div class="dash-panel">
          <div class="panel-header"><h2 class="panel-title"><i class="bi bi-graph-up" style="color:var(--main-500);"></i> روند درآمد ماهانه</h2><span class="cell-sub">تومان</span></div>
          <div class="rep-chart">
            <% if (!hasRevenue) { %>
              <div class="sw-empty"><i class="bi bi-graph-up"></i>در این بازه فاکتور پرداخت‌شده‌ای ثبت نشده است.</div>
            <% } else { %>
            <svg viewBox="0 0 600 224" class="rep-svg" role="img" aria-label="نمودار روند درآمد ماهانه">
              <defs>
                <linearGradient id="revg" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#6447f4"/><stop offset="100%" stop-color="#0090e8"/></linearGradient>
                <linearGradient id="revfill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#6447f4" stop-opacity=".28"/><stop offset="100%" stop-color="#6447f4" stop-opacity="0"/></linearGradient>
              </defs>
              <% for (let g = 0; g <= 3; g++) { const gy = BASE - g * (BASE - TOP) / 3; %>
                <line x1="0" y1="<%= gy %>" x2="600" y2="<%= gy %>" class="rep-grid-line"/>
                <% if (g > 0) { %><text x="6" y="<%= gy - 5 %>" class="rep-ylabel" text-anchor="end"><%= compact(revMax * g / 3) %></text><% } %>
              <% } %>
              <path d="<%= areaPath %>" fill="url(#revfill)" class="rep-area"/>
              <path d="<%= linePath %>" fill="none" stroke="url(#revg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="rep-line"/>
              <% revPts.forEach(function (p, i) { %>
                <circle cx="<%= p[0].toFixed(1) %>" cy="<%= p[1].toFixed(1) %>" r="4.5" class="rep-dot" tabindex="0" data-tip="<%= mon[i] %>: <%= fa(ser.revenue[i]) %> تومان" aria-label="<%= mon[i] %>: <%= fa(ser.revenue[i]) %> تومان"/>
                <text x="<%= p[0].toFixed(1) %>" y="214" class="rep-xlabel" text-anchor="middle"><%= mon[i] %></text>
              <% }); %>
            </svg>
            <% } %>
          </div>
        </div>

        <div class="dash-panel">
          <div class="panel-header"><h2 class="panel-title"><i class="bi bi-pie-chart-fill" style="color:var(--main-500);"></i> وضعیت فاکتورها</h2></div>
          <div class="rep-chart">
            <% if (!invTotal) { %>
              <div class="sw-empty"><i class="bi bi-receipt"></i>در این بازه فاکتوری صادر نشده است.</div>
            <% } else { %>
            <div class="donut-wrap">
              <svg viewBox="0 0 42 42" width="150" height="150" role="img" aria-label="نمودار وضعیت فاکتورها">
                <circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--color-border)" stroke-width="4"/>
                <% donut.forEach(function (d) { if (d.pct > 0) { %>
                  <circle cx="21" cy="21" r="15.9" fill="none" stroke="<%= d.c %>" stroke-width="4" stroke-dasharray="<%= Math.max(d.pct - 0.6, 0.1).toFixed(2) %> <%= (100 - Math.max(d.pct - 0.6, 0.1)).toFixed(2) %>" stroke-dashoffset="<%= d.off.toFixed(2) %>" class="donut-seg"/>
                <% } }); %>
              </svg>
              <div class="donut-center"><div class="donut-val"><%= fa(invTotal) %></div><div class="donut-sub">فاکتور</div></div>
            </div>
            <div class="traffic-list">
              <% donut.forEach(function (d) { %>
                <div class="traffic-item"><span class="t-dot" style="background:<%= d.c %>;"></span><span class="t-name"><%= d.t %></span><span class="t-pct"><%= fa(d.count) %></span></div>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- نوع پروژه‌ها + برترین مشتریان -->
      <div class="rep-grid even fade-up fade-up-4">
        <div class="dash-panel">
          <div class="panel-header"><h2 class="panel-title"><i class="bi bi-bar-chart-fill" style="color:var(--main-500);"></i> پروژه‌های ثبت‌شده بر اساس نوع</h2></div>
          <div class="rep-chart rep-hbars">
            <% if (!types.length) { %><div class="sw-empty"><i class="bi bi-kanban"></i>در این بازه پروژه‌ای ثبت نشده است.</div><% } %>
            <% types.forEach(function (t, i) { %>
              <div class="hbar-row">
                <span class="hbar-label"><%= t.title %></span>
                <div class="hbar-track"><div class="hbar-fill" style="width:<%= Math.round(t.count / typeMax * 100) %>%;background:<%= TYPE_COLORS[i % TYPE_COLORS.length] %>;"></div></div>
                <span class="hbar-val"><%= fa(t.count) %></span>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="dash-panel">
          <div class="panel-header"><h2 class="panel-title"><i class="bi bi-trophy-fill" style="color:var(--main-500);"></i> برترین مشتریان (بر اساس درآمد)</h2></div>
          <div class="rep-clients">
            <% if (!topClients.length) { %><div class="sw-empty"><i class="bi bi-people"></i>در این بازه پرداختی ثبت نشده است.</div><% } %>
            <% topClients.forEach(function (c, i) { %>
              <div class="top-client-row">
                <span class="rank-badge <%= ['gold', 'silver', 'bronze'][i] || '' %>"><%= fa(i + 1) %></span>
                <div class="cl-av av-<%= i % 6 + 1 %>"><%= initials(c.name) %></div>
                <div class="top-client-info"><div class="cell-title"><%= c.name %></div><div class="cell-sub"><%= fa(c.projects) %> پروژه</div></div>
                <span class="top-client-val text-grad"><%= compact(c.revenue) %></span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <% } %>

      <!-- خروجی‌ها -->
      <div class="dash-panel fade-up fade-up-5 sw-noprint" style="margin-top:var(--sw-s3);">
        <div class="panel-header"><h2 class="panel-title"><i class="bi bi-download" style="color:var(--main-500);"></i> دانلود گزارش‌ها</h2></div>
        <div class="rep-exports">
          <a class="export-btn" href="/sw-admin/invoices/export/pdf"><i class="bi bi-cash-coin"></i><span>گزارش مالی (PDF فاکتورها)</span></a>
          <a class="export-btn" href="/sw-admin/projects/export"><i class="bi bi-kanban-fill"></i><span>گزارش پروژه‌ها (Excel)</span></a>
          <a class="export-btn" href="/sw-admin/clients/export"><i class="bi bi-people-fill"></i><span>گزارش مشتریان (CSV)</span></a>
        </div>
      </div>

    </main>
  </div>
</div>

<div class="rep-tip" id="repTip" role="tooltip" hidden></div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }

  var sel = $('#rangeSel');
  if (sel) sel.addEventListener('change', function () { location.search = '?range=' + sel.value; });
  $('#printBtn').addEventListener('click', function () { window.print(); });

  /* ───────── تولتیپ نمودار (ماوس + فوکوس کیبورد) ───────── */
  var tip = $('#repTip');
  function show(el) {
    tip.textContent = el.dataset.tip; tip.hidden = false;
    var r = el.getBoundingClientRect(), t = tip.getBoundingClientRect();
    tip.style.left = Math.max(8, Math.min(window.innerWidth - t.width - 8, r.left + r.width / 2 - t.width / 2)) + 'px';
    tip.style.top = (r.top - t.height - 10) + 'px';
  }
  document.addEventListener('mouseover', function (e) { var d = e.target.closest('.rep-dot'); if (d) show(d); });
  document.addEventListener('focusin', function (e) { var d = e.target.closest && e.target.closest('.rep-dot'); if (d) show(d); });
  document.addEventListener('mouseout', function (e) { if (e.target.closest && e.target.closest('.rep-dot')) tip.hidden = true; });
  document.addEventListener('focusout', function () { tip.hidden = true; });
  window.addEventListener('scroll', function () { tip.hidden = true; }, { passive: true });
});
</script>

<%- include('partials/_scripts') %>
