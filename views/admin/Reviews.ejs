<%# views/admin/Reviews.ejs — مدیریت نظرات مشتریان
    ورودی‌ها از server.js: reviews (با populate('client','name') و populate('project','title'))
    روت‌ها: POST /sw-admin/reviews/:id/status (JSON) · /:id/delete · /save (افزودن/ویرایش)
    ⚠️ نام فیلدهای مدل Review را من نمی‌دانم؛ همهٔ نگاشت فیلدها فقط در بلوک «normalize» پایین انجام می‌شود (یک جا ویرایش کنید). %>
<%
  const list = Array.isArray(reviews) ? reviews : [];
  const fa = (n) => Number(n || 0).toLocaleString('fa-IR');

  // ── نگاشت فیلدهای مدل → فیلدهای صفحه (اگر مدل‌تان اسم دیگری دارد، فقط همین‌جا عوض کنید) ──
  const normalize = (r) => ({
    id: String(r._id),
    name: r.name || r.clientName || r.authorName || (r.client && r.client.name) || 'بدون نام',
    company: r.company || r.position || r.role || (r.client && r.client.company) || '',
    text: r.text || r.comment || r.content || r.body || r.message || '',
    rating: Math.max(0, Math.min(5, Math.round(Number(r.rating) || 0))),
    approved: !!r.isApproved,
    published: !!r.isPublished,
    project: (r.project && r.project.title) ? r.project.title : '',
    createdAt: r.createdAt
  });
  const rows = list.map(normalize);

  const ago = (v) => {
    const s = Math.round((Date.now() - new Date(v).getTime()) / 1000);
    if (!isFinite(s)) return '';
    if (s < 60) return 'همین الان';
    const m = Math.round(s / 60); if (m < 60) return fa(m) + ' دقیقه پیش';
    const h = Math.round(m / 60); if (h < 24) return fa(h) + ' ساعت پیش';
    const d = Math.round(h / 24); if (d < 30) return d === 1 ? 'دیروز' : fa(d) + ' روز پیش';
    return new Date(v).toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' });
  };
  const initials = (n) => (n || '؟').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('‌');
  const avClass = (id) => 'av-' + ((parseInt(id.slice(-2), 16) || 0) % 6 + 1);

  const approvedRated = rows.filter((r) => r.approved && r.rating > 0);
  const avg = approvedRated.length ? approvedRated.reduce((s, r) => s + r.rating, 0) / approvedRated.length : 0;
  const dist = [5, 4, 3, 2, 1].map((n) => ({ n, c: approvedRated.filter((r) => r.rating === n).length }));
  const pendingCount = rows.filter((r) => !r.approved).length;
  const publishedCount = rows.filter((r) => r.published).length;
%>
<%- include('partials/_head', { title: 'مدیریت نظرات' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'reviews' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'نظرات' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content" id="revPage">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">مدیریت نظرات مشتریان</h1>
          <p class="page-subtitle"><span id="subTotal"><%= fa(rows.length) %></span> نظر ثبت‌شده · <span id="subPending"><%= fa(pendingCount) %></span> نظر در انتظار تأیید</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/#reviews" class="btn-ghost-sm" target="_blank" rel="noopener"><i class="bi bi-eye"></i> مشاهده در سایت</a>
          <button type="button" class="btn-sol-sm" id="newReviewBtn" data-modal-open="reviewModal"><i class="bi bi-plus-lg"></i> افزودن نظر</button>
        </div>
      </div>

      <!-- خلاصه امتیازها (فقط نظرات تأییدشده) -->
      <div class="rev-summary fade-up fade-up-2">
        <div class="rev-score-box">
          <div class="rev-score" id="revAvg"><%= avg ? fa(Math.round(avg * 10) / 10) : '—' %></div>
          <div class="rev-stars-lg" id="revAvgStars" aria-hidden="true"><% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= Math.round(avg) ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></div>
          <div class="rev-score-sub">از <span id="revAvgCount"><%= fa(approvedRated.length) %></span> نظر امتیازدار</div>
        </div>

        <div class="rev-bars" id="revBars">
          <% dist.forEach(function (d) { %>
            <div class="rev-bar-row" data-star="<%= d.n %>">
              <span><%= fa(d.n) %> ستاره</span>
              <div class="rev-bar-track"><div class="rev-bar-fill" style="width:<%= approvedRated.length ? Math.round(d.c / approvedRated.length * 100) : 0 %>%;"></div></div>
              <span class="rev-bar-count"><%= fa(d.c) %></span>
            </div>
          <% }); %>
        </div>

        <div class="rev-mini-stats">
          <div class="rmini"><div class="rmini-val text-grad" id="miniTotal"><%= fa(rows.length) %></div><div class="rmini-lbl">کل نظرات</div></div>
          <div class="rmini"><div class="rmini-val rmini-warn" id="miniPending"><%= fa(pendingCount) %></div><div class="rmini-lbl">در انتظار تأیید</div></div>
          <div class="rmini"><div class="rmini-val text-grad" id="miniPublished"><%= fa(publishedCount) %></div><div class="rmini-lbl">نمایش در صفحه اصلی</div></div>
        </div>
      </div>

      <!-- فیلتر / جستجو -->
      <div class="filter-bar fade-up fade-up-2" role="toolbar" aria-label="فیلتر نظرات">
        <button type="button" class="filter-chip active" data-filter="all">همه</button>
        <button type="button" class="filter-chip" data-filter="pending">در انتظار تأیید <span class="filter-count alert" id="chipPending"><%= fa(pendingCount) %></span></button>
        <button type="button" class="filter-chip" data-filter="approved">تأییدشده</button>
        <button type="button" class="filter-chip" data-filter="published">نمایش‌داده‌شده</button>
        <button type="button" class="filter-chip" data-filter="5star">۵ ستاره</button>

        <div class="tools">
          <label class="sw-search" aria-label="جستجو در نظرات">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="revSearch" placeholder="نام، شرکت یا متن نظر…" autocomplete="off">
          </label>
        </div>
      </div>

      <!-- لیست نظرات -->
      <div class="rev-grid fade-up fade-up-3" id="revGrid">
        <% rows.forEach(function (r, idx) { %>
          <article class="rev-card <%= r.approved ? '' : 'pending' %>" style="--i:<%= Math.min(idx, 8) %>"
                   data-id="<%= r.id %>" data-approved="<%= r.approved %>" data-published="<%= r.published %>" data-rating="<%= r.rating %>" data-name="<%= r.name %>"
                   data-q="<%= [r.name, r.company, r.text, r.project].join(' ') %>"
                   data-review="<%= JSON.stringify({ id: r.id, name: r.name, company: r.company, rating: r.rating, text: r.text, published: r.published }) %>">

            <div class="rev-card-top">
              <div class="rev-who">
                <div class="cl-av <%= avClass(r.id) %>"><%= initials(r.name) %></div>
                <div>
                  <div class="rev-name"><%= r.name %></div>
                  <div class="rev-meta"><%= [r.company, ago(r.createdAt)].filter(Boolean).join(' · ') %></div>
                </div>
              </div>
              <div class="rev-state">
                <span class="badge-status <%= r.approved ? 'badge-done' : 'badge-review' %>" data-badge><%= r.approved ? 'تأییدشده' : 'در انتظار' %></span>
                <label class="sw-toggle sw-toggle-sm" title="نمایش در صفحه اصلی" data-pub-wrap <%= r.approved ? '' : 'hidden' %>>
                  <input type="checkbox" data-pub-toggle aria-label="نمایش نظر «<%= r.name %>» در صفحه اصلی" <%= r.published ? 'checked' : '' %>><span class="sw-slider"></span>
                </label>
              </div>
            </div>

            <% if (r.rating > 0) { %>
              <div class="rev-stars" role="img" aria-label="امتیاز <%= r.rating %> از ۵"><% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= r.rating ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></div>
            <% } %>
            <p class="rev-text"><%= r.text || 'متنی ثبت نشده است.' %></p>
            <% if (r.project) { %><div class="rev-project"><i class="bi bi-kanban"></i> <%= r.project %></div><% } %>

            <div class="rev-actions">
              <button type="button" class="btn-sol-sm" data-approve <%= r.approved ? 'hidden' : '' %>><i class="bi bi-check-lg"></i> تأیید</button>
              <button type="button" class="btn-ghost-sm" data-modal-open="reviewModal" data-review-edit><i class="bi bi-pencil"></i> ویرایش</button>
              <form action="/sw-admin/reviews/<%= r.id %>/delete" method="POST" class="rev-del" data-sw-confirm="نظر «<%= r.name %>» حذف شود؟ این کار قابل بازگشت نیست.">
                <button type="submit" class="btn-danger-sm" data-del-btn><i class="bi <%= r.approved ? 'bi-trash' : 'bi-x-lg' %>"></i> <span data-del-label><%= r.approved ? 'حذف' : 'رد' %></span></button>
              </form>
            </div>
          </article>
        <% }); %>

        <div class="sw-empty rev-empty" id="revNoMatch" hidden><i class="bi bi-search"></i>نظری با این فیلتر پیدا نشد.</div>
        <% if (!rows.length) { %><div class="sw-empty rev-empty"><i class="bi bi-chat-heart"></i>هنوز نظری ثبت نشده است.</div><% } %>
      </div>

    </main>
  </div>
</div>

<!-- Modal: افزودن / ویرایش نظر -->
<div class="modal-overlay" id="reviewModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title" id="reviewModalTitle">افزودن نظر</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>

    <form action="/sw-admin/reviews/save" method="POST" id="reviewForm" data-validate novalidate>
      <input type="hidden" name="id" id="reviewId">

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="reviewName">نام مشتری</label>
          <input class="sol-input" type="text" name="name" id="reviewName" placeholder="نام و نام‌خانوادگی" data-rule="required" autocomplete="off">
        </div>
        <div class="sw-field">
          <label class="sol-label" for="reviewCompany">شرکت / سمت</label>
          <input class="sol-input" type="text" name="company" id="reviewCompany" placeholder="مثال: مدیر فروشگاه اسیل" autocomplete="off">
        </div>
      </div>

      <div class="sw-field">
        <span class="sol-label" id="ratingLabel">امتیاز</span>
        <div class="star-pick" id="starPick" role="radiogroup" aria-labelledby="ratingLabel">
          <% for (let i = 1; i <= 5; i++) { %><button type="button" role="radio" aria-checked="false" aria-label="<%= i %> ستاره" data-star="<%= i %>"><i class="bi bi-star-fill"></i></button><% } %>
        </div>
        <input type="hidden" name="rating" id="reviewRating" value="5">
      </div>

      <div class="sw-field">
        <label class="sol-label" for="reviewText">متن نظر</label>
        <textarea class="sol-input" name="text" id="reviewText" rows="4" placeholder="متن نظر مشتری…" data-rule="required"></textarea>
      </div>

      <div class="sw-field">
        <label class="sw-switch-row">
          <span class="sw-toggle"><input type="checkbox" name="isPublished" id="reviewPublished" checked><span class="sw-slider"></span></span>
          <span>نمایش در صفحه اصلی وب‌سایت</span>
        </label>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button type="submit" class="btn-sol-sm"><i class="bi bi-check-lg"></i> ذخیره نظر</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return Number(v).toLocaleString('fa-IR'); }
  function norm(s) { return String(s || '').replace(/ي/g, 'ی').replace(/ك/g, 'ک').toLowerCase(); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var grid = $('#revGrid'), cards = $$('.rev-card', grid), state = { filter: 'all', q: '' };
  function isOn(c, k) { return c.dataset[k] === 'true'; }

  /* ───────── فیلتر + جستجو ───────── */
  function apply() {
    var q = norm(state.q), shown = 0;
    cards.forEach(function (c) {
      var f = state.filter, ok = f === 'all' || (f === 'pending' && !isOn(c, 'approved')) || (f === 'approved' && isOn(c, 'approved')) ||
              (f === 'published' && isOn(c, 'published')) || (f === '5star' && c.dataset.rating === '5');
      ok = ok && (!q || norm(c.dataset.q).indexOf(q) > -1);
      c.hidden = !ok; if (ok) shown++;
    });
    $('#revNoMatch').hidden = !(cards.length && !shown);
  }
  $$('.filter-chip[data-filter]').forEach(function (chip) {
    chip.addEventListener('click', function () {
      $$('.filter-chip[data-filter]').forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active'); state.filter = chip.dataset.filter; apply();
    });
  });
  var t = 0;
  $('#revSearch').addEventListener('input', function (e) { clearTimeout(t); t = setTimeout(function () { state.q = e.target.value.trim(); apply(); }, 90); });

  /* ───────── آمار زنده (خلاصهٔ امتیاز، شمارنده‌ها) ───────── */
  function recompute() {
    var rated = cards.filter(function (c) { return isOn(c, 'approved') && Number(c.dataset.rating) > 0; });
    var sum = rated.reduce(function (s, c) { return s + Number(c.dataset.rating); }, 0), avg = rated.length ? sum / rated.length : 0;
    $('#revAvg').textContent = avg ? fa(Math.round(avg * 10) / 10) : '—';
    $$('#revAvgStars i').forEach(function (i, idx) { i.className = 'bi ' + (idx + 1 <= Math.round(avg) ? 'bi-star-fill' : 'bi-star'); });
    $('#revAvgCount').textContent = fa(rated.length);
    $$('.rev-bar-row', $('#revBars')).forEach(function (row) {
      var n = Number(row.dataset.star), c = rated.filter(function (x) { return Number(x.dataset.rating) === n; }).length;
      $('.rev-bar-fill', row).style.width = (rated.length ? Math.round(c / rated.length * 100) : 0) + '%'; $('.rev-bar-count', row).textContent = fa(c);
    });
    var pending = cards.filter(function (c) { return !isOn(c, 'approved'); }).length, pub = cards.filter(function (c) { return isOn(c, 'published'); }).length;
    ['subPending', 'miniPending', 'chipPending'].forEach(function (id) { $('#' + id).textContent = fa(pending); });
    $('#miniPublished').textContent = fa(pub); $('#subTotal').textContent = fa(cards.length); $('#miniTotal').textContent = fa(cards.length);
  }

  /* ───────── API ───────── */
  function post(url, data) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.success) throw new Error(j.message || 'خطا در ارتباط با سرور'); return j; }); });
  }
  function paint(c, approved, published) {
    c.dataset.approved = String(approved); c.dataset.published = String(published);
    c.classList.toggle('pending', !approved);
    var b = $('[data-badge]', c); b.className = 'badge-status ' + (approved ? 'badge-done' : 'badge-review'); b.textContent = approved ? 'تأییدشده' : 'در انتظار';
    $('[data-pub-wrap]', c).hidden = !approved; $('[data-pub-toggle]', c).checked = published;
    $('[data-approve]', c).hidden = approved;
    $('[data-del-label]', c).textContent = approved ? 'حذف' : 'رد'; $('[data-del-btn] i', c).className = 'bi ' + (approved ? 'bi-trash' : 'bi-x-lg');
    try { var d = JSON.parse(c.dataset.review); d.published = published; c.dataset.review = JSON.stringify(d); } catch (e) {}
  }
  function change(c, approved, published, okMsg, undoable) {
    var pa = isOn(c, 'approved'), pp = isOn(c, 'published');
    paint(c, approved, published); recompute(); apply();
    return post('/sw-admin/reviews/' + c.dataset.id + '/status', { isApproved: approved, isPublished: published }).then(function () {
      if (okMsg) toast(okMsg, { type: 'success', detail: c.dataset.name, ms: undoable ? 5000 : 2200, actions: undoable ? [{ label: 'بازگردانی', fn: function () { change(c, pa, pp, '', false); } }] : [] });
    }).catch(function (err) { paint(c, pa, pp); recompute(); apply(); toast(err.message || 'تغییر انجام نشد', { type: 'error' }); });
  }
  grid.addEventListener('click', function (e) {
    var a = e.target.closest('[data-approve]');
    if (a) change(a.closest('.rev-card'), true, true, 'نظر تأیید و در سایت نمایش داده شد', true);
  });
  grid.addEventListener('change', function (e) {
    var cb = e.target.closest('[data-pub-toggle]'); if (!cb) return;
    change(cb.closest('.rev-card'), true, cb.checked, cb.checked ? 'نظر در صفحه اصلی نمایش داده می‌شود' : 'نظر از صفحه اصلی مخفی شد', false);
  });

  /* ───────── مودال افزودن / ویرایش + انتخاب ستاره ───────── */
  var form = $('#reviewForm'), title = $('#reviewModalTitle'), star = $('#starPick'), rating = $('#reviewRating');
  function setStars(n) {
    rating.value = n;
    $$('button', star).forEach(function (b) { var on = Number(b.dataset.star) <= n; b.classList.toggle('on', on); b.setAttribute('aria-checked', String(Number(b.dataset.star) === n)); });
  }
  star.addEventListener('click', function (e) { var b = e.target.closest('[data-star]'); if (b) setStars(Number(b.dataset.star)); });
  function clearErrors() { $$('.sw-err', form).forEach(function (n) { n.remove(); }); $$('.is-invalid', form).forEach(function (n) { n.classList.remove('is-invalid'); n.removeAttribute('aria-invalid'); }); }
  function setMode(d) {
    clearErrors();
    if (d) {
      title.textContent = 'ویرایش نظر'; $('#reviewId').value = d.id; $('#reviewName').value = d.name; $('#reviewCompany').value = d.company;
      $('#reviewText').value = d.text; $('#reviewPublished').checked = !!d.published; setStars(d.rating || 5);
    } else {
      title.textContent = 'افزودن نظر'; form.reset(); $('#reviewId').value = ''; $('#reviewPublished').checked = true; setStars(5);
    }
  }
  $('#newReviewBtn').addEventListener('click', function () { setMode(null); });
  grid.addEventListener('click', function (e) {
    var b = e.target.closest('[data-review-edit]'); if (!b) return;
    try { setMode(JSON.parse(b.closest('.rev-card').dataset.review)); } catch (err) {}
  });
  setStars(5);
});
</script>

<%- include('partials/_scripts') %>
س