<%# views/admin/Tickets.ejs — تیکت‌های پشتیبانی (لیست + گفتگو)
    ورودی‌ها از server.js: tickets (با populate('client','name'))، clients (اختیاری؛ برای ثبت تیکت از طرف مدیریت)
    روت‌ها: POST /sw-admin/tickets (ثبت) · /:id/reply (JSON) · /:id/status (JSON) · /:id/priority (JSON) · /:id/delete
    لینک مستقیم به یک تیکت: /sw-admin/tickets#<id> · پیام‌ها: ?success= / ?error= %>
<%
  const fa = (n) => String(n ?? 0).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]);
  const plain = (t) => (t && typeof t.toObject === 'function') ? t.toObject() : t;

  const STATUS = { open: 'باز', pending: 'در حال بررسی', closed: 'بسته شده' };
  const PRIO   = { urgent: 'فوری', medium: 'متوسط', low: 'کم' };
  const DEPT   = { general: 'عمومی', technical: 'فنی', tech: 'فنی', financial: 'مالی', finance: 'مالی', sales: 'فروش', sale: 'فروش', support: 'پشتیبانی' };
  const SOURCE = { contact_form: 'فرم تماس سایت', admin: 'ثبت توسط مدیریت' };

  const ago = (v) => {
    const s = Math.round((Date.now() - new Date(v).getTime()) / 1000);
    if (!isFinite(s)) return '';
    if (s < 60) return 'الان';
    const m = Math.round(s / 60); if (m < 60) return fa(m) + ' د';
    const h = Math.round(m / 60); if (h < 24) return fa(h) + ' س';
    const d = Math.round(h / 24); return d === 1 ? 'دیروز' : fa(d) + ' روز';
  };

  const rows = (Array.isArray(tickets) ? tickets : []).map(plain).map((t) => {
    const id    = String(t._id);
    const name  = t.requesterName || (t.client && t.client.name) || 'ناشناس';
    const msgs  = (Array.isArray(t.messages) ? t.messages : []).map((m) => ({
      sender: m.sender || 'client', body: m.body || '',
      at: m.createdAt ? new Date(m.createdAt).toISOString() : (t.createdAt ? new Date(t.createdAt).toISOString() : '')
    }));
    const last  = msgs.length ? msgs[msgs.length - 1] : null;
    return {
      id, name,
      no      : t.ticketNo || t.ticketNumber || ('TCK-' + id.slice(-5).toUpperCase()),
      email   : t.requesterEmail || '', phone: t.requesterPhone || '',
      subject : t.subject || 'بدون موضوع',
      dept    : DEPT[t.department] || t.department || 'عمومی',
      priority: PRIO[t.priority] ? t.priority : 'medium',
      status  : STATUS[t.status] ? t.status : 'open',
      source  : SOURCE[t.source] || '',
      createdAt: t.createdAt ? new Date(t.createdAt).toISOString() : '',
      last    : (last && last.at) || (t.createdAt ? new Date(t.createdAt).toISOString() : ''),
      preview : last ? String(last.body).replace(/\s+/g, ' ').slice(0, 90) : '',
      initials: name.trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('‌'),
      av      : 'av-' + ((parseInt(id.slice(-2), 16) || 0) % 6 + 1),
      messages: msgs
    };
  });

  const counts = { all: rows.length, open: 0, pending: 0, closed: 0 };
  rows.forEach((r) => { counts[r.status]++; });

  const clientsList = (typeof clients !== 'undefined' && Array.isArray(clients)) ? clients : [];
  const dataMap = {};
  rows.forEach((r) => { dataMap[r.id] = r; });
%>
<%- include('partials/_head', { title: 'تیکت‌های پشتیبانی' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'tickets' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [{ label: 'داشبورد', href: '/sw-admin' }, { label: 'تیکت‌های پشتیبانی' }],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">تیکت‌های پشتیبانی</h1>
          <p class="page-subtitle"><span id="subOpen"><%= fa(counts.open) %></span> تیکت باز · <span id="subPending"><%= fa(counts.pending) %></span> در حال بررسی · <span id="subAll"><%= fa(counts.all) %></span> تیکت کل</p>
        </div>
        <button type="button" class="btn-sol-sm" data-modal-open="composeModal"><i class="bi bi-plus-lg"></i> ایجاد تیکت جدید</button>
      </div>

      <script type="application/json" id="ticketsData"><%- JSON.stringify(dataMap).replace(/</g, '\\u003c') %></script>

      <div class="tk-layout fade-up fade-up-2" id="tkLayout">

        <!-- لیست تیکت‌ها -->
        <section class="tk-side dash-panel" aria-label="لیست تیکت‌ها">
          <div class="tk-side-head">
            <label class="sw-search" aria-label="جستجو در تیکت‌ها">
              <i class="bi bi-search" aria-hidden="true"></i>
              <input type="search" id="tkSearch" placeholder="موضوع، نام یا شماره تیکت…" autocomplete="off">
            </label>
            <div class="tk-tabs" role="tablist">
              <button type="button" class="tk-tab active" data-tab="all" role="tab" aria-selected="true">همه <span class="tk-count" data-count="all"><%= fa(counts.all) %></span></button>
              <button type="button" class="tk-tab" data-tab="open" role="tab" aria-selected="false">باز <span class="tk-count" data-count="open"><%= fa(counts.open) %></span></button>
              <button type="button" class="tk-tab" data-tab="pending" role="tab" aria-selected="false">بررسی <span class="tk-count" data-count="pending"><%= fa(counts.pending) %></span></button>
              <button type="button" class="tk-tab" data-tab="closed" role="tab" aria-selected="false">بسته <span class="tk-count" data-count="closed"><%= fa(counts.closed) %></span></button>
            </div>
          </div>

          <div class="tk-list" id="tkList">
            <% rows.forEach(function (r) { %>
              <button type="button" class="tk-item <%= r.status === 'open' ? 'unread' : '' %>" data-id="<%= r.id %>" data-status="<%= r.status %>"
                      data-q="<%= [r.name, r.subject, r.no, r.email, r.preview].join(' ') %>">
                <span class="tk-av <%= r.av %>"><%= r.initials %></span>
                <span class="tk-item-body">
                  <span class="tk-item-top"><span class="tk-item-name"><%= r.name %></span><span class="tk-item-time"><%= ago(r.last) %></span></span>
                  <span class="tk-item-meta"><span class="tk-no"><%= r.no %></span><span class="tk-tag"><%= r.dept %></span></span>
                  <span class="tk-item-sub"><%= r.subject %></span>
                  <span class="tk-item-prev"><%= r.preview %></span>
                  <span class="tk-item-badges">
                    <span class="tk-badge tk-s-<%= r.status %>"><%= STATUS[r.status] %></span>
                    <span class="tk-prio tk-p-<%= r.priority %>"><i class="bi bi-flag-fill"></i> <%= PRIO[r.priority] %></span>
                  </span>
                </span>
              </button>
            <% }); %>
            <div class="sw-empty" id="tkNoMatch" hidden><i class="bi bi-inbox"></i>تیکتی با این فیلتر پیدا نشد.</div>
            <% if (!rows.length) { %>
              <div class="sw-empty"><i class="bi bi-ticket-detailed"></i>هنوز تیکتی ثبت نشده است.</div>
            <% } %>
          </div>
        </section>

        <!-- گفتگو -->
        <section class="tk-chat dash-panel" aria-label="گفتگوی تیکت">
          <div class="tk-chat-empty" id="tkEmpty"<%= rows.length ? ' hidden' : '' %>>
            <i class="bi bi-chat-square-text"></i>
            <p><%= rows.length ? 'یک تیکت را انتخاب کنید' : 'وقتی تیکتی ثبت شود، اینجا نمایش داده می‌شود.' %></p>
          </div>

          <div class="tk-chat-main" id="tkMain" hidden>
            <header class="tk-head">
              <button type="button" class="btn-icon tk-back" id="tkBack" aria-label="بازگشت به لیست"><i class="bi bi-arrow-right"></i></button>
              <span class="tk-av tk-av-lg" id="tkAv">—</span>
              <div class="tk-head-info">
                <div class="tk-head-title"><b id="tkName">—</b><span class="tk-no" id="tkNo"></span></div>
                <div class="tk-head-meta"><span class="tk-tag" id="tkDept"></span><span id="tkContact"></span></div>
              </div>
              <div class="tk-head-ctl">
                <select class="sol-select tk-sel" id="tkPriority" aria-label="اولویت">
                  <% Object.keys(PRIO).forEach(function (k) { %><option value="<%= k %>"><%= PRIO[k] %></option><% }); %>
                </select>
                <select class="sol-select tk-sel" id="tkStatus" aria-label="وضعیت">
                  <% Object.keys(STATUS).forEach(function (k) { %><option value="<%= k %>"><%= STATUS[k] %></option><% }); %>
                </select>
                <form method="POST" id="tkDeleteForm" data-sw-confirm="این تیکت و همه پیام‌هایش حذف شود؟ این کار قابل بازگشت نیست.">
                  <button type="submit" class="btn-icon danger" title="حذف تیکت" aria-label="حذف تیکت"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </header>

            <div class="tk-subject"><i class="bi bi-chat-left-text"></i><span id="tkSubject"></span><span class="tk-source" id="tkSource"></span></div>

            <div class="tk-body" id="tkBody" aria-live="polite"></div>

            <footer class="tk-compose">
              <textarea id="tkInput" rows="1" placeholder="پاسخ خود را به‌عنوان پشتیبانی بنویسید…" aria-label="متن پاسخ"></textarea>
              <button type="button" class="tk-send" id="tkSend" aria-label="ارسال پاسخ"><i class="bi bi-send-fill"></i></button>
            </footer>
          </div>
        </section>

      </div>
    </main>
  </div>
</div>

<!-- Modal: ایجاد تیکت از طرف مدیریت -->
<div class="modal-overlay" id="composeModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">ایجاد تیکت از طرف مدیریت</h3>
      <button type="button" class="btn-icon" data-modal-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>

    <form action="/sw-admin/tickets" method="POST" id="composeForm" data-validate novalidate>
      <% if (clientsList.length) { %>
        <div class="sw-field">
          <label class="sol-label" for="cmpClient">مشتری</label>
          <select class="sol-select" name="client" id="cmpClient" data-rule="required">
            <option value="" selected disabled>انتخاب مشتری…</option>
            <% clientsList.forEach(function (c) { %><option value="<%= c._id %>"><%= c.name %><%= c.company ? ' — ' + c.company : '' %></option><% }); %>
          </select>
        </div>
      <% } else { %>
        <div class="form-row two">
          <div class="sw-field"><label class="sol-label" for="cmpName">نام</label><input class="sol-input" type="text" name="name" id="cmpName" data-rule="required" autocomplete="off"></div>
          <div class="sw-field"><label class="sol-label" for="cmpEmail">ایمیل</label><input class="sol-input" type="email" name="email" id="cmpEmail" dir="ltr" data-rule="required|email" autocomplete="off"></div>
        </div>
      <% } %>

      <div class="form-row two">
        <div class="sw-field">
          <label class="sol-label" for="cmpDept">دپارتمان</label>
          <select class="sol-select" name="department" id="cmpDept">
            <option value="technical">فنی</option><option value="financial">مالی</option><option value="sales">فروش</option><option value="general" selected>عمومی</option>
          </select>
        </div>
        <div class="sw-field">
          <label class="sol-label" for="cmpPriority">اولویت</label>
          <select class="sol-select" name="priority" id="cmpPriority">
            <option value="urgent">فوری</option><option value="medium" selected>متوسط</option><option value="low">کم</option>
          </select>
        </div>
      </div>

      <div class="sw-field">
        <label class="sol-label" for="cmpSubject">موضوع تیکت</label>
        <input class="sol-input" type="text" name="subject" id="cmpSubject" placeholder="موضوع تیکت را بنویسید…" data-rule="required" autocomplete="off">
      </div>
      <div class="sw-field">
        <label class="sol-label" for="cmpBody">متن اولین پیام</label>
        <textarea class="sol-input" name="body" id="cmpBody" rows="5" placeholder="شرح مشکل یا درخواست را بنویسید…" data-rule="required"></textarea>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn-ghost-sm" data-modal-close>انصراف</button>
        <button type="submit" class="btn-sol-sm"><i class="bi bi-plus-lg"></i> ایجاد تیکت</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return String(v == null ? '' : v).replace(/[0-9]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }
  function norm(s) { return String(s || '').replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/[۰-۹]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); }).toLowerCase(); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var DATA = {};
  try { DATA = JSON.parse($('#ticketsData').textContent || '{}'); } catch (e) {}
  var STATUS = { open: 'باز', pending: 'در حال بررسی', closed: 'بسته شده' };
  var PRIO = { urgent: 'فوری', medium: 'متوسط', low: 'کم' };

  var layout = $('#tkLayout'), listEl = $('#tkList'), bodyEl = $('#tkBody'), mainEl = $('#tkMain'), emptyEl = $('#tkEmpty');
  var input = $('#tkInput'), sendBtn = $('#tkSend'), statusSel = $('#tkStatus'), prioSel = $('#tkPriority');
  var state = { id: null, tab: 'all', q: '' }, sending = false;
  function cur() { return state.id ? DATA[state.id] : null; }
  function item(id) { return $('.tk-item[data-id="' + id + '"]', listEl); }

  /* ───────── زمان ───────── */
  var tf = new Intl.DateTimeFormat('fa-IR', { hour: '2-digit', minute: '2-digit' });
  var df = new Intl.DateTimeFormat('fa-IR', { day: 'numeric', month: 'long' });
  function dayKey(d) { return d.getFullYear() + '-' + d.getMonth() + '-' + d.getDate(); }
  function dayLabel(d) {
    var n = new Date(), y = new Date(Date.now() - 864e5);
    return dayKey(d) === dayKey(n) ? 'امروز' : dayKey(d) === dayKey(y) ? 'دیروز' : df.format(d);
  }
  function ago(iso) {
    var s = Math.round((Date.now() - new Date(iso).getTime()) / 1000); if (!isFinite(s)) return '';
    if (s < 60) return 'الان'; var m = Math.round(s / 60); if (m < 60) return fa(m) + ' د';
    var h = Math.round(m / 60); if (h < 24) return fa(h) + ' س';
    var d = Math.round(h / 24); return d === 1 ? 'دیروز' : fa(d) + ' روز';
  }

  /* ───────── شمارنده‌ها و فیلتر ───────── */
  function recount() {
    var c = { all: 0, open: 0, pending: 0, closed: 0 };
    Object.keys(DATA).forEach(function (id) { c.all++; c[DATA[id].status]++; });
    $$('.tk-count').forEach(function (n) { n.textContent = fa(c[n.dataset.count]); });
    $('#subOpen').textContent = fa(c.open); $('#subPending').textContent = fa(c.pending); $('#subAll').textContent = fa(c.all);
  }
  function applyFilter() {
    var q = norm(state.q), shown = 0;
    $$('.tk-item', listEl).forEach(function (it) {
      var ok = (state.tab === 'all' || it.dataset.status === state.tab) && (!q || norm(it.dataset.q).indexOf(q) > -1);
      it.hidden = !ok; if (ok) shown++;
    });
    $('#tkNoMatch').hidden = !(Object.keys(DATA).length && !shown);
  }
  $$('.tk-tab').forEach(function (b) {
    b.addEventListener('click', function () {
      $$('.tk-tab').forEach(function (x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      b.classList.add('active'); b.setAttribute('aria-selected', 'true'); state.tab = b.dataset.tab; applyFilter();
    });
  });
  var st = 0;
  $('#tkSearch').addEventListener('input', function (e) { clearTimeout(st); st = setTimeout(function () { state.q = e.target.value.trim(); applyFilter(); }, 90); });

  /* ───────── نمایش گفتگو ───────── */
  function bubble(m, pending) {
    var out = m.sender !== 'client', el = document.createElement('div');
    el.className = 'tk-msg ' + (out ? 'out' : 'in') + (pending ? ' pending' : '');
    var tx = document.createElement('div'); tx.className = 'tk-text'; tx.textContent = m.body; el.appendChild(tx);
    var tm = document.createElement('div'); tm.className = 'tk-time';
    var d = m.at ? new Date(m.at) : null; tm.textContent = d && !isNaN(d.getTime()) ? tf.format(d) : ''; el.appendChild(tm);
    return el;
  }
  function renderThread(t) {
    bodyEl.textContent = '';
    var lastDay = '';
    if (!t.messages.length) { var n = document.createElement('div'); n.className = 'tk-day'; n.dataset.empty = '1'; n.textContent = 'هنوز پیامی ثبت نشده است'; bodyEl.appendChild(n); }
    t.messages.forEach(function (m) {
      var d = m.at ? new Date(m.at) : null;
      if (d && !isNaN(d.getTime()) && dayKey(d) !== lastDay) {
        lastDay = dayKey(d); var sep = document.createElement('div'); sep.className = 'tk-day'; sep.textContent = dayLabel(d); bodyEl.appendChild(sep);
      }
      bodyEl.appendChild(bubble(m, false));
    });
    bodyEl.scrollTop = bodyEl.scrollHeight;
  }
  function fillHead(t) {
    var av = $('#tkAv'); av.className = 'tk-av tk-av-lg ' + t.av; av.textContent = t.initials;
    $('#tkName').textContent = t.name; $('#tkNo').textContent = t.no; $('#tkDept').textContent = t.dept;
    $('#tkContact').textContent = [t.email, t.phone ? fa(t.phone) : ''].filter(Boolean).join(' · ');
    $('#tkSubject').textContent = t.subject; $('#tkSource').textContent = t.source;
    statusSel.value = t.status; prioSel.value = t.priority;
    $('#tkDeleteForm').action = '/sw-admin/tickets/' + t.id + '/delete';
  }
  function select(id, fromUser) {
    var t = DATA[id]; if (!t) return;
    state.id = id;
    $$('.tk-item', listEl).forEach(function (it) { it.classList.toggle('active', it.dataset.id === id); });
    emptyEl.hidden = true; mainEl.hidden = false;
    fillHead(t); renderThread(t);
    if (fromUser) { layout.classList.add('is-chat'); try { history.replaceState(null, '', '#' + id); } catch (e) {} }
    if (!matchMedia('(pointer:coarse)').matches && fromUser) input.focus();
  }
  listEl.addEventListener('click', function (e) { var it = e.target.closest('.tk-item'); if (it) select(it.dataset.id, true); });
  $('#tkBack').addEventListener('click', function () { layout.classList.remove('is-chat'); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && layout.classList.contains('is-chat') && !$$('.modal-overlay.active').length) layout.classList.remove('is-chat'); });

  /* ───────── API ───────── */
  function post(url, data) {
    return fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(data)
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        if (!r.ok || !j.success) throw new Error(j.message || 'خطا در ارتباط با سرور');
        return j;
      });
    });
  }

  /* ───────── وضعیت و اولویت ───────── */
  function paintItem(t) {
    var it = item(t.id); if (!it) return;
    it.dataset.status = t.status; it.classList.toggle('unread', t.status === 'open');
    var sb = $('.tk-badge', it); sb.className = 'tk-badge tk-s-' + t.status; sb.textContent = STATUS[t.status];
    var pb = $('.tk-prio', it); pb.className = 'tk-prio tk-p-' + t.priority; pb.textContent = ' ' + PRIO[t.priority];
    var fl = document.createElement('i'); fl.className = 'bi bi-flag-fill'; pb.insertBefore(fl, pb.firstChild);
  }
  function change(field, to, label) {
    var t = cur(); if (!t || t[field] === to) return;
    var prev = t[field]; t[field] = to; paintItem(t); recount(); applyFilter();
    post('/sw-admin/tickets/' + t.id + '/' + field, (function (o) { o[field] = to; return o; })({}))
      .then(function () { toast(label + ' «' + (field === 'status' ? STATUS : PRIO)[to] + '» شد', { type: 'success', ms: 2200 }); })
      .catch(function (err) {
        t[field] = prev; paintItem(t); recount(); applyFilter();
        if (state.id === t.id) (field === 'status' ? statusSel : prioSel).value = prev;
        toast(err.message || 'تغییر انجام نشد', { type: 'error' });
      });
  }
  statusSel.addEventListener('change', function () { change('status', statusSel.value, 'وضعیت تیکت'); });
  prioSel.addEventListener('change', function () { change('priority', prioSel.value, 'اولویت تیکت'); });

  /* ───────── ارسال پاسخ ───────── */
  function grow() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }
  input.addEventListener('input', grow);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && !matchMedia('(pointer:coarse)').matches) { e.preventDefault(); send(); }
  });
  sendBtn.addEventListener('click', send);

  function send() {
    var t = cur(), text = input.value.trim();
    if (!t || !text || sending) return;
    sending = true; sendBtn.classList.add('busy');
    var msg = { sender: 'admin', body: text, at: new Date().toISOString() };
    var ph = $('.tk-day[data-empty]', bodyEl); if (ph) ph.remove();
    var node = bubble(msg, true); bodyEl.appendChild(node); bodyEl.scrollTo({ top: bodyEl.scrollHeight, behavior: 'smooth' });
    input.value = ''; grow();
    post('/sw-admin/tickets/' + t.id + '/reply', { body: text }).then(function (j) {
      node.classList.remove('pending');
      if (j.message && j.message.createdAt) { msg.at = j.message.createdAt; $('.tk-time', node).textContent = tf.format(new Date(msg.at)); }
      t.messages.push(msg); t.last = msg.at;
      var it = item(t.id);
      if (it) { $('.tk-item-prev', it).textContent = text.replace(/\s+/g, ' ').slice(0, 90); $('.tk-item-time', it).textContent = 'الان'; listEl.insertBefore(it, listEl.firstChild); }
      if (j.status && j.status !== t.status) { t.status = j.status; statusSel.value = j.status; paintItem(t); recount(); applyFilter(); }
    }).catch(function (err) {
      node.remove(); input.value = text; grow();
      toast(err.message || 'ارسال پاسخ انجام نشد', { type: 'error', detail: 'متن شما در کادر نگه داشته شد.' });
    }).then(function () { sending = false; sendBtn.classList.remove('busy'); });
  }

  /* ───────── انتخاب اولیه: hash → اولین تیکت (دسکتاپ) ───────── */
  function fromHash() { var id = (location.hash || '').slice(1); if (id && DATA[id]) { select(id, false); layout.classList.add('is-chat'); return true; } return false; }
  window.addEventListener('hashchange', fromHash);
  if (!fromHash()) {
    var first = $('.tk-item', listEl);
    if (first && matchMedia('(min-width:901px)').matches) select(first.dataset.id, false);
    else if (!first) emptyEl.hidden = false;
  }
  applyFilter();
});
</script>

