<%- include('partials/_head', { title: isEdit ? 'ویرایش مقاله' : 'مقاله جدید' }) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="admin-shell">

<%- include('partials/_sidebar', {
  activePage: 'blog',
  adminUser: { name: 'علی مدیری', role: 'مدیر کل سیستم', initials: 'ادم' }
}) %>

<div class="main-content" id="mainContent">
<%- include('partials/_header', {
  breadcrumbs: [
    { label: 'داشبورد', href: '/sw-admin' },
    { label: 'وبلاگ', href: '/sw-admin/blog' },
    { label: isEdit ? 'ویرایش مقاله' : 'مقاله جدید' }
  ],
  searchPlaceholder: 'جستجو در مقالات…'
}) %>

<%
const defaultTagOptions = [
  'طراحی وب', 'سئو', 'وردپرس', 'فروشگاه اینترنتی', 'برندینگ',
  'بازاریابی دیجیتال', 'تولید محتوا', 'React', 'Node.js', 'تکنولوژی', 'آموزش'
];

const itemCategorySlug = item.category && item.category.slug ? item.category.slug : item.category;
const itemTags = item.tags || [];
const formAction = isEdit ? ('/sw-admin/blog/' + item._id + '/update') : '/sw-admin/blog';
%>

<main class="page-content">

  <div class="page-header fade-up fade-up-1">
    <div>
      <h1 class="page-title"><%= isEdit ? 'ویرایش مقاله' : 'مقاله جدید' %></h1>
      <p class="page-subtitle">
        <% if (isEdit) { %>
          ویرایش مقاله «<%= item.title %>»
        <% } else { %>
          افزودن یک مقاله جدید به وبلاگ
        <% } %>
      </p>
    </div>
    <a href="/sw-admin/blog" class="btn-ghost-sm">
      <i class="bi bi-arrow-right"></i> بازگشت به وبلاگ
    </a>
  </div>

  <form id="blogForm" action="<%= formAction %>" method="POST" enctype="multipart/form-data">

    <div class="pf-layout fade-up fade-up-2">

      <!-- ═══════ ستون اصلی ═══════ -->
      <div class="pf-main">

        <div class="pf-title-box">
          <input
            type="text"
            class="pf-title-input"
            name="title"
            id="postTitle"
            placeholder="عنوان جذاب مقاله را وارد کنید…"
            value="<%= item.title || '' %>"
            autocomplete="off"
          >

          <div class="pf-slug-row">
            <span class="pf-slug-prefix">/blog/</span>
            <input
              type="text"
              class="pf-slug-input"
              name="slug"
              id="postSlug"
              placeholder="نامک-مقاله"
              value="<%= item.slug || '' %>"
              autocomplete="off"
              dir="ltr"
            >
          </div>
        </div>

        <div class="pf-editor-box">
          <div class="form-row" style="margin-bottom:1rem;">
            <label class="sol-label">خلاصه مقاله</label>
            <textarea
              class="sol-input"
              name="excerpt"
              id="postExcerpt"
              rows="2"
              placeholder="چکیده کوتاهی برای نمایش در لیست مقالات و نتایج جستجو…"
              style="resize:vertical;"
            ><%= item.excerpt || '' %></textarea>
          </div>

          <label class="sol-label">متن کامل مقاله</label>
          <div id="quillEditor" class="pf-quill"><%- item.content || '' %></div>
          <textarea name="content" id="contentInput" style="display:none;"><%= item.content || '' %></textarea>
        </div>

      </div>

      <!-- ═══════ سایدبار ═══════ -->
      <div class="pf-sidebar">

        <!-- انتشار / وضعیت -->
        <div class="pf-box">
          <div class="pf-box-header"><i class="bi bi-broadcast"></i> انتشار</div>
          <div class="pf-box-body">

            <div class="pf-status-row">
              <span>وضعیت فعلی:</span>
              <% if (item.isPublished) { %>
                <span class="badge-status badge-done">منتشرشده</span>
              <% } else { %>
                <span class="badge-status badge-new">پیش‌نویس</span>
              <% } %>
            </div>

            <div class="pf-publish-actions">
              <button class="btn-ghost-sm w-100" type="submit" name="publish" value="0">
                <i class="bi bi-file-earmark"></i> ذخیره پیش‌نویس
              </button>
              <button class="btn-sol-sm w-100" type="submit" name="publish" value="1">
                <i class="bi bi-send"></i> انتشار مقاله
              </button>
            </div>

          </div>
        </div>

        <!-- اطلاعات مقاله -->
        <div class="pf-box">
          <div class="pf-box-header"><i class="bi bi-info-circle"></i> اطلاعات مقاله</div>
          <div class="pf-box-body">

            <div class="form-row">
              <label class="sol-label">دسته‌بندی</label>
              <div style="display:flex;gap:.5rem;">
                <select class="sol-select" name="category" id="postCategory" style="width:100%">

                  <option value="">انتخاب دسته</option>

                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.slug %>" <%= cat.slug === itemCategorySlug ? 'selected' : '' %>>
                      <%= cat.title %>
                    </option>
                  <% }) %>

                  <% if (itemCategorySlug && !categories.find(c => c.slug === itemCategorySlug)) { %>
                    <option value="<%= itemCategorySlug %>" selected><%= itemCategorySlug %></option>
                  <% } %>

                </select>

                <button type="button" class="btn-ghost-sm" id="addCategoryBtn" title="افزودن دسته جدید" style="flex-shrink:0;padding:.5rem .7rem;">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>

              <div id="addCategoryBox" style="display:none;gap:.5rem;margin-top:.6rem;">
                <input type="text" class="sol-input" id="newCategoryInput" placeholder="عنوان دسته جدید…" style="flex:1;">
                <button type="button" class="btn-sol-sm" id="confirmAddCategory">افزودن</button>
              </div>
            </div>

            <div class="form-row">
              <label class="sol-label">نویسنده</label>
              <select class="sol-select" name="author" id="postAuthor" style="width:100%">
                <option value="">انتخاب نویسنده</option>
                <% (typeof authors !== 'undefined' ? authors : []).forEach(a => { %>
                  <option value="<%= a %>" <%= a === item.author ? 'selected' : '' %>><%= a %></option>
                <% }) %>
                <% if (item.author && (typeof authors === 'undefined' || !authors.includes(item.author))) { %>
                  <option value="<%= item.author %>" selected><%= item.author %></option>
                <% } %>
              </select>
            </div>

            <div class="form-row" style="margin-bottom:0;">
              <label class="sol-label">زمان مطالعه</label>
              <input class="sol-input" type="text" placeholder="مثلاً: ۵ دقیقه مطالعه" name="readTime" id="postReadTime" value="<%= item.readTime || '' %>">
            </div>

          </div>
        </div>

        <!-- برچسب‌های مقاله -->
        <div class="pf-box">
          <div class="pf-box-header"><i class="bi bi-tags"></i> برچسب‌های مقاله</div>
          <div class="pf-box-body">

            <div class="tag-checklist" id="tagChecklist">
              <% defaultTagOptions.forEach(tag => { %>
                <label class="tag-check-item">
                  <input type="checkbox" name="tags[]" value="<%= tag %>" <%= itemTags.includes(tag) ? 'checked' : '' %>>
                  <span class="tag-chip-label"><%= tag %></span>
                  <span class="tag-chip-remove"><i class="bi bi-x-lg"></i></span>
                </label>
              <% }) %>

              <% itemTags.filter(t => !defaultTagOptions.includes(t)).forEach(tag => { %>
                <label class="tag-check-item">
                  <input type="checkbox" name="tags[]" value="<%= tag %>" checked>
                  <span class="tag-chip-label"><%= tag %></span>
                  <span class="tag-chip-remove"><i class="bi bi-x-lg"></i></span>
                </label>
              <% }) %>
            </div>

            <div style="display:flex;gap:.5rem;margin-top:.65rem;">
              <input type="text" class="sol-input" id="newTagInput" placeholder="افزودن برچسب جدید…" style="flex:1;">
              <button type="button" class="btn-ghost-sm" id="addTagBtn">
                <i class="bi bi-plus-lg"></i> افزودن
              </button>
            </div>

          </div>
        </div>

        <!-- تصویر شاخص -->
        <div class="pf-box">
          <div class="pf-box-header"><i class="bi bi-image"></i> تصویر شاخص</div>
          <div class="pf-box-body">

            <div class="port-upload-area <%= item.coverImage ? 'has-preview' : '' %>" id="uploadArea">
              <div id="uploadAreaContent">
                <% if (item.coverImage) { %>
                  <div class="upload-preview-wrap">
                    <img src="<%= item.coverImage %>" alt="<%= item.title %>" class="upload-preview-img">
                  </div>
                  <div style="font-size:.7rem;color:var(--color-text-light);margin-top:.5rem;">برای تغییر، کلیک یا فایل را رها کنید</div>
                <% } else { %>
                  <i class="bi bi-cloud-upload-fill" style="font-size:1.75rem;color:var(--main-400);"></i>
                  <div style="font-size:.8rem;font-weight:600;margin-top:.4rem;">تصویر را بکشید یا کلیک کنید</div>
                  <div style="font-size:.68rem;color:var(--color-text-light);">PNG, JPG</div>
                <% } %>
              </div>
              <input type="file" accept="image/*" style="display:none;" id="imgUpload" name="coverImage">
            </div>

          </div>
        </div>

      </div>

    </div>

  </form>

</main>
</div>
</div>

<%- include('partials/_scripts', { extraScripts: `
<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
<style>

/* ─── دو ستونی (سبک وردپرس) ─── */
.pf-layout{display:grid;grid-template-columns:1fr 340px;gap:1.75rem;align-items:start;}
@media (max-width:991.98px){.pf-layout{grid-template-columns:1fr;gap:1.25rem;}}

.pf-main{display:flex;flex-direction:column;gap:1.5rem;min-width:0;}
.pf-sidebar{display:flex;flex-direction:column;gap:1.5rem;}

.pf-title-box{background:var(--color-surface);border:1px solid var(--color-border);border-radius:22px;padding:.5rem 1.4rem 1rem;box-shadow:var(--shadow-sm);transition:box-shadow .3s var(--ease-smooth), border-color .3s var(--ease-smooth);}
.pf-title-box:focus-within{border-color:var(--main-300);box-shadow:0 0 0 4px rgba(100,71,244,.12), var(--shadow-md);}
.pf-title-input{width:100%;border:none;outline:none;background:transparent;font-family:var(--font-primary);font-size:1.5rem;font-weight:800;color:var(--color-text-primary);padding:.75rem 0 .35rem;}
.pf-title-input::placeholder{color:var(--color-text-light);font-weight:600;}

.pf-slug-row{display:flex;align-items:center;gap:.35rem;padding-top:.5rem;border-top:1px solid var(--color-border);}
.pf-slug-prefix{font-size:.8rem;color:var(--color-text-light);font-weight:600;flex-shrink:0;}
.pf-slug-input{flex:1;border:none;outline:none;background:transparent;font-family:var(--font-mono);font-size:.82rem;color:var(--main-500);padding:.35rem 0;}
.pf-slug-input::placeholder{color:var(--color-text-light);}

/* ─── ادیتور Quill: امضای بصری صفحه ─── */
.pf-editor-box{background:var(--color-surface);border:1.5px solid var(--color-border);border-radius:24px;padding:1.5rem;box-shadow:var(--shadow-sm);transition:box-shadow .4s var(--ease-smooth), border-color .4s var(--ease-smooth);}
.pf-editor-box:focus-within{
  border-color:rgba(100,71,244,.4);
  box-shadow:
    0 0 0 5px rgba(100,71,244,.1),
    0 0 32px rgba(100,71,244,.18),
    0 0 48px rgba(0,144,232,.10),
    var(--shadow-lg);
}
.pf-quill{margin-top:.85rem;border-radius:16px;overflow:hidden;}

.ql-toolbar.ql-snow{
  border-color:var(--color-border) !important;
  border-radius:16px 16px 0 0;
  background:var(--color-bg-soft);
  font-family:var(--font-primary);
  padding:.7rem .85rem;
}
.ql-container.ql-snow{
  border-color:var(--color-border) !important;
  border-radius:0 0 16px 16px;
  font-family:var(--font-primary);
  background:var(--color-bg);
}
.ql-editor{min-height:360px;font-size:.95rem;line-height:1.95;direction:rtl;text-align:right;padding:1.25rem 1.4rem;}
.ql-editor h1,.ql-editor h2,.ql-editor h3,.ql-editor h4,.ql-editor h5,.ql-editor h6{font-family:var(--font-primary);font-weight:800;}
.ql-editor.ql-blank::before{right:1.4rem;left:auto;font-style:normal;color:var(--color-text-light);font-family:var(--font-primary);}

/* دکمه‌ها و دراپ‌داون‌های Quill کاملاً گرد */
.ql-snow .ql-picker{border-radius:10px;}
.ql-snow .ql-picker-label{border-radius:10px;padding-left:.4rem;}
.ql-snow .ql-picker-options{
  border-radius:14px !important;
  border-color:var(--color-border) !important;
  box-shadow:var(--shadow-lg);
  padding:.5rem !important;
  background:var(--color-surface) !important;
}
.ql-snow .ql-picker-item{border-radius:8px;}
.ql-snow .ql-picker-item:hover,
.ql-snow .ql-picker-label:hover{color:var(--main-500) !important;}
.ql-snow.ql-toolbar button{border-radius:8px;}
.ql-snow.ql-toolbar button:hover,
.ql-snow.ql-toolbar button.ql-active{background:var(--main-50);color:var(--main-500) !important;}
.ql-snow.ql-toolbar button:hover .ql-stroke,
.ql-snow.ql-toolbar button.ql-active .ql-stroke{stroke:var(--main-500) !important;}
.ql-snow.ql-toolbar button:hover .ql-fill,
.ql-snow.ql-toolbar button.ql-active .ql-fill{fill:var(--main-500) !important;}
.ql-snow .ql-tooltip{
  border-radius:14px !important;
  border-color:var(--color-border) !important;
  box-shadow:var(--shadow-lg) !important;
  background:var(--color-surface) !important;
  color:var(--color-text-primary) !important;
}
.ql-snow .ql-tooltip input[type=text]{border-radius:10px !important;}

/* فارسی‌سازی گزینه‌های هدینگ */
.pf-editor-box .ql-picker.ql-header .ql-picker-label::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item::before{
  content:'متن عادی';
}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="1"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="1"]::before{content:'تیتر ۱';}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="2"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="2"]::before{content:'تیتر ۲';}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="3"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="3"]::before{content:'تیتر ۳';}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="4"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="4"]::before{content:'تیتر ۴';}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="5"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="5"]::before{content:'تیتر ۵';}
.pf-editor-box .ql-picker.ql-header .ql-picker-label[data-value="6"]::before,
.pf-editor-box .ql-picker.ql-header .ql-picker-item[data-value="6"]::before{content:'تیتر ۶';}

.pf-box{background:var(--color-surface);border:1px solid var(--color-border);border-radius:22px;overflow:hidden;box-shadow:var(--shadow-sm);transition:box-shadow .3s var(--ease-smooth);}
.pf-box:hover{box-shadow:var(--shadow-md);}
.pf-box-header{display:flex;align-items:center;gap:.55rem;padding:1rem 1.25rem;font-weight:700;font-size:.85rem;border-bottom:1px solid var(--color-border);background:var(--color-bg-soft);color:var(--color-text-primary);}
.pf-box-header i{color:var(--main-500);}
.pf-box-body{padding:1.25rem;}

.pf-status-row{display:flex;align-items:center;justify-content:space-between;font-size:.8rem;color:var(--color-text-muted);margin-bottom:1rem;}
.pf-publish-actions{display:flex;flex-direction:column;gap:.6rem;}
.w-100{width:100%;justify-content:center;}

#blogForm .btn-sol-sm,
#blogForm .btn-ghost-sm{border-radius:14px;}
#blogForm .sol-input,
#blogForm .sol-select{border-radius:14px;}

/* ─── آپلود تصویر ─── */
.port-upload-area{border:2px dashed var(--main-200);border-radius:20px;padding:1.5rem 1rem;text-align:center;cursor:pointer;transition:all var(--dur-fast);background:var(--main-50);position:relative;}
.port-upload-area:hover{border-color:var(--main-400);background:rgba(100,71,244,.08);}
.port-upload-area.has-preview{padding:.75rem;}
[data-bs-theme="dark"] .port-upload-area{background:rgba(100,71,244,.08);}
.upload-preview-img{max-width:100%;max-height:180px;border-radius:16px;object-fit:cover;display:block;margin:0 auto;}
.upload-preview-wrap{position:relative;display:inline-block;}
.upload-remove-btn{position:absolute;top:-.5rem;left:-.5rem;width:1.75rem;height:1.75rem;border-radius:50%;background:var(--color-surface);border:1.5px solid var(--color-border);color:var(--color-text-muted);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.85rem;box-shadow:var(--shadow-sm);}
.upload-remove-btn:hover{background:#ef4444;border-color:#ef4444;color:#fff;}

/* ─── چیپ‌های برچسب مقاله (مدرن، منظم، ریسپانسیو) ─── */
.tag-checklist{
  display:flex;
  flex-wrap:wrap;
  gap:.6rem;
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:20px;
  padding:1rem;
}
.tag-check-item{
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:.4rem;
  padding:.5rem .95rem;
  border-radius:999px;
  background:var(--color-surface);
  border:1.5px solid var(--color-border);
  font-size:.78rem;
  font-weight:600;
  color:var(--color-text-muted);
  cursor:pointer;
  -webkit-user-select:none;
  user-select:none;
  transition:all .25s var(--ease-spring);
  white-space:nowrap;
}
.tag-check-item input[type="checkbox"]{
  position:absolute;
  width:0;
  height:0;
  opacity:0;
  pointer-events:none;
}
.tag-check-item:hover{
  border-color:var(--main-300);
  color:var(--main-600);
  transform:translateY(-2px);
  box-shadow:var(--shadow-sm);
}
.tag-check-item.selected{
  background:var(--grad-main);
  border-color:transparent;
  color:#fff;
  box-shadow:var(--shadow-main);
}
.tag-check-item.selected:hover{color:#fff;}
.tag-chip-remove{
  display:flex;
  align-items:center;
  justify-content:center;
  width:0;
  overflow:hidden;
  opacity:0;
  font-size:.68rem;
  transition:all .25s var(--ease-spring);
}
.tag-check-item.selected:hover .tag-chip-remove{
  width:14px;
  opacity:1;
  margin-inline-start:.1rem;
}

@media (max-width:575.98px){
  .pf-box-body{padding:1rem;}
  .ql-editor{padding:1rem;min-height:260px;}
  .tag-checklist{padding:.75rem;gap:.5rem;}
  .tag-check-item{padding:.45rem .8rem;font-size:.75rem;}
}
</style>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.js"></script>
<script>

// ─────────────────────────────────────
// راه‌اندازی ویرایشگر متن Quill
// ─────────────────────────────────────
var quill = new Quill('#quillEditor', {
  theme: 'snow',
  placeholder: 'متن کامل مقاله را اینجا بنویسید…',
  modules: {
    toolbar: [
      [{ header: [1, 2, 3, 4, 5, 6, false] }],
      ['bold', 'italic', 'underline', 'strike'],
      [{ align: '' }, { align: 'center' }, { align: 'right' }, { align: 'justify' }],
      [{ list: 'ordered' }, { list: 'bullet' }],
      ['link', 'image'],
      ['clean']
    ]
  }
})

var contentInput = document.getElementById('contentInput')
var blogForm      = document.getElementById('blogForm')

if (blogForm && contentInput) {
  blogForm.addEventListener('submit', function () {
    contentInput.value = quill.root.innerHTML
  })
}

// ─────────────────────────────────────
// اسلاگ خودکار از روی عنوان (تا وقتی کاربر خودش دستی ویرایشش نکرده)
// ─────────────────────────────────────
var postTitleInput = document.getElementById('postTitle')
var postSlugInput  = document.getElementById('postSlug')
var slugManuallyEdited = !!(postSlugInput && postSlugInput.value.trim())

function slugify(text) {
  return (text || '')
    .trim()
    .replace(/[\\s_]+/g, '-')
    .replace(/[^\\p{L}\\p{N}-]+/gu, '')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
}

if (postTitleInput && postSlugInput) {
  postTitleInput.addEventListener('input', function () {
    if (!slugManuallyEdited) {
      postSlugInput.value = slugify(postTitleInput.value)
    }
  })

  postSlugInput.addEventListener('input', function () {
    slugManuallyEdited = postSlugInput.value.trim().length > 0
  })
}

// ─────────────────────────────────────
// آپلود تصویر شاخص + پیش‌نمایش زنده + درگ‌اند‌دراپ
// ─────────────────────────────────────
var uploadArea        = document.getElementById('uploadArea')
var uploadAreaContent = document.getElementById('uploadAreaContent')
var imgUpload         = document.getElementById('imgUpload')

var originalUploadAreaHTML = uploadAreaContent.innerHTML
var originalHasPreview     = uploadArea.classList.contains('has-preview')

function resetUploadArea() {
  imgUpload.value = ''
  uploadAreaContent.innerHTML = originalUploadAreaHTML
  uploadArea.classList.toggle('has-preview', originalHasPreview)
}

function renderImagePreview(src) {
  uploadArea.classList.add('has-preview')
  uploadAreaContent.innerHTML = \`
    <div class="upload-preview-wrap">
      <img src="\${src}" alt="پیش‌نمایش تصویر" class="upload-preview-img">
      <button type="button" class="upload-remove-btn" id="removePreviewBtn" title="بازگشت به حالت قبل">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div style="font-size:.68rem;color:var(--color-text-light);margin-top:.5rem;">تصویر جدید انتخاب شد</div>
  \`

  var removeBtn = document.getElementById('removePreviewBtn')
  if (removeBtn) {
    removeBtn.addEventListener('click', function (e) {
      e.stopPropagation()
      resetUploadArea()
    })
  }
}

function handleSelectedFile(file) {
  if (!file || !file.type || file.type.indexOf('image/') !== 0) return

  var reader = new FileReader()
  reader.onload = function (e) {
    renderImagePreview(e.target.result)
  }
  reader.readAsDataURL(file)
}

uploadArea.addEventListener('click', function (e) {
  if (e.target.closest('#removePreviewBtn')) return
  imgUpload.click()
})

imgUpload.addEventListener('change', function () {
  if (this.files && this.files[0]) {
    handleSelectedFile(this.files[0])
  }
})

uploadArea.addEventListener('dragover', function (e) {
  e.preventDefault()
  uploadArea.classList.add('dragover')
})

uploadArea.addEventListener('dragleave', function () {
  uploadArea.classList.remove('dragover')
})

uploadArea.addEventListener('drop', function (e) {
  e.preventDefault()
  uploadArea.classList.remove('dragover')

  var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]
  if (!file) return

  var dataTransfer = new DataTransfer()
  dataTransfer.items.add(file)
  imgUpload.files = dataTransfer.files

  handleSelectedFile(file)
})

// ─────────────────────────────────────
// دسته‌بندی (افزودن آنی مشابه پورتفولیو)
// ─────────────────────────────────────
var postCategory       = document.getElementById('postCategory')
var addCategoryBtn     = document.getElementById('addCategoryBtn')
var addCategoryBox     = document.getElementById('addCategoryBox')
var newCategoryInput   = document.getElementById('newCategoryInput')
var confirmAddCategory = document.getElementById('confirmAddCategory')

if (addCategoryBtn && addCategoryBox) {
  addCategoryBtn.addEventListener('click', function () {
    var isHidden = !addCategoryBox.style.display || addCategoryBox.style.display === 'none'
    addCategoryBox.style.display = isHidden ? 'flex' : 'none'

    if (isHidden && newCategoryInput) {
      newCategoryInput.focus()
    }
  })
}

function addNewCategory() {
  if (!newCategoryInput || !postCategory) return

  var value = (newCategoryInput.value || '').trim()
  if (!value) return

  var option = document.createElement('option')
  option.value = value
  option.textContent = value
  postCategory.appendChild(option)
  postCategory.value = value

  newCategoryInput.value = ''
  addCategoryBox.style.display = 'none'
}

if (confirmAddCategory) {
  confirmAddCategory.addEventListener('click', addNewCategory)
}

if (newCategoryInput) {
  newCategoryInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault()
      addNewCategory()
    }
  })
}

// ─────────────────────────────────────
// برچسب‌های مقاله (چیپ‌های تعاملی + افزودن آنی)
// ─────────────────────────────────────
var tagChecklist = document.getElementById('tagChecklist')

// هماهنگ‌سازی ظاهر چیپ‌ها با وضعیت واقعی چک‌باکس (انتخاب‌شده/نشده)
function syncTagChipState() {
  if (!tagChecklist) return

  tagChecklist.querySelectorAll('.tag-check-item').forEach(function (label) {
    var checkbox = label.querySelector('input[type="checkbox"]')
    label.classList.toggle('selected', !!(checkbox && checkbox.checked))
  })
}

if (tagChecklist) {
  tagChecklist.addEventListener('change', syncTagChipState)
  syncTagChipState()
}

function ensureTagCheckbox(value, checked) {
  if (!tagChecklist || !value) return

  var existing = Array.from(tagChecklist.querySelectorAll('input[type="checkbox"]'))
    .find(function (cb) { return cb.value === value })

  if (!existing) {
    var label = document.createElement('label')
    label.className = 'tag-check-item'

    var checkbox = document.createElement('input')
    checkbox.type = 'checkbox'
    checkbox.name = 'tags[]'
    checkbox.value = value

    var labelSpan = document.createElement('span')
    labelSpan.className = 'tag-chip-label'
    labelSpan.textContent = value

    var removeSpan = document.createElement('span')
    removeSpan.className = 'tag-chip-remove'
    removeSpan.innerHTML = '<i class="bi bi-x-lg"></i>'

    label.appendChild(checkbox)
    label.appendChild(labelSpan)
    label.appendChild(removeSpan)
    tagChecklist.appendChild(label)

    existing = checkbox
  }

  existing.checked = !!checked
  syncTagChipState()
}

var newTagInput = document.getElementById('newTagInput')
var addTagBtn   = document.getElementById('addTagBtn')

function addNewTag() {
  if (!newTagInput) return

  var value = (newTagInput.value || '').trim()
  if (!value) return

  ensureTagCheckbox(value, true)
  newTagInput.value = ''
}

if (addTagBtn) {
  addTagBtn.addEventListener('click', addNewTag)
}

if (newTagInput) {
  newTagInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault()
      addNewTag()
    }
  })
}

</script>
