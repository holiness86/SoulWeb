<%# views/admin/blog-form.ejs — افزودن / ویرایش مقاله
    ورودی‌ها از server.js: item، isEdit، authors (آرایهٔ {_id,name} یا آرایهٔ id)، categories ({slug,title})
    فرم: POST /sw-admin/blog (ثبت) یا /sw-admin/blog/:id/update (ویرایش) — multipart با coverImage
    فیلدها: title, slug, excerpt, content(HTML از Quill → در schema می‌شود body), category(رشته), author, readTime(دقیقه)، tags[], publish('0'|'1')
    دسته‌بندی در schema فقط یک رشته است؛ پس «دسته جدید» همین‌جا ساخته می‌شود و با اولین مقاله ذخیره می‌شود. %>
<%
  const safeItem = item || {};
  const cats = Array.isArray(categories) ? categories : [];
  const rawAuthors = (typeof authors !== 'undefined' && Array.isArray(authors)) ? authors : [];

  // authors می‌تواند [{_id,name}] (پیشنهادی) یا فقط آرایه‌ای از idها (رفتار قدیمی) باشد
  const authorOpts = rawAuthors.map((a) => (a && typeof a === 'object' && a.name) ? { id: String(a._id), name: a.name } : { id: String(a), name: String(a) });
  const itemAuthorId = safeItem.author ? String(typeof safeItem.author === 'object' && safeItem.author._id ? safeItem.author._id : safeItem.author) : '';

  const defaultTagOptions = [
    'طراحی وب', 'سئو', 'وردپرس', 'فروشگاه اینترنتی', 'برندینگ',
    'بازاریابی دیجیتال', 'تولید محتوا', 'React', 'Node.js', 'تکنولوژی', 'آموزش'
  ];
  const itemTags = Array.isArray(safeItem.tags) ? safeItem.tags : [];
  const itemCategory = safeItem.category && typeof safeItem.category === 'object' ? safeItem.category.slug : safeItem.category;
  const published = safeItem.status === 'published';
  const formAction = isEdit ? ('/sw-admin/blog/' + safeItem._id + '/update') : '/sw-admin/blog';
  const pageTitle = isEdit ? 'ویرایش مقاله' : 'مقاله جدید';
  const content = safeItem.body || safeItem.content || '';
%>
<%- include('partials/_head', {
  title: pageTitle,
  extraHead: '<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">'
}) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'blog' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [
        { label: 'داشبورد', href: '/sw-admin' },
        { label: 'وبلاگ', href: '/sw-admin/blog' },
        { label: pageTitle }
      ],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title"><%= pageTitle %></h1>
          <p class="page-subtitle"><%= isEdit ? 'ویرایش مقاله «' + (safeItem.title || '') + '»' : 'افزودن یک مقاله جدید به وبلاگ' %></p>
        </div>
        <a href="/sw-admin/blog" class="btn-ghost-sm"><i class="bi bi-arrow-right"></i> بازگشت به وبلاگ</a>
      </div>

      <form id="blogForm" action="<%= formAction %>" method="POST" enctype="multipart/form-data" data-validate novalidate>
        <div class="pf-layout fade-up fade-up-2">

          <!-- ═══════ ستون اصلی ═══════ -->
          <div class="pf-main">

            <div class="pf-title-box">
              <input type="text" class="pf-title-input" name="title" id="postTitle" placeholder="عنوان جذاب مقاله را وارد کنید…"
                     value="<%= safeItem.title || '' %>" autocomplete="off" data-rule="required" aria-label="عنوان مقاله">
              <div class="pf-slug-row">
                <span class="pf-slug-prefix">/blog/</span>
                <input type="text" class="pf-slug-input" name="slug" id="postSlug" placeholder="نامک-مقاله" value="<%= safeItem.slug || '' %>" autocomplete="off" dir="ltr" aria-label="نامک (slug)">
              </div>
            </div>

            <div class="pf-editor-box">
              <div class="sw-field">
                <label class="sol-label" for="postExcerpt">خلاصه مقاله</label>
                <textarea class="sol-input" name="excerpt" id="postExcerpt" rows="2" placeholder="چکیده کوتاهی برای نمایش در لیست مقالات و نتایج جستجو…"><%= safeItem.excerpt || '' %></textarea>
              </div>

              <label class="sol-label" for="contentInput">متن کامل مقاله <span class="feat-count" id="wordCount">۰ کلمه</span></label>
              <div id="quillEditor" class="pf-quill"><%- content %></div>
              <textarea name="content" id="contentInput" class="sol-input pf-desc-fallback" rows="14" hidden><%= content %></textarea>
            </div>

          </div>

          <!-- ═══════ سایدبار ═══════ -->
          <div class="pf-sidebar">

            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-broadcast"></i> انتشار</div>
              <div class="pf-box-body">
                <div class="pf-status-row">
                  <span>وضعیت فعلی:</span>
                  <% if (published) { %><span class="badge-status badge-done">منتشرشده</span><% } else { %><span class="badge-status badge-review">پیش‌نویس</span><% } %>
                </div>

                <!-- دکمهٔ اول = دکمهٔ پیش‌فرض Enter؛ برای مقالهٔ منتشرشده باید publish=1 باشد تا ناخواسته پیش‌نویس نشود -->
                <div class="pf-publish-actions">
                  <% if (published) { %>
                    <button class="btn-sol-sm w-100" type="submit" name="publish" value="1"><i class="bi bi-check-lg"></i> ذخیره تغییرات</button>
                    <button class="btn-ghost-sm w-100" type="submit" name="publish" value="0"><i class="bi bi-file-earmark"></i> برگرداندن به پیش‌نویس</button>
                  <% } else { %>
                    <button class="btn-ghost-sm w-100" type="submit" name="publish" value="0"><i class="bi bi-file-earmark"></i> ذخیره پیش‌نویس</button>
                    <button class="btn-sol-sm w-100" type="submit" name="publish" value="1"><i class="bi bi-send"></i> انتشار مقاله</button>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-info-circle"></i> اطلاعات مقاله</div>
              <div class="pf-box-body">

                <div class="sw-field">
                  <label class="sol-label" for="postCategory">دسته‌بندی</label>
                  <div class="sw-inline">
                    <div class="grow">
                      <select class="sol-select" name="category" id="postCategory">
                        <option value="">انتخاب دسته</option>
                        <% cats.forEach(function (cat) { %><option value="<%= cat.slug %>" <%= cat.slug === itemCategory ? 'selected' : '' %>><%= cat.title %></option><% }); %>
                        <% if (itemCategory && !cats.find(function (c) { return c.slug === itemCategory; })) { %><option value="<%= itemCategory %>" selected><%= itemCategory %></option><% } %>
                      </select>
                    </div>
                    <button type="button" class="btn-ghost-sm" id="addCategoryBtn" title="افزودن دسته جدید" aria-label="افزودن دسته جدید" aria-expanded="false"><i class="bi bi-plus-lg"></i></button>
                  </div>
                  <div class="sw-inline" id="addCategoryBox" hidden style="margin-top:.6rem;">
                    <div class="grow"><input type="text" class="sol-input" id="newCategoryInput" placeholder="عنوان دسته جدید…" aria-label="عنوان دسته جدید"></div>
                    <button type="button" class="btn-sol-sm" id="confirmAddCategory">افزودن</button>
                  </div>
                </div>

                <div class="sw-field">
                  <label class="sol-label" for="postAuthor">نویسنده</label>
                  <select class="sol-select" name="author" id="postAuthor">
                    <option value="">انتخاب نویسنده</option>
                    <% authorOpts.forEach(function (a) { %><option value="<%= a.id %>" <%= a.id === itemAuthorId ? 'selected' : '' %>><%= a.name %></option><% }); %>
                    <% if (itemAuthorId && !authorOpts.find(function (a) { return a.id === itemAuthorId; })) { %><option value="<%= itemAuthorId %>" selected><%= (safeItem.author && safeItem.author.name) || itemAuthorId %></option><% } %>
                  </select>
                </div>

                <div class="sw-field" style="margin-bottom:0;">
                  <label class="sol-label" for="postReadTime">زمان مطالعه (دقیقه)</label>
                  <div class="sw-inline">
                    <div class="grow"><input class="sol-input" type="number" min="1" max="999" step="1" dir="ltr" name="readTime" id="postReadTime" placeholder="مثلاً ۵" value="<%= safeItem.readingTime || safeItem.readTime || '' %>"></div>
                    <button type="button" class="btn-ghost-sm" id="estimateRead" title="محاسبه از روی طول متن (۲۰۰ کلمه در دقیقه)"><i class="bi bi-magic"></i> تخمین</button>
                  </div>
                </div>

              </div>
            </div>

            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-tags"></i> برچسب‌های مقاله</div>
              <div class="pf-box-body">
                <div class="tech-checklist" id="tagChecklist">
                  <% defaultTagOptions.concat(itemTags.filter(function (t) { return defaultTagOptions.indexOf(t) === -1; })).forEach(function (tag) { %>
                    <label class="tech-check-item"><input type="checkbox" name="tags[]" value="<%= tag %>" <%= itemTags.indexOf(tag) > -1 ? 'checked' : '' %>><span><%= tag %></span></label>
                  <% }); %>
                </div>
                <div class="sw-inline" style="margin-top:.65rem;">
                  <div class="grow"><input type="text" class="sol-input" id="newTagInput" placeholder="افزودن برچسب جدید…" aria-label="برچسب جدید"></div>
                  <button type="button" class="btn-ghost-sm" id="addTagBtn"><i class="bi bi-plus-lg"></i> افزودن</button>
                </div>
              </div>
            </div>

            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-image"></i> تصویر شاخص</div>
              <div class="pf-box-body">
                <div class="port-upload-area <%= safeItem.coverImage ? 'has-preview' : '' %>" id="uploadArea" role="button" tabindex="0" aria-label="انتخاب تصویر شاخص">
                  <div id="uploadAreaContent">
                    <% if (safeItem.coverImage) { %>
                      <div class="upload-preview-wrap"><img src="<%= safeItem.coverImage %>" alt="<%= safeItem.title || '' %>" class="upload-preview-img"></div>
                      <div class="upload-hint">برای تغییر، کلیک کنید یا فایل را رها کنید</div>
                    <% } else { %>
                      <i class="bi bi-cloud-upload-fill upload-icon"></i>
                      <div class="upload-title">تصویر را بکشید یا کلیک کنید</div>
                      <div class="upload-hint">PNG, JPG, WebP — حداکثر ۱۰ مگابایت</div>
                    <% } %>
                  </div>
                  <input type="file" accept="image/*" id="imgUpload" name="coverImage" hidden>
                </div>
              </div>
            </div>

          </div>
        </div>
      </form>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return Number(v).toLocaleString('fa-IR'); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var form = $('#blogForm'), contentInput = $('#contentInput'), editorEl = $('#quillEditor');
  var dirty = false;
  function markDirty() { dirty = true; }

  /* ───────── ویرایشگر: Quill (CDN) یا textarea ساده اگر لود نشد ───────── */
  var quill = null;
  if (window.Quill) {
    quill = new Quill('#quillEditor', {
      theme: 'snow',
      placeholder: 'متن کامل مقاله را اینجا بنویسید…',
      modules: { toolbar: [
        [{ header: [1, 2, 3, 4, 5, 6, false] }], ['bold', 'italic', 'underline', 'strike'],
        [{ align: '' }, { align: 'center' }, { align: 'right' }, { align: 'justify' }],
        [{ list: 'ordered' }, { list: 'bullet' }], ['link', 'image'], ['clean']
      ] }
    });
    quill.on('text-change', function (d, o, source) { if (source === 'user') markDirty(); });
  } else {
    editorEl.hidden = true; contentInput.hidden = false;
    toast('ویرایشگر پیشرفته بارگذاری نشد', { type: 'warning', detail: 'از کادر متن ساده استفاده کنید؛ برای ویرایشگر کامل اتصال اینترنت لازم است.' });
  }
  function bodyText() { return quill ? quill.getText() : contentInput.value; }
  function words() { return bodyText().trim().split(/\s+/).filter(Boolean).length; }

  form.addEventListener('submit', function () { if (quill) contentInput.value = quill.root.innerHTML; dirty = false; });
  form.addEventListener('input', markDirty);
  window.addEventListener('beforeunload', function (e) { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  /* ───────── شمارندهٔ کلمه + تخمین زمان مطالعه (۲۰۰ کلمه در دقیقه) ───────── */
  var readInput = $('#postReadTime'), readTouched = !!readInput.value;
  function sync() {
    var w = words(); $('#wordCount').textContent = fa(w) + ' کلمه';
    if (!readTouched && w) readInput.value = Math.max(1, Math.ceil(w / 200));
  }
  readInput.addEventListener('input', function () { readTouched = readInput.value !== ''; });
  $('#estimateRead').addEventListener('click', function () {
    var w = words(); if (!w) return toast('ابتدا متن مقاله را بنویسید', { type: 'warning' });
    readInput.value = Math.max(1, Math.ceil(w / 200)); readTouched = true; markDirty();
  });
  if (quill) quill.on('text-change', sync); else contentInput.addEventListener('input', sync);
  sync();

  /* ───────── عنوان: Enter فرم را ارسال نکند؛ نامک خودکار تا وقتی دستی ویرایش نشده ───────── */
  var title = $('#postTitle'), slug = $('#postSlug'), slugTouched = !!slug.value.trim();
  function slugify(t) {
    return (t || '').trim().replace(/[\s_]+/g, '-').replace(/[^\p{L}\p{N}-]+/gu, '').replace(/-+/g, '-').replace(/^-+|-+$/g, '');
  }
  title.addEventListener('input', function () { if (!slugTouched) slug.value = slugify(title.value); });
  slug.addEventListener('input', function () { slugTouched = slug.value.trim().length > 0; });
  title.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('#postExcerpt').focus(); } });

  /* ───────── تصویر شاخص ───────── */
  var area = $('#uploadArea'), areaContent = $('#uploadAreaContent'), file = $('#imgUpload');
  var origHTML = areaContent.innerHTML, origPreview = area.classList.contains('has-preview'), objectUrl = null, MAX = 10 * 1024 * 1024;
  function resetArea() {
    if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    file.value = ''; areaContent.innerHTML = origHTML; area.classList.toggle('has-preview', origPreview);
  }
  function preview(f) {
    if (!f || !f.type || f.type.indexOf('image/') !== 0) return toast('فقط فایل تصویری مجاز است', { type: 'warning' });
    if (f.size > MAX) { file.value = ''; return toast('حجم تصویر بیش از ۱۰ مگابایت است', { type: 'warning', detail: 'تصویر کوچک‌تری انتخاب کنید.' }); }
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(f); areaContent.textContent = '';
    var wrap = document.createElement('div'); wrap.className = 'upload-preview-wrap';
    var img = document.createElement('img'); img.className = 'upload-preview-img'; img.alt = 'پیش‌نمایش تصویر'; img.src = objectUrl;
    var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'upload-remove-btn'; rm.title = 'بازگشت به حالت قبل'; rm.setAttribute('aria-label', 'حذف تصویر انتخاب‌شده');
    var ic = document.createElement('i'); ic.className = 'bi bi-x-lg'; rm.appendChild(ic);
    rm.addEventListener('click', function (e) { e.stopPropagation(); resetArea(); });
    wrap.appendChild(img); wrap.appendChild(rm);
    var hint = document.createElement('div'); hint.className = 'upload-hint'; hint.textContent = 'تصویر جدید انتخاب شد';
    areaContent.appendChild(wrap); areaContent.appendChild(hint); area.classList.add('has-preview'); markDirty();
  }
  area.addEventListener('click', function (e) { if (!e.target.closest('.upload-remove-btn')) file.click(); });
  area.addEventListener('keydown', function (e) { if ((e.key === 'Enter' || e.key === ' ') && e.target === area) { e.preventDefault(); file.click(); } });
  file.addEventListener('change', function () { if (file.files && file.files[0]) preview(file.files[0]); });
  area.addEventListener('dragover', function (e) { e.preventDefault(); area.classList.add('dragover'); });
  area.addEventListener('dragleave', function () { area.classList.remove('dragover'); });
  area.addEventListener('drop', function (e) {
    e.preventDefault(); area.classList.remove('dragover');
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]; if (!f) return;
    try { var dt = new DataTransfer(); dt.items.add(f); file.files = dt.files; } catch (err) {}
    preview(f);
  });

  /* ───────── دسته جدید (رشته) و برچسب جدید ───────── */
  var cat = $('#postCategory'), addBtn = $('#addCategoryBtn'), addBox = $('#addCategoryBox'), newCat = $('#newCategoryInput');
  addBtn.addEventListener('click', function () { var open = addBox.hidden; addBox.hidden = !open; addBtn.setAttribute('aria-expanded', String(open)); if (open) newCat.focus(); });
  function addCategory() {
    var v = (newCat.value || '').trim(); if (!v) return;
    var o = $$('option', cat).filter(function (x) { return x.value === v; })[0];
    if (!o) { o = document.createElement('option'); o.value = v; o.textContent = v; cat.appendChild(o); }
    cat.value = v; newCat.value = ''; addBox.hidden = true; addBtn.setAttribute('aria-expanded', 'false'); markDirty();
  }
  $('#confirmAddCategory').addEventListener('click', addCategory);
  newCat.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addCategory(); } });

  var tagBox = $('#tagChecklist'), newTag = $('#newTagInput');
  function addTag() {
    var v = (newTag.value || '').trim(); if (!v) return;
    var cb = $$('input', tagBox).filter(function (x) { return x.value === v; })[0];
    if (!cb) {
      var label = document.createElement('label'); label.className = 'tech-check-item';
      cb = document.createElement('input'); cb.type = 'checkbox'; cb.name = 'tags[]'; cb.value = v;
      var span = document.createElement('span'); span.textContent = v; label.appendChild(cb); label.appendChild(span); tagBox.appendChild(label);
    }
    cb.checked = true; newTag.value = ''; markDirty();
  }
  $('#addTagBtn').addEventListener('click', addTag);
  newTag.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addTag(); } });
});
</script>

<%- include('partials/_scripts') %>
