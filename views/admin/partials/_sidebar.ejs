<%#
  admin/_sidebar.ejs
  پارامترهای مورد نیاز:
    - activePage  (string)  — نام صفحه فعال: 'dashboard' | 'projects' | 'clients' | ...
    - adminUser   (object)  — { name, role, initials }
%>

<%
  // helper برای تشخیص active
  const isActive = (page) => activePage === page ? 'active' : '';

  // nav items
  const navMain = [
    { page: 'dashboard', href: '/sw-admin',          icon: 'bi-grid-1x2-fill',  label: 'داشبورد' },
    { page: 'projects',  href: '/sw-admin/projects', icon: 'bi-kanban-fill',    label: 'پروژه‌ها', badge: '۱۲' },
    { page: 'clients',   href: '/sw-admin/clients',  icon: 'bi-people-fill',    label: 'مشتریان' },
    { page: 'Tickets',   href: '/sw-admin/tickets',  icon: 'bi-ticket-detailed-fill', label: 'تیکت‌ها', badge: '۵' },
    { page: 'invoices',  href: '/sw-admin/invoices', icon: 'bi-receipt',        label: 'فاکتورها' },
  ];
  
  const navContent = [
    { page: 'portfolio', href: '/sw-admin/portfolio', icon: 'bi-collection-fill', label: 'پورتفولیو' },
    { page: 'packages',  href: '/sw-admin/packages',  icon: 'bi-box-seam-fill',   label: 'پکیج‌ها' },
    { page: 'reviews',   href: '/sw-admin/reviews',   icon: 'bi-star-fill',       label: 'نظرات' },
    { page: 'blog',      href: '/sw-admin/blog',      icon: 'bi-journal-text',    label: 'وبلاگ' },
  ];
  
  const navSystem = [
    { page: 'reports',  href: '/sw-admin/reports',  icon: 'bi-bar-chart-line-fill', label: 'گزارش‌ها' },
    { page: 'settings', href: '/sw-admin/settings', icon: 'bi-gear-fill',           label: 'تنظیمات' },
  ];
%>

<aside class="sidebar" id="sidebar">

  <a class="sidebar-brand" href="/sw-admin">
    <div class="sidebar-logo">سل</div>
    <span class="sidebar-brand-text">سُل وب — پنل</span>
  </a>

  <nav class="sidebar-nav">

    <span class="nav-label">اصلی</span>
    <% navMain.forEach(function(item){ %>
      <a href="<%= item.href %>" class="nav-item-sol <%= isActive(item.page) %>">
        <span class="nav-icon"><i class="bi <%= item.icon %>"></i></span>
        <span class="nav-text"><%= item.label %></span>
        <% if(item.badge){ %><span class="nav-badge"><%= item.badge %></span><% } %>
      </a>
    <% }); %>

    <span class="nav-label">محتوا</span>
    <% navContent.forEach(function(item){ %>
      <a href="<%= item.href %>" class="nav-item-sol <%= isActive(item.page) %>">
        <span class="nav-icon"><i class="bi <%= item.icon %>"></i></span>
        <span class="nav-text"><%= item.label %></span>
        <% if(item.badge){ %><span class="nav-badge"><%= item.badge %></span><% } %>
      </a>
    <% }); %>

    <span class="nav-label">سیستم</span>
    <% navSystem.forEach(function(item){ %>
      <a href="<%= item.href %>" class="nav-item-sol <%= isActive(item.page) %>">
        <span class="nav-icon"><i class="bi <%= item.icon %>"></i></span>
        <span class="nav-text"><%= item.label %></span>
      </a>
    <% }); %>

  </nav>

  <div class="sidebar-footer">
    <div class="user-dropdown" id="userDropdown">

      <button type="button" class="sidebar-user" id="userDropdownTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="userDropdownMenu">
        <div class="user-avatar"><%= adminUser ? adminUser.initials : 'ادم' %></div>
        <div class="user-info">
          <div class="user-name"><%= adminUser ? adminUser.name : 'مدیر سیستم' %></div>
          <div class="user-role"><%= adminUser ? adminUser.role : 'مدیر کل' %></div>
        </div>
        <i class="bi bi-three-dots-vertical user-dropdown-dots" id="userDropdownDots"></i>
      </button>

      <div class="user-dropdown-menu" id="userDropdownMenu" role="menu">
        <a href="/sw-admin/profile" class="user-dropdown-item" role="menuitem">
          <span class="user-dropdown-item-icon"><i class="bi bi-person-circle"></i></span>
          <span class="user-dropdown-item-text">مشاهده پروفایل</span>
        </a>

        <a href="/sw-admin/settings?tab=security" class="user-dropdown-item" role="menuitem">
          <span class="user-dropdown-item-icon"><i class="bi bi-shield-lock-fill"></i></span>
          <span class="user-dropdown-item-text">تنظیمات امنیت</span>
        </a>

        <div class="user-dropdown-divider" role="separator"></div>

        <form action="/sw-admin/logout" method="POST" class="user-dropdown-logout-form">
          <button type="submit" class="user-dropdown-item user-dropdown-item-danger" role="menuitem">
            <span class="user-dropdown-item-icon"><i class="bi bi-box-arrow-right"></i></span>
            <span class="user-dropdown-item-text">خروج از حساب</span>
          </button>
        </form>
      </div>

    </div>
  </div>

</aside>

<style>
  /* ═══════════════════════════════════════════
     User Footer Drop-up — سایدبار سُل وب
  ═══════════════════════════════════════════ */
  .user-dropdown {
    position: relative;
    width: 100%;
  }

  .sidebar-user {
    /* بازنویسی به‌عنوان دکمه (بدون تغییر ظاهر) */
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: .75rem;
    width: 100%;
    cursor: pointer;
    border-radius: var(--radius-md, .9rem);
    transition: background .18s ease;
  }

  .sidebar-user:hover,
  .user-dropdown.open .sidebar-user {
    background: rgba(255, 255, 255, .06);
  }

  .user-dropdown-dots {
    color: rgba(255, 255, 255, .35);
    font-size: .85rem;
    flex-shrink: 0;
    transition: color .18s ease, transform .18s ease;
  }

  .user-dropdown.open .user-dropdown-dots {
    color: rgba(255, 255, 255, .75);
    transform: rotate(90deg);
  }

  /* ── Menu (Drop-up Permanent) ── */
  .user-dropdown-menu {
    position: absolute;
    bottom: calc(100% + .6rem);
    top: auto; /* اطمینان از باز نشدن به سمت پایین */
    right: 0;
    left: 0;
    min-width: 230px;
    background: #1b1d2e;
    background: linear-gradient(160deg, #20223a 0%, #181a2c 100%);
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 1rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, .45), 0 2px 8px rgba(0, 0, 0, .25);
    padding: .5rem;
    z-index: 1050;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(.97);
    transform-origin: bottom center; /* نقطه شروع انیمیشن ثابت در پایین */
    transition: opacity .2s cubic-bezier(.34,1.56,.64,1),
                transform .2s cubic-bezier(.34,1.56,.64,1),
                visibility .2s;
  }

  .user-dropdown.open .user-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  /* فلش کوچک اتصال‌دهنده منو به باکس کاربر */
  .user-dropdown-menu::after {
    content: '';
    position: absolute;
    bottom: -6px; /* کاملا قفل شده در پایین منو */
    right: 1.4rem;
    width: 12px;
    height: 12px;
    background: #1e2038;
    border-left: 1px solid rgba(255, 255, 255, .08);
    border-bottom: 1px solid rgba(255, 255, 255, .08);
    transform: rotate(-45deg);
    border-radius: 0 0 0 3px;
  }

  .user-dropdown-item {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: .65rem;
    width: 100%;
    padding: .65rem .75rem;
    border-radius: .7rem;
    font-size: .85rem;
    font-weight: 500;
    font-family: var(--font-primary, inherit);
    color: rgba(255, 255, 255, .8);
    cursor: pointer;
    transition: background .15s ease, color .15s ease, padding-right .15s ease;
    text-decoration: none;
  }

  .user-dropdown-item:hover,
  .user-dropdown-item:focus-visible {
    background: rgba(100, 71, 244, .18);
    color: #fff;
    padding-right: 1rem;
  }

  .user-dropdown-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: .55rem;
    background: rgba(255, 255, 255, .06);
    font-size: .95rem;
    flex-shrink: 0;
    color: #a394fb;
    transition: background .15s ease, color .15s ease;
  }

  .user-dropdown-item:hover .user-dropdown-item-icon {
    background: rgba(100, 71, 244, .35);
    color: #fff;
  }

  .user-dropdown-item-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-dropdown-divider {
    height: 1px;
    margin: .4rem .3rem;
    background: rgba(255, 255, 255, .08);
  }

  .user-dropdown-logout-form { width: 100%; }

  .user-dropdown-item-danger { color: rgba(255, 120, 120, .85); }
  
  .user-dropdown-item-danger .user-dropdown-item-icon {
    color: #ff7878;
    background: rgba(255, 90, 90, .1);
  }
  
  .user-dropdown-item-danger:hover {
    background: rgba(220, 53, 69, .16);
    color: #ff9c9c;
  }
  
  .user-dropdown-item-danger:hover .user-dropdown-item-icon {
    background: rgba(220, 53, 69, .35);
    color: #fff;
  }
</style>

<script>
  (function () {
    const dropdown  = document.getElementById('userDropdown');
    const trigger   = document.getElementById('userDropdownTrigger');
    const menu      = document.getElementById('userDropdownMenu');
    if (!dropdown || !trigger || !menu) return;

    function openMenu() {
      dropdown.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      dropdown.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    function toggleMenu(e) {
      e.stopPropagation();
      dropdown.classList.contains('open') ? closeMenu() : openMenu();
    }

    trigger.addEventListener('click', toggleMenu);

    // بستن با کلیک بیرون از منو
    document.addEventListener('click', function (e) {
      if (!dropdown.contains(e.target)) closeMenu();
    });

    // بستن با کلید Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });

    // بستن منو با انتخاب هر گزینه (بجز اینکه فرم خروج خودش ساب‌میت شود)
    menu.querySelectorAll('.user-dropdown-item').forEach(function (item) {
      item.addEventListener('click', function () {
        closeMenu();
      });
    });
  })();
</script>