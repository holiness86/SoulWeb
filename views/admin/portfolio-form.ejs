<%# views/admin/portfolio-form.ejs — افزودن / ویرایش نمونه کار
    ورودی‌ها از server.js: item، isEdit، clients، categories
    فرم: POST /sw-admin/portfolio (ثبت) یا /sw-admin/portfolio/:id/update (ویرایش) — multipart با coverImage
    فیلدهای مهم: title, description(HTML از Quill), category(slug), techStack[], client, liveUrl, isFeatured('on'), publish('0'|'1'), seoKeywords, metaDescription
    ویرایشگر Quill از CDN (jsDelivr) لود می‌شود؛ اگر در دسترس نباشد، یک textarea ساده جایگزین می‌شود. %>
<%
  const safeItem = item || {};
  const cats = Array.isArray(categories) ? categories : [];
  const cls  = Array.isArray(clients) ? clients : [];

  const defaultTechOptions = [
    'PHP', 'Laravel', 'وردپرس', 'React', 'Vue.js', 'Next.js', 'Node.js', 'Angular',
    'TypeScript', 'Tailwind CSS', 'Bootstrap', 'MySQL', 'MongoDB', 'jQuery'
  ];

  const itemCategorySlug = safeItem.category && typeof safeItem.category === 'object' ? safeItem.category.slug : safeItem.category;
  const itemClientId = safeItem.client ? (safeItem.client._id || safeItem.client) : '';
  const itemTech = Array.isArray(safeItem.techStack) ? safeItem.techStack : [];
  const formAction = isEdit ? ('/sw-admin/portfolio/' + safeItem._id + '/update') : '/sw-admin/portfolio';
  const published = !!safeItem.isPublished;
  const pageTitle = isEdit ? 'ویرایش نمونه کار' : 'نمونه کار جدید';
%>
<%- include('partials/_head', {
  title: pageTitle,
  extraHead: '<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">'
}) %>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <%- include('partials/_sidebar', { activePage: 'portfolio' }) %>

  <div class="main-content" id="mainContent">

    <%- include('partials/_header', {
      breadcrumbs: [
        { label: 'داشبورد', href: '/sw-admin' },
        { label: 'پورتفولیو', href: '/sw-admin/portfolio' },
        { label: pageTitle }
      ],
      searchPlaceholder: 'جستجو در پنل…'
    }) %>

    <main class="page-content">

      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title"><%= pageTitle %></h1>
          <p class="page-subtitle"><%= isEdit ? 'ویرایش اطلاعات پروژه «' + (safeItem.title || '') + '»' : 'افزودن یک پروژه جدید به گالری پورتفولیو' %></p>
        </div>
        <a href="/sw-admin/portfolio" class="btn-ghost-sm"><i class="bi bi-arrow-right"></i> بازگشت به پورتفولیو</a>
      </div>

      <form id="portfolioForm" action="<%= formAction %>" method="POST" enctype="multipart/form-data" data-validate novalidate>
        <div class="pf-layout fade-up fade-up-2">

          <!-- ═══════ ستون اصلی ═══════ -->
          <div class="pf-main">

            <div class="pf-title-box">
              <input type="text" class="pf-title-input" name="title" id="portTitle" placeholder="عنوان پروژه را وارد کنید…"
                     value="<%= safeItem.title || '' %>" autocomplete="off" data-rule="required" aria-label="عنوان پروژه">
            </div>

            <div class="pf-editor-box">
              <label class="sol-label" for="descriptionInput">توضیحات کامل پروژه</label>
              <div id="quillEditor" class="pf-quill"><%- safeItem.description || '' %></div>
              <textarea name="description" id="descriptionInput" class="sol-input pf-desc-fallback" rows="12" hidden><%= safeItem.description || '' %></textarea>
            </div>

          </div>

          <!-- ═══════ سایدبار ═══════ -->
          <div class="pf-sidebar">

            <!-- انتشار -->
            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-broadcast"></i> انتشار</div>
              <div class="pf-box-body">
                <div class="pf-status-row">
                  <span>وضعیت فعلی:</span>
                  <% if (published) { %><span class="badge-status badge-done">منتشرشده</span><% } else { %><span class="badge-status badge-new">پیش‌نویس</span><% } %>
                </div>

                <label class="sw-switch-row pf-feat">
                  <span class="sw-toggle"><input type="checkbox" name="isFeatured" id="portFeatured" <%= safeItem.isFeatured ? 'checked' : '' %>><span class="sw-slider"></span></span>
                  <span>نمونه کار ویژه</span>
                </label>

                <!-- دکمهٔ اول = دکمهٔ پیش‌فرض Enter: برای نمونه‌ی منتشرشده باید «ذخیره» (publish=1) باشد تا ناخواسته پیش‌نویس نشود -->
                <div class="pf-publish-actions">
                  <% if (published) { %>
                    <button class="btn-sol-sm w-100" type="submit" name="publish" value="1"><i class="bi bi-check-lg"></i> ذخیره تغییرات</button>
                    <button class="btn-ghost-sm w-100" type="submit" name="publish" value="0"><i class="bi bi-file-earmark"></i> برگرداندن به پیش‌نویس</button>
                  <% } else { %>
                    <button class="btn-ghost-sm w-100" type="submit" name="publish" value="0"><i class="bi bi-file-earmark"></i> ذخیره پیش‌نویس</button>
                    <button class="btn-sol-sm w-100" type="submit" name="publish" value="1"><i class="bi bi-send"></i> انتشار</button>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- اطلاعات پروژه -->
            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-info-circle"></i> اطلاعات پروژه</div>
              <div class="pf-box-body">
                <div class="sw-field">
                  <label class="sol-label" for="portClient">مشتری</label>
                  <select class="sol-select" name="client" id="portClient">
                    <option value="">بدون مشتری</option>
                    <% cls.forEach(function (c) { %><option value="<%= c._id %>" <%= String(c._id) === String(itemClientId) ? 'selected' : '' %>><%= c.name %></option><% }); %>
                  </select>
                </div>
                <div class="sw-field" style="margin-bottom:0;">
                  <label class="sol-label" for="portUrl">لینک زنده پروژه</label>
                  <input class="sol-input" type="url" name="liveUrl" id="portUrl" placeholder="https://…" dir="ltr" value="<%= safeItem.liveUrl || '' %>" data-rule="url">
                </div>
              </div>
            </div>

            <!-- دسته‌بندی و تکنولوژی -->
            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-tags"></i> دسته‌بندی و تکنولوژی‌ها</div>
              <div class="pf-box-body">
                <div class="sw-field">
                  <label class="sol-label" for="portCategory">دسته‌بندی</label>
                  <div class="sw-inline">
                    <div class="grow">
                      <select class="sol-select" name="category" id="portCategory">
                        <option value="">انتخاب دسته</option>
                        <% cats.forEach(function (cat) { %><option value="<%= cat.slug %>" <%= cat.slug === itemCategorySlug ? 'selected' : '' %>><%= cat.title %></option><% }); %>
                        <% if (itemCategorySlug && !cats.find(function (c) { return c.slug === itemCategorySlug; })) { %><option value="<%= itemCategorySlug %>" selected><%= itemCategorySlug %></option><% } %>
                      </select>
                    </div>
                    <button type="button" class="btn-ghost-sm" id="addCategoryBtn" title="افزودن دسته جدید" aria-label="افزودن دسته جدید" aria-expanded="false"><i class="bi bi-plus-lg"></i></button>
                  </div>
                  <div class="sw-inline" id="addCategoryBox" hidden style="margin-top:.6rem;">
                    <div class="grow"><input type="text" class="sol-input" id="newCategoryInput" placeholder="عنوان دسته جدید…" aria-label="عنوان دسته جدید"></div>
                    <button type="button" class="btn-sol-sm" id="confirmAddCategory">افزودن</button>
                  </div>
                </div>

                <div class="sw-field" style="margin-bottom:0;">
                  <span class="sol-label">تکنولوژی‌های استفاده‌شده</span>
                  <div class="tech-checklist" id="techChecklist">
                    <% defaultTechOptions.concat(itemTech.filter(function (t) { return defaultTechOptions.indexOf(t) === -1; })).forEach(function (tech) { %>
                      <label class="tech-check-item"><input type="checkbox" name="techStack[]" value="<%= tech %>" <%= itemTech.indexOf(tech) > -1 ? 'checked' : '' %>><span><%= tech %></span></label>
                    <% }); %>
                  </div>
                  <div class="sw-inline" style="margin-top:.65rem;">
                    <div class="grow"><input type="text" class="sol-input" id="newTechInput" placeholder="افزودن تکنولوژی جدید…" aria-label="تکنولوژی جدید"></div>
                    <button type="button" class="btn-ghost-sm" id="addTechBtn"><i class="bi bi-plus-lg"></i> افزودن</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- تصویر شاخص -->
            <div class="pf-box">
              <div class="pf-box-header"><i class="bi bi-image"></i> تصویر شاخص</div>
              <div class="pf-box-body">
                <div class="port-upload-area <%= safeItem.coverImage ? 'has-preview' : '' %>" id="uploadArea" role="button" tabindex="0" aria-label="انتخاب تصویر شاخص">
                  <div id="uploadAreaContent">
                    <% if (safeItem.coverImage) { %>
                      <div class="upload-preview-wrap"><img src="<%= safeItem.coverImage %>" alt="<%= safeItem.title || '' %>" class="upload-preview-img"></div>
                      <div class="upload-hint">برای تغییر، کلیک کنید یا فایل را رها کنید</div>
                    <% } else { %>
                      <i class="bi bi-cloud-upload-fill upload-icon"></i>
                      <div class="upload-title">تصویر را بکشید یا کلیک کنید</div>
                      <div class="upload-hint">PNG, JPG, WebP — حداکثر ۱۰ مگابایت</div>
                    <% } %>
                  </div>
                  <input type="file" accept="image/*" id="imgUpload" name="coverImage" hidden>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ═══════ سئو داخلی ═══════ -->
        <div class="pf-seo-box fade-up fade-up-3">
          <div class="pf-seo-header"><i class="bi bi-graph-up-arrow"></i><span>سئو داخلی (پایه)</span></div>
          <div class="pf-seo-body">
            <div class="pf-seo-grid">
              <div>
                <div class="sw-field">
                  <label class="sol-label" for="focusKeyword">کلمه کلیدی تمرکزی (Focus Keyword)</label>
                  <input class="sol-input" type="text" id="focusKeyword" name="seoKeywords" placeholder="مثلاً: طراحی وب‌سایت فروشگاهی" value="<%= safeItem.seoKeywords || '' %>" autocomplete="off">
                </div>
                <div class="sw-field" style="margin-bottom:0;">
                  <label class="sol-label" for="metaDescription">توضیحات متا (Meta Description)</label>
                  <textarea class="sol-input" id="metaDescription" name="metaDescription" rows="3" maxlength="160" placeholder="خلاصه‌ای گیرا برای نمایش در نتایج گوگل…"><%= safeItem.metaDescription || '' %></textarea>
                  <div class="pf-char-counter"><span id="metaCharCount">۰</span> / ۱۶۰ کاراکتر</div>
                </div>
              </div>

              <div class="pf-seo-checklist" id="seoChecklist">
                <div class="pf-seo-check" data-check="titleHasKeyword"><i class="bi bi-circle"></i><span>کلمه کلیدی تمرکزی در «عنوان پروژه» استفاده شده است</span></div>
                <div class="pf-seo-check" data-check="metaHasKeyword"><i class="bi bi-circle"></i><span>کلمه کلیدی تمرکزی در «توضیحات متا» وجود دارد</span></div>
                <div class="pf-seo-check" data-check="bodyHasKeyword"><i class="bi bi-circle"></i><span>کلمه کلیدی تمرکزی در متن توضیحات اصلی استفاده شده است</span></div>
                <div class="pf-seo-check" data-check="bodyLength"><i class="bi bi-circle"></i><span>حداقل ۳۰۰ کلمه در توضیحات اصلی وجود دارد (<span id="wordCountLabel">۰</span> کلمه)</span></div>
              </div>
            </div>
          </div>
        </div>

      </form>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  function $(s, c) { return (c || document).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
  function fa(v) { return Number(v).toLocaleString('fa-IR'); }
  function toast(m, o) { if (window.SW) SW.island(m, o); }

  var form = $('#portfolioForm'), descInput = $('#descriptionInput'), editorEl = $('#quillEditor');
  var dirty = false;
  function markDirty() { dirty = true; }

  /* ───────── ویرایشگر: Quill (CDN) یا textarea ساده اگر لود نشد ───────── */
  var quill = null;
  if (window.Quill) {
    quill = new Quill('#quillEditor', {
      theme: 'snow',
      placeholder: 'توضیحات کامل پروژه را اینجا بنویسید…',
      modules: { toolbar: [
        [{ header: [1, 2, 3, 4, 5, 6, false] }], ['bold', 'italic', 'underline', 'strike'],
        [{ align: '' }, { align: 'center' }, { align: 'right' }, { align: 'justify' }],
        [{ list: 'ordered' }, { list: 'bullet' }], ['link', 'image'], ['clean']
      ] }
    });
    quill.on('text-change', function (d, o, source) { if (source === 'user') markDirty(); });
  } else {
    editorEl.hidden = true; descInput.hidden = false;
    toast('ویرایشگر پیشرفته بارگذاری نشد', { type: 'warning', detail: 'از کادر متن ساده استفاده کنید؛ برای ویرایشگر کامل اتصال اینترنت لازم است.' });
  }
  function bodyText() { return quill ? quill.getText() : descInput.value; }

  // ارسال: محتوای ویرایشگر داخل textarea مخفی کپی می‌شود
  form.addEventListener('submit', function () { if (quill) descInput.value = quill.root.innerHTML; dirty = false; });
  form.addEventListener('input', markDirty);
  window.addEventListener('beforeunload', function (e) { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  // Enter در عنوان فرم را ارسال نکند؛ فوکوس به ویرایشگر برود
  $('#portTitle').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); if (quill) quill.focus(); else descInput.focus(); }
  });

  /* ───────── تصویر شاخص: انتخاب / کشیدن‌ورها کردن / پیش‌نمایش ───────── */
  var area = $('#uploadArea'), areaContent = $('#uploadAreaContent'), file = $('#imgUpload');
  var origHTML = areaContent.innerHTML, origPreview = area.classList.contains('has-preview'), objectUrl = null;
  var MAX = 10 * 1024 * 1024;

  function resetArea() {
    if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    file.value = ''; areaContent.innerHTML = origHTML; area.classList.toggle('has-preview', origPreview);
  }
  function preview(f) {
    if (!f || !f.type || f.type.indexOf('image/') !== 0) return toast('فقط فایل تصویری مجاز است', { type: 'warning' });
    if (f.size > MAX) { file.value = ''; return toast('حجم تصویر بیش از ۱۰ مگابایت است', { type: 'warning', detail: 'تصویر کوچک‌تری انتخاب کنید.' }); }
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(f);
    areaContent.textContent = '';
    var wrap = document.createElement('div'); wrap.className = 'upload-preview-wrap';
    var img = document.createElement('img'); img.className = 'upload-preview-img'; img.alt = 'پیش‌نمایش تصویر'; img.src = objectUrl;
    var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'upload-remove-btn'; rm.title = 'بازگشت به حالت قبل'; rm.setAttribute('aria-label', 'حذف تصویر انتخاب‌شده');
    rm.innerHTML = '<i class="bi bi-x-lg"></i>';
    rm.addEventListener('click', function (e) { e.stopPropagation(); resetArea(); });
    wrap.appendChild(img); wrap.appendChild(rm);
    var hint = document.createElement('div'); hint.className = 'upload-hint'; hint.textContent = 'تصویر جدید انتخاب شد';
    areaContent.appendChild(wrap); areaContent.appendChild(hint);
    area.classList.add('has-preview'); markDirty();
  }
  area.addEventListener('click', function (e) { if (!e.target.closest('.upload-remove-btn')) file.click(); });
  area.addEventListener('keydown', function (e) { if ((e.key === 'Enter' || e.key === ' ') && e.target === area) { e.preventDefault(); file.click(); } });
  file.addEventListener('change', function () { if (file.files && file.files[0]) preview(file.files[0]); });
  area.addEventListener('dragover', function (e) { e.preventDefault(); area.classList.add('dragover'); });
  area.addEventListener('dragleave', function () { area.classList.remove('dragover'); });
  area.addEventListener('drop', function (e) {
    e.preventDefault(); area.classList.remove('dragover');
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]; if (!f) return;
    try { var dt = new DataTransfer(); dt.items.add(f); file.files = dt.files; } catch (err) {}
    preview(f);
  });

  /* ───────── دسته‌بندی جدید (ذخیره‌ی واقعی در دیتابیس) و تکنولوژی ───────── */
  var cat = $('#portCategory'), addBtn = $('#addCategoryBtn'), addBox = $('#addCategoryBox'), newCat = $('#newCategoryInput'), okCat = $('#confirmAddCategory');
  addBtn.addEventListener('click', function () { var open = addBox.hidden; addBox.hidden = !open; addBtn.setAttribute('aria-expanded', String(open)); if (open) newCat.focus(); });

  function addCategory() {
    var title = (newCat.value || '').trim(); if (!title) return;
    okCat.classList.add('sw-loading'); okCat.disabled = true;
    fetch('/sw-admin/service-categories/add', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ title: title, type: 'portfolio' })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(j.message || 'خطا در ثبت دسته‌بندی'); return j; });
    }).then(function (j) {
      var value = j.category.slug || j.category.title;     // اگر سرور slug برنگرداند، عنوان به‌عنوان مقدار استفاده می‌شود
      var o = document.createElement('option'); o.value = value; o.textContent = j.category.title; cat.appendChild(o); cat.value = value;
      newCat.value = ''; addBox.hidden = true; addBtn.setAttribute('aria-expanded', 'false'); markDirty();
      toast('دسته‌بندی اضافه شد', { type: 'success', detail: j.category.title });
    }).catch(function (err) { toast(err.message || 'خطا در ارتباط با سرور', { type: 'error' }); })
      .then(function () { okCat.classList.remove('sw-loading'); okCat.disabled = false; });
  }
  okCat.addEventListener('click', addCategory);
  newCat.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addCategory(); } });

  var techBox = $('#techChecklist'), newTech = $('#newTechInput');
  function addTech() {
    var v = (newTech.value || '').trim(); if (!v) return;
    var cb = $$('input', techBox).filter(function (x) { return x.value === v; })[0];
    if (!cb) {
      var label = document.createElement('label'); label.className = 'tech-check-item';
      cb = document.createElement('input'); cb.type = 'checkbox'; cb.name = 'techStack[]'; cb.value = v;
      var span = document.createElement('span'); span.textContent = v; label.appendChild(cb); label.appendChild(span); techBox.appendChild(label);
    }
    cb.checked = true; newTech.value = ''; markDirty();
  }
  $('#addTechBtn').addEventListener('click', addTech);
  newTech.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addTech(); } });

  /* ───────── تحلیل زنده‌ی سئو ───────── */
  var kw = $('#focusKeyword'), meta = $('#metaDescription'), title = $('#portTitle');
  function seo() {
    var k = (kw.value || '').trim().toLowerCase(), body = bodyText();
    var words = body.trim().split(/\s+/).filter(Boolean).length;
    var checks = {
      titleHasKeyword: !!k && title.value.toLowerCase().indexOf(k) > -1,
      metaHasKeyword : !!k && meta.value.toLowerCase().indexOf(k) > -1,
      bodyHasKeyword : !!k && body.toLowerCase().indexOf(k) > -1,
      bodyLength     : words >= 300
    };
    Object.keys(checks).forEach(function (key) {
      var el = $('.pf-seo-check[data-check="' + key + '"]'); if (!el) return;
      el.classList.toggle('pf-check-pass', checks[key]);
      $('i', el).className = 'bi ' + (checks[key] ? 'bi-check-circle-fill' : 'bi-circle');
    });
    $('#wordCountLabel').textContent = fa(words);
    var len = meta.value.length; $('#metaCharCount').textContent = fa(len);
    $('#metaCharCount').parentElement.classList.toggle('over', len >= 160);
  }
  [kw, meta, title].forEach(function (el) { el.addEventListener('input', seo); });
  if (quill) quill.on('text-change', seo); else descInput.addEventListener('input', seo);
  seo();
});
</script>

<%- include('partials/_scripts') %>
