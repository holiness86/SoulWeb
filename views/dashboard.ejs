<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سُل وب — پنل مدیریت</title>
  <link rel="stylesheet" href="assets/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="assets/css/icons-1.13.1/font/bootstrap-icons.min.css">

  <style>
    /* ═══════════════════════════════════════
       DESIGN TOKENS — همگام با style.css
    ═══════════════════════════════════════ */
    @font-face {
      font-family: YekanBakh;
      src: url("assets/fonts/YekanBakh-VF.ttf");
    }

    :root {
      --font-primary : 'YekanBakh', 'Tahoma', sans-serif;

      --main-50   : #f0eeff;
      --main-100  : #ddd9fe;
      --main-200  : #c4bcfd;
      --main-300  : #a394fb;
      --main-400  : #836af8;
      --main-500  : #6447f4;
      --main-600  : #5236d6;
      --main-700  : #4028b8;
      --main-800  : #2f1d95;
      --main-900  : #1e1274;

      --accent-400 : #17aaff;
      --accent-500 : #0090e8;
      --accent-600 : #0073bf;

      --neutral-0   : #ffffff;
      --neutral-50  : #f7f7fb;
      --neutral-100 : #eeeff7;
      --neutral-200 : #dcddf0;
      --neutral-300 : #c3c4de;
      --neutral-400 : #9899bc;
      --neutral-500 : #6d6e94;
      --neutral-600 : #505175;
      --neutral-700 : #393a5c;
      --neutral-800 : #232441;
      --neutral-900 : #10102a;

      --color-bg           : #f5f5fb;
      --color-surface      : #ffffff;
      --color-surface-alt  : #f0eeff;
      --color-border       : #e2e2f0;
      --color-text-primary : #10102a;
      --color-text-muted   : #6d6e94;
      --color-text-light   : #9899bc;

      --grad-main   : linear-gradient(135deg, #6447f4 0%, #0090e8 100%);
      --grad-hero   : linear-gradient(145deg, #1e1274 0%, #4028b8 40%, #0073bf 100%);
      --grad-soft   : linear-gradient(135deg, #f0eeff 0%, #e8f8ff 100%);

      --shadow-xs   : 0 1px 3px rgba(16,16,42,.06);
      --shadow-sm   : 0 2px 8px rgba(16,16,42,.08);
      --shadow-md   : 0 4px 20px rgba(16,16,42,.10);
      --shadow-lg   : 0 8px 40px rgba(16,16,42,.12);
      --shadow-main : 0 8px 32px rgba(100,71,244,.28);

      --radius-sm  : .75rem;
      --radius-md  : 1.1rem;
      --radius-lg  : 1.5rem;
      --radius-xl  : 2rem;
      --radius-full: 9999px;

      --ease-spring : cubic-bezier(.34, 1.56, .64, 1);
      --ease-smooth : cubic-bezier(.4, 0, .2, 1);
      --dur-fast    : 150ms;
      --dur-normal  : 280ms;

      /* Layout */
      --sidebar-w      : 260px;
      --sidebar-w-mini : 72px;
      --header-h       : 60px;
    }

    [data-bs-theme="dark"] {
      --color-bg           : #0d0d22;
      --color-surface      : #14142e;
      --color-surface-alt  : #1a1a38;
      --color-border       : rgba(255,255,255,.08);
      --color-text-primary : #e8e8f5;
      --color-text-muted   : #9899bc;
      --color-text-light   : #505175;
    }

    /* ═══════════════════════════════════════
       BASE
    ═══════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      font-family : var(--font-primary);
      font-size   : .9rem;
      line-height : 1.65;
      color       : var(--color-text-primary);
      background  : var(--color-bg);
      overflow-x  : hidden;
      direction   : rtl;
      transition  : background var(--dur-normal) var(--ease-smooth),
                    color var(--dur-normal) var(--ease-smooth);
    }

    ::-webkit-scrollbar       { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--main-300); border-radius: 99px; }

    /* ═══════════════════════════════════════
       LAYOUT SHELL
    ═══════════════════════════════════════ */
    .admin-shell {
      display   : flex;
      min-height: 100vh;
      position  : relative;
    }

    /* ═══════════════════════════════════════
       SIDEBAR
    ═══════════════════════════════════════ */
    .sidebar {
      width           : var(--sidebar-w);
      flex-shrink     : 0;
      position        : fixed;
      top             : 0; right: 0; bottom: 0;
      background      : var(--neutral-900);
      display         : flex;
      flex-direction  : column;
      z-index         : 1050;
      transition      : width var(--dur-normal) var(--ease-smooth),
                        transform var(--dur-normal) var(--ease-smooth);
      overflow        : hidden;
    }

    .sidebar.mini {
      width: var(--sidebar-w-mini);
    }

    /* Sidebar gradient accent bar */
    .sidebar::before {
      content    : '';
      position   : absolute;
      top        : 0; right: 0;
      width      : 3px;
      height     : 100%;
      background : var(--grad-main);
      opacity    : .6;
    }

    /* Brand */
    .sidebar-brand {
      display       : flex;
      align-items   : center;
      gap           : .75rem;
      padding       : 1.1rem 1.1rem 1rem;
      border-bottom : 1px solid rgba(255,255,255,.07);
      text-decoration: none;
      flex-shrink   : 0;
      min-height    : var(--header-h);
    }

    .sidebar-logo {
      width          : 36px;
      height         : 36px;
      border-radius  : var(--radius-sm);
      background     : var(--grad-main);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : .8rem;
      font-weight    : 900;
      color          : #fff;
      flex-shrink    : 0;
      box-shadow     : var(--shadow-main);
    }

    .sidebar-brand-text {
      font-size    : 1.15rem;
      font-weight  : 900;
      background   : var(--grad-main);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      white-space  : nowrap;
      transition   : opacity var(--dur-fast) var(--ease-smooth),
                     width var(--dur-fast) var(--ease-smooth);
    }

    .sidebar.mini .sidebar-brand-text,
    .sidebar.mini .nav-label,
    .sidebar.mini .nav-text,
    .sidebar.mini .nav-badge {
      opacity : 0;
      width   : 0;
      overflow: hidden;
    }

    /* Nav sections */
    .sidebar-nav {
      flex      : 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding   : .75rem .7rem;
      display   : flex;
      flex-direction: column;
      gap       : .25rem;
    }
    .sidebar-nav::-webkit-scrollbar { width: 3px; }

    .nav-label {
      font-size    : .68rem;
      font-weight  : 700;
      color        : rgba(255,255,255,.25);
      text-transform: uppercase;
      letter-spacing: .1em;
      padding      : .8rem .5rem .3rem;
      white-space  : nowrap;
      transition   : opacity var(--dur-fast);
    }

    .nav-item-sol {
      display       : flex;
      align-items   : center;
      gap           : .75rem;
      padding       : .65rem .75rem;
      border-radius : var(--radius-sm);
      color         : rgba(255,255,255,.5);
      text-decoration: none;
      transition    : all var(--dur-fast) var(--ease-smooth);
      cursor        : pointer;
      position      : relative;
      white-space   : nowrap;
      font-size     : .87rem;
      font-weight   : 500;
    }

    .nav-item-sol .nav-icon {
      width          : 34px;
      height         : 34px;
      border-radius  : var(--radius-sm);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : 1rem;
      flex-shrink    : 0;
      transition     : all var(--dur-normal) var(--ease-spring);
      background     : rgba(255,255,255,.06);
    }

    .nav-item-sol:hover {
      color     : rgba(255,255,255,.9);
      background: rgba(255,255,255,.07);
    }
    .nav-item-sol:hover .nav-icon {
      background: rgba(100,71,244,.25);
      color     : var(--main-300);
    }

    .nav-item-sol.active {
      color     : #fff;
      background: rgba(100,71,244,.2);
    }
    .nav-item-sol.active .nav-icon {
      background: var(--grad-main);
      color     : #fff;
      box-shadow: 0 4px 16px rgba(100,71,244,.4);
    }
    .nav-item-sol.active::before {
      content      : '';
      position     : absolute;
      right        : -0.7rem;
      top          : 50%;
      transform    : translateY(-50%);
      width        : 3px;
      height       : 60%;
      border-radius: 99px;
      background   : var(--grad-main);
    }

    .nav-text { transition: opacity var(--dur-fast), width var(--dur-fast); }

    .nav-badge {
      margin-right : auto;
      background   : var(--main-500);
      color        : #fff;
      font-size    : .65rem;
      font-weight  : 700;
      padding      : .1rem .45rem;
      border-radius: 99px;
      transition   : opacity var(--dur-fast), width var(--dur-fast);
    }

    /* Sidebar footer */
    .sidebar-footer {
      padding      : .85rem .7rem;
      border-top   : 1px solid rgba(255,255,255,.07);
      flex-shrink  : 0;
    }

    .sidebar-user {
      display     : flex;
      align-items : center;
      gap         : .65rem;
      padding     : .6rem .75rem;
      border-radius: var(--radius-sm);
      transition  : background var(--dur-fast);
      cursor      : pointer;
    }
    .sidebar-user:hover { background: rgba(255,255,255,.06); }

    .user-avatar {
      width          : 34px;
      height         : 34px;
      border-radius  : var(--radius-sm);
      background     : var(--grad-main);
      color          : #fff;
      font-size      : .72rem;
      font-weight    : 800;
      display        : flex;
      align-items    : center;
      justify-content: center;
      flex-shrink    : 0;
    }

    .user-info { overflow: hidden; }
    .user-name {
      font-size  : .82rem;
      font-weight: 700;
      color      : rgba(255,255,255,.9);
      white-space: nowrap;
    }
    .user-role {
      font-size : .7rem;
      color     : rgba(255,255,255,.35);
      white-space: nowrap;
    }

    /* ═══════════════════════════════════════
       MAIN CONTENT
    ═══════════════════════════════════════ */
    .main-content {
      flex       : 1;
      margin-right: var(--sidebar-w);
      min-height : 100vh;
      display    : flex;
      flex-direction: column;
      transition : margin-right var(--dur-normal) var(--ease-smooth);
    }
    .main-content.mini { margin-right: var(--sidebar-w-mini); }

    /* ═══════════════════════════════════════
       HEADER
    ═══════════════════════════════════════ */
    .admin-header {
      height          : var(--header-h);
      background      : var(--color-surface);
      border-bottom   : 1px solid var(--color-border);
      display         : flex;
      align-items     : center;
      padding         : 0 1.5rem;
      gap             : 1rem;
      position        : sticky;
      top             : 0;
      z-index         : 100;
      transition      : background var(--dur-normal) var(--ease-smooth),
                        border-color var(--dur-normal);
      backdrop-filter : blur(20px);
    }

    .header-toggle {
      width         : 34px;
      height        : 34px;
      border-radius : var(--radius-sm);
      border        : 1.5px solid var(--color-border);
      background    : var(--color-bg);
      color         : var(--color-text-muted);
      display       : flex;
      align-items   : center;
      justify-content: center;
      cursor        : pointer;
      transition    : all var(--dur-fast) var(--ease-smooth);
      font-size     : 1rem;
      flex-shrink   : 0;
    }
    .header-toggle:hover {
      background   : var(--main-50);
      border-color : var(--main-300);
      color        : var(--main-500);
    }
    [data-bs-theme="dark"] .header-toggle:hover { background: rgba(100,71,244,.15); }

    /* Breadcrumb */
    .header-breadcrumb {
      flex      : 1;
      display   : flex;
      align-items: center;
      gap       : .4rem;
      font-size : .8rem;
      color     : var(--color-text-muted);
    }
    .header-breadcrumb .current {
      font-weight: 700;
      color      : var(--color-text-primary);
    }
    .header-breadcrumb .sep { color: var(--color-text-light); }

    /* Search */
    .header-search {
      display       : flex;
      align-items   : center;
      gap           : .4rem;
      background    : var(--color-bg);
      border        : 1.5px solid var(--color-border);
      border-radius : var(--radius-md);
      padding       : .35rem .85rem;
      transition    : all var(--dur-fast);
      cursor        : text;
    }
    .header-search:focus-within {
      border-color : var(--main-400);
      box-shadow   : 0 0 0 3px rgba(100,71,244,.12);
    }
    .header-search i { color: var(--color-text-light); font-size: .85rem; }
    .header-search input {
      border    : none;
      background: transparent;
      outline   : none;
      font-family: var(--font-primary);
      font-size : .82rem;
      color     : var(--color-text-primary);
      width     : 160px;
    }
    .header-search input::placeholder { color: var(--color-text-light); }

    /* Header actions */
    .header-actions {
      display    : flex;
      align-items: center;
      gap        : .5rem;
    }

    .hdr-btn {
      width         : 34px;
      height        : 34px;
      border-radius : var(--radius-sm);
      border        : 1.5px solid var(--color-border);
      background    : var(--color-bg);
      color         : var(--color-text-muted);
      display       : flex;
      align-items   : center;
      justify-content: center;
      cursor        : pointer;
      transition    : all var(--dur-fast) var(--ease-smooth);
      font-size     : .95rem;
      position      : relative;
      flex-shrink   : 0;
    }
    .hdr-btn:hover {
      background   : var(--main-50);
      border-color : var(--main-300);
      color        : var(--main-500);
      transform    : translateY(-1px);
    }
    [data-bs-theme="dark"] .hdr-btn:hover { background: rgba(100,71,244,.15); }

    .hdr-notif-dot {
      position     : absolute;
      top          : 4px;
      left         : 4px;
      width        : 7px;
      height       : 7px;
      border-radius: 50%;
      background   : #ef4444;
      border       : 2px solid var(--color-surface);
      animation    : dotPulse 2s ease-in-out infinite;
    }
    @keyframes dotPulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,.4); }
      50%     { box-shadow: 0 0 0 5px rgba(239,68,68,0); }
    }

    .hdr-avatar {
      width         : 34px;
      height        : 34px;
      border-radius : var(--radius-sm);
      background    : var(--grad-main);
      color         : #fff;
      font-size     : .7rem;
      font-weight   : 800;
      display       : flex;
      align-items   : center;
      justify-content: center;
      cursor        : pointer;
      box-shadow    : var(--shadow-main);
      flex-shrink   : 0;
      transition    : transform var(--dur-fast) var(--ease-spring);
    }
    .hdr-avatar:hover { transform: scale(1.08); }

    /* ═══════════════════════════════════════
       PAGE CONTENT
    ═══════════════════════════════════════ */
    .page-content {
      flex   : 1;
      padding: 1.75rem 2rem;
    }

    /* Page title */
    .page-header {
      display      : flex;
      align-items  : flex-start;
      justify-content: space-between;
      margin-bottom: 1.75rem;
      gap          : 1rem;
      flex-wrap    : wrap;
    }
    .page-title {
      font-size    : 1.4rem;
      font-weight  : 900;
      margin-bottom: .2rem;
      letter-spacing: -.02em;
    }
    .page-subtitle {
      font-size : .82rem;
      color     : var(--color-text-muted);
      margin    : 0;
    }

    /* ═══════════════════════════════════════
       STAT CARDS
    ═══════════════════════════════════════ */
    .stat-grid {
      display              : grid;
      grid-template-columns: repeat(4, 1fr);
      gap                  : 1rem;
      margin-bottom        : 1.5rem;
    }
    @media (max-width:1199px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width:575px)  { .stat-grid { grid-template-columns: 1fr; } }

    .stat-card-dash {
      background    : var(--color-surface);
      border        : 1px solid var(--color-border);
      border-radius : var(--radius-lg);
      padding       : 1.25rem 1.4rem;
      display       : flex;
      flex-direction: column;
      gap           : .85rem;
      transition    : all var(--dur-normal) var(--ease-spring);
      position      : relative;
      overflow      : hidden;
      cursor        : default;
    }
    .stat-card-dash:hover {
      transform  : translateY(-3px);
      box-shadow : var(--shadow-md);
      border-color: var(--main-200);
    }
    [data-bs-theme="dark"] .stat-card-dash:hover { border-color: rgba(100,71,244,.25); }

    .stat-card-dash::after {
      content  : '';
      position : absolute;
      bottom   : 0; right: 0; left: 0;
      height   : 3px;
      background: var(--grad-main);
      transform : scaleX(0);
      transform-origin: right;
      transition: transform var(--dur-normal) var(--ease-spring);
    }
    .stat-card-dash:hover::after { transform: scaleX(1); }

    .stat-header {
      display       : flex;
      align-items   : center;
      justify-content: space-between;
    }
    .stat-icon-box {
      width          : 40px;
      height         : 40px;
      border-radius  : var(--radius-sm);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : 1.1rem;
    }
    .stat-icon-box.main    { background: rgba(100,71,244,.12); color: var(--main-500); }
    .stat-icon-box.accent  { background: rgba(0,144,232,.12);  color: var(--accent-500); }
    .stat-icon-box.success { background: rgba(34,197,94,.12);  color: #16a34a; }
    .stat-icon-box.warning { background: rgba(245,158,11,.12); color: #d97706; }

    .stat-trend {
      display      : flex;
      align-items  : center;
      gap          : .25rem;
      font-size    : .73rem;
      font-weight  : 700;
      border-radius: var(--radius-full);
      padding      : .2rem .55rem;
    }
    .stat-trend.up   { background: rgba(34,197,94,.12); color: #16a34a; }
    .stat-trend.down { background: rgba(239,68,68,.12); color: #dc2626; }

    .stat-value {
      font-size    : 1.9rem;
      font-weight  : 900;
      line-height  : 1;
      letter-spacing: -.03em;
    }
    .stat-label {
      font-size : .78rem;
      color     : var(--color-text-muted);
      margin-top: .2rem;
    }
    .stat-sub {
      font-size : .73rem;
      color     : var(--color-text-light);
    }

    /* ═══════════════════════════════════════
       MAIN GRID
    ═══════════════════════════════════════ */
    .main-grid {
      display              : grid;
      grid-template-columns: 1fr 340px;
      gap                  : 1.25rem;
      margin-bottom        : 1.25rem;
    }
    @media (max-width:1100px) { .main-grid { grid-template-columns: 1fr; } }

    /* ═══════════════════════════════════════
       PANEL / CARD
    ═══════════════════════════════════════ */
    .dash-panel {
      background    : var(--color-surface);
      border        : 1px solid var(--color-border);
      border-radius : var(--radius-lg);
      overflow      : hidden;
      transition    : border-color var(--dur-fast);
    }
    .dash-panel:hover { border-color: var(--main-200); }
    [data-bs-theme="dark"] .dash-panel:hover { border-color: rgba(100,71,244,.2); }

    .panel-header {
      display       : flex;
      align-items   : center;
      justify-content: space-between;
      padding       : 1rem 1.25rem;
      border-bottom : 1px solid var(--color-border);
    }
    .panel-title {
      font-size  : .9rem;
      font-weight: 700;
      margin     : 0;
    }
    .panel-action {
      font-size      : .75rem;
      color          : var(--main-500);
      font-weight    : 600;
      text-decoration: none;
      display        : flex;
      align-items    : center;
      gap            : .25rem;
      transition     : gap var(--dur-fast);
    }
    .panel-action:hover { gap: .5rem; color: var(--main-600); }

    /* ═══════════════════════════════════════
       CHART BAR (Pure CSS)
    ═══════════════════════════════════════ */
    .chart-area {
      padding : 1.25rem;
    }

    .chart-bars {
      display    : flex;
      align-items: flex-end;
      gap        : .6rem;
      height     : 140px;
      padding-top: .5rem;
    }

    .chart-bar-wrap {
      flex           : 1;
      display        : flex;
      flex-direction : column;
      align-items    : center;
      gap            : .4rem;
      height         : 100%;
      justify-content: flex-end;
    }

    .chart-bar {
      width          : 100%;
      max-width      : 40px;
      border-radius  : var(--radius-sm) var(--radius-sm) .25rem .25rem;
      background     : var(--grad-soft);
      border         : 1px solid var(--main-200);
      transition     : all .4s var(--ease-spring);
      cursor         : pointer;
      position       : relative;
    }
    .chart-bar.active,
    .chart-bar:hover {
      background : var(--grad-main);
      border-color: transparent;
      box-shadow : var(--shadow-main);
    }
    .chart-bar-label {
      font-size : .68rem;
      color     : var(--color-text-light);
      text-align: center;
    }

    .chart-legend {
      display    : flex;
      gap        : 1.25rem;
      flex-wrap  : wrap;
      margin-top : 1rem;
    }
    .legend-item {
      display    : flex;
      align-items: center;
      gap        : .4rem;
      font-size  : .75rem;
      color      : var(--color-text-muted);
    }
    .legend-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
    }

    /* ═══════════════════════════════════════
       PROJECTS TABLE
    ═══════════════════════════════════════ */
    .proj-table {
      width         : 100%;
      border-collapse: collapse;
    }
    .proj-table th {
      font-size    : .72rem;
      font-weight  : 700;
      color        : var(--color-text-light);
      text-transform: uppercase;
      letter-spacing: .06em;
      padding      : .65rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      text-align   : right;
    }
    .proj-table td {
      padding    : .85rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      font-size  : .84rem;
      vertical-align: middle;
    }
    .proj-table tr:last-child td { border-bottom: none; }
    .proj-table tbody tr {
      transition: background var(--dur-fast);
      cursor    : pointer;
    }
    .proj-table tbody tr:hover { background: var(--color-bg); }
    [data-bs-theme="dark"] .proj-table tbody tr:hover { background: rgba(255,255,255,.03); }

    .proj-name {
      font-weight: 600;
      font-size  : .85rem;
    }
    .proj-type {
      font-size : .73rem;
      color     : var(--color-text-muted);
      margin-top: .1rem;
    }

    .badge-status {
      display      : inline-flex;
      align-items  : center;
      gap          : .3rem;
      font-size    : .7rem;
      font-weight  : 700;
      padding      : .2rem .65rem;
      border-radius: var(--radius-full);
    }
    .badge-status::before {
      content      : '';
      width        : 5px;
      height       : 5px;
      border-radius: 50%;
      background   : currentColor;
    }
    .badge-done    { background: rgba(34,197,94,.12);  color: #16a34a; }
    .badge-inprog  { background: rgba(100,71,244,.12); color: var(--main-600); }
    .badge-review  { background: rgba(245,158,11,.12); color: #d97706; }
    .badge-hold    { background: rgba(239,68,68,.1);   color: #dc2626; }

    .prog-bar-mini {
      width        : 80px;
      height       : 5px;
      border-radius: 99px;
      background   : var(--color-border);
      overflow     : hidden;
    }
    .prog-fill {
      height        : 100%;
      border-radius : 99px;
      background    : var(--grad-main);
      transition    : width .8s var(--ease-spring);
    }

    /* ═══════════════════════════════════════
       ACTIVITIES FEED
    ═══════════════════════════════════════ */
    .activity-feed { padding: .75rem 0; }

    .activity-item {
      display    : flex;
      align-items: flex-start;
      gap        : .85rem;
      padding    : .7rem 1.25rem;
      transition : background var(--dur-fast);
      cursor     : default;
    }
    .activity-item:hover { background: var(--color-bg); }
    [data-bs-theme="dark"] .activity-item:hover { background: rgba(255,255,255,.03); }

    .act-icon {
      width          : 32px;
      height         : 32px;
      border-radius  : var(--radius-sm);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : .85rem;
      flex-shrink    : 0;
      margin-top     : .1rem;
    }
    .act-icon.main    { background: rgba(100,71,244,.12); color: var(--main-500); }
    .act-icon.accent  { background: rgba(0,144,232,.12);  color: var(--accent-500); }
    .act-icon.success { background: rgba(34,197,94,.12);  color: #16a34a; }
    .act-icon.warning { background: rgba(245,158,11,.12); color: #d97706; }

    .act-body { flex: 1; }
    .act-text {
      font-size  : .82rem;
      margin     : 0;
      line-height: 1.5;
    }
    .act-text strong { color: var(--color-text-primary); }
    .act-time {
      font-size : .7rem;
      color     : var(--color-text-light);
      margin-top: .15rem;
    }

    /* ═══════════════════════════════════════
       QUICK STATS ROW
    ═══════════════════════════════════════ */
    .quick-grid {
      display              : grid;
      grid-template-columns: repeat(3, 1fr);
      gap                  : 1.25rem;
      margin-bottom        : 1.25rem;
    }
    @media (max-width:767px) { .quick-grid { grid-template-columns: 1fr; } }

    .mini-card {
      background    : var(--color-surface);
      border        : 1px solid var(--color-border);
      border-radius : var(--radius-lg);
      padding       : 1.1rem 1.25rem;
      display       : flex;
      align-items   : center;
      gap           : 1rem;
      transition    : all var(--dur-normal) var(--ease-spring);
    }
    .mini-card:hover {
      transform  : translateY(-2px);
      box-shadow : var(--shadow-sm);
      border-color: var(--main-200);
    }
    [data-bs-theme="dark"] .mini-card:hover { border-color: rgba(100,71,244,.2); }

    .mini-icon {
      width          : 44px;
      height         : 44px;
      border-radius  : var(--radius-md);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : 1.2rem;
      flex-shrink    : 0;
    }

    .mini-val {
      font-size  : 1.35rem;
      font-weight: 900;
      line-height: 1;
    }
    .mini-lbl {
      font-size  : .75rem;
      color      : var(--color-text-muted);
      margin-top : .15rem;
    }

    /* ═══════════════════════════════════════
       MESSAGES LIST
    ═══════════════════════════════════════ */
    .msg-item {
      display    : flex;
      align-items: flex-start;
      gap        : .85rem;
      padding    : .9rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      cursor     : pointer;
      transition : background var(--dur-fast);
    }
    .msg-item:last-child { border-bottom: none; }
    .msg-item:hover { background: var(--color-bg); }
    [data-bs-theme="dark"] .msg-item:hover { background: rgba(255,255,255,.03); }
    .msg-item.unread { background: rgba(100,71,244,.04); }
    [data-bs-theme="dark"] .msg-item.unread { background: rgba(100,71,244,.08); }

    .msg-avatar {
      width          : 36px;
      height         : 36px;
      border-radius  : var(--radius-sm);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : .72rem;
      font-weight    : 800;
      color          : #fff;
      flex-shrink    : 0;
    }

    .msg-body { flex: 1; min-width: 0; }
    .msg-top {
      display        : flex;
      align-items    : center;
      justify-content: space-between;
      gap            : .5rem;
      margin-bottom  : .25rem;
    }
    .msg-sender { font-size: .83rem; font-weight: 700; }
    .msg-time   { font-size: .7rem; color: var(--color-text-light); white-space: nowrap; }
    .msg-preview {
      font-size  : .77rem;
      color      : var(--color-text-muted);
      overflow   : hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .msg-item.unread .msg-preview { color: var(--color-text-primary); font-weight: 500; }

    /* ═══════════════════════════════════════
       TASK LIST
    ═══════════════════════════════════════ */
    .task-item {
      display    : flex;
      align-items: center;
      gap        : .75rem;
      padding    : .75rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      transition : background var(--dur-fast);
      cursor     : pointer;
    }
    .task-item:last-child { border-bottom: none; }
    .task-item:hover { background: var(--color-bg); }
    [data-bs-theme="dark"] .task-item:hover { background: rgba(255,255,255,.03); }

    .task-check {
      width         : 18px;
      height        : 18px;
      border-radius : 5px;
      border        : 2px solid var(--color-border);
      display       : flex;
      align-items   : center;
      justify-content: center;
      flex-shrink   : 0;
      transition    : all var(--dur-fast);
      cursor        : pointer;
    }
    .task-check.done {
      background   : var(--main-500);
      border-color : var(--main-500);
      color        : #fff;
      font-size    : .65rem;
    }

    .task-text {
      flex      : 1;
      font-size : .83rem;
    }
    .task-text.done {
      text-decoration: line-through;
      color          : var(--color-text-muted);
    }

    .task-pri {
      font-size    : .67rem;
      font-weight  : 700;
      padding      : .15rem .5rem;
      border-radius: var(--radius-full);
    }
    .task-pri.high   { background: rgba(239,68,68,.1);   color: #dc2626; }
    .task-pri.medium { background: rgba(245,158,11,.1);  color: #d97706; }
    .task-pri.low    { background: rgba(34,197,94,.1);   color: #16a34a; }

    /* ═══════════════════════════════════════
       CLIENTS ROW
    ═══════════════════════════════════════ */
    .clients-grid {
      display              : grid;
      grid-template-columns: repeat(2, 1fr);
      gap                  : 1.25rem;
      margin-bottom        : 1.5rem;
    }
    @media (max-width:767px) { .clients-grid { grid-template-columns: 1fr; } }

    .client-item {
      display    : flex;
      align-items: center;
      gap        : .85rem;
      padding    : .85rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      transition : background var(--dur-fast);
      cursor     : pointer;
    }
    .client-item:last-child { border-bottom: none; }
    .client-item:hover { background: var(--color-bg); }
    [data-bs-theme="dark"] .client-item:hover { background: rgba(255,255,255,.03); }

    .client-avatar {
      width          : 38px;
      height         : 38px;
      border-radius  : var(--radius-sm);
      display        : flex;
      align-items    : center;
      justify-content: center;
      font-size      : .78rem;
      font-weight    : 800;
      color          : #fff;
      flex-shrink    : 0;
    }

    .client-name { font-size: .84rem; font-weight: 700; }
    .client-proj { font-size: .73rem; color: var(--color-text-muted); }
    .client-tag  {
      margin-right : auto;
      font-size    : .68rem;
      font-weight  : 700;
      padding      : .15rem .55rem;
      border-radius: var(--radius-full);
    }

    /* ═══════════════════════════════════════
       SIDEBAR MOBILE OVERLAY
    ═══════════════════════════════════════ */
    .sidebar-overlay {
      display : none;
      position: fixed;
      inset   : 0;
      background: rgba(16,16,42,.6);
      backdrop-filter: blur(4px);
      z-index : 1049;
      opacity : 0;
      transition: opacity var(--dur-normal);
    }
    .sidebar-overlay.show { opacity: 1; }

    @media (max-width:768px) {
      .sidebar {
        transform   : translateX(100%);
        width       : var(--sidebar-w) !important;
      }
      .sidebar.mobile-open {
        transform: translateX(0);
      }
      .sidebar-overlay { display: block; }
      .main-content { margin-right: 0 !important; }
      .page-content { padding: 1.25rem 1rem; }
    }

    /* ═══════════════════════════════════════
       ANIMATIONS
    ═══════════════════════════════════════ */
    .fade-up {
      opacity  : 0;
      transform: translateY(16px);
      animation: fadeUp .4s var(--ease-smooth) forwards;
    }
    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .fade-up-1 { animation-delay: .05s; }
    .fade-up-2 { animation-delay: .10s; }
    .fade-up-3 { animation-delay: .15s; }
    .fade-up-4 { animation-delay: .20s; }
    .fade-up-5 { animation-delay: .25s; }
    .fade-up-6 { animation-delay: .30s; }

    /* ═══════════════════════════════════════
       UTILS
    ═══════════════════════════════════════ */
    .g-6 { background: var(--grad-main); }
    .text-grad {
      background: var(--grad-main);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .btn-sol-sm {
      display       : inline-flex;
      align-items   : center;
      gap           : .35rem;
      background    : var(--grad-main);
      color         : #fff;
      border        : none;
      border-radius : var(--radius-sm);
      padding       : .45rem 1.1rem;
      font-family   : var(--font-primary);
      font-size     : .8rem;
      font-weight   : 700;
      cursor        : pointer;
      transition    : all var(--dur-normal) var(--ease-spring);
      box-shadow    : var(--shadow-main);
      white-space   : nowrap;
    }
    .btn-sol-sm:hover {
      transform  : translateY(-2px);
      box-shadow : 0 10px 32px rgba(100,71,244,.4);
    }

    .btn-ghost-sm {
      display       : inline-flex;
      align-items   : center;
      gap           : .35rem;
      background    : transparent;
      color         : var(--main-500);
      border        : 1.5px solid var(--main-200);
      border-radius : var(--radius-sm);
      padding       : .42rem 1rem;
      font-family   : var(--font-primary);
      font-size     : .8rem;
      font-weight   : 600;
      cursor        : pointer;
      transition    : all var(--dur-fast) var(--ease-smooth);
    }
    .btn-ghost-sm:hover {
      background  : var(--main-50);
      border-color: var(--main-400);
    }
    [data-bs-theme="dark"] .btn-ghost-sm:hover { background: rgba(100,71,244,.12); }

    /* Donut placeholder */
    .donut-wrap {
      position: relative;
      width   : 120px;
      height  : 120px;
      margin  : 0 auto;
    }
    .donut-svg circle { transition: stroke-dashoffset 1s var(--ease-spring); }

    .donut-center {
      position       : absolute;
      inset          : 0;
      display        : flex;
      align-items    : center;
      justify-content: center;
      flex-direction : column;
    }
    .donut-val {
      font-size  : 1.3rem;
      font-weight: 900;
      line-height: 1;
    }
    .donut-sub {
      font-size : .65rem;
      color     : var(--color-text-muted);
      margin-top: .15rem;
    }

  </style>
</head>
<body>

<!-- Mobile Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="admin-shell">

  <!-- ═══════════════════════════════════
       SIDEBAR
  ═══════════════════════════════════ -->
  <aside class="sidebar" id="sidebar">

    <!-- Brand -->
    <a class="sidebar-brand" href="#">
      <div class="sidebar-logo">سل</div>
      <span class="sidebar-brand-text">سُل وب — پنل</span>
    </a>

    <!-- Nav -->
    <nav class="sidebar-nav">

      <span class="nav-label">اصلی</span>

      <a href="#" class="nav-item-sol active">
        <span class="nav-icon"><i class="bi bi-grid-1x2-fill"></i></span>
        <span class="nav-text">داشبورد</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-kanban-fill"></i></span>
        <span class="nav-text">پروژه‌ها</span>
        <span class="nav-badge">۱۲</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
        <span class="nav-text">مشتریان</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-chat-dots-fill"></i></span>
        <span class="nav-text">پیام‌ها</span>
        <span class="nav-badge">۵</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-receipt"></i></span>
        <span class="nav-text">فاکتورها</span>
      </a>

      <span class="nav-label">محتوا</span>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-collection-fill"></i></span>
        <span class="nav-text">پورتفولیو</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-box-seam-fill"></i></span>
        <span class="nav-text">پکیج‌ها</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-star-fill"></i></span>
        <span class="nav-text">نظرات</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-journal-text"></i></span>
        <span class="nav-text">وبلاگ</span>
      </a>

      <span class="nav-label">سیستم</span>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-bar-chart-line-fill"></i></span>
        <span class="nav-text">گزارش‌ها</span>
      </a>

      <a href="#" class="nav-item-sol">
        <span class="nav-icon"><i class="bi bi-gear-fill"></i></span>
        <span class="nav-text">تنظیمات</span>
      </a>

    </nav>

    <!-- Footer User -->
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="user-avatar">ادم</div>
        <div class="user-info">
          <div class="user-name">علی مدیری</div>
          <div class="user-role">مدیر کل سیستم</div>
        </div>
        <i class="bi bi-three-dots-vertical" style="color:rgba(255,255,255,.3);font-size:.85rem;flex-shrink:0;"></i>
      </div>
    </div>

  </aside><!-- /sidebar -->


  <!-- ═══════════════════════════════════
       MAIN CONTENT
  ═══════════════════════════════════ -->
  <div class="main-content" id="mainContent">

    <!-- HEADER -->
    <header class="admin-header">

      <!-- Toggle -->
      <button class="header-toggle" id="sidebarToggle" title="بستن/باز کردن منو">
        <i class="bi bi-layout-sidebar-reverse"></i>
      </button>

      <!-- Breadcrumb -->
      <div class="header-breadcrumb">
        <i class="bi bi-house-fill" style="font-size:.8rem; color:var(--color-text-light);"></i>
        <span class="sep">/</span>
        <span class="current">داشبورد</span>
      </div>

      <!-- Search -->
      <div class="header-search d-none d-md-flex">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="جستجو در پنل…">
        <kbd style="font-size:.65rem; color:var(--color-text-light); background:var(--color-border); border-radius:4px; padding:.1rem .35rem;">⌘K</kbd>
      </div>

      <!-- Actions -->
      <div class="header-actions">

        <button class="hdr-btn" title="اعلان‌ها">
          <i class="bi bi-bell-fill"></i>
          <span class="hdr-notif-dot"></span>
        </button>

        <button class="hdr-btn" title="تغییر تم" id="themeToggle">
          <i class="bi bi-moon-stars-fill"></i>
        </button>

        <button class="hdr-btn d-none d-md-flex" title="تمام‌صفحه" id="fullscreenBtn">
          <i class="bi bi-fullscreen"></i>
        </button>

        <div class="hdr-avatar" title="پروفایل من">ادم</div>

      </div>
    </header><!-- /header -->


    <!-- PAGE CONTENT -->
    <main class="page-content">

      <!-- Page Header -->
      <div class="page-header fade-up fade-up-1">
        <div>
          <h1 class="page-title">خوش آمدید، علی 👋</h1>
          <p class="page-subtitle">امروز ۲۱ خرداد ۱۴۰۴ — وضعیت کلی پروژه‌ها و فعالیت‌های تیم</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn-ghost-sm"><i class="bi bi-download"></i> گزارش</button>
          <button class="btn-sol-sm"><i class="bi bi-plus-lg"></i> پروژه جدید</button>
        </div>
      </div>


      <!-- ── STAT CARDS ── -->
      <div class="stat-grid">

        <div class="stat-card-dash fade-up fade-up-1">
          <div class="stat-header">
            <div class="stat-icon-box main"><i class="bi bi-kanban-fill"></i></div>
            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>۱۲٪</span>
          </div>
          <div>
            <div class="stat-value text-grad">۲۴</div>
            <div class="stat-label">پروژه فعال</div>
            <div class="stat-sub">۸ پروژه در مرحله ریویو</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-2">
          <div class="stat-header">
            <div class="stat-icon-box accent"><i class="bi bi-people-fill"></i></div>
            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>۸٪</span>
          </div>
          <div>
            <div class="stat-value text-grad">۸۶</div>
            <div class="stat-label">مشتری فعال</div>
            <div class="stat-sub">۳ مشتری جدید این هفته</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-3">
          <div class="stat-header">
            <div class="stat-icon-box success"><i class="bi bi-check-circle-fill"></i></div>
            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>۲۲٪</span>
          </div>
          <div>
            <div class="stat-value text-grad">۱۵۳</div>
            <div class="stat-label">پروژه تحویل‌داده‌شده</div>
            <div class="stat-sub">۹۸٪ رضایت مشتری</div>
          </div>
        </div>

        <div class="stat-card-dash fade-up fade-up-4">
          <div class="stat-header">
            <div class="stat-icon-box warning"><i class="bi bi-chat-dots-fill"></i></div>
            <span class="stat-trend down"><i class="bi bi-arrow-down-short"></i>۳٪</span>
          </div>
          <div>
            <div class="stat-value text-grad">۵</div>
            <div class="stat-label">پیام خوانده‌نشده</div>
            <div class="stat-sub">آخرین پیام: ۲ ساعت پیش</div>
          </div>
        </div>

      </div><!-- /stat-grid -->


      <!-- ── QUICK MINI CARDS ── -->
      <div class="quick-grid fade-up fade-up-5">

        <div class="mini-card">
          <div class="mini-icon" style="background:rgba(100,71,244,.1); color:var(--main-500);">
            <i class="bi bi-clock-history"></i>
          </div>
          <div>
            <div class="mini-val">۱۴۲ ساعت</div>
            <div class="mini-lbl">کل ساعات کاری این ماه</div>
          </div>
        </div>

        <div class="mini-card">
          <div class="mini-icon" style="background:rgba(0,144,232,.1); color:var(--accent-500);">
            <i class="bi bi-stars"></i>
          </div>
          <div>
            <div class="mini-val">۴.۹ / ۵</div>
            <div class="mini-lbl">میانگین امتیاز مشتریان</div>
          </div>
