<!-- ═══════════════════════════════════════
     HOW WE WORK — Curved Dashed Workflow
═══════════════════════════════════════ -->
<section class="how-section" id="how">
  <div class="floating-parallax float-soft float-d" data-speed="0.09" aria-hidden="true"></div>
  <div class="container">

    <div class="text-center mb-5 reveal section-heading">
      <span class="section-title-bg" aria-hidden="true">PROCESS</span>
      <span class="section-tag">
        <i class="bi bi-gear-fill"></i>
        فرایند کار
      </span>
      <h2 class="section-title">چطور کار می‌کنیم؟</h2>
      <p class="section-subtitle mx-auto">
        از اولین جلسه مشاوره تا تحویل محصول نهایی، هر مرحله را شفاف دنبال کنید
      </p>
    </div>

    <!-- Steps — Desktop با مسیر منحنی خط‌چین -->
    <div class="workflow-wrap d-none d-lg-block mb-5 reveal">
      <svg class="workflow-svg-desktop" viewBox="0 0 1200 150" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="workflow-track" d="M1050,75 C920,140 880,15 750,75 C620,140 580,15 450,75 C320,140 280,15 150,75"></path>
        <path id="workflowPathDesktop" class="workflow-progress" d="M1050,75 C920,140 880,15 750,75 C620,140 580,15 450,75 C320,140 280,15 150,75"></path>
        <circle r="5" class="workflow-pulse">
          <animateMotion dur="4.5s" repeatCount="indefinite" rotate="auto">
            <mpath href="#workflowPathDesktop" xlink:href="#workflowPathDesktop"></mpath>
          </animateMotion>
        </circle>
      </svg>

      <div class="d-flex align-items-start justify-content-between position-relative workflow-steps-desktop">
        <div class="text-center flex-fill workflow-step">
          <div class="step-num mx-auto">۱</div>
          <h6>کشف</h6>
          <p class="text-muted">شناخت کامل از کسب‌وکار، هدف‌ها و مخاطبان شما</p>
        </div>
        <div class="text-center flex-fill workflow-step">
          <div class="step-num mx-auto">۲</div>
          <h6>طراحی</h6>
          <p class="text-muted">طراحی پروتوتایپ و تایید رابط کاربری با مشتری</p>
        </div>
        <div class="text-center flex-fill workflow-step">
          <div class="step-num mx-auto">۳</div>
          <h6>توسعه</h6>
          <p class="text-muted">کدنویسی تمیز، سریع و بهینه با بهترین تکنولوژی‌ها</p>
        </div>
        <div class="text-center flex-fill workflow-step">
          <div class="step-num mx-auto">۴</div>
          <h6>تحویل</h6>
          <p class="text-muted">تست کامل، انتشار و پشتیبانی مداوم پروژه شما</p>
        </div>
      </div>
    </div>

    <!-- Steps — Mobile: ستون عمودی با مسیر منحنی -->
    <div class="workflow-wrap-mobile d-lg-none mb-4 reveal">
      <svg class="workflow-svg-mobile" viewBox="0 0 140 720" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="workflow-track" d="M70,50 C140,150 0,230 70,330 C140,430 0,510 70,610 C110,660 40,680 70,690"></path>
        <path id="workflowPathMobile" class="workflow-progress" d="M70,50 C140,150 0,230 70,330 C140,430 0,510 70,610 C110,660 40,680 70,690"></path>
        <circle r="5" class="workflow-pulse">
          <animateMotion dur="5s" repeatCount="indefinite" rotate="auto">
            <mpath href="#workflowPathMobile" xlink:href="#workflowPathMobile"></mpath>
          </animateMotion>
        </circle>
      </svg>

      <div class="workflow-steps-mobile">
        <div class="workflow-step-mobile">
          <div class="step-num">۱</div>
          <div>
            <h6>کشف</h6>
            <p class="text-muted">شناخت کامل کسب‌وکار شما</p>
          </div>
        </div>
        <div class="workflow-step-mobile">
          <div class="step-num">۲</div>
          <div>
            <h6>طراحی</h6>
            <p class="text-muted">پروتوتایپ و تایید رابط کاربری</p>
          </div>
        </div>
        <div class="workflow-step-mobile">
          <div class="step-num">۳</div>
          <div>
            <h6>توسعه</h6>
            <p class="text-muted">کدنویسی تمیز و بهینه</p>
          </div>
        </div>
        <div class="workflow-step-mobile">
          <div class="step-num">۴</div>
          <div>
            <h6>تحویل</h6>
            <p class="text-muted">انتشار و پشتیبانی مداوم</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Why us -->
    <div class="row g-4 mt-2">
      <div class="col-md-4 reveal reveal-delay-1">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-main flex-shrink-0"><i class="bi bi-shield-check"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">ضمانت کیفیت</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">تمام پروژه‌ها با ضمانت کیفیت و بازنگری رایگان تحویل داده می‌شوند.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 reveal reveal-delay-2">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-accent flex-shrink-0"><i class="bi bi-lightning-charge"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">تحویل سریع</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">پروژه‌ها در کمترین زمان ممکن و با بالاترین کیفیت تحویل داده می‌شوند.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 reveal reveal-delay-3">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-main flex-shrink-0"><i class="bi bi-headset"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">پشتیبانی ۲۴/۷</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">تیم پشتیبانی ما همیشه آماده پاسخگویی به سوالات و رفع مشکلات شماست.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>


