<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سُل وب — طراحی وب‌سایت حرفه‌ای</title>
  <link rel="stylesheet" href="assets/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="assets/css/style.css">
  <link rel="stylesheet" href="assets/css/icons-1.13.1/font/bootstrap-icons.min.css">
  <style>
    #scrollProgress {
      position: fixed;
      top: 0; right: 0; left: 0;
      height: 3px;
      background: linear-gradient(90deg, #6447f4, #0090e8);
      width: 0%;
      z-index: 9998;
      transition: width .1s linear;
    }
  </style>
</head>
<body>

<!-- ═══════════ Scroll Progress ═══════════ -->
<div id="scrollProgress" aria-hidden="true"></div>

<!-- ═══════════ Preloader ═══════════ -->
<div id="preloader" aria-hidden="true">
  <div class="preloader-logo">سُل وب</div>
  <div class="preloader-dots">
    <span></span><span></span><span></span>
  </div>
</div>

<!-- ═══════════════════════════════════════
     NAVBAR
═══════════════════════════════════════ -->
<nav class="navbar navbar-sol navbar-expand-lg" aria-label="منوی اصلی">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand" href="#home">سُل وب</a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="باز کردن منو">
      <i class="bi bi-list" style="font-size:1.4rem;"></i>
    </button>

    <!-- Nav links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
        <li class="nav-item"><a class="nav-link active" href="#home">صفحه اصلی</a></li>
        <li class="nav-item"><a class="nav-link" href="services.html">خدمات</a></li>
        <li class="nav-item"><a class="nav-link" href="portfolio.html">نمونه کارها</a></li>
        <li class="nav-item"><a class="nav-link" href="packages.html">پکیج‌ها</a></li>
        <li class="nav-item"><a class="nav-link" href="about.html">درباره ما</a></li>
        <li class="nav-item"><a class="nav-link" href="contact.html">تماس با ما</a></li>
      </ul>

      <div class="d-flex align-items-center gap-3">
        <!-- Theme toggle -->
        <button class="btn-theme-toggle" id="themeToggle" aria-label="تغییر تم">
          <i class="bi bi-moon-stars-fill"></i>
        </button>
        <!-- CTA -->
        <a href="contact.html" class="btn btn-main btn-sm d-none d-lg-inline-flex align-items-center gap-1">
          مشاوره رایگان
          <i class="bi bi-arrow-left"></i>
        </a>
      </div>
    </div>

  </div>
</nav>


<!-- ═══════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════ -->
<section class="hero-section" id="home">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-3" aria-hidden="true"></div>
  <div class="hero-dots" aria-hidden="true"></div>

  <div class="container">
    <div class="row align-items-center">

      <!-- Content -->
      <div class="col-lg-6 hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          آماده پروژه جدید هستیم!
        </div>

        <h1 class="hero-title">
          ما وب‌سایت‌هایی می‌سازیم که
          <span style="display:block; color:#a394fb;">روح دارند</span>
        </h1>

        <p class="hero-subtitle">
          وب‌سایت‌هایی مبتنی بر آخرین فناوری‌ها، با طراحی بی‌نظیر و عملکردی که کسب‌وکار شما را متحول می‌کند.
        </p>

        <div class="hero-actions">
          <a href="portfolio.html" class="btn-hero-primary">
            نمونه کارها
            <i class="bi bi-grid-3x3-gap"></i>
          </a>
          <a href="contact.html" class="btn-hero-secondary">
            <i class="bi bi-chat-dots"></i>
            مشاوره رایگان
          </a>
        </div>

        <!-- Stats -->
        <div class="hero-stats">
          <div class="hero-stat">
            <strong>+۱۵۰</strong>
            <span>پروژه موفق</span>
          </div>
          <div class="hero-stat">
            <strong>+۸۰</strong>
            <span>مشتری راضی</span>
          </div>
          <div class="hero-stat">
            <strong>۵ سال</strong>
            <span>تجربه</span>
          </div>
          <div class="hero-stat">
            <strong>۹۸٪</strong>
            <span>رضایت‌مشتری</span>
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div class="col-lg-6 hero-visual d-none d-lg-flex">
        <div style="position:relative; width:340px; height:340px;">
          <div style="
            width:230px; height:230px;
            border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
            background: linear-gradient(160deg, rgba(255,255,255,.25) 0%, rgba(255,255,255,.05) 100%);
            border: 1.5px solid rgba(255,255,255,.3);
            backdrop-filter: blur(20px);
            margin: 55px auto 0;
            display: flex; align-items: center; justify-content: center;
            animation: ghostFloat 4s ease-in-out infinite;
            position: relative; z-index: 2;
          ">
            <i class="bi bi-code-slash" style="font-size:4rem; color:rgba(255,255,255,.9);"></i>
          </div>
          <div style="width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.2);position:absolute;bottom:34px;left:120px;animation:ghostFloat 4s ease-in-out infinite;animation-delay:.2s;"></div>
          <div style="width:18px;height:18px;border-radius:50%;background:rgba(255,255,255,.15);position:absolute;bottom:12px;left:135px;animation:ghostFloat 4s ease-in-out infinite;animation-delay:.4s;"></div>

          <div class="hero-glass-card card-tl" style="right:-20px; top:10px;">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-check-circle-fill" style="color:#4ade80;"></i>
              <span style="font-size:.8rem; font-weight:600;">پروژه تحویل داده شد!</span>
            </div>
          </div>
          <div class="hero-glass-card card-br" style="left:-20px; bottom:10px;">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-star-fill" style="color:#fbbf24;"></i>
              <span style="font-size:.8rem; font-weight:600;">رضایت ۱۰۰٪</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════
     SERVICES SECTION
═══════════════════════════════════════ -->
<section class="services-section" id="services">
  <div class="container">

    <div class="text-center mb-5 reveal">
      <span class="section-tag">
        <i class="bi bi-lightning-charge-fill"></i>
        خدمات ما
      </span>
      <h2 class="section-title">طراحی آنلاین، بی‌نظیر و باکیفیت</h2>
      <p class="section-subtitle mx-auto">
        از طراحی اختصاصی تا فروشگاه آنلاین — همه چیز در یک تیم حرفه‌ای
      </p>
    </div>

    <div class="row g-4">

      <div class="col-md-6 col-lg-4 reveal reveal-delay-1">
        <div class="card-sol card-service h-100">
          <div class="service-icon">
            <i class="bi bi-code-slash"></i>
          </div>
          <h5>طراحی اختصاصی با PHP</h5>
          <p class="text-muted" style="font-size:.9rem; line-height:1.8;">
            توسعه وب‌سایت کاملاً سفارشی با PHP، Laravel یا Node.js — بدون محدودیت قالب، با سرعت و امنیت بالا.
          </p>
          <a href="services.html" class="btn btn-ghost btn-sm mt-3">
            بیشتر بدانید
            <i class="bi bi-arrow-left ms-1"></i>
          </a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal reveal-delay-2">
        <div class="card-sol card-service h-100">
          <div class="service-icon">
            <i class="bi bi-wordpress"></i>
          </div>
          <h5>طراحی با وردپرس</h5>
          <p class="text-muted" style="font-size:.9rem; line-height:1.8;">
            ساخت وب‌سایت با وردپرس — شخصی‌سازی کامل، مدیریت آسان محتوا و افزونه‌های حرفه‌ای.
          </p>
          <a href="services.html" class="btn btn-ghost btn-sm mt-3">
            بیشتر بدانید
            <i class="bi bi-arrow-left ms-1"></i>
          </a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal reveal-delay-3">
        <div class="card-sol card-service h-100">
          <div class="service-icon">
            <i class="bi bi-cart4"></i>
          </div>
          <h5>فروشگاه آنلاین</h5>
          <p class="text-muted" style="font-size:.9rem; line-height:1.8;">
            فروشگاه اینترنتی حرفه‌ای با امکانات کامل پرداخت، انبارداری و گزارش‌گیری پیشرفته.
          </p>
          <a href="services.html" class="btn btn-ghost btn-sm mt-3">
            بیشتر بدانید
            <i class="bi bi-arrow-left ms-1"></i>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════
     HOW WE WORK
═══════════════════════════════════════ -->
<section class="how-section" id="how">
  <div class="container">

    <div class="text-center mb-5 reveal">
      <span class="section-tag">
        <i class="bi bi-gear-fill"></i>
        فرایند کار
      </span>
      <h2 class="section-title">چطور کار می‌کنیم؟</h2>
      <p class="section-subtitle mx-auto">
        از اولین جلسه مشاوره تا تحویل محصول نهایی، هر مرحله را شفاف دنبال کنید
      </p>
    </div>

    <!-- Steps — Desktop timeline -->
    <div class="d-none d-lg-flex align-items-start justify-content-between mb-5 position-relative reveal" style="gap:1rem;">
      <div style="position:absolute;top:1.5rem;right:12.5%;left:12.5%;height:2px;background:linear-gradient(90deg,#6447f4,#0090e8);opacity:.25;z-index:0;"></div>

      <div class="text-center flex-fill position-relative" style="z-index:1;">
        <div class="step-num mx-auto">۱</div>
        <h6 style="font-weight:700;">کشف</h6>
        <p class="text-muted" style="font-size:.82rem; line-height:1.7;">شناخت کامل از کسب‌وکار، هدف‌ها و مخاطبان شما</p>
      </div>
      <div class="text-center flex-fill position-relative" style="z-index:1;">
        <div class="step-num mx-auto">۲</div>
        <h6 style="font-weight:700;">طراحی</h6>
        <p class="text-muted" style="font-size:.82rem; line-height:1.7;">طراحی پروتوتایپ و تایید رابط کاربری با مشتری</p>
      </div>
      <div class="text-center flex-fill position-relative" style="z-index:1;">
        <div class="step-num mx-auto">۳</div>
        <h6 style="font-weight:700;">توسعه</h6>
        <p class="text-muted" style="font-size:.82rem; line-height:1.7;">کدنویسی تمیز، سریع و بهینه با بهترین تکنولوژی‌ها</p>
      </div>
      <div class="text-center flex-fill position-relative" style="z-index:1;">
        <div class="step-num mx-auto">۴</div>
        <h6 style="font-weight:700;">تحویل</h6>
        <p class="text-muted" style="font-size:.82rem; line-height:1.7;">تست کامل، انتشار و پشتیبانی مداوم پروژه شما</p>
      </div>
    </div>

    <!-- Steps — Mobile -->
    <div class="d-lg-none row g-3 mb-4">
      <div class="col-6 reveal reveal-delay-1">
        <div class="card-sol step-card h-100">
          <div class="step-num">۱</div>
          <h6 style="font-weight:700;">کشف</h6>
          <p class="text-muted" style="font-size:.82rem; line-height:1.7; margin:0;">شناخت کامل کسب‌وکار شما</p>
        </div>
      </div>
      <div class="col-6 reveal reveal-delay-2">
        <div class="card-sol step-card h-100">
          <div class="step-num">۲</div>
          <h6 style="font-weight:700;">طراحی</h6>
          <p class="text-muted" style="font-size:.82rem; line-height:1.7; margin:0;">پروتوتایپ و تایید رابط کاربری</p>
        </div>
      </div>
      <div class="col-6 reveal reveal-delay-3">
        <div class="card-sol step-card h-100">
          <div class="step-num">۳</div>
          <h6 style="font-weight:700;">توسعه</h6>
          <p class="text-muted" style="font-size:.82rem; line-height:1.7; margin:0;">کدنویسی تمیز و بهینه</p>
        </div>
      </div>
      <div class="col-6 reveal reveal-delay-4">
        <div class="card-sol step-card h-100">
          <div class="step-num">۴</div>
          <h6 style="font-weight:700;">تحویل</h6>
          <p class="text-muted" style="font-size:.82rem; line-height:1.7; margin:0;">انتشار و پشتیبانی مداوم</p>
        </div>
      </div>
    </div>

    <!-- Why us -->
    <div class="row g-4 mt-2">
      <div class="col-md-4 reveal reveal-delay-1">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-main flex-shrink-0"><i class="bi bi-shield-check"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">ضمانت کیفیت</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">تمام پروژه‌ها با ضمانت کیفیت و بازنگری رایگان تحویل داده می‌شوند.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 reveal reveal-delay-2">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-accent flex-shrink-0"><i class="bi bi-lightning-charge"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">تحویل سریع</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">پروژه‌ها در کمترین زمان ممکن و با بالاترین کیفیت تحویل داده می‌شوند.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 reveal reveal-delay-3">
        <div class="d-flex gap-3">
          <div class="float-icon float-icon-main flex-shrink-0"><i class="bi bi-headset"></i></div>
          <div>
            <h6 style="font-weight:700; margin-bottom:.3rem;">پشتیبانی ۲۴/۷</h6>
            <p class="text-muted" style="font-size:.875rem; line-height:1.7; margin:0;">تیم پشتیبانی ما همیشه آماده پاسخگویی به سوالات و رفع مشکلات شماست.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- ═══════════════════════════════════════
     STATS SECTION
═══════════════════════════════════════ -->
<section class="stats-section" id="stats">
  <div class="container">
    <div class="stats-grid reveal">

      <div class="stat-card">
        <div class="stat-icon"><i class="bi bi-trophy-fill"></i></div>
        <span class="stat-number">
          <span class="counter" data-target="150" data-prefix="+" data-suffix=""></span>
        </span>
        <span class="stat-label">پروژه موفق</span>
      </div>

      <div class="stat-divider-v"></div>

      <div class="stat-card">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <span class="stat-number">
          <span class="counter" data-target="80" data-prefix="+" data-suffix=""></span>
        </span>
        <span class="stat-label">مشتری راضی</span>
      </div>

      <div class="stat-divider-v"></div>

      <div class="stat-card">
        <div class="stat-icon"><i class="bi bi-calendar-check-fill"></i></div>
        <span class="stat-number">
          <span class="counter" data-target="5" data-suffix=" سال"></span>
        </span>
        <span class="stat-label">تجربه</span>
      </div>

      <div class="stat-divider-v"></div>

      <div class="stat-card">
        <div class="stat-icon"><i class="bi bi-hand-thumbs-up-fill"></i></div>
        <span class="stat-number">
          <span class="counter" data-target="98" data-suffix="٪"></span>
        </span>
        <span class="stat-label">رضایت مشتری</span>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════
     PORTFOLIO SECTION
═══════════════════════════════════════ -->
<section class="portfolio-section" id="portfolio">
  <div class="container">

    <div class="text-center mb-5 reveal">
      <span class="section-tag">
        <i class="bi bi-collection-fill"></i>
        نمونه کارها
      </span>
      <h2 class="section-title">آخرین پروژه‌های ما</h2>
      <p class="section-subtitle mx-auto">
        نگاهی به برخی از بهترین پروژه‌هایی که برای مشتریان عزیزمان انجام داده‌ایم
      </p>
    </div>

    <div class="portfolio-filter justify-content-center reveal">
      <button class="filter-btn active" data-filter="*">همه</button>
      <button class="filter-btn" data-filter=".web">طراحی وب</button>
      <button class="filter-btn" data-filter=".shop">فروشگاه</button>
      <button class="filter-btn" data-filter=".ui">UI/UX</button>
    </div>

<div class="row">
  <% portfolio.forEach((item, index) => { %>
    <% 
      // نگاشت دسته‌بندی‌ها به متن فارسی و کلاس CSS
      const catMap = {
        'web': { text: 'طراحی وب', class: 'web' },
        'store': { text: 'فروشگاه', class: 'shop' },
        'ui_ux': { text: 'UI/UX', class: 'ui' },
        'webapp': { text: 'وب اپلیکیشن', class: 'web' },
        'branding': { text: 'برندینگ', class: 'ui' },
        'other': { text: 'سایر', class: 'other' }
      };
      const currentCat = catMap[item.category] || { text: 'پروژه', class: 'other' };
      
      // محاسبه تاخیر انیمیشن (1, 2, 3) برای ایجاد حالت پله‌ای
      const delay = (index % 3) + 1;
    %>

    <div class="col-md-6 col-lg-4 portfolio-item <%= currentCat.class %> reveal reveal-delay-<%= delay %>">
      <div class="card-sol card-portfolio">
        <div class="portfolio-img">
          <% if (item.coverImage) { %>
            <!-- اگر تصویر داشت نمایش بده، در غیر این صورت گرادینت پیش‌فرض -->
            <img src="<%= item.coverImage %>" alt="<%= item.title %>" style="width:100%; height:220px; object-fit:cover;">
          <% } else { %>
            <div style="width:100%; height:220px; background:linear-gradient(135deg,#6447f4,#0090e8); display:flex; align-items:center; justify-content:center;">
              <i class="bi bi-laptop" style="font-size:4rem; color:rgba(255,255,255,.7);"></i>
            </div>
          <% } %>
          
          <div class="portfolio-overlay">
            <a href="<%= item.liveUrl || '#' %>" class="btn-portfolio-view">
              <i class="bi bi-eye me-1"></i>
              مشاهده پروژه
            </a>
          </div>
        </div>
        
        <div class="portfolio-body">
          <p class="tag"><%= currentCat.text %></p>
          <h5 style="font-weight:700; font-size:.95rem; margin-bottom:.3rem;">
            <%= item.title %>
          </h5>
          <p class="text-muted" style="font-size:.82rem; margin:0;">
            <%= item.description %>
          </p>
        </div>
      </div>
    </div>
  <% }) %>
</div>


    <div class="text-center mt-5 reveal">
      <a href="portfolio.html" class="btn btn-outline-main btn-lg">
        مشاهده همه پروژه‌ها
        <i class="bi bi-arrow-left ms-2"></i>
      </a>
    </div>

  </div>
</section>


<!-- ═══════════════════════════════════════
     PACKAGES / PRICING
════════════════════════════════════════ -->
<section class="packages-section" id="packages">
  <div class="container">

    <div class="text-center mb-5 reveal">
      <span class="section-tag">
        <i class="bi bi-box-seam-fill"></i>
        پکیج‌ها
      </span>
      <h2 class="section-title">پکیج مناسب خود را انتخاب کنید</h2>
      <p class="section-subtitle mx-auto">
        راه‌حل‌های متنوع برای هر نوع کسب‌وکار — از طراحی ساده تا پروژه‌های سازمانی
      </p>
    </div>

    <div class="row g-4 justify-content-center">

      <% if (packages && packages.length > 0) { %>
        <% packages.forEach((pkg, index) => { %>

          <div class="col-md-6 col-lg-3 reveal reveal-delay-<%= index + 1 %>">
            <div class="card-sol card-package h-100 <%= pkg.isFeatured ? 'card-package-featured' : '' %>">

              <div class="package-badge <%= pkg.isFeatured ? 'package-badge-featured' : '' %>">
                <%= pkg.isFeatured ? 'پرطرفدار' : pkg.categoryLabel || 'پکیج' %>
              </div>

              <div class="package-icon">
                <% if (pkg.category === 'web') { %>
                  <i class="bi bi-window-stack"></i>
                <% } else if (pkg.category === 'store') { %>
                  <i class="bi bi-cart-check"></i>
                <% } else if (pkg.category === 'ui_ux') { %>
                  <i class="bi bi-palette"></i>
                <% } else if (pkg.category === 'seo') { %>
                  <i class="bi bi-graph-up-arrow"></i>
                <% } else if (pkg.category === 'maintenance') { %>
                  <i class="bi bi-tools"></i>
                <% } else { %>
                  <i class="bi bi-box-seam"></i>
                <% } %>
              </div>

              <h4 class="package-name"><%= pkg.name %></h4>

              <p class="package-desc">
                <%= pkg.description %>
              </p>

              <% if (pkg.price && pkg.price > 0) { %>
                <div class="package-price mb-3">
                  <strong>
                    <%= pkg.price.toLocaleString('fa-IR') %>
                  </strong>
                  <span>
                    <%= pkg.currency === 'IRR' ? 'تومان' : pkg.currency %>
                  </span>
                </div>
              <% } %>

              <% if (pkg.duration) { %>
                <div class="package-duration mb-3">
                  <i class="bi bi-clock"></i>
                  <span><%= pkg.duration %></span>
                </div>
              <% } %>

              <ul class="package-features">
                <% if (pkg.features && pkg.features.length > 0) { %>
                  <% pkg.features.forEach(feature => { %>
                    <li>
                      <i class="bi bi-check-lg"></i>
                      <%= feature %>
                    </li>
                  <% }) %>
                <% } %>
              </ul>

              <a href="/contact?package=<%= pkg.slug || pkg._id %>" class="btn <%= pkg.isFeatured ? 'btn-main' : 'btn-outline-main' %> w-100 mt-auto">
                مشاوره رایگان
              </a>

            </div>
          </div>

        <% }) %>
      <% } else { %>

        <div class="col-12 text-center">
          <p>در حال حاضر پکیجی برای نمایش وجود ندارد.</p>
        </div>

      <% } %>

    </div>
  </div>
</section>



