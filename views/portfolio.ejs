            <i class="bi bi-layers-half" style="font-size: 4rem;"></i>
          </div>
          <div class="p-4">
            <span class="badge bg-main-100 text-main-700 mb-2 px-3 py-1.5 rounded-pill fs-7">رابط کاربری مایع</span>
