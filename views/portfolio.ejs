          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 portfolio-item" data-category="shop">
        <div class="card-sol card-tilt tilt-3 h-100 p-0 overflow-hidden position-relative" data-cursor-hover>
          <div class="portfolio-img-wrapper" style="height: 240px; background: linear-gradient(135deg, #2f1d95, #5236d6); opacity: 0.85; display:flex; align-items:center; justify-content:center; color:#fff;">
            <i class="bi bi-bag-heart-fill" style="font-size: 4rem;"></i>
          </div>
          <div class="p-4">
            <span class="badge bg-main-100 text-main-700 mb-2 px-3 py-1.5 rounded-pill fs-7">فروشگاهی</span>
